// =============================================================================
//  «СКОЛЬКО МЕСЯЦЕВ ВЫ ПРОДЕРЖИТЕСЬ» — интро к курсу «Дистанция».
//  VO — distanciya-VO.md, //lip 1..11.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. ОБМАНКА ВЕДЁТ ОТ СОСЕДА К СЕБЕ. Ролик открывается ЛЕСТНИЧНОЙ ПЛОЩАДКОЙ
//     с двумя одинаковыми дверями: двое с одинаковым доходом и разной жизнью.
//     Одиннадцать секунд зритель слушает про чужих и соглашается легко. Ровно в
//     этот момент звучит вопрос, на который придётся отвечать себе: сколько
//     месяцев вы продержитесь, если доход прекратится завтра. Дальше разговор
//     уже не про соседа, и мир меняется на КУХНЮ — место, где считают этот
//     месяц.
//
//  2. ПЯТЬ ОТГОВОРОК ВМЕСТО ОДНОГО ТЕРМИНА. Пулемёт — это короткий горизонт
//     изнутри, и ни разу не назван по имени: «Не до этого», «Вот будет
//     прибавка», «Вот с понедельника», «Вот с нового года», «Этот бы месяц
//     закрыть». Термин
//     «горизонт планирования» нельзя узнать в своей кухне, а эти пять фраз
//     узнаются мгновенно.
//
//  3. ОПЫТ С КОНФЕТОЙ НЕ ОПРОВЕРГАЕТСЯ, А ПЕРЕСЧИТЫВАЕТСЯ. Сначала звучит то,
//     что все помнят, потом два факта из переоценки: связь вдвое слабее, а с
//     поправкой на семью падает ещё втрое. Единственные цифры ролика стоят в
//     ПУСТОТЕ, где нечем отвлечься. «Учёные доказали» не звучит ни разу — этот
//     оборот запрещён гейтом, и правильно.
//
//  4. ЛОКАЦИЯ ДОКАЗЫВАЕТ РЕПЛИКУ, А НЕ СТОИТ ФОНОМ. Два одинаковых стула
//     (двое) → кухня со счётом (там считают месяц) → ПУСТОТА (механизм и
//     цифры) → дорога со столбами (длина отмерена) → зал Лектория → снова
//     площадка. Все три сюжетные локации сняты ПОД ЭТОТ РОЛИК, и в каждой
//     ровно один красный предмет: цвет переживает монохромный проход движка.
//     Красным помечено то, что держит горизонт коротким, — счета у двери и
//     штамп на квитанции; в финале тот же красный меняет знак и становится
//     дальним столбом, до которого надо дожить.
//
//  5. ТЕМП ИДЁТ ПО БИТАМ: хук 1.42, измерение 1.31, пулемёт 1.59, сразу за ним
//     разворот 1.25. Самое медленное место — не дно, а ВОПРОС: зритель должен
//     успеть начать считать про себя.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set ploschadka from "../assets/sets/ploschadka-dve-dveri.svg"
import set kuhnya from "../assets/sets/kuhnya-schet.svg"
import set void from "../assets/sets/void-black.svg"
import set doroga from "../assets/sets/doroga-stolby.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ПЛОЩАДКА С ДВУМЯ ДВЕРЯМИ — ХУК И ДОБИВКА =============
//  ДВЕ ОДИНАКОВЫЕ ДВЕРИ, И ВСЯ РАЗНИЦА — В ТОМ, ЧТО У НИХ НА ПОЛУ. Слева
//  аккуратная стопка писем, справа счета лезут из ящика и валяются по полу.
//  Ролик не показывает ни соседа, ни его квартиру: снаружи двери одинаковые,
//  разница возникла в решениях, которых никто не заметил.
//
//  ЕДИНСТВЕННОЕ ЦВЕТНОЕ ПЯТНО КАДРА — красная печать на счёте у правой двери.
//  Цвет переживает монохромный проход (движок пропускает насыщенный пиксель),
//  и красным помечено ровно то, что держит горизонт коротким.
scene "ploschadka" (duration: 1s, set: ploschadka) {
    transition static 0.2s

    //  Стоит МЕЖДУ ДВЕРЯМИ, ни к одной не прислонившись: разговор про двоих,
    //  и сам он пока ни один из них.
    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92

    //  ПРЕДМЕТ-ШУТКА УЖЕ В КАДРЕ, И ЕГО НЕ ПРИШЛОСЬ РИСОВАТЬ: на подоконнике
    //  между дверями стоит пустая жестяная банка — она пришла вместе с
    //  картинкой локации. Первые сорок секунд её никто не называет. Выстрелит
    //  на взлёте («это не запас, это банка») и вернётся в жале первым шагом.
    //  Отдельный реквизит не нужен: банка — часть сета, она не съедет и не
    //  потеряется при перекадрировке.
    camera wide

    freeman pose "calm"
    wait 0.3s

    // ── ХУК (VO-1): «Вы и ваш сосед зарабатываете одинаково.» ──────────
    //  Подача БУДНИЧНАЯ, как читают статистику: он не жалеет и не обвиняет.
    //  Обвинения не будет вообще — в этом ролике виноватого нет, есть
    //  положение.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 6.1s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "vzves"       // «у него жильё и запас» — две ладони
                                           // на разной высоте: сравнение двоих
            wait 1.6s
            freeman overlays "no"          // «у вас кредиты» — развёл руками
        }
    }
    camera wide
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «Тот же ум. То же трудолюбие.» ─────────────
    //  ТРИ КОРОТКИХ УДАРА подряд — здесь рубленость уместна: перечисляется то,
    //  что зритель и сам считает объяснением, и каждое отбрасывается.
    freeman pose "calm"
    freeman overlays "hips"
    //lip 2
    together {
        freeman speaks for 3.6s
        do {
            wait 1.4s
            freeman overlays "zatylok"     // «то же трудолюбие» — рука за голову
            wait 1.0s
            freeman overlays "shrug"       // «разница в другом» — плечами
        }
    }
    wait 0.4s
}

// ============ СЦЕНА 2: КУХНЯ — ВОПРОС, ПУЛЕМЁТ, РАЗВОРОТ ====================
//  МЕСТО, ГДЕ СЧИТАЮТ ЭТОТ МЕСЯЦ. Кухня с чужой посудой на столе: вечер
//  кончился, все разошлись, а счёт остался. Здесь задают вопрос про число
//  месяцев и здесь же слышны все пять отговорок.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    //  Стоит В ПРОХОДЕ, в глубине. Пробовал левее, у стола (0.32 при 0.55) —
    //  столешница срезала фигуру по грудь, оставалась одна голова над столом.
    //  Свободен ровно центр кадра: по нему он потом и идёт на камеру.
    place freeman at (0.46, 0.82) facing front on floor
    freeman scales 0.52
    camera wide

    // ── ИЗМЕРЕНИЕ (VO-3): «Сколько месяцев вы продержитесь?» ───────────
    //  САМАЯ МЕДЛЕННАЯ РЕПЛИКА РОЛИКА (темп 0.92) — медленнее дна. Зритель
    //  должен успеть начать считать про себя, а не дослушать вопрос.
    freeman pose "calm"
    freeman overlays "open"
    //lip 3
    together {
        freeman speaks for 5.0s
        do {
            wait 1.8s
            freeman overlays "point"       // «измерить» — ткнул в счёт на столе
            wait 1.6s
            freeman overlays "k_sebe"      // «вы продержитесь» — ладонь к груди
        }
    }
    wait 0.4s

    // ── ПУЛЕМЁТ (VO-4): пять отговорок, ИДЁТ НА КАМЕРУ ─────────────────
    //  ОТГОВОРКИ НЕ ОТДАЛЯЮТ, ОНИ НАСТУПАЮТ — поэтому движение на зрителя, а
    //  не вбок. Шаг фронтальный (`shag_levoj`/`shag_pravoj`), обе накладки без
    //  рта, липсинк не перебивается.
    //
    //  Шаг и движение ОДНОВРЕМЕННО: `moves-to ... over` и `scales ... over`
    //  занимают время как `wait`, поэтому накладка ставится ПЕРЕД своим
    //  отрезком, а не после всех. 4×1.2 = 4.8 с при 5.0 с реплики.
    freeman pose "calm"
    //lip 4
    together {
        freeman speaks for 6.1s
        do {
            freeman overlays "shag_levoj"
            freeman moves-to (0.48, 0.89) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.63 over 1.2s
            freeman overlays "shag_levoj"
            freeman moves-to (0.50, 0.95) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.80 over 1.2s
            freeman overlays "shag_levoj"
            freeman moves-to (0.50, 0.96) over 1.1s
        }
    }
    //  Остановка полной позой: слои шага сняты, ноги приставлены. Поза не
    //  нейтральная, а СМЫСЛОВАЯ — `otmahnulsya`: пять отговорок кончились ровно
    //  тем движением, которым от них и отмахиваются.
    freeman pose "otmahnulsya"
    //  Тишина на месте шестой отговорки — её нет, и это слышно.
    wait 0.5s

    // ── РАЗВОРОТ (VO-5): «И это не слабоволие.» ────────────────────────
    //  ВПЕРВЫЕ В УПОР. До этой секунды он ни разу не смотрел в камеру: пока
    //  разговор шёл про соседа и про отговорки, взгляд в упор был бы
    //  преждевременным. Здесь снимается обвинение — и потому смотрит прямо.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 5.8s
        do {
            wait 2.2s
            freeman overlays "k_sebe"      // «не слабоволие» — про зрителя
            wait 1.4s
            camera medium freeman
            freeman overlays "ugryumo"     // «доживать» — лицо жёстче. НЕ
                                           // `stern`: та трогает рот и
                                           // перебила бы липсинк.
        }
    }
    camera wide
    wait 0.3s
}

// ================== СЦЕНА 3: ПУСТОТА — ЦИФРЫ И ПОЗИЦИЯ ======================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Единственные цифры ролика стоят здесь, где нечем
//  отвлечься: ни кухни, ни дверей. Две реплики подряд без смены плана —
//  сначала пересчитанный опыт, потом вывод.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между кухней и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-6): опыт с конфетой пересчитали ──────────────
    //  БЕЗ ЗЛОРАДСТВА. Опыт не высмеивается: сначала звучит то, что все
    //  помнят, и только потом пересчёт. Если сыграть это разоблачением,
    //  зритель начнёт спорить вместо того, чтобы считать.
    //lip 6
    together {
        freeman speaks for 9.0s
        do {
            wait 3.6s
            freeman overlays "zatylok"     // «пересчитали заново» — неловкость
            wait 2.2s
            freeman overlays "think"       // цифры — отвёл взгляд
            wait 1.8s
            freeman overlays "v_upor"      // и снова в упор
        }
    }
    wait 0.4s

    // ── ДНО (VO-7): «Это позиция, в которой вы стоите.» ────────────────
    //  ГЛАВНАЯ ФРАЗА РОЛИКА, и потому играется почти неподвижно: любой жест
    //  здесь отвлекает. Вспышка вынесена ЗА реплику, в тишину после неё.
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 4.3s
        do {
            wait 2.6s
            freeman overlays "ugryumo"
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: ДОРОГА СО СТОЛБАМИ — ВЗЛЁТ ===========================
scene "doroga" (duration: 1s, set: doroga) {
    transition static 0.2s

    //  ГОРИЗОНТ ВИДНО ДО КРАЯ. Ни развилки, ни знака: выбор здесь ни при чём,
    //  важна ДЛИНА — и она отмерена столбами, от крупного ближнего до точек у
    //  горизонта. Красная верхушка САМОГО ДАЛЬНЕГО столба — второе и последнее
    //  цветное пятно ролика: в первой сцене красным были счета, здесь — то, до
    //  чего надо дожить. Жест `vdal` показывает ровно туда.
    place freeman at (0.5, 0.90) facing front on floor
    freeman scales 0.80
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: позиция названа, сейчас скажут, что с
    //  ней делать. Реплика сразу после склейки читалась бы приговором.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): «Запас. Люди. Вещь, которая работает без вас.» ───
    //  ТРИ ВЕЩИ, А НЕ ТРИ СОВЕТА: перечисляется то, что можно поставить между
    //  собой и завтрашним днём, — и ни одна из них не про характер.
    freeman pose "calm"
    //lip 8
    together {
        freeman speaks for 9.1s
        do {
            wait 1.6s
            freeman overlays "open"        // «запас, который держит месяц»
            wait 1.7s
            freeman overlays "vdal"        // «горизонт длиннее» — рука вдаль,
                                           // ровно туда, куда уходит дорога
            wait 1.7s
            freeman overlays "raskryl"     // «вещь, которая работает без вас»
            wait 2.2s
            //  ШУТКА ИГРАЕТСЯ СУХО. «Это не запас, это банка» — единственная
            //  шутка ролика, и подавать её жестом нельзя: подмигнёшь — станет
            //  номером. Поэтому не хохма, а отмашка: мол, и говорить не о чем.
            freeman overlays "otmahnulsya"
        }
    }
    wait 0.4s

    // ── ПОДЪЁМ (VO-9): «Первый отложенный месяц даёт вам выбор.» ───────
    //  РОЛИК НЕ ДОЛЖЕН КОНЧИТЬСЯ ПРИГОВОРОМ. Мотивация здесь не обещанием, а
    //  масштабом задачи: не капитал, а ОДИН месяц — планка, которую человек в
    //  дефиците может взять, не поверив ни в одно обещание. Камера ближе:
    //  единственное место ролика, где он говорит по-доброму.
    freeman pose "calm"
    //lip 9
    together {
        freeman speaks for 4.3s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "k_sebe"      // «даёт вам выбор» — к зрителю
        }
    }
    camera wide
    wait 0.2s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-9): называет курс ──────────────────────────────
    //lip 10
    together {
        freeman speaks for 3.6s
        do {
            camera medium freeman
            wait 1.4s
            freeman overlays "wave"        // «дистанция»
            wait 1.2s
            freeman overlays "open"        // «бесплатно»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 6: СНОВА ПЛОЩАДКА — ЖАЛО ================================
scene "final" (duration: 1s, set: ploschadka) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92
    //  ТА ЖЕ БАНКА НА ТОМ ЖЕ ПОДОКОННИКЕ. Кольцо замыкается не фразой, а
    //  предметом: он стоял тут с первой секунды, и последнее, что делает
    //  Фримен, — показывает на него. Над банкой только что смеялись, и она же
    //  оказывается единственным доступным первым шагом.
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.2s

    // ── ЖАЛО (VO-10): «Посчитайте своё число. Без округления вверх.» ───
    //  ИЗМЕРИМОЕ ЗАДАНИЕ, а не мысль на прощание: число можно посчитать
    //  сегодня вечером и провалить сегодня же. «Без округления вверх» — про
    //  то, как считать будут на самом деле.
    //lip 11
    together {
        freeman speaks for 6.8s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "ruka_vverh"  // «без округления вверх» — рука вверх
            wait 1.4s
            camera wide
            //  ПОКАЗАЛ НА ПОДОКОННИК — банка стоит между дверями, чуть выше
            //  его головы. Подход идёт ПОД РЕЧЬ, а не после неё: первая версия
            //  отправляла его к предмету в тишине, и гейт пауз честно поймал
            //  4.7 с молчаливого хвоста — движение занимает время наравне
            //  с `wait`.
            //  ВСТАЁТ ПРАВЕЕ ПОДОКОННИКА, а не под ним: накладка `point`
            //  поднимает ЛЕВУЮ руку вверх-влево, и с точки прямо под банкой
            //  палец уходил в потолок мимо неё — видно на сборке. Отойдя на
            //  0.56, он показывает ровно на подоконник.
            freeman moves-to (0.56, 0.94) over 0.9s
            freeman overlays "point"       // «не выбрасывайте банку» — показал
        }
    }
    freeman overlays "hero_wink"
    wait 0.1s

    // ── УХОДИТ, ДВЕРИ ОСТАЮТСЯ ─────────────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой.
    //  Кольцо замыкается на ПРЕДМЕТЕ: последнее, что видит зритель, — те же
    //  две одинаковые двери, с которых ролик начался. Снаружи они и через
    //  десять лет одинаковые; разница — в счетах на полу и в числе, которого
    //  не видно.
    //  Молчаливый хвост держится под тремя секундами (tools/pauses.py).
    //  ПОДХОДИТ К ВЕЛОСИПЕДУ И ПОПРАВЛЯЕТ ЕГО — стоя. Фигура НЕ приседает:
    //  поза, роняющая рост больше чем на 8%, валит прогон (tools/posture.py),
    //  поэтому к предмету он тянется рукой, а не садится над ним. Ни слова:
    //  предмет играет сам, комментировать его нельзя.
    //  Показал — и ушёл. Весь хвост укладывается в полторы секунды: гейт пауз
    //  считает молчание после последнего слова, и три секунды там уже дыра, а
    //  не приём.
    camera wide
    freeman pose "ruka_vverh"

    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой.
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.94) over 0.5s
    freeman overlays "shag_bok_levoj"
    wait 0.25s
    freeman overlays "shag_bok_pravoj"
    wait 0.25s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы.
    freeman pose "bok_levo"
}

// ========================== СЦЕНА 7: ТИТРЫ ==================================
scene "titry" (duration: 1.7s, set: titry) {
    transition static 0.15s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.35s
    transition fade-black 0.25s
}
