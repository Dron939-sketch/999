import character hero from "../assets/characters/freeman_rig"
config {
    width: 1000
    height: 1000
    fps: 24
    background: #e9eae4
    film-grain: 0.0
    vignette: 0.0
    line-boil: 0.0
    on-twos: 1
    form-shadow: 0.0
    ground-shadow: 0.0
    rim-light: 0.0
}
scene "karta" (duration: 1s) {
    place hero at (0.5, 0.6) facing front
    hero scales 0.9
    hero pose "chetvert_levo"
    camera wide
    wait 1s
}
