config {
    width: 1280
    height: 720
    fps: 24
    background: #d4d7cf
    monochrome: false
    snow: 0.1
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.04
    vignette: 0.1
    film-flicker: 0.02
    gate-weave: 0.3
    film-scratch: 0.2
    film-dust: 0.4
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ── 0:00.09 (7.73с) — «здравствуйте, с вами Фреди»
scene "b000_shov" (duration: 1s, set: komnata) {
    transition static 0.10s
    place freeman at (0.50, 0.99) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"
    wait 0.60s
    freeman pose "vzglyad"
    wait 1.40s
    freeman pose "point"
    wait 1.40s
    freeman pose "calm"
    wait 4.2233s
}

// ── 0:07.84 (12.61с) — «что в повседневности ваш выбор, а что настройки»
scene "b001" (duration: 1s, set: lek1_obychnaya_zhizn) {
    transition static 0.10s
    camera two-shot
    camera pan-to (0.500, 0.452) over 0.01s
    camera pan-to (0.500, 0.548) over 12.4983s ease-in-out
}

// ── 0:20.46 (11.19с) — «увидеть свою жизнь свежим взглядом»
