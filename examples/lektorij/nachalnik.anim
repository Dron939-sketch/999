// =============================================================================
//  «ЛУЧШИЕ УЙДУТ ПЕРВЫМИ» — интро к курсу «Управление людьми», номер 24.
//  VO — nachalnik-VO.md, маркеры 1..16.
//
//  ОДНА МЫСЛЬ НА РОЛИК: он своими руками делает ту команду, на которую будет
//  жаловаться. Каждый вечер, когда он переделывает чужую работу вместо того,
//  чтобы объяснить, один человек перестаёт пробовать. Через год рядом остаются
//  только те, кого это устраивает.
//
//  ЭТО ВТОРАЯ РЕДАКЦИЯ, И ПЕРВАЯ БЫЛА ОТБИТА СТУДИЕЙ СО СЛОВАМИ «НЕ ЦЕПЛЯЕТ,
//  НЕТ ДРАМАТУРГИИ». Она была формально полной и мёртвой: тринадцать элементов
//  формулы на месте, двадцать пять гейтов зелёные, а ставки нет, поворота нет,
//  температура одна от первой реплики до последней. Здесь по-другому:
//
//  1. СТАВКА В ПЕРВОЙ СЕКУНДЕ И В ЕДИНИЦАХ ЕГО ЖИЗНИ. Не «вы работаете больше»
//     (сводка бухгалтера), а «от вас первыми уйдут лучшие»: он теряет людей, и
//     теряет уже сейчас.
//
//  2. ПОВОРОТ РАЗВОРАЧИВАЕТ ЗРИТЕЛЯ ПРОТИВ НЕГО САМОГО. Он слышит свою
//     собственную будущую фразу — «и вы скажете: не повезло с командой», —
//     узнаёт её, и через паузу в 1.2 с получает три слова: «Её собрали вы».
//     Обвинение предъявляется ОДИН раз и стоит в середине, а не в финале.
//
//  3. ТЕМПЕРАТУРА ХОДИТ. VO-4 — самая тихая точка, почти шёпотом. VO-8 — удар
//     в упор, крупный план. Дальше отпускает в иронию и заканчивается тихо.
//     Сыграть всё одним приговором — вернуть мёртвую редакцию.
//
//  4. РАЗРЫВ В КАРТИНКЕ — РАБОЧИЕ ПЕРЧАТКИ на вершине башни офисных бумаг.
//     Предмет прежней профессии на предмете новой; их никто не трогает и ни
//     разу не называет словом. Они же единственное цветное пятно ролика,
//     0.65% кадра, и нарисованы прямо в локации: гейт цвета читает пятно
//     только по локациям.
//
//  5. ПОВЁРНУТЫХ РАКУРСОВ НЕТ, И НИЖНЕГО РАКУРСА НЕТ. Пары ±22°, ±45° и ±90°
//     у рига не зеркальны (реестр §XLI), а `camera angle low` наклоняет камеру
//     и обнажает подложку — на первом сданном файле это стоило трёх секунд
//     пустого кадра. Чистых ракурсов три: анфас, полуспина, спина.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ ПО 4.1 СЛОГА В СЕКУНДУ. Поправка снята с
//  переписанных заводом чисел прошлой редакции: живая озвучка идёт медленнее
//  слоговой таблицы, и прошлый ролик из-за этого вышел на 23 секунды длиннее
//  прогноза. Завод перепишет числа по факту.
// =============================================================================
//
//  МИЗАНСЦЕНЫ ПРОСМОТРЕНЫ: ec3aa9a0
import character freeman from "../assets/characters/freeman_rig"
import set voronka from "../assets/sets/nachalnik-stol-voronka.svg"
import set dvoe from "../assets/sets/nachalnik-stol-na-dvoih.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.12
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}


// ============ СЦЕНА 1: voronka — ПРИГОВОР И ВЕЧЕР ========================
//  Четыре одинаковых стола в ряд, три чистые и пустые, третий слева завален до
//  потолка. На вершине башни — перчатки. Персонаж стоит у ЧИСТОГО стола: он
//  между тем, что забрал, и теми, у кого забрал.
scene "s1" (duration: 1s, set: voronka) {
    place freeman at (0.30, 0.96) facing front on floor
    freeman scales 0.94 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-24.svg") at (0.325, 0.545) layer 9
    nomer scales 0.17 over 0.01s
    nomer hides
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.19 over 0.05s ease-out
    nomer scales 0.17 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"
    wait 0.1s

    //lip 1
    //  «От вас первыми уйдут лучшие.» — БЕЗ РАЗГОНА, как сводку. Ставка ролика
    //  стоит в первой секунде: он теряет людей, и теряет уже сейчас.
    together {
        freeman speaks for 2.44s
        do {
            freeman overlays "vdal"
            wait 1.4s
            freeman overlays "vzglyad"
        }
    }
    wait 0.4s

    //  ПЕРЕМЕЩЕНИЕ ПО КАДРУ. Он идёт от чистого стола к заваленному — единственный
    //  проход ролика, и он же его сюжет в одном движении.
    freeman overlays "turn34"
    wait 0.1s
    freeman pose "shag_pravoj"
    wait 0.12s
    freeman moves-to (0.42, 0.96) over 0.5s ease-in-out
    freeman pose "shag_levoj"
    wait 0.12s
    freeman pose "calm"
    wait 0.1s

    //lip 2
    //  «Вечер. Опять чужой отчёт.» — единственная сцена ролика. Ни оценки, ни
    //  укора: событие названо, вывод складывает зритель.
    together {
        freeman speaks for 1.95s
        do {
            freeman overlays "vniz"
            wait 1.1s
            freeman overlays "ladoni_vniz"
        }
    }
    camera medium freeman
    wait 0.4s

    //lip 3
    //  «Объяснить — час. Сделать — сорок минут.» — его собственный счёт, и он
    //  верный. Всё дальнейшее стоит на том, что зритель с числами согласился.
    together {
        freeman speaks for 3.34s
        do {
            freeman overlays "vzves"
            wait 1.51s
            freeman overlays "vzves_r"
            wait 1.23s
            freeman overlays "poimal"
        }
    }
    wait 0.9s
}


// ============ СЦЕНА 2: voronka — ТИХАЯ ТОЧКА И КРУГ ======================
//  Склейка: шелест бумаги обрывается, остаётся гул. Крупный план — реплика
//  идёт почти шёпотом, и её надо видеть по лицу.
scene "s2" (duration: 1s, set: voronka) {
    transition static 0.12s

    place freeman at (0.42, 0.96) facing front on floor
    freeman scales 0.94 over 0.01s
    camera close-up freeman
    freeman pose "calm"
    wait 0.15s

    //lip 4
    //  «Кто его писал — больше не попробует.» — САМАЯ ТИХАЯ ТОЧКА РОЛИКА.
    //  У чисел появилось последствие, и оно не про его вечер, а про человека.
    //  Сыграть приговором — превратить ставку в упрёк, и зритель начнёт
    //  защищаться вместо того, чтобы считать.
    together {
        freeman speaks for 2.93s
        do {
            freeman overlays "gorech"
            wait 1.5s
            freeman overlays "ostyl"
        }
    }
    camera wide
    wait 0.4s

    //  ЛИЦО, КОТОРОГО В РЯДУ НЕ БЫЛО: `hero_disgust` — злые глаза и волна рта.
    //  Отвращение к КРУГУ, а не к человеку, который в нём сидит. Накладкой, а
    //  не позой: полная поза стёрла бы жест тела в стойку смирно
    //  (PRAVILA-DVIZHENIYA.md §5). И только лицо — всё, что трогает голову или
    //  корпус, уводит подол (реестр §XLI).
    freeman overlays "hero_disgust"
    wait 0.1s

    //lip 5
    //  «Быстрее. Быстрее. Быстрее. Полгода.» — МАНТРА. Повтор внутри реплики,
    //  ровно, без нарастания: круг не разгоняется, он крутится.
    together {
        freeman speaks for 2.93s
        do {
            freeman overlays "otschet"
            wait 1.0s
            freeman overlays "manit"
            wait 1.0s
            freeman overlays "manit_l"
        }
    }
    freeman pose "calm"
    wait 0.4s

    //lip 6
    //  «Через год останутся те, кого всё устраивает.» — СТАВКА. Ровно, без
    //  жалости. Камера уходит с него на три чистых стола: те, кому он не отдал.
    together {
        freeman speaks for 3.90s
        do {
            freeman overlays "razvel"
            wait 2.1s
            freeman overlays "dve_storony"
        }
    }
    wait 0.5s
}


// ============ СЦЕНА 3: voronka — ЕГО ФРАЗА И УДАР ========================
//  Здесь ролик перестаёт говорить о нём сочувственно и предъявляет счёт. Ровно
//  один раз, и в середине ролика, а не в финале: дальше зрителю дают мерку,
//  шутку над способом и действие на завтра.
scene "s3" (duration: 1s, set: voronka) {
    transition static 0.12s

    place freeman at (0.42, 0.96) facing front on floor
    freeman scales 0.94 over 0.01s
    camera medium freeman
    freeman pose "calm"
    wait 0.15s

    //lip 7
    //  «И вы скажете: не повезло с командой.» — его собственная будущая фраза.
    //  Буднично, чужой репликой: он обязан узнать в ней себя.
    together {
        freeman speaks for 2.93s
        do {
            freeman overlays "shrug"
            wait 1.3s
            freeman overlays "otmahnulsya"
            wait 1.0s
            freeman overlays "klin"
        }
    }
    camera close-up freeman
    wait 1.2s

    //  ВЗГЛЯД СТАВИТСЯ ДО РЕПЛИКИ, И ЭТО НЕ `v_upor`. Тот разворачивает корпус
    //  на 15° и голову на 14°, а плащ висит на торсе: гейт подола намерил -13
    //  пикселей, двадцать процентов видимой длины ног. Удар держится не позой,
    //  а глазами и паузой перед ним.
    freeman overlays "stern"
    wait 0.1s

    //lip 8
    //  «Её собрали вы.» — ПЕРЕЛОМ. Три слова, в упор, без нажима. Пауза перед
    //  этим — рабочее время зрителя: он успевает узнать себя в первой фразе и
    //  только тогда получает вторую.
    together {
        freeman speaks for 1.46s
        do {
            freeman overlays "vzglyad"
        }
    }
    camera wide
    wait 0.5s
}


// ============ СЦЕНА 4: dvoe — МЕРКА И ШУТКА ==============================
//  Пустая столешница и ровно два стула лицом к лицу: работа, в которой нечего
//  делать руками. Смета зачитывается тому, кого за этим столом нет.
scene "s4" (duration: 1s, set: dvoe) {
    transition static 0.12s

    //  Ставится к левому краю и к самой передней кромке пола: мера локации
    //  0.77 кадра, и от середины фигура закрывала бы собой ровно то, ради чего
    //  кадр взят. Ступни на 0.99 — так рост держится в мере, а над макушкой
    //  остаётся поле (гейт запаса и гейт масштаба тянут в разные стороны).
    place freeman at (0.23, 0.99) facing front on floor
    freeman scales 1.12 over 0.01s
    camera wide
    freeman pose "calm"
    wait 0.15s

    //lip 9
    //  «Считайте не свой день, а их. Решать вам.» — ВЗЛЁТ и ОТКАЗ одной
    //  репликой: другая единица результата, а что с ней делать — не моё дело.
    together {
        freeman speaks for 3.87s
        do {
            freeman overlays "k_sebe"
            wait 2.16s
            freeman overlays "ladon_pusta"
        }
    }
    wait 0.5s

    //  ЛИЦО, КОТОРОГО В РЯДУ НЕ БЫЛО: `talk` — он просто читает смету, как
    //  строку из бумаги. Сухо, без игры: станок шутки держится на несовпадении
    //  единиц, и всякая подсказка его убивает. Накладкой и ДО реплики — внутри
    //  неё рот принадлежит липсинку.
    freeman overlays "talk"
    wait 0.1s

    //lip 10
    //  «Экономия — ровно двадцать минут.» — МЕРА НЕ ИЗ ТОЙ СИСТЕМЫ, станок 3.
    //  Число подаётся ФАКТОМ, а не отсылкой: «те самые» стояло здесь один
    //  прогон и было снято вычиткой — двадцать минут нигде не звучали, они
    //  вычислимы из «часа» и «сорока минут», а на скорости этого никто не
    //  считает. Отсылка к тому, чего не говорили, — требование к памяти.
    together {
        freeman speaks for 2.68s
        do {
            freeman overlays "otschet"
            wait 1.5s
            freeman overlays "lokti"
        }
    }
    camera close-up freeman
    wait 1.2s

    //lip 11
    //  «Цена — человек. Работает ровно до завтра.» — добивка и предел способа
    //  одной репликой. Экономия настоящая, но её хватает на один вечер.
    together {
        freeman speaks for 3.40s
        do {
            freeman overlays "odna_v_bok"
            wait 1.85s
            freeman overlays "otverg"
        }
    }
    camera wide
    freeman pose "calm"
    wait 0.4s
}


// ============ СЦЕНА 5: zal — ПРЕЗЕНТАЦИЯ И РОЛИК О СЕБЕ ==================
//  Зал Лектория: презентация звучит в другом месте, и оно нарочно не его.
scene "s5" (duration: 1s, set: zal) {
    transition static 0.12s

    place freeman at (0.48, 0.95) facing front on floor
    freeman scales 0.86 over 0.01s
    camera medium freeman
    freeman pose "calm"
    wait 0.15s

    //lip 12
    //  «Курс «Управление людьми». Бесплатно.» — без подмигивания, как факт.
    //  Цена отдельной строкой.
    together {
        freeman speaks for 2.68s
        do {
            freeman overlays "raskryl"
            wait 1.5s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    //lip 13
    //  «Мне легко: я нарисованный, вся судьба — ваша лента.» —
    //  САМОРЕФЕРЕНЦИЯ. Ролик записывает себя в ту же ленту, из которой
    //  говорит, и снимает с себя пафос дешевле любой другой правки.
    together {
        freeman speaks for 3.90s
        do {
            freeman overlays "wave"
            wait 2.1s
            freeman overlays "prishchur"
        }
    }
    camera reset
    wait 0.5s
}


// ============ СЦЕНА 6: voronka — ЖАЛО, ВОЗВРАТ ЯКОРЯ, КОЛЬЦО =============
//  Возвращаемся туда же, где начали, и в ту же точку пола: кольцо смыкается и
//  в кадре, и в тексте.
scene "s6" (duration: 1s, set: voronka) {
    transition static 0.12s

    place freeman at (0.30, 0.96) facing front on floor
    freeman scales 0.94 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-24.svg") at (0.325, 0.545) layer 9
    nomer2 scales 0.17 over 0.01s
    nomer2 hides
    camera wide
    freeman pose "calm"
    wait 0.15s

    //lip 14
    //  «Завтра отдайте задачу целиком.» — ЖАЛО. Измеримое действие на завтра,
    //  а не «учитесь делегировать».
    together {
        freeman speaks for 2.68s
        do {
            freeman overlays "k_sebe_r"
            wait 1.5s
            freeman overlays "raspahnul"
        }
    }
    wait 0.5s

    //  КРУПНО НА ПЕРЧАТКИ. Разрыв, посаженный в первой секунде, оплачивается
    //  здесь. Цель панорамы на 0.24, а не выше: на среднем плане видно 0.45
    //  высоты локации, и центр на 0.20 выводил верхнюю кромку кадра за её край.
    camera medium freeman
    camera pan-to (0.635, 0.24) over 0.6s ease-in-out
    wait 0.1s

    //lip 15
    //  «От вас первыми уйдут лучшие.» — ВОЗВРАТ ЯКОРЯ. Дословно и тем же тоном,
    //  что в начале: узнавание работает на совпадении, а не на смысле.
    together {
        freeman speaks for 2.44s
        do {
            freeman overlays "vdal"
            wait 1.4s
            freeman overlays "vzglyad"
        }
    }
    camera reset
    camera wide

    //  ПАУЗА 1.8 с. Зритель складывает «отсчёт идёт уже полгода, и первый,
    //  возможно, уже решил». Заполнить нечем — это его работа.
    freeman pose "calm"
    wait 1.8s

    //lip 16
    //  «Вы уже начали…» — ПОДТВЕРЖДЕНИЕ. Рассказчик приходит вторым и коротко.
    //  Вниз, с обрывом.
    together {
        freeman speaks for 1.46s
        do {
            freeman overlays "ostyl"
            wait 0.9s
            freeman overlays "zatylok"
        }
    }
    wait 1.0s

    //  КОЛЬЦО. Кадр собирается тождественным первому: то же место, та же точка
    //  пола, та же поза, та же метка курса — и ролик уходит на второй круг.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.02 over 0.01s
    nomer2 scales 0.19 over 0.05s ease-out
    nomer2 scales 0.17 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer2 hides
    freeman pose "calm"
    wait 0.4s
}
