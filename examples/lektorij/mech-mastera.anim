// =============================================================================
//  «МЕЧ МАСТЕРА» — сказка с озвучкой.  VO — mech-mastera-VO.md, маркеры 1..42.
//
//  ФОРМАТ ДРУГОЙ. Это не ролик серии, а озвученная сказка: 6 минут 01 секунда,
//  сорок две реплики, семь локаций. Структуры монолога — хука на третьей
//  секунде, перелома на двадцать первой, шутки, жала — здесь нет и быть не
//  должно. `tools/script_lint.py` на этом сценарии осмысленного вердикта не
//  даёт: он проверяет партитуру монолога.
//
//  ТЕКСТ СТУДИИ, МЕНЯТЬ НЕЛЬЗЯ. Реплики нарезаны дословно.
//
//  1. ПЕРСОНАЖ И РАССКАЗЫВАЕТ, И ПРИСУТСТВУЕТ. Он не играет юношу и не играет
//     мастеров — он стоит в местах сказки и говорит. Локации это МЕСТА, а не
//     иллюстрации к репликам.
//
//  2. ОТВЕТ МАСТЕРА («этот меч тебе не подойдёт») звучит ЧЕТЫРЕ РАЗА и все
//     четыре идут с ОДНИМ И ТЕМ ЖЕ слоем `teplo`. Ни разу не многозначительно.
//     Смысл меняется не подачей, а тем, кто фразу произносит: первые три раза
//     старики, четвёртый — сам герой. Сыграешь последний «со значением» —
//     сказка станет нравоучением.
//
//  3. РАЗНООБРАЗИЕ ДВИЖЕНИЙ — ГЛАВНАЯ ЗАДАЧА ШЕСТИ МИНУТ. Пул на сорок слоёв,
//     ни один не повторяется в окне из восьми реплик. Больше половины — из тех
//     ста двух поз, что не использовались в серии ни разу: `chelo`, `k_sebe_r`,
//     `zatylok_l`, `yorik`, `povorot_levo`, `ruka_vverh_r`, `think_r`,
//     `vzves_r`, `wave_r` и зеркальные варианты. В двухминутном интро хватает
//     пятнадцати движений, здесь их нужно втрое больше: повтор жеста на третьей
//     минуте виден невооружённым глазом.
//
//  4. ЧЁРНЫЙ КАДР РОВНО ОДИН (VO-38) — «ведь он-то знал, что у него так и не
//     было настоящего Меча Мастера». Признание не должно ни на что опираться.
//
//  5. МАСШТАБ ФИГУРЫ снят пробным рендером по каждой локации (реестр §XXVII).
//     В доме, кузнице и на поле с первого раза фигура вышла ребёнком: стол
//     приходился ей по грудь вместо колена. Поправлено.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ. Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set gory from "../assets/sets/skazka-gory.svg"
import set doroga from "../assets/sets/skazka-doroga.svg"
import set dom from "../assets/sets/skazka-dom.svg"
import set vorota from "../assets/sets/skazka-vorota.svg"
import set kuznica from "../assets/sets/skazka-kuznica.svg"
import set pole from "../assets/sets/skazka-pole.svg"
import set void from "../assets/sets/void-black.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: gory ==========================================
scene "s1" (duration: 1s, set: gory) {
    place freeman at (0.30, 0.95) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 1
    together {
        freeman speaks for 6.59s
        do {
            freeman overlays "vozzvanie"
            wait 3.43s
            freeman overlays "razvel"
        }
    }
    wait 0.55s

    //lip 2
    together {
        freeman speaks for 7.15s
        do {
            freeman overlays "rubit"
            wait 3.72s
            freeman overlays "kozyrek"
        }
    }
    wait 0.55s
}

