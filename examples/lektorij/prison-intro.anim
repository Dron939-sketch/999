// =============================================================================
//  ТЮРЬМА УМА — интро (регистр «выйти из клетки»).
//  Локация НАРИСОВАНА (prison-cell.svg, плоский тушевый стиль по LOCATION_STYLE.md),
//  не фото — персонаж читается на графичном поле. Три речевых удара:
//  завязка → поворот → добивание. //lip 1..3 → синхрон по конструкции с озвучкой
//  (examples/lektorij/prison-intro-VO.md). Локально немой (флэпы).
//  Рендер: cargo run --release -- render examples/lektorij/prison-intro.anim -o prison.mp4
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set cell from "../assets/sets/prison-cell.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #1a1c1a
    on-twos: 2
    line-boil: 0.6
    film-grain: 0.30
    vignette: 0.55
    light-angle: 58
    form-shadow: 0.42
    cast-shadow: 0.30
    rim-light: 0.5
}

scene "cell" (duration: 16s, set: cell) {
    place freeman at (0.5, 0.80) facing front
    freeman scales 1.5
    // ФОНОВЫЙ АКТЁР + НЕСУРАЗИЦА (фирменный приём): крыса вылезает из унитаза,
    // бежит по полу, лезет по стене и ныряет в окно. Координаты — из
    // prison-cell.surfaces.json. Масштаб задаём ОДИН РАЗ при размещении (scale
    // как action в середине пути ломает трек пропа — проверено).
    let rat = prop("rat", "../assets/props/rat.svg") at (0.80, 0.66)
    rat scales 0.42
    // анфас-цел крысы для «машет+подмиг» у окна (подмена бегущей). Скрыт до реплики.
    let ratw = prop("rat_wave", "../assets/props/rat-wave.svg") at (0.42, 0.30)
    ratw scales 0.39
    ratw hides

    // --- общий: клетка целиком, фигура в центре ---
    camera wide
    freeman pose "calm"
    // из унитаза — на пол
    rat moves-to (0.70, 0.93) over 0.7s ease-out
    // по полу к стене под окном (floor → wall_base_window)
    rat moves-to (0.45, 0.66) over 1.0s
    // ЛЕЗЕТ ВВЕРХ по задней стене (встаёт вертикально)
    together {
        rat moves-to (0.42, 0.34) over 1.0s
        rat rotates -80 over 0.6s
    }
    // ПОВОРАЧИВАЕТСЯ К КАМЕРЕ: подмена бегущей крысы на анфас-цел (машет+подмиг)
    rat hides over 0.12s
    ratw shows over 0.12s
    // машет лапой (качание корпуса) + подмиг (запечён в целе)
    ratw rotates 10 over 0.15s
    ratw rotates -12 over 0.2s
    ratw rotates 8 over 0.2s
    // ныряет в окно (вверх наружу, растворяясь)
    together {
        ratw moves-to (0.42, 0.20) over 0.45s ease-in
        ratw fades-to 0 over 0.4s
    }
    freeman pose "think"
    wait 1.0s

    // --- средний: завязка в упор (VO-1: «тебя держат стены») ---
    camera medium freeman
    freeman pose "talk"
    //lip 1
    freeman speaks for 2.6s
    freeman pose "point"
    wait 0.4s

    // --- крупно: поворот мысли (VO-2: «стен нет, дверь открыта») ---
    camera close-up freeman
    freeman pose "talk"
    //lip 2
    freeman speaks for 4.8s
    freeman pose "stern"
    wait 0.5s

    // --- сверхкруп: добивание в упор (VO-3: «выход — это мысль... выйди») ---
    camera extreme-close-up freeman
    freeman pose "talk"
    //lip 3
    freeman speaks for 4.8s
    freeman pose "grotesque"
    wait 0.6s
    freeman pose "calm"
    wait 0.6s
    transition fade-black 1.3s
}
