// =============================================================================
//  ТЮРЬМА УМА v4 — продающее интро курса «Перепрошивка».
//  РЕЖИССУРА ПО HOLLYWOOD.md: раскадровка по битам, медиана плана к ритму
//  оригинала (~1.3-2с), флэш-морды, поле-ритм, наезды, ракурсы high/low,
//  рука-в-камеру. VO v3 (SCRIPT-FREEMAN §5): реплики раздроблены на короткие
//  удары ≤7 слов. v5: КАТЫ ВНУТРИ РЕПЛИК — together{speaks + do{камеры}} —
//  речь непрерывна, планы рубятся (ритм оригинала). //lip 1..9.
//  Тайм-якоря 3-7-21: t=3 крыса лезет, t=7 хук отыгран, t=21 разворот+рука.
//  Паттерны: телепорт moves-to over 0.01s; пропы ждут за кадром.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set cell from "../assets/sets/prison-cell.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #1a1c1a
    on-twos: 2
    line-boil: 1.25
    film-grain: 0.05
    vignette: 0.12
    light-angle: 58
    form-shadow: 0.0        // канон: лицо Фримена ПЛОСКОЕ, без объёма
    cast-shadow: 0.30
    rim-light: 0.5
}

// ============================== СЦЕНА 1: КЛЕТКА ==============================
scene "cell" (duration: 40s, set: cell) {
    transition static 0.4s

    place freeman at (0.5, 0.45) facing front
    freeman scales 1.15
    // Крыса на полу: `on floor` — точка привязки внизу рисунка (лапы стоят
    // на полу, а не тонут в нём), размер считается по глубине из
    // prison-cell.surfaces.json. Раньше и того и другого не было: центр
    // рисунка садился на сиденье унитаза — половина крысы висела в воздухе, —
    // а на дальней кромке пола она оставалась того же размера, что под ногами.
    let rat = prop("rat", "../assets/props/rat.svg") at (0.804, 0.653) on floor
    rat scales 0.42
    // ЛЕЗЕТ ПО СТЕНЕ — отдельный рисунок, вид СО СПИНЫ. Задняя стена смотрит
    // в камеру, значит лезущего по ней видно сверху-сзади. Раньше по стене
    // ехал вид сбоку, повёрнутый на −80°: крыса на боку, приклеенная к стене.
    // Масштаб 0.23 = 0.42 на дальней кромке пола, чтобы при подмене рисунка
    // размер не прыгнул.
    let ratb = prop("ratb", "../assets/props/rat-back.svg") at (0.45, -1.5)
    ratb scales 0.23
    let ratw = prop("rat_wave", "../assets/props/rat-wave.svg") at (0.42, 0.30)
    ratw scales 0.39
    ratw hides
    let hand = prop("hand", "../assets/props/hand-point.svg") at (-1.5, 1.5) layer 5
    let slovo = text("СВОБОДА?", 150) at (0.5, -2.0) layer 6
    slovo scales 2.6

    // --- t=0..3.5 БЕЗ СЛОВ: крыса-одиссея (крючок 3с — уже лезет по стене) ---
    camera wide
    freeman pose "calm"
    // вылезла из унитаза, спрыгнула на пол и бежит к стене — вид сбоку
    rat moves-to (0.70, 0.99) over 0.5s ease-out
    rat moves-to (0.46, 0.70) over 0.7s
    // у стены разворачивается вверх: рисунок МЕНЯЕТСЯ на вид со спины
    rat hides over 0.01s
    ratb moves-to (0.45, 0.64) over 0.01s
    ratb moves-to (0.42, 0.36) over 0.7s
    ratb moves-to (0.42, -1.5) over 0.01s
    ratw shows over 0.1s
    ratw rotates 10 over 0.12s
    ratw rotates -12 over 0.15s
    together {
        ratw moves-to (0.42, 0.20) over 0.35s ease-in
        ratw fades-to 0 over 0.3s
    }

    // --- ХОДИТ ПО КАМЕРЕ ВЗАД-ВПЕРЁД ---
    // Действие до первого слова: камера показана не планом, а поведением.
    // Ходьба идёт БАЗОЙ, а руки-в-карманы и опущенные плечи ложатся СЛОЕМ
    // (`overlays`) — ноги своим ходом, корпус своим, как у человека.
    camera medium freeman
    freeman pose "shag_levoj"
    freeman overlays "hunch"
    freeman moves-to (0.68, 0.45) over 1.3s
    wait 0.3s
    freeman pose "shag_pravoj"
    freeman overlays "hunch"
    wait 0.5s
    freeman pose "shag_levoj"
    freeman overlays "hunch"
    freeman moves-to (0.34, 0.45) over 1.3s
    wait 0.4s
    // упирается в стену и разворачивается — тупик читается телом
    freeman pose "shag_pravoj"
    wait 0.4s
    freeman pose "ugryumo"
    wait 0.6s

    // --- ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) ---
    // «Ну-у-у... здравствуйте. Дорогие мои. Сидите? Ну сидите, сидите.»
    // Сквозное приветствие Лектория плюс каламбур ИМЕННО этого ролика:
    // зритель сидит в кресле, герой — в камере, а курс про то, что сидят оба.
    // Глаза по контексту реплики: подача снисходительная, поэтому прищур и
    // ухмылка (`smug`), а не клин злости — тот приберегается для приговоров.
    freeman moves-to (0.5, 0.45) over 0.01s
    freeman pose "smug"
    //lip 1
    together {
        freeman speaks for 4.6s
        do {
            camera medium freeman
            wait 1.6s
            camera close-up freeman
            wait 1.4s
            // «сидите? ну сидите, сидите» — ленивый отмах ладонью СЛОЕМ,
            // поза лица держится
            freeman overlays "wave"
            wait 0.9s
            camera medium freeman
        }
    }
    freeman pose "ugryumo"
    wait 0.5s

    // --- ХУК (VO-2): средний, фигура ВПРАВО-треть, ракурс СВЕРХУ ---
    freeman moves-to (0.63, 0.45) over 0.01s
    freeman pose "smug"
    //lip 2
    together {
        freeman speaks for 1.8s
        do {
            camera angle high freeman
            wait 0.9s
            camera medium freeman
        }
    }
    // --- ХУК-добивка (VO-3): КАТ на крупный, фигура ВЛЕВО-треть ---
    freeman moves-to (0.37, 0.45) over 0.01s
    freeman pose "weary"
    //lip 3
    together {
        freeman speaks for 1.6s
        do {
            camera close-up freeman
            wait 0.8s
            camera extreme-close-up freeman
        }
    }
    freeman pose "flash_grotesque"
    wait 0.08s
    freeman pose "skeptic"
    wait 0.45s

    // --- ПУЛЕМЁТ 1 (VO-3): средний, центр, ракурс обычный ---
    freeman moves-to (0.5, 0.45) over 0.01s
    freeman pose "puppet"
    //lip 4
    together {
        freeman speaks for 2.4s
        do {
            camera medium freeman
            wait 1.2s
            camera close-up freeman
        }
    }
    // --- ПУЛЕМЁТ 2 (VO-4): КАТ крупный, ВПРАВО-треть ---
    freeman moves-to (0.64, 0.45) over 0.01s
    freeman pose "puppet_jerk"
    //lip 5
    together {
        freeman speaks for 2.0s
        do {
            camera close-up freeman
            wait 1.0s
            camera wide
        }
    }
    // --- ПУЛЕМЁТ финал (VO-5): КАТ ECU + тряска на «здравом смысле» ---
    freeman pose "stern"
    //lip 6
    together {
        freeman speaks for 2.1s
        do {
            camera extreme-close-up freeman
            wait 1.0s
            camera medium freeman
        }
    }
    camera shake 0.35s intensity 2
    freeman pose "flash_grin"
    wait 0.08s
    freeman pose "stern"
    wait 0.6s

    // --- t≈21 ПЕРЕЛОМ: РАЗВОРОТ (VO-6), ракурс СНИЗУ + рука-в-камеру ---
    freeman moves-to (0.42, 0.45) over 0.01s
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 4.0s
        do {
            camera angle low freeman
            wait 1.4s
            camera extreme-close-up freeman
            wait 1.3s
            camera medium freeman
        }
    }
    hand moves-to (0.72, 0.72) over 0.01s
    camera shake 0.3s intensity 2
    wait 0.6s
    hand moves-to (-1.5, 1.5) over 0.01s
    wait 0.5s

    // --- ВЗЛЁТ (VO-7): ECU, тепло; следом слово-удар ---
    freeman pose "raskryl"
    //lip 8
    together {
        freeman speaks for 3.5s
        do {
            camera extreme-close-up freeman
            wait 1.8s
            camera wide
        }
    }
    // СЛОВО-УДАР + негатив-вспышка (поле-ритм: уход из павильона в графику)
    camera wide
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 2
    wait 0.8s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    freeman pose "flash_pupils"
    wait 0.08s

    // --- ЖАЛО-CTA (VO-8): средний, центр, наезд-удар на подколке ---
    freeman moves-to (0.5, 0.45) over 0.01s
    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 1.8s
            camera close-up freeman
            wait 1.7s
            camera wide
        }
    }
    camera zoom-to freeman over 0.18s ease-in
    freeman pose "hero_wink"
    wait 0.55s
    // отъезд-одиночество: зритель остаётся с мыслью
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.6s
}

// ============================== СЦЕНА 2: ТИТРЫ ==============================
scene "titry" (duration: 6s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.2s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 2.5s
    transition fade-black 0.8s
}
