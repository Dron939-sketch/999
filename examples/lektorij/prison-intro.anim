// =============================================================================
//  ТЮРЬМА УМА v3 — продающее интро курса «Перепрошивка», РЕЖИССУРА ПО HOLLYWOOD.md
//  Волна 1: раскадровка по битам (бит VO = 2-4 плана), флэш-морды, поле-ритм
//  (павильон ↔ чёрное ECU ↔ белое слово), наезд-удар, смещённые композиции.
//  Волна 2: ракурсы pitch/angle (low = власть, high = унижение), рука-в-камеру.
//  VO v2 по SCRIPT-FREEMAN.md: хук-подколка → триада-пулемёт → разворот →
//  взлёт (слово-удар «СВОБОДА?» + инверсия) → жало-CTA. //lip 1..5.
//  Паттерны: телепорт moves-to over 0.01s; пропы ждут за кадром.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set cell from "../assets/sets/prison-cell.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #1a1c1a
    on-twos: 2
    line-boil: 0.6
    film-grain: 0.30
    vignette: 0.55
    light-angle: 58
    form-shadow: 0.42
    cast-shadow: 0.30
    rim-light: 0.5
}

// ============================== СЦЕНА 1: КЛЕТКА ==============================
scene "cell" (duration: 40s, set: cell) {
    // старт БЕЗ текста: ТВ-помехи, из них врывается клетка
    transition static 0.4s

    place freeman at (0.5, 0.80) facing front
    freeman scales 1.5
    // крыса-несуразица (фирменный приём) — открытие без слов
    let rat = prop("rat", "../assets/props/rat.svg") at (0.80, 0.66)
    rat scales 0.42
    let ratw = prop("rat_wave", "../assets/props/rat-wave.svg") at (0.42, 0.30)
    ratw scales 0.39
    ratw hides
    // рука-в-камеру и слово-удар ждут ЗА КАДРОМ
    let hand = prop("hand", "../assets/props/hand-point.svg") at (-1.5, 1.5) layer 5
    let slovo = text("СВОБОДА?", 150) at (0.5, -2.0) layer 6
    slovo scales 2.6

    // --- БИТ 0 (тишина, ~5.5с): клетка, крыса-одиссея ---
    camera wide
    freeman pose "calm"
    rat moves-to (0.70, 0.93) over 0.7s ease-out
    rat moves-to (0.45, 0.66) over 1.0s
    together {
        rat moves-to (0.42, 0.34) over 1.0s
        rat rotates -80 over 0.6s
    }
    rat hides over 0.12s
    ratw shows over 0.12s
    ratw rotates 10 over 0.15s
    ratw rotates -12 over 0.2s
    together {
        ratw moves-to (0.42, 0.20) over 0.45s ease-in
        ratw fades-to 0 over 0.4s
    }
    freeman pose "think"

    // --- БИТ 1 ХУК (VO-1 «Удобно сидишь?..», 3 плана) ---
    // план 1: средний, фигура смещена ВПРАВО (треть), взгляд сверху = «ты мелкий»
    freeman moves-to (0.63, 0.80) over 0.01s
    camera angle high freeman
    freeman pose "talk"
    //lip 1
    freeman speaks for 3.5s
    // флэш-морда: ухмылка-подколка
    freeman pose "flash_grotesque"
    wait 0.08s
    freeman pose "skeptic"
    wait 0.9s

    // --- БИТ 2 ТРИАДА-ПУЛЕМЁТ (VO-2, 4 плана: кат на каждый удар) ---
    // план: крупно, фигура слева-треть
    freeman moves-to (0.37, 0.80) over 0.01s
    camera close-up freeman
    freeman pose "talk"
    //lip 2
    freeman speaks for 7.0s
    // конец пулемёта: удар + тряска
    camera shake 0.4s intensity 2
    freeman pose "stern"
    wait 1.0s

    // --- БИТ 3 РАЗВОРОТ (VO-3 «про кого-то другого?», ракурс СНИЗУ = власть) ---
    freeman moves-to (0.5, 0.80) over 0.01s
    camera angle low freeman
    freeman pose "talk"
    //lip 3
    freeman speaks for 5.5s
    // рука-В-КАМЕРУ на «поправь меня»: гигантский палец в зрителя
    hand moves-to (0.72, 0.72) over 0.01s
    camera shake 0.3s intensity 2
    wait 0.7s
    hand moves-to (-1.5, 1.5) over 0.01s
    // флэш-морда: ярость на миг
    freeman pose "flash_rage"
    wait 0.08s
    freeman pose "stern"
    wait 0.5s

    // --- БИТ 4 ВЗЛЁТ (VO-4 «Выход — это мысль», ECU + слово-удар) ---
    camera extreme-close-up freeman
    freeman pose "talk"
    //lip 4
    freeman speaks for 5.0s
    // СЛОВО-УДАР: «СВОБОДА?» впечатывается + негатив-вспышка
    camera wide
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.2s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 2
    wait 1.0s
    slovo moves-to (0.5, -2.0) over 0.25s ease-in

    // --- БИТ 5 ЖАЛО-CTA (VO-5, наезд-удар на финал) ---
    freeman moves-to (0.5, 0.80) over 0.01s
    camera medium freeman
    freeman pose "talk"
    //lip 5
    freeman speaks for 7.6s
    // наезд-удар в упор на подколке
    camera zoom-to freeman over 0.18s ease-in
    freeman pose "sly"
    wait 0.8s
    // отъезд-одиночество: мелкая фигура в клетке, зритель остаётся с мыслью
    camera reset over 0.6s
    freeman pose "calm"
    wait 1.0s
}

// ============================== СЦЕНА 2: ТИТРЫ ==============================
scene "titry" (duration: 6.5s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.4s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 3.2s
    transition fade-black 0.8s
}
