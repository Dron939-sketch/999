// =============================================================================
//  ТЮРЬМА УМА — интро (регистр «выйти из клетки»).
//  Локация НАРИСОВАНА (prison-cell.svg, плоский тушевый стиль по LOCATION_STYLE.md),
//  не фото — персонаж читается на графичном поле. Три речевых удара:
//  завязка → поворот → добивание. //lip 1..3 → синхрон по конструкции с озвучкой
//  (examples/lektorij/prison-intro-VO.md). Локально немой (флэпы).
//  Рендер: cargo run --release -- render examples/lektorij/prison-intro.anim -o prison.mp4
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set cell from "../assets/sets/prison-cell.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #1a1c1a
    on-twos: 2
    line-boil: 0.6
    film-grain: 0.30
    vignette: 0.55
    light-angle: 58
    form-shadow: 0.42
    cast-shadow: 0.30
}

scene "cell" (duration: 16s, set: cell) {
    place freeman at (0.5, 0.80) facing front
    freeman scales 1.5

    // --- общий: клетка целиком, фигура в центре ---
    camera wide
    freeman pose "calm"
    wait 1.4s
    freeman pose "think"
    wait 1.2s

    // --- средний: завязка в упор (VO-1: «тебя держат стены») ---
    camera medium freeman
    freeman pose "talk"
    //lip 1
    freeman speaks for 2.6s
    freeman pose "point"
    wait 0.4s

    // --- крупно: поворот мысли (VO-2: «стен нет, дверь открыта») ---
    camera close-up freeman
    freeman pose "talk"
    //lip 2
    freeman speaks for 4.8s
    freeman pose "stern"
    wait 0.5s

    // --- сверхкруп: добивание в упор (VO-3: «выход — это мысль... выйди») ---
    camera extreme-close-up freeman
    freeman pose "talk"
    //lip 3
    freeman speaks for 4.8s
    freeman pose "grotesque"
    wait 0.6s
    freeman pose "calm"
    wait 0.6s
    transition fade-black 1.3s
}
