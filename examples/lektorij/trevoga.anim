// =============================================================================
//  «В СРЕДУ» — интро к курсу «Тревога и как с ней жить».
//  VO — trevoga-VO.md, маркеры 1..19.
//
//  ОДНА МЫСЛЬ НА РОЛИК: избегание — плата в рассрочку. Сегодня отпускает на
//  десять минут, завтра приходит счёт, и он больше.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ОН НЕ ОБЪЯСНЯЕТ, ЧТО ТАКОЕ ТРЕВОГА, И ЭТО ГЛАВНОЕ РЕШЕНИЕ. Объяснять её
//     бесполезно: зритель знает изнутри лучше нас. Он не знает другого — во
//     что ему обходятся те десять минут, за которые отпускает. Поэтому ролик
//     считает, а не разбирает (реестр §XXI: узнавание вместо объяснения).
//
//  2. СТОРОЖ ПОКАЗАН РАНЬШЕ, ЧЕМ НАЗВАН. В окне голая ветка, её тень лежит на
//     полу чёрными пальцами и дотягивается до ног фигуры. Зритель на секунду
//     видит руку — и ровно об этом следующая реплика. Локация нарисована под
//     этот кадр, и ставить в ней фигуру надо ТОЛЬКО слева: справа окно и тень,
//     то есть весь смысл.
//
//  3. КАЧЕЛИ ОБЪЯСНЯЮТ ПОВЕДЕНИЕ, А НЕ УТЕШАЮТ (VO-13). «Трусу всё равно — он
//     не проверяет по три раза.» Проверяет тот, кому не всё равно; это
//     возвращает достоинство и заодно объясняет, откуда взялась привычка.
//
//  4. СНИЖЕННОЙ ЛЕКСИКИ ЗДЕСЬ НЕТ, И ЭТО НЕ ОСТОРОЖНОСТЬ. В «Отказе» она была
//     дважды и работала: тот ролик злит. Этот — пугает; грубость добавит стыда
//     вместо облегчения, а стыд в этой теме гонит обратно в избегание.
//
//  5. ПРАВИЛО 3–7–21 ПРОВЕРЕНО ПО ТАЙМЛАЙНУ: крючок на 0:01 (чужая строка из
//     переписки), первый удар голосом на 0:04.8, перелом на 0:27.7.
//
//  6. НОМЕРА КУРСА В ПОДПИСИ НЕТ, И ЭТО НЕ ЗАБЫТО. «Личным границам» студия
//     присвоила восьмой; у «Тревоги» номер пока не назначен, а выдуманная
//     цифра ушла бы в ленту и разошлась с каталогом. Как только номер дадут —
//     добавляются строка подписи и метка на груди по образцу `otkaz.anim`.
//
//  7. ЦВЕТА В РОЛИКЕ НЕТ, И ЭТО ЗАМЕРЕНО. Красная полоска уведомления на
//     телефоне уцелела после квантования, но занимает 42 пикселя — 0.005%
//     кадра; после зерна, снега и дрожания линии её не видно. Ролик идёт
//     монохромным, как три ролика «Логики»: одно цветное пятно — потолок, а
//     не обязанность.
//
//  8. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): пулемёт 6.3,
//     цена 4.4 — перепад в полтора раза. Ухо слышит не скорость, а смену
//     скорости.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/mouth_ownership.py);
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · координаты фигуры на новой локации снимаются ПРОБНЫМ КОНТАКТНЫМ ЛИСТОМ,
//      а не по аналогии с соседней сценой (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` РАСЧЁТНЫЕ — ролик новый. Модель «0.59 с на внутренний
//  знак», поправленная коэффициентом 0.93. Модель врёт неравномерно по битам
//  (`KONVEJER.md` §4.1); завод перепишет числа по факту.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set stol from "../assets/sets/stol-neprochitannoe.svg"
import set koridor from "../assets/sets/koridor-lovushka.svg"
import set kuhnya from "../assets/sets/kuhnya-tri-kruga.svg"
import set void from "../assets/sets/void-black.svg"
import set okno from "../assets/sets/okno-vetka.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: СТОЛ С НЕПРОЧИТАННЫМ ================================
//  ЗАКРЫТЫЙ КОНВЕРТ И ТЕЛЕФОН ЛЕЖАТ РЯДОМ, И ОБА НЕ ТРОНУТЫ. В кадре ничего не
//  происходит — и в этом он весь: тревога живёт не в событии, а в его
//  отсутствии.
scene "stol" (duration: 1s, set: stol) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании, и
    //  вспышка помех на ней заметнее любого шва.
    //  Плинтус задней стены на y 0.737, снят по левой половине кадра, где нет
    //  мебели. Правее 0.45 заходить нельзя — срежет столешницей.
    place freeman at (0.24, 0.95) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"
    wait 0.3s

    // ── ХУК (VO-1): чужая строка и дата ───────────────────────────────
    //  РОВНО, КАК ЗАЧИТЫВАЮТ ЧУЖУЮ СТРОКУ. Сыграешь драму — зритель решит,
    //  что речь про чей-то развод, и выйдет из своей истории. От кого
    //  сообщение, не говорится ни разу: каждый достроит своё.
    //lip 1
    together {
        freeman speaks for 3.41s
        do {
            freeman overlays "hips"
            wait 1.9s
            freeman overlays "vzglyad"     // «вы прочитали это в среду»
        }
    }
    wait 0.4s

    // ── ДОБИВКА (VO-2): сколько прошло ────────────────────────────────
    //  ДВЕ КОРОТКИЕ ФРАЗЫ, ВТОРАЯ СУШЕ. Ни капли упрёка: упрекнёшь — зритель
    //  начнёт оправдываться и перестанет считать.
    //lip 2
    together {
        freeman speaks for 2.92s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "ostyl"       // «вы не ответили»
        }
    }
    wait 0.6s

    // ── ОТРИЦАНИЕ (VO-3): ложное согласие ─────────────────────────────
    //  ВОЗРАЖЕНИЕ ЗАКРЫВАЕТСЯ ДО ОЧЕРЕДИ ПРИМЕРОВ. Первое, чем зритель
    //  защищается, — «я просто выбираю подходящий момент». Приём серии:
    //  примирительная фраза, снимающая спор, и следом та же мысль в
    //  регистре, от которого спорить уже поздно. БЕЗ нажима — нажмёшь, и
    //  выйдет издёвка.
    //lip 3
    together {
        freeman speaks for 6.12s
        do {
            freeman overlays "ladoni_vniz" // «я не говорю, что вы трус»
            wait 3.2s
            freeman overlays "prishchur"   // «особенно бессрочную»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 2: КОРИДОР — ОЧЕРЕДЬ «ПОТОМ» ===========================
//  «ПОТОМ» ГОВОРЯТ НА ХОДУ, МЕЖДУ ДЕЛОМ, НЕ ОСТАНАВЛИВАЯСЬ. Отсрочка не
//  выглядит решением — она выглядит занятостью, и в этом её защита.
scene "potom" (duration: 1s, set: koridor) {
    transition static 0.15s

    //  Пол коридора уходит в перспективу (карта: back_y 0.589) — фигура
    //  ставится к переднему краю, иначе окажется в стене.
    place freeman at (0.46, 0.90) facing front on floor
    freeman scales 0.70 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПУЛЕМЁТ (VO-4): три отсрочки подряд ───────────────────────────
    //  ШАГ И НАЕЗД ОДНОВРЕМЕННО, ПО ОДНОМУ НА ПУНКТ. Записанные подряд,
    //  `moves-to` и `scales` и выполняются подряд — в кадре это «подъехал, а
    //  потом раздулся». `together` внутри `do` связывает их в один отрезок.
    //  Персонаж идёт НА КАМЕРУ: отсрочки не отдаляются, они копятся.
    //lip 4
    together {
        freeman speaks for 7.13s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "razvel"      // «позвонить врачу — потом»
            together {
                freeman moves-to (0.46, 0.93) over 1.6s
                freeman scales 0.78 over 1.6s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "somnenie"    // «открыть письмо из банка — потом»
            together {
                freeman moves-to (0.46, 0.96) over 1.6s
                freeman scales 0.86 over 1.6s
            }
            freeman overlays "shag_levoj"
            freeman overlays "k_sebe"      // «спросить, что он имел в виду»
            wait 1.6s
            freeman overlays "shag_pravoj"
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты.
    freeman pose "calm"
    wait 0.4s
}

// ============ СЦЕНА 3: НОЧНАЯ КУХНЯ — ДЕСЯТЬ МИНУТ =========================
//  СТОЛ СДВИНУТ К КРАЮ, ЦЕНТР ПУСТ. Человек остаётся один со своей ночью, и
//  облегчение, о котором идёт речь, происходит ровно здесь.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.15s

    //  Пол начинается низко (карта: back_y 0.799) — фигура встаёт в пустую
    //  правую треть кадра, а не к столу.
    place freeman at (0.58, 0.94) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── УДАР (VO-5): согласие, на котором держится перелом ────────────
    //  ВОПРОС ВВЕРХ, НО БЕЗ НАЖИМА. Это приглашение кивнуть: кивок нужен ДО
    //  счёта, иначе вторая половина ролика будет спорить с человеком,
    //  который ещё ни с чем не согласился.
    //lip 5
    together {
        freeman speaks for 4.35s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "vozzvanie"   // «Знакомо?» — вопрос повисает
        }
    }
    camera wide
    //  САМАЯ ДЛИННАЯ ПАУЗА ПЕРВОЙ ПОЛОВИНЫ. В неё входит кивок зрителя.
    wait 1.0s
}

// ============ СЦЕНА 4: ПУСТОТА — СЧЁТ ======================================
//  СЧИТАЮТ ТАМ, ГДЕ НЕЧЕМ ОТВЛЕЧЬСЯ. Перелом ролика совпадает с обрывом в
//  чёрное: смена занятия видна глазом раньше, чем ухо разберёт слова.
scene "schet" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── РАЗВОРОТ (VO-6): счёт вместо разбора ──────────────────────────
    //  РОВНО, ПОЧТИ БУДНИЧНО, И ДАЛЬШЕ ВОСЕМЬ ДЕСЯТЫХ ТИШИНЫ. Зритель
    //  начинает считать сам, и следующая реплика ложится на готовый счёт.
    //lip 6
    together {
        freeman speaks for 4.15s
        do {
            freeman overlays "calm"
            wait 2.2s
            freeman overlays "vzves"       // «во сколько вам обошлись»
        }
    }
    wait 0.8s

    // ── УДАР (VO-7): главное узнавание ролика ─────────────────────────
    //  АСИММЕТРИЯ ПАМЯТИ: повод стёрся, цена осталась. Две половины
    //  разведены паузой — сначала что забыто, потом что осталось. Слитно
    //  пропадёт: узнавание живёт ровно в зазоре между ними.
    //lip 7
    together {
        freeman speaks for 6.30s
        do {
            freeman overlays "vzglyad"
            wait 3.4s
            freeman overlays "klin"        // «не спали в четверг»
        }
    }
    wait 1.0s

    // ── ЦЕНА (VO-8): столкновение регистров ───────────────────────────
    //  СОСТОЯНИЕ МЕРЯЕТСЯ БАНКОВСКИМ СЛОВОМ И ЗАКАНЧИВАЕТСЯ ФИЗИОЛОГИЕЙ.
    //  «Дышите в темноту» — вниз и тише всего остального: это конец спуска,
    //  дальше ролик пойдёт вверх.
    //lip 8
    together {
        freeman speaks for 5.62s
        do {
            freeman overlays "dve_storony" // «взяли её в рассрочку»
            wait 3.0s
            freeman overlays "ostyl"       // «дышите в темноту до утра»
        }
    }
    freeman overlays "flash_pupils"
    wait 1.2s
}

// ============ СЦЕНА 5: НОЧНАЯ КУХНЯ — КРУГ =================================
//  ВОЗВРАТ В ТУ ЖЕ КУХНЮ, ГДЕ БЫЛО ОБЛЕГЧЕНИЕ. Теперь в том же кадре
//  называется, чем оно оплачено, — и кадр работает как улика.
scene "krug" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.58, 0.94) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОТРИЦАНИЕ (VO-9): снятие вины ─────────────────────────────────
    //  ВПЕРВЫЕ ТЕПЛЕЕ. Не «вы слабый», а «так устроено»: облегчение приходит
    //  раньше счёта, и потому опыт не спорит с привычкой.
    //lip 9
    together {
        freeman speaks for 6.49s
        do {
            freeman overlays "otmahnulsya" // «не слабость и не судьба»
            wait 3.4s
            freeman overlays "teplo"
        }
    }
    wait 0.5s

    // ── УДАР (VO-10): единственное место, где курс что-то даёт ────────
    //  ПОРОЧНЫЙ КРУГ, НАЗВАННЫЙ БЕЗ ЕДИНОГО ТЕРМИНА. Читается ровно, как
    //  читают инструкцию: не пугая. Проверяется сегодня же — и это то, что
    //  зритель унесёт с собой.
    //lip 10
    together {
        freeman speaks for 5.45s
        do {
            camera medium freeman
            wait 3.0s
            freeman overlays "klin"        // «и просит ещё»
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 6: ОКНО С ВЕТКОЙ — СТОРОЖ, ХОД И КАЧЕЛИ ================
//  ГОЛАЯ ВЕТКА ЗА СТЕКЛОМ, ЕЁ ТЕНЬ НА ПОЛУ ТЯНЕТСЯ К НОГАМ ЧЁРНЫМИ ПАЛЬЦАМИ.
//  Зритель на секунду видит руку — и ровно об этом первая реплика сцены.
//  Локация нарисована под этот кадр; фигура ставится ТОЛЬКО слева, справа окно
//  и тень, то есть весь смысл.
scene "storozh" (duration: 1s, set: okno) {
    transition static 0.25s

    //  Плинтус снят по левой трети, где нет ни рамы, ни ветки: back_y 0.735.
    //  Числа фигуры сняты пробным контактным листом (реестр §XVIII).
    place freeman at (0.28, 0.90) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "think"
    wait 0.3s

    // ── ОБРАЗ (VO-11): сторож ─────────────────────────────────────────
    //  ЖИВО, ПОЧТИ С УСМЕШКОЙ. Сторож не враг: он честно работает и честно
    //  ошибается. Скажешь сурово — получится диагноз, а не облегчение.
    freeman pose "calm"
    //lip 11
    together {
        freeman speaks for 4.32s
        do {
            freeman overlays "razvel"      // «тревога — сторож»
            wait 2.4s
            freeman overlays "prishchur"   // «вора от ветра»
        }
    }
    wait 0.8s

    // ── ВЗЛЁТ (VO-12): ход отдают, а не продают ───────────────────────
    //  СПОКОЙНО, С ДОСТОИНСТВОМ, БЕЗ ТОРЖЕСТВА В ГОЛОСЕ. Тревогу не
    //  выключают — ей меняют порог, и это принципиально другое обещание.
    //lip 12
    together {
        freeman speaks for 3.10s
        do {
            freeman overlays "raspahnul"   // «его учат смотреть»
        }
    }
    wait 0.5s

    // ── КАЧЕЛИ (VO-13): возврат достоинства ───────────────────────────
    //  РОВНО, КАК КОНСТАТИРУЮТ, БЕЗ УТЕШЕНИЯ В ГОЛОСЕ. Проверяет тот, кому
    //  не всё равно: реплика возвращает достоинство и заодно объясняет,
    //  откуда взялась привычка.
    //lip 13
    together {
        freeman speaks for 4.66s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "teplo"       // «трусу всё равно»
        }
    }
    camera wide
    wait 0.9s

    // ── ШУТКА (VO-14): самое популярное НЕ-решение ────────────────────
    //  ЛЁГКАЯ ИРОНИЯ, БЕЗ ПРЕВОСХОДСТВА. Смеются над способом, а не над
    //  человеком: не открывать письма советуют себе все и бесплатно.
    //lip 14
    together {
        freeman speaks for 3.04s
        do {
            freeman overlays "otmahnulsya" // «не открывать письма вообще»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-15): у способа назван предел ────────────────
    //  ШУТКА ОБЯЗАНА НАЗЫВАТЬ ПРЕДЕЛ, ИНАЧЕ ЭТО НАСМЕШКА. Подчеркнёшь предел
    //  голосом — станет насмешкой над зрителем.
    //lip 15
    together {
        freeman speaks for 2.15s
        do {
            freeman overlays "poimal"      // «до звонка из банка»
        }
    }
    wait 1.0s
}

// ============ СЦЕНА 7: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ==========================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ. Деловой тон, как объявляют пункт, — в
//  этом ролике продаёт не обещание, а счёт, который зритель уже подвёл сам.
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "raskryl"
    wait 0.2s

    // ── ПРЕЗЕНТАЦИЯ (VO-16): имя курса и объём ────────────────────────
    freeman pose "calm"
    //lip 16
    together {
        freeman speaks for 4.31s
        do {
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            wait 2.3s
            freeman overlays "open"          // «Десять лекций»
        }
    }
    wait 0.5s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-17): цена ────────────────────────────
    //  ОТДЕЛЬНОЙ РЕПЛИКОЙ И ПОСЛЕ ПАУЗЫ. Внутри длинной строки «бесплатно»
    //  проскакивает мимо уха вместе с названием и числом; вынесенное отдельно
    //  — слышится. Повтор числа отвечает на немой вопрос «все или первая».
    //
    //  ГОЛОСОМ НЕ НАЖИМАТЬ: бесплатное с нажимом читается как подвох.
    //lip 17
    together {
        freeman speaks for 1.82s
        do {
            freeman overlays "razvel"        // «все десять — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 8: ТОТ ЖЕ СТОЛ — ЖАЛО ==================================
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ЛЕЖИТ ОТВЕТ: тот же конверт, тот же телефон, и оба
//  всё ещё не тронуты.
scene "zhalo" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.24, 0.95) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-18) ──────────────────────────────────────────────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание. Какое именно письмо —
    //  зритель знает, и добивка спрашивает его об этом прямо.
    //lip 18
    together {
        freeman speaks for 4.31s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "vozzvanie"   // «догадываетесь какое?»
        }
    }
    camera wide
    freeman overlays "hero_wink"
    wait 1.3s
}

// ============ СЦЕНА 9: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ =================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: тот же стол, тот же `place`, тот же
//  масштаб. Метки курса нет ни в первом кадре, ни в последнем — номер студией
//  не назначен (разбор — п.6 в шапке), и потому шва при зацикливании не
//  возникает по другой причине, чем обычно: показывать просто нечего.
scene "final" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.24, 0.95) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide

    //lip 19
    together {
        freeman speaks for 4.18s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.3s
            freeman overlays "palec_vverh" // «Поехали!»
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания — ровно то, с чего
    //  ролик начинается.
    freeman pose "gladit_grud"
    wait 0.4s
}
