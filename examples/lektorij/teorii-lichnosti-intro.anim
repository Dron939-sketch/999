// =============================================================================
//  «ТЕОРИИ ЛИЧНОСТИ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/teorii-lichnosti — 13 лекций, 20 теорий).
//
//  Сквозная метафора — ЧУЖИЕ ОЧКИ. Зритель уже пользуется теорией личности:
//  он объясняет людей. Просто объяснения не его — донашивает чужую оптику.
//  Очки садятся на маску в первые три секунды (крючок без слов), живут на ней
//  весь ролик и слетают на взлёте: их смысл зритель понимает только на 29-й
//  секунде. Курс продаётся не «пониманием себя», а сменой линзы.
//
//    · персонаж — канон (SIMILARITY.md);
//    · поле — ПУСТОЕ светлое (дефолт оригинала), без павильона;
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, ракурсы high/low,
//      флэш-морды, наезд-удар, слово-удар + инверсия, отъезд-одиночество;
//    · сценарий (SCRIPT-FREEMAN.md) — teorii-lichnosti-intro-VO.md, //lip 1..9,
//      гейт tools/script_lint.py: 100/100.
//
//  ОЧКИ — КОСТЬ, НЕ ПРОП. Проп стоит в мировых координатах, а голова ездит
//  от позы к позе: очки-пропом то съезжали на рот, то висели над бровью, и
//  подгонка под один кадр ломала все остальные. Теперь это кость `glasses`
//  под `head` в тех же координатах, что и маска, — оправы едут с головой в
//  любой позе и на любом плане сами. Включают её позы с суффиксом `_ochki`.
//  Проп остался только на два движения — прилёт и срыв.
//  Правило целиком: KARTA.md, «кость или проп».
//
//  ВКЛЮЧАЕТСЯ КОСТЬ ПОДМЕНОЙ ДЕТАЛИ, А НЕ МАСШТАБОМ [0,0]. Масштаб движок
//  ТЯНЕТ через переход позы (0.18с), а тянется он от пивота кости — пивот же
//  стоит на пивоте головы, у подбородка. Поэтому очки не появлялись и не
//  исчезали, а вырастали из шеи и уползали обратно ко рту: на срыве это
//  читалось как пара крошечных оправ у подбородка на четыре кадра. Деталь
//  же не тянется — `part` щёлкает на середине перехода. Отсюда: по умолчанию
//  кость несёт `blank` при масштабе [1,1], а позы `_ochki` подменяют деталь
//  на `glasses`. Пивот при этом ТРОГАТЬ НЕЛЬЗЯ: он общий с головой, и любой
//  его сдвиг уводит рисунок (проверено — уехал на 4 пикселя).
//
//  ПОСАДКА ФИГУРЫ. Якорь сущности сидит на уровне плеч; макушка на 0.19,
//  ступни на 0.45 высоты кадра от него — НА ЕДИНИЦУ `scales` (см. frame_shot
//  в src/timeline и KARTA.md). Отсюда: scales 0.80 при y 0.585 ставит ступни
//  на 0.946 (линия земли поля) и макушку на 0.433 — фигура целиком в общем
//  плане.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set titry from "../assets/sets/lektorij-final.svg"
import set pole from "../assets/sets/field-empty.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab        // тон земли: поле задаёт сет field-empty
    monochrome: true
    mono-contrast: 2.2
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0           // канон: лицо плоское
    rim-light: 0.0
}

// ============================ СЦЕНА 1: ЛИНЗА ================================
scene "linza" (duration: 61s, set: pole) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    // `over 0.01s` у КАЖДОЙ установочной строки. Голый `scales` стоит
    // движку полсекунды: три установки подряд съедали 1.5 секунды до первого
    // слова, и фирменное приветствие уезжало с 2.4-й секунды на 3.9-ю —
    // полторы секунды пустого поля в самом начале продающего ролика.
    freeman scales 0.80 over 0.01s
    let ochki = prop("ochki", "../assets/props/glasses-alien.svg") at (0.5, -1.0) layer 7
    // Размер и точки посадки пропа СНЯТЫ С КАДРА, а не подобраны на глаз:
    // в кость `glasses` временно ставилась красная метка на середину пары
    // линз, кадр рендерился, и её пиксели переводились в координаты сцены.
    // Прежние 0.4925/0.511 достались от старой посадки очков и после того,
    // как оправы пересели на линию глаз, стали указывать на МАКУШКУ: проп
    // прилетал на темя и подменялся костью со скачком в 19 пикселей.
    // Прилёт идёт при позе `smug` (голова без смещения), срыв — при
    // `raskryl_ochki` (голова опущена на 34 и повёрнута на 9°), поэтому точки
    // РАЗНЫЕ; одна на оба движения была ошибкой сама по себе.
    // Масштаб 0.201: расстояние между центрами линз пропа (146 из 420 ширины
    // рисунка) приведено к расстоянию между центрами линз кости (53.5 единиц
    // head.svg) на этом плане.
    ochki scales 0.201 over 0.01s
    let hand = prop("hand", "../assets/props/hand-point.svg") at (-1.5, 1.5) layer 5
    let slovo = text("ЧЬИ?", 170) at (0.5, -2.0) layer 6
    slovo scales 2.6 over 0.01s

    // ВТОРОЙ ПЛАН ИГРАЕТ ТУ ЖЕ МЫСЛЬ. Ролик про то, что человека закрывают
    // тремя словами, — и эти три слова должны быть В КАДРЕ, а не только в
    // звуке. На каждый приговор в пустое поле за спиной впечатывается ярлык;
    // они НЕ ГАСНУТ, а копятся и висят до взлёта: пока герой говорит, поле
    // зарастает чужими словами. На «челове́к — не ярлы́к, а судьба́» они
    // осыпаются — реплика и картинка бьют в одну точку.
    //
    // Слой 1 — ЗА фигурой (проверено рендером: слой 9 рисуется поверх маски,
    // слой 1 уходит за неё). Координаты МИРОВЫЕ, а не экранные: камера их
    // преобразует, и на `camera medium freeman` мировая y съезжает по экрану
    // примерно на 0.22 вверх. Отсюда y 0.33–0.43 — это небо над горизонтом и
    // по бокам от головы; подобрано рендером, а не на глаз. На близких планах
    // ярлыки естественно уходят из кадра — так и задумано, они фон.
    //
    // Размер задаётся ТОЛЬКО `scales`: кегль в `text(...)` на итоговый размер
    // не влияет (проверено — 26px и 90px дают одинаковую надпись).
    let yar1 = text("СЛАБАК", 90) at (0.19, -2.0) layer 1
    let yar2 = text("СТЕРВА", 90) at (0.80, -2.0) layer 1
    let yar3 = text("НИКТО", 90) at (0.50, -2.0) layer 1
    yar1 scales 0.77 over 0.01s        // 1.4× от конечного — впечатка вжимает
    yar2 scales 0.77 over 0.01s
    yar3 scales 0.98 over 0.01s

    // ── t=0..2 БЕЗ СЛОВ: фигура одна в пустом поле ────────────────────────
    //  Было `open` — руки враскидку на 70°. Мимика идёт слоем и рук не трогает,
    //  поэтому руки так и стояли раскинутыми всю завязку и всё приветствие:
    //  пять слоёв подряд, четыре с лишним секунды (studio.lint_arms). Для «один
    //  в пустом поле» верна закрытая стойка, а жест приходит на реплику.
    camera wide
    freeman pose "ugryumo"
    wait 1.4s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.6s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) ──────────────────────────────────────
    // «Ну-у-у... здравствуйте. Дорогие мои.» — и ничего сверх этого: шутка
    // под тему у каждого ролика своя и стоит ПОСЛЕ, в хуке. Идёт ПОВЕРХ
    // визуального крючка: пока звучит «дорогие мои», на маску садятся чужие
    // очки, поэтому пустых секунд не прибавляется.
    //
    // Глаза по контексту реплики: приветствие снисходительное, а не злое —
    // здесь прищур и ухмылка (`smug`), клин злости приберегается для
    // приговоров. Проп ЛЕТИТ, кость НАДЕТА: в момент касания проп прячется,
    // поза меняется на «_ochki», и дальше оправы едут с головой сами.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.4s
        do {
            wait 0.7s
            camera close-up freeman
            ochki moves-to (0.4953, 0.5382) over 0.55s ease-out
            // ПОДМЕНА С ПЕРЕКРЫТИЕМ, А НЕ ВСТЫК. `hides` гасит проп за пару
            // кадров, а поза встаёт примерно через шесть — при команде встык
            // между ними проваливались четыре кадра, где очков нет вообще:
            // на экране это мигание. Кость включается ЗАРАНЕЕ, пока проп ещё
            // виден; оба стоят в одной точке и одного размера, поэтому
            // перекрытие не читается, а провал читался.
            freeman overlays "blink_ochki"
            wait 0.15s
            ochki hides
            // ОЧКИ СЕЛИ — И ЭТО НАДО ВИДЕТЬ. Крючок всего ролика («смотришь не
            // своими глазами») отыгрывается посадкой оправ на маску, а снят он
            // был на близком плане, где оправы занимают десяток пикселей: приём
            // стоял в сценарии и проходил мимо зрителя. Сверхкруп держится
            // ровно на посадке и сразу отпускает — это удар, а не крупность
            // ролика (ecu меряется приёмщиком режиссуры, потолок 0.40).
            camera extreme-close-up freeman
            wait 0.15s
            freeman overlays "smug_ochki"
            wait 0.55s
            camera medium freeman
            freeman pose "open_ochki"     // «дорогие мои» — раскрыл руки
            wait 0.6s
        }
    }
    freeman pose "calm_ochki"
    wait 0.6s

    // ── ХУК (VO-2): фигура ВПРАВО-треть, ракурс СВЕРХУ (зритель мелкий) ────
    // Камера не стоит, а НАВАЛИВАЕТСЯ: «ты уже объясняешь людей» — обвинение,
    // и наезд внутри реплики делает его тяжелее, чем кат на её середине.
    freeman moves-to (0.63, 0.585) over 0.01s
    freeman overlays "smug_ochki"
    //lip 2
    together {
        freeman speaks for 2.6s
        do {
            camera angle high freeman
            camera zoom-to freeman over 1.3s ease-in
            freeman overlays "no"             // «да не в вас дело» — развёл руками
            camera medium freeman
            wait 0.6s
        }
    }
    // ── ХУК-добивка (VO-3): КАТ крупный, фигура ВЛЕВО-треть ───────────────
    freeman moves-to (0.37, 0.585) over 0.01s
    freeman pose "v_upor_ochki"
    //lip 3
    together {
        freeman speaks for 3.0s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "point"          // тычет пальцем в зрителя
            camera close-up freeman
            wait 0.7s
            camera extreme-close-up freeman   // «чужие» — в упор, на самих очках
            wait 0.5s
        }
    }
    // ФЛЭШ-МОРДА — НА СВЕРХКРУПЕ. Вспышка зрачков длится 2 кадра; на общем
    // плане это две белые точки, и приёма нет. Кадр уже сверхкрупный с конца
    // реплики — вспышка попадает в лицо, ради которого нарисована.
    freeman overlays "flash_pupils_ochki"
    wait 0.08s
    // И СРАЗУ ОТПУСКАЕМ. Сверхкруп — это два кадра удара; держать его дальше,
    // на реакции, значит снова сделать его нормой ролика, а не ударом. Ровно
    // так он и расползался до 0.74 в прошлый заход.
    camera medium freeman
    freeman overlays "hero_skeptic_ochki"
    wait 0.5s

    // ── ПУЛЕМЁТ (VO-4..6): три приговора — марионетка чужих слов ──────────
    //
    // РИТМ РВАНЫЙ И УСКОРЯЮЩИЙСЯ, А НЕ МЕТРОНОМ. Прежде каждая из трёх реплик
    // резалась одинаково — 1.7с плюс 1.7с, шесть равных планов подряд. На
    // бумаге это «частый монтаж», на экране — ровный стук, от которого сцена
    // проседает ровно там, где приговоры должны сыпаться всё быстрее. Теперь
    // планы укорачиваются и внутри реплики, и от реплики к реплике
    // (1.1/0.9/0.4/0.4 → 1.2/0.9/0.8 → 1.1/0.8/0.6), а последний срывается
    // во флэш-морду на сверхкрупе.
    freeman moves-to (0.5, 0.585) over 0.01s
    freeman pose "puppet_ochki"
    //lip 4
    together {
        freeman speaks for 3.4s
        do {
            camera medium freeman
            // «Он слаба́к» — первый ярлык впечатывается в поле за спиной.
            yar1 moves-to (0.19, 0.36) over 0.01s
            yar1 scales 0.55 over 0.14s ease-in
            wait 1.1s
            // «Она́ сте́рва» — второй.
            freeman overlays "shag_levoj"     // марионетку дёрнули за ногу
            yar2 moves-to (0.80, 0.43) over 0.01s
            yar2 scales 0.55 over 0.14s ease-in
            wait 0.9s
            // «Ты — никто́» — третий, крупнее и прямо за головой.
            yar3 moves-to (0.50, 0.33) over 0.01s
            yar3 scales 0.70 over 0.14s ease-in
            camera close-up freeman
            wait 0.4s
            camera extreme-close-up freeman   // «Ты — никто» в упор
            wait 0.4s
        }
    }
    // ── ПУЛЕМЁТ 2 (VO-5): тот же рывок марионетки — приём монотонности ────
    freeman pose "puppet_jerk_ochki"
    //lip 5
    together {
        freeman speaks for 3.4s
        do {
            camera medium freeman
            wait 1.2s
            freeman overlays "hips"           // руки в боки: «и что дальше?»
            camera close-up freeman
            wait 0.9s
            // «человек закрыт» — фигуру придавили сверху И отодвинули: один
            // ракурс без смены размера кат не читается как монтаж (приёмщик
            // режиссуры меряет долю катов, меняющих класс крупности).
            camera angle high freeman
            camera medium freeman
            wait 0.8s
        }
    }
    // ── ПУЛЕМЁТ финал (VO-6): презрение, тряска ───────────────────────────
    freeman pose "otvraschenie_ochki"
    //lip 6
    together {
        freeman speaks for 3.4s
        do {
            camera close-up freeman
            wait 1.1s
            freeman overlays "za_golovu"      // схватился за маску
            camera medium freeman
            wait 0.8s
            camera extreme-close-up freeman
            wait 0.6s
        }
    }
    camera shake 0.35s intensity 2
    freeman overlays "flash_disgust_ochki"
    wait 0.08s
    camera medium freeman             // удар отыгран — отпускаем (см. выше)
    freeman overlays "stern_ochki"
    wait 0.7s

    // ── t≈24 ПЕРЕЛОМ: РАЗВОРОТ (VO-7), ракурс СНИЗУ + рука в камеру ───────
    //
    // «Чьи это слова?» НЕ РЕЖЕТСЯ КАТОМ, А НАЕЗЖАЕТ. Это единственный вопрос
    // ролика и его перелом; кат на середине сбрасывал напряжение ровно там,
    // где оно должно копиться. Медленный наезд на 2.2с держит зрителя в кадре,
    // пока вопрос повисает, — по паузе 0:31.1–0:32.8 из VO-сценария.
    freeman moves-to (0.44, 0.585) over 0.01s
    freeman pose "v_upor_ochki"
    //lip 7
    together {
        freeman speaks for 7.2s
        do {
            camera angle low freeman
            wait 1.8s
            freeman overlays "point"          // тычет пальцем на переломе
            camera extreme-close-up freeman   // палец — в лицо зрителю
            wait 1.0s
            camera close-up freeman
            wait 0.6s
            freeman overlays "raskryl"        // раскрыл обе
            camera zoom-to freeman over 2.2s ease-in
            freeman overlays "v_upor"         // ладонь в камеру
            camera close-up freeman
            wait 0.8s
        }
    }
    hand moves-to (0.72, 0.72) over 0.01s
    camera shake 0.3s intensity 2
    wait 0.7s
    hand moves-to (-1.5, 1.5) over 0.01s
    freeman pose "think_ochki"
    wait 0.6s

    // ── ВЗЛЁТ (VO-8): очки слетают, фигура раскрывается ───────────────────
    freeman moves-to (0.5, 0.585) over 0.01s
    freeman pose "raskryl_ochki"
    //lip 8
    together {
        freeman speaks for 11.1s
        do {
            camera medium freeman
            wait 1.2s
            // «челове́к — НЕ ЯРЛЫ́К, а судьба́» — и ярлыки осыпаются из кадра.
            // Реплика и второй план бьют в одну точку: слово их отменяет,
            // поле за спиной снова пустое. Это и есть плата по счёту за
            // накопленный мусор — она показана, а не проговорена.
            together {
                yar1 moves-to (0.14, 1.5) over 0.55s ease-in
                yar2 moves-to (0.86, 1.5) over 0.55s ease-in
                yar3 moves-to (0.50, 1.6) over 0.55s ease-in
                yar1 rotates -38 over 0.55s
                yar2 rotates 32 over 0.55s
                yar3 rotates 14 over 0.55s
            }
            wait 0.4s
            freeman overlays "open"           // раскрыл ладони
            camera close-up freeman
            wait 1.8s
            freeman overlays "hips"           // руки в боки
            camera medium freeman
            // Срыв: проп встаёт НА МЕСТО КОСТИ И ТОЛЬКО ПОТОМ гаснет кость.
            // Обратный порядок давал провал: `hides`/подмена детали срабатывает
            // на середине перехода позы, и между уходом кости и появлением
            // пропа кадр оставался без очков вовсе.
            ochki moves-to (0.5022, 0.5068) over 0.01s
            ochki shows
            freeman pose "raskryl"
            together {
                ochki moves-to (0.16, 1.25) over 0.45s ease-in
                ochki rotates -140 over 0.45s
            }
            wait 1.2s
            // ЛИЦО БЕЗ ЧУЖИХ ОПРАВ — ВПЕРВЫЕ ЗА РОЛИК. Очки сидели на маске с
            // 3.7-й секунды; момент, когда их нет, — плата по счёту всей
            // метафоры, и он обязан быть на том же сверхкрупе, на котором они
            // садились. Раньше здесь стоял средний план: разницы не видно.
            camera extreme-close-up freeman
            wait 1.2s
            camera close-up freeman
            wait 1.8s
            camera wide
        }
    }
    // ── СЛОВО-УДАР «ЧЬИ?» + негатив-панч ──────────────────────────────────
    camera wide
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.9s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    camera extreme-close-up freeman       // оскал после слова-удара — в лицо
    freeman overlays "flash_grin"
    wait 0.08s

    // ── ЖАЛО-CTA (VO-9): наезд-удар, подмиг-издёвка ───────────────────────
    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 12.8s
        do {
            camera medium freeman
            wait 2.6s
            freeman pose "point"           // «двадцать линз» — тычет
            camera close-up freeman
            wait 2.4s
            freeman pose "open"            // раскрыл ладони
            camera wide
            wait 2.4s
            freeman pose "hips"            // руки в боки
            camera medium freeman
            wait 2.6s
            freeman pose "v_upor"          // ладонь в камеру на жале
            camera close-up freeman
        }
    }
    // ПОДМИГ — ПУАНТ РОЛИКА, И ОН НА СВЕРХКРУПЕ. «Тебе идёт?» держится
    // подмигом; на среднем плане глаз в четыре пикселя, и вся подколка
    // держалась только на интонации диктора.
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.7s
    // отъезд-одиночество: снова маленькая фигура в пустом поле
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.8s
}

// ============================ СЦЕНА 2: ТИТРЫ ================================
scene "titry" (duration: 6s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.2s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 2.5s
    transition fade-black 0.8s
}
