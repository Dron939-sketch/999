    transition static 0.10s
    camera two-shot
    let w = text("СКОЛЬКО ИЗ НИХ", 84) at (0.5, -2.0)
    wait 0.30s
    w moves-to (0.500, 0.845) over 0.01s
    camera pan-to (0.500, 0.452) over 0.01s
    camera pan-to (0.500, 0.548) over 11.5217s ease-in-out
}

// ── 2:22.17 (9.19с) — «было ли решение»
