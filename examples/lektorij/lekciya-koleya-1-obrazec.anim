config {
    width: 1280
    height: 720
    fps: 24
    background: #d4d7cf
    monochrome: false
    snow: 0.1
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.04
    vignette: 0.1
    film-flicker: 0.02
    gate-weave: 0.3
    film-scratch: 0.2
    film-dust: 0.4
}

// ── 1:28.92 (3.77с) — «теперь представьте анкету»
scene "b00" (duration: 1s, set: lek1a_anketa_0) {
    transition static 0.10s
    camera two-shot
    wait 3.6750s
}

// ── 1:32.70 (3.15с) — «графа первая — РАБОТА»
