// =============================================================================
//  «СКУКА — ЭТО ОТСУТСТВИЕ ТРЕВОГИ» — интро к курсу «Привязанность и
//  отношения». VO — privyazannost-VO.md, //lip 1..11.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. СПУСК НА ЭТАЖ ВНИЗ. Первая версия останавливалась на «привязанность —
//     паттерн из детства»: верно и пусто. Ролик теперь идёт дальше и отвечает
//     на «почему знакомое сильнее хорошего» — психика оптимизирует не счастье,
//     а предсказуемость. Оттуда и вывод, ради которого всё снято: рядом со
//     спокойным человеком скучно не от нехватки любви, а от нехватки тревоги.
//
//  2. ПРИТЧА-ОБМАНКА И ЕЁ ВЫСТРЕЛ. На 12-й секунде звучит фраза про битую
//     собаку, которую тянет к знакомой руке, — как факт про животных. На
//     развороте (24.5с) знакомая рука оказывается своей. Между этими двумя
//     точками не должно быть ни одного намёка, иначе выстрел не сработает:
//     поэтому в сцене кухни персонаж не смотрит в камеру до самого разворота.
//
//  3. ДВА ПУСТЫХ СТУЛА — ГЛАВНЫЙ ПРЕДМЕТ. Они стоят друг напротив друга, и
//     пустое место между ними и есть тема. Персонаж встаёт МЕЖДУ ними: он не
//     занимает сторону, он показывает расстояние. Первая реплика при этом
//     описывает того, кто «сидит напротив», хотя стулья пусты, — расхождение
//     намеренное: зритель достраивает человека, которого нет, ровно так же,
//     как достраивает чувство, которого нет.
//
//  4. ЛОКАЦИЯ МЕНЯЕТСЯ ПОД МЫСЛЬ. Два стула (двоих нет) → ночная кухня (где
//     пары не расстаются, а тухнут) → ПУСТОТА (механизм и дно) → развилка
//     двух троп (выход) → зал Лектория → снова два стула.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — поза `bok_*_govorit` (корпус в профиль, маска к
//      зрителю) плюс шаг СЛОЕМ `shag_bok_*`. Полная поза сбрасывает липсинк,
//      и рот прыгал бы на каждом шаге (tools/speech_lint.py);
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе брошенный слой шага висит и
//      фигура доигрывает полушаг стоя (tools/walk.py --check);
//    · фигура НЕ ПРИСЕДАЕТ и НЕ САДИТСЯ — тем более здесь, где в кадре два
//      стула: стоит ему сесть, и ролик про отсутствующих двоих становится
//      роликом про одного сидящего. Поза, роняющая рост больше чем на 8%,
//      валит прогон (tools/posture.py);
//    · все `place` идут через `on floor`, у каждой локации есть
//      `*.surfaces.json`. Исключение одно — сцена пустоты, объяснено там же;
//    · тень: `ground-shadow` даёт пятно контакта, `cast-shadow` кладёт силуэт
//      на пол. Без них фигура читается наклеенной на фон;
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set stulya from "../assets/sets/dva-stula.svg"
import set kuhnya from "../assets/sets/kuhnya-noch.svg"
import set void from "../assets/sets/void-black.svg"
import set tropy from "../assets/sets/dve-tropy.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ДВА СТУЛА — ХУК, ДОБИВКА, ПРИТЧА =====================
scene "stulya" (duration: 16s, set: stulya) {
    transition static 0.2s

    //  ВСТАЁТ МЕЖДУ СТУЛЬЯМИ, а не рядом с одним из них: он не занимает
    //  сторону, он показывает расстояние.
    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.7
    camera wide

    //  Доля секунды без слов: два пустых стула друг напротив друга.
    freeman pose "calm"
    wait 0.3s

    // ── ХУК (VO-1): «Он сидит напротив. Жуёт. И вам скучно.» ─────────────
    //  Подача БУДНИЧНАЯ, будто подглядел в чужое окно. Обвинения тут ещё нет,
    //  есть бытовая деталь — и зритель уже узнал свой вечер.
    freeman pose "calm"
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 5.1s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "no"          // «жуёт» — кивок в пустой стул
            wait 1.8s
            freeman overlays "hips"        // «и вам скучно»
        }
    }
    camera wide
    //  Зазор перед приговором: без него две фразы слипаются в одну.
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «Это не про него. Это про вас.» ─────────────
    //  Приговор НЕ КРИЧАТ. Поза в упор, голос тише — от этого страшнее, чем
    //  от нажима.
    freeman pose "v_upor"
    //lip 2
    together {
        freeman speaks for 5.1s
        do {
            wait 2.4s
            camera medium freeman
            freeman overlays "point"       // «это про вас» — в зрителя
        }
    }
    camera wide
    freeman overlays "flash_pupils"
    wait 0.4s

    // ── ПРИТЧА-ОБМАНКА (VO-3): «Битую собаку тянет к знакомой руке.» ────
    //  РУЖЬЁ ЧЕХОВА. Подаётся как факт про животных, ровно и без нажима —
    //  ни намёка, что это про зрителя. Выстрелит на развороте, через восемь
    //  секунд. Поэтому здесь ни взгляда в упор, ни указующего жеста: любая
    //  подсветка обесценит выстрел.
    freeman pose "calm"
    freeman overlays "open"
    //lip 3
    together {
        freeman speaks for 4.4s
        do {
            wait 2.2s
            freeman overlays "think"       // отвёл взгляд: думает вслух
        }
    }
    wait 0.2s
}

// ============ СЦЕНА 2: НОЧНАЯ КУХНЯ — ЧЕТЫРЕ ГОЛОСА =========================
scene "kuhnya" (duration: 20s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.26, 0.94) facing front on floor
    freeman scales 0.66
    camera wide
    freeman pose "bok_pravo_govorit"
    wait 0.15s

    // ── ПУЛЕМЁТ (VO-4): четыре чужих голоса, НА ХОДУ вдоль стола ────────
    //  «Ты всегда так. Закатил глаза. А сам-то. Молчание третий день.» —
    //  это четыре всадника Готтмана, но НЕ НАЗВАННЫЕ. Термин зритель не
    //  узнает в своей кухне, а эти четыре фразы узнает мгновенно: он их
    //  вчера говорил. Стол с двумя тарелками проезжает мимо, как улика.
    //lip 4
    together {
        freeman speaks for 7.3s
        do {
            freeman moves-to (0.58, 0.94) over 6.4s
            freeman overlays "shag_bok_levoj"
            wait 0.8s
            freeman overlays "shag_bok_pravoj"
            wait 0.8s
            freeman overlays "shag_bok_levoj"
            wait 0.8s
            camera medium freeman
            freeman overlays "shag_bok_pravoj"
            wait 0.8s
            freeman overlays "shag_bok_levoj"
            wait 0.8s
            freeman overlays "shag_bok_pravoj"
            wait 0.8s
            freeman overlays "shag_bok_levoj"
            wait 0.8s
            freeman overlays "shag_bok_pravoj"
        }
    }
    //  Остановка полной позой: слой шага снят, ноги приставлены.
    freeman pose "calm"
    camera wide
    //  Тишина на месте пятого голоса — его нет, и это слышно.
    wait 0.4s

    // ── РАЗВОРОТ (VO-5): «убивают закатанные глаза» ─────────────────────
    //  ЗДЕСЬ ВЫСТРЕЛИВАЕТ ПРИТЧА: знакомая рука оказывается своей. Впервые
    //  за сцену — взгляд в упор, и он же означает «это про тебя».
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 4.4s
        do {
            wait 2.2s
            camera medium freeman
            freeman overlays "otvraschenie"  // сам закатил глаза — показал как
        }
    }
    camera wide
    freeman pose "calm"
    wait 0.5s

    // ── ДОКАЗАТЕЛЬСТВО (VO-6): цифры Готтмана ──────────────────────────
    //  Ролик перестаёт быть мнением и становится измерением, поэтому подача
    //  ровная, как зачитывают протокол, а тело почти не двигается.
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 6.6s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "hips"
            wait 2.2s
            freeman overlays "point"         // «девять из десяти»
        }
    }
    camera wide
    //  ПАУЗА-УДАР: цифры повисли.
    wait 0.6s
}

// ================== СЦЕНА 3: ПУСТОТА — МЕХАНИЗМ И ДНО =======================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Балахон сливается с фоном целиком — остаётся
//  только лицо. Отговорок больше нет: ни кухни, ни стульев, ни обстоятельств.
//  Две реплики подряд без смены плана: сначала механизм, потом дно. Смена
//  локации между ними разбила бы мысль ровно там, где она собирается.
scene "temnota" (duration: 15s, set: void) {
    //  Резкая склейка: между кухней и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`. Пола нет, кадр держит МАСКА:
    //  посадка по ступням увела бы её в верхнюю четверть кадра (карта фигуры:
    //  ступни +0.495 от якоря, центр маски +0.004). Точка задаётся по якорю и
    //  целится в центр, ноги уходят за нижнюю кромку. План ОБЩИЙ: на нём зум
    //  равен единице и маска встаёт ровно туда, куда посажена.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-7): «Психика ищет не счастье» ─────────────────
    //lip 7
    together {
        freeman speaks for 7.3s
        do {
            wait 4.4s
            freeman overlays "point"         // «зовите это судьбой»
        }
    }
    wait 0.4s

    // ── ДНО (VO-8): «Скука — не отсутствие любви. Это отсутствие тревоги» ─
    //  САМАЯ ВАЖНАЯ ФРАЗА РОЛИКА, и потому она играется почти неподвижно:
    //  любой жест здесь отвлекает. Внутри реплики — только `ugryumo`, накладка
    //  без рта: и зрачки, и `stern` трогают рот и перебили бы липсинк до
    //  следующего флэпа, поэтому вспышка вынесена ЗА реплику и приходится на
    //  тишину после неё — там она и сильнее.
    freeman pose "v_upor"
    //lip 8
    together {
        freeman speaks for 5.9s
        do {
            wait 3.4s
            freeman overlays "ugryumo"
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: ДВЕ ТРОПЫ — ВЫХОД ЕСТЬ ===============================
scene "tropy" (duration: 6s, set: tropy) {
    transition static 0.2s

    //  ВСТАЁТ НА РАЗВИЛКЕ: старая колея уходит прямо, свежий след — вправо.
    //  Оба варианта по бокам от него, решать зрителю. Сцена играется ТОЛЬКО
    //  общим планом: средний выбрасывает тропы из кадра, и остаётся говорящая
    //  фигура на пустом фоне — ровно то, ради чего локация и рисовалась.
    place freeman at (0.46, 0.90) facing front on floor
    freeman scales 0.7
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: только что прозвучало, что тревога и
    //  была тем, что человек звал любовью. Реплика, начатая сразу после
    //  склейки, читалась бы продолжением; пауза делает её возражением.
    freeman pose "think"
    wait 1.3s

    // ── ВЗЛЁТ (VO-9): «Тропу протоптали ногами. Ногами и меняют.» ───────
    freeman pose "calm"
    //lip 9
    together {
        freeman speaks for 4.4s
        do {
            wait 2.2s
            freeman overlays "confident"     // ладонь к свежему следу
        }
    }
    wait 0.2s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 6s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-10): называет курс ──────────────────────────────
    //lip 10
    together {
        freeman speaks for 5.1s
        do {
            camera medium freeman
            wait 1.7s
            freeman overlays "wave"          // «Привязанность и отношения»
            wait 1.7s
            freeman overlays "open"          // «бесплатно»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 6: СНОВА ДВА СТУЛА — ЖАЛО ===============================
scene "final" (duration: 7s, set: stulya) {
    transition static 0.2s

    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.7
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.2s

    // ── ЖАЛО (VO-11): «Неделю не закатывайте глаза. Слабо?» ─────────────
    //  ИЗМЕРИМЫЙ ЧЕЛЛЕНДЖ, а не мысль на прощание: у оригинала финал —
    //  «помолчать хотя бы недельку», проверяемое действие. Зритель уходит с
    //  пари, и проверить его можно уже сегодня вечером.
    //lip 11
    together {
        freeman speaks for 3.7s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "shrug"         // «слабо?» — ну как знаете
        }
    }
    freeman overlays "hero_wink"
    wait 0.3s

    // ── УХОДИТ, СТУЛЬЯ ОСТАЮТСЯ ─────────────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой,
    //  профиль — просто «мне туда». Два пустых стула остаются в кадре, и
    //  последнее, что видит зритель, — расстояние между ними.
    camera wide
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.92) over 1.8s
    freeman overlays "shag_bok_levoj"
    wait 0.45s
    freeman overlays "shag_bok_pravoj"
    wait 0.45s
    freeman overlays "shag_bok_levoj"
    wait 0.45s
    freeman overlays "shag_bok_pravoj"
    wait 0.45s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы, и последний
    //  кадр застывал бы на разведённых ногах.
    freeman pose "bok_levo"
    wait 0.3s
}

// ========================== СЦЕНА 7: ТИТРЫ ==================================
scene "titry" (duration: 3s, set: titry) {
    transition static 0.25s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.9s
    transition fade-black 0.35s
}
