import character freeman from "../assets/characters/freeman_rig"
import set void from "../assets/sets/void.svg"

config {
    width: 900
    height: 800
    fps: 24
    background: #54584f
    monochrome: true
    mono-contrast: 1.2
    on-twos: 2
}

scene "test" (duration: 8s, set: void) {
    place freeman at (0.5, 0.6) facing front
    camera medium freeman
    freeman pose "calm"
    freeman speaks for 6s
    camera close-up freeman
    wait 2s
}
