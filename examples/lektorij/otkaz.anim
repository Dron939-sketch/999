// =============================================================================
//  «ЛЁГ» — интро к курсу «Личные границы», ролик первый.
//  VO — otkaz-VO.md, маркеры 1..19.
//
//  ОДНА МЫСЛЬ НА РОЛИК, И ЗДЕСЬ ОНА ВОТ КАКАЯ: ответ, который всегда одинаков,
//  ничего не сообщает — а значит, «да» безотказного человека не стоит ничего.
//  Вторая половина той же темы (человек не слышит ЧУЖОГО «нет») вынесена в
//  отдельный ролик `granicy.anim`: в одном они мешали друг другу, зритель не
//  успевал согласиться с первым, как его разворачивали ко второму.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ОН ДЕРЖИТСЯ РАЗЫГРАННОЙ СЦЕНКОЙ, А НЕ ЦЕПОЧКОЙ. Первая версия текста
//     была разбором: верным, аккуратным и пресным. Студия забраковала одним
//     словом — «без огонька». Вернулась формула серии: сценка в два голоса,
//     пулемёт с эскалацией, ирония с ложным согласием, анекдот, качели.
//     Разбор ошибки — `RABOTA-NAD-OSHIBKAMI.md` §XIV и §XIX.
//
//  2. АНЕКДОТ — НЕ УКРАШЕНИЕ ПРИ АРГУМЕНТЕ, А САМ АРГУМЕНТ (сцена 5). Он
//     показывает предел безотказности доведённым до конца: дальше способ не
//     работает вовсе. Поэтому он стоит В СЕРЕДИНЕ, а не после хода, как ждёт
//     `script_lint`. Отступление сознательное и объявлено в шапке VO.
//
//     ГРУБОСТЬ ЛЕТИТ В ПЕРСОНАЖА, А НЕ В ЗРИТЕЛЯ. «Ни одна сволочь» — про людей
//     на похоронах; «не стоит ни хрена» — про его «да», не про него. Два раза
//     на ролик и не больше: третий сделал бы это манерой, а не ударом.
//
//     РАЗВЯЗКА НЕ ОБЪЯСНЯЕТСЯ. После панча полторы секунды тишины, и в них
//     входит «сколько раз легли вы» (`SMESHNO.md` §XII).
//
//  3. КАЧЕЛИ В КОНЦЕ ОБЯЗАТЕЛЬНЫ (VO-15). Ролик весь идёт на снижение; оставишь
//     зрителя внизу — уйдёт пристыжённым и не вернётся. «Вы не холодильник.
//     Холодильник не просят — из него берут» возвращает достоинство и заодно
//     объясняет, почему просят именно его.
//
//  4. ПРАВИЛО 3–7–21 ПРОВЕРЕНО ПО ТАЙМЛАЙНУ: крючок на 0:01 (чужая просьба и
//     собственный ответ), первый удар голосом на 0:06.8, перелом на 0:27.9.
//
//  5. НОМЕР КУРСА — ВОСЕМЬ. Восьмёрка нарисована под серию
//     (`props/nomer-08.svg`) — две незамкнутые петли, верхняя уже нижней, как
//     выходит у руки, а не у шрифта.
//
//     ПРАВИЛО ПРОПА НА ТЕЛЕ: он живёт в координатах КАДРА, а не на фигуре, и
//     потому существует только пока камера неподвижна. Голый `scales` на пропе,
//     до которого не было АНИМИРОВАННОЙ смены масштаба, не применяется вовсе —
//     метка встаёт в натуральную величину и закрывает торс. Рабочий рисунок
//     один: спрятать, показать, вырастить с 0.02. Отсюда же следует, что на
//     нулевом кадре метки быть не может — значит и в последнем её нет, иначе
//     при зацикливании виден шов.
//
//  6. КРАСНАЯ ЧЕРТА — ЕДИНСТВЕННЫЙ ЦВЕТ ВО ВСЁМ РОЛИКЕ, И ЭТО ЗАМЕРЕНО.
//     Монохромный проход пропускает насквозь пиксели с разбросом каналов
//     больше 55: у черты таких 2.36% кадра на высоте 0.710..0.736, у остальных
//     локаций ролика — ноль. Цвет появляется ровно один раз и ровно там, где
//     назван ход.
//
//  7. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): пулемёт 6.3,
//     приговор 4.4 — перепад в полтора раза. Ухо слышит не скорость, а смену
//     скорости.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/mouth_ownership.py);
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py): выдуманного слоя
//      движок не замечает — он молча ставит дефолтную стойку, и понять это по
//      картинке нельзя. Здесь на этом сгорел один прогон завода;
//    · координаты фигуры на локации БЕЗ карты пола снимаются пробным
//      контактным листом, а не по аналогии с соседней сценой (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` РАСЧЁТНЫЕ — ролик новый. Модель «0.59 с на внутренний
//  знак», поправленная коэффициентом 0.93. Модель врёт неравномерно по битам
//  (`KONVEJER.md` §4.1); завод перепишет числа по факту.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set koridor from "../assets/sets/koridor-lovushka.svg"
import set kuhnya from "../assets/sets/kuhnya-tri-kruga.svg"
import set void from "../assets/sets/void-black.svg"
import set ulica from "../assets/sets/biznes-street.svg"
import set detskaya from "../assets/sets/detskaya.svg"
import set cherta from "../assets/sets/porog-cherta.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: КОРИДОР-ЛОВУШКА — ПРОСЬБА, ОТВЕТ И ОЧЕРЕДЬ ==========
//  ОДНА ДВЕРЬ ИЗ ПЯТИ ПРИОТКРЫТА, И КЛИН СВЕТА ЛЕЖИТ ПОПЕРЁК ПУТИ. Просьба
//  приходит между делом, на ходу, и мимо неё не пройти — положение читается
//  раньше первого слова.
scene "koridor" (duration: 1s, set: koridor) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании, и
    //  вспышка помех на ней заметнее любого шва.
    //  Пол коридора уходит в перспективу (карта: back_y 0.589) — фигура
    //  ставится к переднему краю, иначе окажется в стене.
    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer scales 0.19 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ (разбор — п.5
    //  в шапке). Метка проявляется через четверть секунды после стыка и
    //  снимается до первого движения камеры.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.21 over 0.05s ease-out
    nomer scales 0.19 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): чужая просьба и собственный ответ ─────────────────
    //  ДВА ГОЛОСА ДЕЛАЮТСЯ РАЗНОСТЬЮ, А НЕ АКТЁРСТВОМ: просьба бодрая и
    //  близкая, ответ тише и на полтона ниже. Это не диалог двоих — это
    //  запись, которую зритель узнаёт. Пережмёшь — станет пародией.
    //  Тело почти неподвижно: жест на просьбе выдал бы, что просят не его.
    //lip 1
    together {
        freeman speaks for 5.43s
        do {
            freeman overlays "hips"
            wait 2.4s
            freeman overlays "k_sebe"      // «Да не вопрос» — рука уже согласилась
            wait 1.6s
            freeman overlays "ostyl"
        }
    }
    wait 0.4s

    // ── ДОБИВКА (VO-2): три коротких удара ────────────────────────────
    //  БУДНИЧНО, КАК СООБЩАЮТ ФАКТ. Ни капли сочувствия: посочувствуешь —
    //  зритель успокоится и сойдёт с крючка на второй секунде.
    //lip 2
    together {
        freeman speaks for 2.88s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "obvinil"     // «Вас купили» — в зрителя
        }
    }
    wait 0.6s

    // ── ОТРИЦАНИЕ (VO-3): ложное согласие ─────────────────────────────
    //  ВОЗРАЖЕНИЕ ЗАКРЫВАЕТСЯ ДО ОЧЕРЕДИ ПРИМЕРОВ, А НЕ ПОСЛЕ. Первое, чем
    //  зритель защищается, — «я согласился, потому что я добрый». Пока оно
    //  цело, дальше слушают вполуха. Отнимают приёмом серии: примирительная
    //  фраза, снимающая спор, и следом та же мысль в регистре, от которого
    //  спорить уже поздно. Играется БЕЗ нажима — нажмёшь, выйдет издёвка.
    //lip 3
    together {
        freeman speaks for 6.47s
        do {
            freeman overlays "ladoni_vniz" // «я не говорю, что помогать плохо»
            wait 3.2s
            freeman overlays "prishchur"   // «особенно добровольное»
        }
    }
    camera wide
    wait 0.4s

    // ── ПУЛЕМЁТ (VO-4): очередь просьб с эскалацией ───────────────────
    //  ШАГ И НАЕЗД ОДНОВРЕМЕННО, ПО ОДНОМУ НА ПРОСЬБУ. Записанные подряд,
    //  `moves-to` и `scales` и выполняются подряд — в кадре это «подъехал, а
    //  потом раздулся». `together` внутри `do` связывает их в один отрезок.
    //  Персонаж идёт НА КАМЕРУ: просьбы не отдаляются, они подступают.
    //lip 4
    together {
        freeman speaks for 5.25s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "k_sebe"      // «Подвезти?» — рука за ответом
            together {
                freeman moves-to (0.46, 0.94) over 1.2s
                freeman scales 0.80 over 1.2s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "razvel"      // «Занять?»
            together {
                freeman moves-to (0.46, 0.96) over 1.2s
                freeman scales 0.86 over 1.2s
            }
            freeman overlays "shag_levoj"
            freeman overlays "somnenie"    // «Помочь с переездом в субботу?»
            wait 1.2s
            freeman overlays "shag_pravoj"
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты.
    freeman pose "calm"
    wait 0.4s
}

// ============ СЦЕНА 2: НОЧНАЯ КУХНЯ — ЧТО ОСТАЁТСЯ ВЕЧЕРОМ ================
//  СТОЛ СДВИНУТ К КРАЮ, ЦЕНТР ПУСТ. Человек остаётся один со своей злостью, а
//  не сидит за столом: круг замыкается стоя, посреди кухни, и выйти некуда.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.15s

    //  Пол начинается низко (карта: back_y 0.799) — фигура встаёт в пустую
    //  правую треть кадра, а не к столу.
    place freeman at (0.58, 0.94) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОБРАЗ (VO-5): вечерний круг ───────────────────────────────────
    //  БУДНИЧНО, КАК О ЕДЕ. «Жуёте свою злость» — поле метафор серии: высокое
    //  заземляется физиологией, а не наоборот. Каждая половина тише
    //  предыдущей: круг сужается.
    //lip 5
    together {
        freeman speaks for 4.25s
        do {
            freeman overlays "vzglyad"     // «жуёте свою злость»
            wait 2.2s
            freeman overlays "ostyl"       // «потом на себя»
        }
    }
    wait 0.7s
}

// ============ СЦЕНА 3: ПУСТОТА — ПЕРЕЛОМ И ЦЕНА ============================
//  ПЕРЕЛОМ РОЛИКА НА 28-Й СЕКУНДЕ, И ОН СТАВИТСЯ В ЧЁРНОМ. Ни коридора, ни
//  кухни: вывод делается там, где нечем отвлечься.
scene "perelom" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── РАЗВОРОТ (VO-6): вся конструкция в одной строке ───────────────
    //  ПЕРВАЯ ПОЛОВИНА РОВНО, ВТОРАЯ — НА ПОЛТОНА НИЖЕ. Не обвинение, а
    //  разворот камеры; нажмёшь голосом — зритель услышит приговор себе и
    //  начнёт защищаться вместо того, чтобы смотреть.
    //lip 6
    together {
        freeman speaks for 6.77s
        do {
            freeman overlays "calm"
            wait 3.4s
            freeman overlays "klin"        // «не стоит ни хрена»
        }
    }
    wait 0.6s

    // ── ЦЕНА (VO-7): столкновение регистров ───────────────────────────
    //  ВЫСОКОЕ СЛОВО ЗАЗЕМЛЯЕТСЯ БЫТОВОЙ ВЕЩЬЮ. «Благодарят за удобство» и
    //  «как холодильник» стоят в одной реплике; последний вопрос — вверх и
    //  без нажима, это псевдосомнение, подпись серии.
    //lip 7
    together {
        freeman speaks for 6.17s
        do {
            freeman overlays "razmer"      // «как холодильник»
            wait 3.4s
            freeman overlays "vozzvanie"   // «или я преувеличиваю?»
        }
    }
    freeman overlays "flash_pupils"
    wait 1.2s
}

// ============ СЦЕНА 4: ДЕЛОВАЯ УЛИЦА — АНЕКДОТ =============================
//  БАЙКУ ТРАВЯТ НА ХОДУ, МЕЖДУ ДЕЛОМ. Так её и рассказывают: не с кафедры, а
//  мимоходом, среди чужих спин, — и потому она не выглядит уроком.
scene "anekdot" (duration: 1s, set: ulica) {
    transition static 0.15s

    //  Пол начинается высоко (карта: back_y 0.66) — фигура к переднему краю.
    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── АНЕКДОТ, ЗАЧИН (VO-8) ─────────────────────────────────────────
    //  РАССКАЗЫВАЕТСЯ ЛЕГКО, БЕЗ НАМЁКА, ЧТО ЭТО ПРО ЗРИТЕЛЯ. Намекнёшь —
    //  зритель поставит защиту раньше панча, и панч не дойдёт.
    //lip 8
    together {
        freeman speaks for 4.25s
        do {
            freeman overlays "razvel"      // «старый анекдот»
            wait 2.4s
            freeman overlays "ostyl"       // «помер»
        }
    }
    wait 0.4s

    // ── АНЕКДОТ, ПОХОРОНЫ (VO-9) ──────────────────────────────────────
    //  ТЕМП ДЕРЖАТЬ, ПАУЗУ ПЕРЕД ВОПРОСОМ НЕ ДЕЛАТЬ. Пауза здесь показывает
    //  панч заранее, и он перестаёт быть панчем.
    //lip 9
    together {
        freeman speaks for 5.08s
        do {
            camera medium freeman
            wait 2.7s
            freeman overlays "shrug"       // «чего не плачешь?»
        }
    }
    wait 0.5s

    // ── ПАНЧ (VO-10) ──────────────────────────────────────────────────
    //  ЧУЖИМ ГОЛОСОМ И ТИШЕ ПРОЧЕГО. Тело почти неподвижно: жест на ударном
    //  слове крадёт слово. Дальше полторы секунды молчания — они и есть
    //  половина шутки.
    freeman pose "v_upor"
    //lip 10
    together {
        freeman speaks for 3.42s
        do {
            freeman overlays "doshlo"      // «он и лёг»
        }
    }
    camera wide
    //  РАЗВЯЗКА НЕ ОБЪЯСНЯЕТСЯ НИ СЛОВОМ.
    wait 1.6s
}

// ============ СЦЕНА 5: ПУСТОТА — СМЕХ ГАСНЕТ ===============================
//  ОБРЫВ В ЧЁРНОЕ СРАЗУ ПОСЛЕ ПАНЧА: между «смешно» и «это про меня» должна
//  быть не связка, а разрыв.
scene "gasnet" (duration: 1s, set: void) {
    transition static 0.12s

    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── ПРИГОВОР (VO-11) ──────────────────────────────────────────────
    //  «СМЕШНО» ПРОИЗНОСИТСЯ РОВНО, БЕЗ УЛЫБКИ В ГОЛОСЕ. Улыбнёшься — зритель
    //  поймёт, что его вели, и обидится на приём, а не на себя.
    //lip 11
    together {
        freeman speaks for 4.27s
        do {
            freeman overlays "calm"
            wait 2.2s
            freeman overlays "obvinil"     // «сколько раз легли вы» — в зрителя
        }
    }
    freeman overlays "flash_pupils"
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА. Диагноз поставлен; сейчас скажут, что с ним
    //  делать, и зритель должен успеть этого захотеть.
    wait 1.0s
}

// ============ СЦЕНА 6: ДЕТСКАЯ — СНЯТИЕ ВИНЫ ===============================
//  ОТВЕТ ПОКАЗАН РАНЬШЕ, ЧЕМ ПРОИЗНЕСЁН. Впервые за ролик светло и впервые
//  тепло: здесь снимают вину, а не ставят диагноз. Без этой сцены зритель
//  уходит пристыжённым и не возвращается.
scene "detskaya" (duration: 1s, set: detskaya) {
    transition static 0.2s

    //  Пол начинается низко (карта: back_y 0.764) — фигура ближе к переднему
    //  краю комнаты.
    place freeman at (0.48, 0.93) facing front on floor
    freeman scales 0.76 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОТРИЦАНИЕ (VO-12): это не характер ────────────────────────────
    //lip 12
    together {
        freeman speaks for 2.97s
        do {
            freeman overlays "otmahnulsya" // «не характер»
            wait 1.6s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    // ── ОБРАЗ (VO-13): доказательство, что кнопка работала ────────────
    //  ЖИВО, ПОЧТИ С УСМЕШКОЙ: двухлетка отказывал безупречно и ни на одном
    //  курсе не был. Это не утешение — это единственное доказательство, что
    //  ход вообще возможен.
    //lip 13
    together {
        freeman speaks for 3.87s
        do {
            camera medium freeman
            wait 2.1s
            freeman overlays "palec_vverh" // «и мир это пережил»
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 7: ЧЕРТА НА ПОЛУ — ХОД И КАЧЕЛИ ========================
//  ОТКАЗ ПЕРЕСТАЁТ БЫТЬ СЛОВОМ И СТАНОВИТСЯ ВЕЩЬЮ. Красная черта лежит
//  поперёк кадра на высоте 0.714..0.736 — единственное цветное пятно ролика.
scene "cherta" (duration: 1s, set: cherta) {
    transition static 0.25s

    //  Дальний край пола на y 0.517; ставить можно ДО черты (y<0.71) или ЗА
    //  ней (y>0.74). Здесь — ДО: черта ложится между зрителем и человеком и
    //  видна целиком. Масштаб 1.05 при глубине 0.72 даёт в кадре 0.76 —
    //  вровень с остальными сценами.
    place freeman at (0.44, 0.70) facing front on floor
    freeman scales 1.05 over 0.01s
    camera wide
    freeman pose "think"
    wait 0.3s

    // ── ВЗЛЁТ (VO-14): ход отдают, а не продают ───────────────────────
    //  СПОКОЙНО, С ДОСТОИНСТВОМ, БЕЗ ТОРЖЕСТВА В ГОЛОСЕ. «Снова появляется
    //  смысл» — высокое слово ролика, и оно стоит ровно там, где отменяется
    //  «жуёте свою злость» из пятой реплики.
    freeman pose "calm"
    //lip 14
    together {
        freeman speaks for 4.38s
        do {
            freeman overlays "raspahnul"   // «кнопку ставят обратно»
            wait 2.4s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    // ── КАЧЕЛИ (VO-15): возврат достоинства ───────────────────────────
    //  РОЛИК ВЕСЬ ИДЁТ НА СНИЖЕНИЕ, И ОСТАВИТЬ ЗРИТЕЛЯ ВНИЗУ НЕЛЬЗЯ. Образ
    //  холодильника возвращается перевёрнутым: из него берут — значит, брали
    //  и у зрителя, и это не про его слабость. Играется ровно, как
    //  констатируют, без утешения в голосе.
    //lip 15
    together {
        freeman speaks for 4.66s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "vzves"       // «из него берут»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 8: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ==========================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ. Деловой тон, как объявляют пункт, — в
//  этом ролике продаёт не обещание, а всё, что было сказано до.
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "raskryl"
    wait 0.2s

    // ── ПРЕЗЕНТАЦИЯ (VO-16): имя курса и объём ────────────────────────
    freeman pose "calm"
    //lip 16
    together {
        freeman speaks for 4.14s
        do {
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            wait 2.2s
            freeman overlays "open"          // «Десять лекций»
        }
    }
    wait 0.5s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-17): цена ────────────────────────────
    //  ОТДЕЛЬНОЙ РЕПЛИКОЙ И ПОСЛЕ ПАУЗЫ, А НЕ ХВОСТОМ ПРЕДЫДУЩЕЙ. Внутри
    //  длинной строки «бесплатно» проскакивает мимо уха вместе с названием и
    //  числом; вынесенное отдельно — слышится. Повтор числа («десять лекций»
    //  → «все десять») отвечает на немой вопрос «все или первая», не задавая
    //  его вслух.
    //
    //  ГОЛОСОМ НЕ НАЖИМАТЬ. Бесплатное, объявленное с нажимом, читается как
    //  подвох, и зритель начинает искать ловушку.
    //lip 17
    together {
        freeman speaks for 1.82s
        do {
            freeman overlays "razvel"        // «все десять — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 9: КОРИДОР — ЖАЛО ======================================
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ПРОЗВУЧАЛА ПРОСЬБА. Тот же коридор, та же дверь: за
//  ней тот же человек, которому предстоит услышать «нет».
scene "zhalo" (duration: 1s, set: koridor) {
    transition static 0.2s

    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-18) ──────────────────────────────────────────────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: проверяется сегодня же, и
    //  ответ зрителю не понравится.
    //lip 18
    together {
        freeman speaks for 4.70s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "vozzvanie"   // «кто после этого отвалится?»
        }
    }
    camera wide
    freeman overlays "hero_wink"
    wait 1.3s
}

// ============ СЦЕНА 10: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ ================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: тот же коридор, тот же `place`, тот же
//  масштаб, та же поза поглаживания. Отличается только то, чего не видно, —
//  звучащая реплика. Метка курса проявляется и здесь, и в первом кадре
//  одинаково, а снимается до стыка — потому шва не возникает.
scene "final" (duration: 1s, set: koridor) {
    transition static 0.2s

    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide

    let nomer2 = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer2 scales 0.19 over 0.01s
    nomer2 hides

    //lip 19
    together {
        freeman speaks for 5.91s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Позы поглаживания трогают
            //  только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.4s
            nomer2 shows
            nomer2 scales 0.02 over 0.01s
            nomer2 scales 0.21 over 0.29s ease-out
            nomer2 scales 0.19 over 0.15s
            freeman overlays "gladit_grud_niz"
            wait 1.4s
            freeman overlays "gladit_grud"
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания, ГРУДЬ ПУСТАЯ —
    //  ровно то, с чего ролик начинается.
    nomer2 hides
    freeman pose "gladit_grud"
    wait 0.4s
}
