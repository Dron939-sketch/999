// =============================================================================
//  ПОДВОДКА К КУРСУ «ПЕРЕПРОШИВКА» — hook-ролик (~55 с)
//  Монтаж в регистре Фримена: жёсткие склейки ≤3.5с, паузы-тишина как удары,
//  жесты ломают силуэт и бьют по пикам голоса (амплитудный липсинк).
//  Драматургия:
//   1) ХУК (тюремная камера): сидит на нарах, говорит в упор, встаёт — «камера = здравый смысл».
//   2) КНИГА: наезд на титул курса.
//   3) КАРТИНКА ОЖИВАЕТ: шестерни, разбор прошивки, гротескный панч в упор.
//  Озвучка: Frederick/Fish Audio по pereproshivka-intro-VO.md (там же SFX).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import character clone1 from "../assets/characters/freeman_rig"
import character clone2 from "../assets/characters/freeman_rig"
import character clone3 from "../assets/characters/freeman_rig"
import character clone4 from "../assets/characters/freeman_rig"
import set cell from "../assets/sets/prison-cell.svg"
import set book from "../assets/sets/book-title-page.svg"
import set mind from "../assets/sets/mind-alive.svg"
import set void from "../assets/sets/void.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #3a3d38
    monochrome: true
    mono-contrast: 1.6         // 5.0 схлопывал серые стены в чистый чёрный:
                               // локация и персонаж сливались в одну массу
    vignette: 0.12
    film-grain: 0.05
    // Фримен-аутентика: рисунок держится «на двойках» (рукотворная дёрганость)
    // + лёгкая атмосферная крошка. Красное (spot-color) выживает акцентом.
    on-twos: 2
    snow: 0.3
    // ОБЪЕКТИВ НЕ ДЁРГАЕТСЯ. line-boil — это дрожание РИСОВАННОЙ ЛИНИИ, оно
    // остаётся: без него перекладка выглядит компьютерной. А вот тряски и
    // крены камеры сняты почти вдвое (shake 0.8→0.3 и 1.4→0.5, dutch 5→2):
    // на 24-секундной сцене они читались не как удар, а как брак съёмки и
    // перетягивали внимание с реплики.
    line-boil: 1.1
}

// === СЦЕНА 1: ХУК В КАМЕРЕ (24 с) ===
scene "cell-hook" (duration: 24s, set: cell) {
    // ВЫХОД ИЗ ГЛУБИНЫ. Ролик начинается не со статики, а с приближения: он
    // идёт на камеру из дальнего угла камеры-тюрьмы и ГОВОРИТ НА ХОДУ.
    //
    // `on floor` — ключевое слово. Заданная точка теперь СТУПНИ на плоскости
    // пола, а не якорь фигуры; масштаб выводится из той же глубины. Пока это
    // умели только предметы, персонажа пришлось бы вести двумя независимыми
    // дорожками — позицией и масштабом, — и он неминуемо поехал бы по
    // воздуху: стоило сменить масштаб, ступни отрывались от пола. Здесь обе
    // величины следуют из одной, и ступни лежат на полу на каждом кадре
    // (замер: 0.699 / 0.808 / 0.924 при заданных 0.70 / 0.80 / 0.92).
    //
    // Пол этой локации: задняя кромка 0.655, передняя 1.0
    // (prison-cell.surfaces.json). Стартуем почти у задней стены.
    place freeman at (0.58, 0.695) facing front on floor
    // ДВОЙНИКОВ У ЗАДНЕЙ СТЕНЫ УБРАЛ. Замысел был верный — «тебе это выдали»
    // произносит человек, за спиной которого стоят такие же, — но постановка
    // не сошлась: на глубине задней кромки (0.66) фигура мельчает почти вдвое,
    // ноги превращаются в культяпки у самой линии стыка, и двойники читались
    // не стоящими, а подвешенными. Пол при этом ни при чём: замер стыка стены
    // и пола по чистой колонке даёт y=0.656 при заявленных в карте 0.655.
    // Ставить их надо ближе к камере и крупнее — это отдельная постановка,
    // а не строчка.
    // КРЫСА ИЗ УНИТАЗА. Точка сиденья размечена в карте поверхностей локации
    // (features.toilet.seat), а не подобрана на глаз.
    let rat = prop("rat", "../assets/props/rat.svg") at (0.804, 0.653) on floor
    // Размер крысы: на дальнем краю пола глубина сама уменьшает её в 0.55
    // раза. На 0.5 она превращалась в точку на тёмном полу — движение было, а
    // видно его не было; на 1.3 выходила ростом с собаку и перетягивала кадр
    // на себя. 0.75 — силуэт читается и остаётся крысой.
    rat scales 0.75
    rat hides
    let strings = prop("strings", "../assets/props/puppet-strings.svg") at (0.55, -0.9)
    strings scales 2.3
    freeman pose "calm"

    // 0–1.6с: тишина, капля (SFX), общий план. Пауза — это тоже удар.
    // Фигура стоит далеко и мелко — зритель ещё не понял, кто это.
    camera wide
    wait 1.6s

    // ПЕРВЫЙ ШАГ + РЕЧЬ. VO-1 идёт ПОВЕРХ ходьбы: шаговый цикл заводится сам
    // от скорости сущности, липсинк — от дорожки рта, и они не мешают друг
    // другу, потому что живут в разных костях (ноги против рта). Это ровно то,
    // ради чего слои поз накапливаются: ноги шагают базой, рот говорит слоем.
    //
    // Три шага за реплику: 0.695 → 0.78 → 0.86 по глубине. Каждый отрезок
    // отдельным `moves-to`, между ними короткая пауза — иначе ход выходит
    // ровным скольжением, а не шагами.
    // Камера ДЕРЖИТ ОБЩИЙ, пока он идёт. Первая версия уходила на средний в
    // начале реплики — и приближение пропадало: план сам подтягивал фигуру, а
    // зритель видел просто говорящую голову. Смысл выхода из глубины в том,
    // что растёт САМА ФИГУРА в неподвижной раме; склейка на средний ставится
    // ПОСЛЕ прихода, как точка.
    // КРЫСА ИДЁТ ПАРАЛЛЕЛЬНО ХОДУ. Первая версия ставила её пробег под нити
    // марионетки — а там крупный план, и пола в кадре нет: единственное живое
    // существо, кроме него, пробегало вне кадра. Ставим на ОБЩИЙ, пока он
    // выходит из глубины: камера видит весь пол, и оба движения читаются
    // одновременно. Крыса уходит под окно — к единственному «наружу» в кадре.
    //lip 1
    together {
        rat shows
        do {
            rat moves-to (0.46, 0.655) over 2.8s
            rat hides
        }
        freeman speaks for 6.4s
        do {
            freeman moves-to (0.57, 0.78) over 1.6s
            wait 0.3s
            freeman moves-to (0.56, 0.86) over 1.6s
            wait 0.4s
            camera medium freeman
            wait 1.4s
            camera wide
            wait 1.1s
        }
    }
    // Дошёл — и ОСТАНОВИЛСЯ. Остановка после хода читается как точка в
    // реплике: пока он шёл, зритель ждал; встал — начал слушать.
    freeman moves-to (0.55, 0.90) over 0.45s
    camera medium freeman
    wait 0.4s

    // СКЛЕЙКА → СРЕДНИЙ, а не крупный. VO-2 — про нити марионетки, и нити
    // видны только на общем/среднем: на крупном в кадре голова, а метафора
    // разыгрывается над ней и вне кадра. Крупный тут работал против сцены.
    camera medium freeman
    together {
        strings moves-to (0.55, 0.44) over 1.9s
        do {
            //lip 2
            freeman speaks for 5.5s
        }
        do {
            // Кат ВНУТРИ реплики: нити спускаются на общем (их видно целиком),
            // на «тебе это выдали» — врез на средний. Без него сцена стояла
            // одним планом 9.8 секунды при среднем по ролику 2.1.
            camera wide
            wait 2.4s
            camera medium freeman
            wait 1.8s
            camera close-up freeman
        }
    }
    // нити ПОДКЛЮЧИЛИСЬ: рывок — его вздёргивает как куклу, ступни отрываются
    // от пола. Это ЕДИНСТВЕННОЕ место, где отрыв от пола законен и работает
    // как приём: марионетку тянут вверх. Координата остаётся координатой пола,
    // поэтому «вверх» здесь — уход в глубину, к задней стене: рывок читается и
    // как подъём, и как отдёргивание назад.
    together {
        freeman pose "puppet_jerk"
        freeman moves-to (0.55, 0.80) over 0.12s
        strings moves-to (0.55, 0.37) over 0.12s
    }
    wait 0.5s
    // обвисает на нитях. В этот момент по полу проходит КРЫСА: единственное
    // живое в кадре, кроме него, и она-то как раз не на нитях.
    freeman pose "puppet"
    wait 0.5s
    // нити уносят вверх, он ПАДАЕТ ОБРАТНО НА ПОЛ — тем же ходом по глубине
    together {
        strings moves-to (0.55, -0.9) over 0.5s
        freeman moves-to (0.55, 0.90) over 0.3s
    }

    // СКЛЕЙКА → обратно средний. VO-3: «Эта камера — не наказание...»
    camera medium freeman
    // РАЗВОРОТ В ДЕЛО. «Эта камера — не наказание» — он оглядывает её: уходит
    // в три четверти к стене и возвращается в упор на слове «это ты сам».
    // До сих пор ни одна из 14 поз разворота в ролике не работала, персонаж
    // все 59 секунд стоял анфас — библиотека была, а кадр её не видел.
    //lip 3
    together {
        freeman speaks for 8.9s
        do {
            freeman pose "chetvert_pravo"
            wait 2.2s
            camera angle low freeman
            freeman pose "povorot_pravo"
            wait 2.0s
            camera medium freeman
            freeman pose "chetvert_pravo"
            wait 2.2s
            camera close-up freeman
            freeman pose "calm"
            wait 1.6s
        }
    }

    // ШАГ В УПОР («признай, что сидишь» → подходит вплотную). Он и так стоит,
    // поэтому удар делается не вставанием, а СОКРАЩЕНИЕМ ДИСТАНЦИИ: ещё один
    // шаг из 0.90 в 0.955 по глубине — фигура растёт, зритель отшатывается.
    // Лязг в SFX + короткая тряска на акценте.
    freeman pose "stern"
    camera shake 0.18s intensity 0.3
    freeman pose "calm"
    freeman moves-to (0.55, 0.955) over 0.9s
    wait 0.3s
    // СКЛЕЙКА → крупно, в упор + нервный крен кадра. VO-4. Это ЕДИНСТВЕННЫЙ
    // крупный план сцены, поэтому он и бьёт.
    camera close-up freeman
    camera dutch 2
    //lip 4
    together {
        freeman speaks for 3.4s
        do {
            wait 1.7s
            camera extreme-close-up freeman
        }
    }
    // жест-приглашение: «выйти?» — руки распахнуты, потом жёсткий взгляд
    freeman pose "open"
    wait 0.7s
    freeman pose "stern"
    wait 0.5s
    // ТВ-шумовая склейка (глитч-удар в стиле Фримена) → книга
    transition static 0.5s
}

// === СЦЕНА 2: КНИГА НА СТОЛЕ (11 с) ===
// СЦЕНА ДЕРЖИТ ДВЕ ДИКТОРСКИЕ РЕПЛИКИ, И ЕЁ ДЛИНА СЧИТАЕТСЯ ПО НИМ.
// VO-5 («Перепрошивка», десять лекций) и VO-6 («Лекция первая») — те две из
// десяти, которые звучат ЗА КАДРОМ: Фримена в сцене нет, рот открывать
// некому, поэтому речевого блока у них нет и движок про них не знает.
// Раньше сцена длилась 11 секунд, а реплики под неё — 8.9: название курса
// договаривалось уже под следующей сценой. Здесь каждой отведён свой кусок
// монтажа: титул под первую, наезд на картинку под вторую.
scene "book" (duration: 14s, set: book) {
    // Тишина после жёсткой фразы: книга, комната. Дай зрителю выдохнуть.
    camera wide
    wait 2s
    // СКЛЕЙКА → ТИТУЛ. VO-5: «"Перепрошивка". Десять лекций...» (5.1с)
    //
    // НАЗВАНИЕ КУРСА ОБЯЗАНО ПОМЕЩАТЬСЯ В КАДР ЦЕЛИКОМ. Здесь стоял голый
    // `camera close-up` — без цели он берёт исторические постоянные (зум 3.4
    // по центру кадра), и слово «ПЕРЕПРОШИВКА» обрезалось с обоих концов все
    // двенадцать секунд сцены: продающий ролик ни разу не показывал того, что
    // продаёт. Читаемым оно было ровно две секунды на общем плане в начале.
    // Теперь наезд адресный: средний план, наведённый НА ТИТУЛ, и медленный
    // ход вниз по нему — слово в кадре целиком от первого кадра до последнего.
    camera medium
    camera pan-to (0.665, 0.40) over 0.01s
    wait 2.2s
    camera pan-to (0.67, 0.47) over 2.6s
    // подъезд к картинке. VO-6: «Лекция первая. Ты — не с нуля.» (3.8с)
    camera wide
    wait 0.5s
    camera medium
    camera pan-to (0.72, 0.62) over 2.6s
    wait 1.4s
    camera pan-to (0.72, 0.70) over 1.6s
    transition dissolve 1s
}

// === СЦЕНА 3: КАРТИНКА ОЖИВАЕТ (20 с) ===
scene "alive" (duration: 14s, set: mind) {
    let gear1 = prop("gear", "../assets/props/gear.svg") at (0.47, 0.30)
    let gear2 = prop("gear", "../assets/props/gear.svg") at (0.36, 0.40)
    // ЭКГ-линия пульса пересекает кадр на «прошивка работает» (мотив Фримена)
    let ekg = prop("ekg", "../assets/props/ekg.svg") at (1.15, 0.52)
    // и КАБЕЛЬ ползёт к голове-схеме — тебя прошивают прямо сейчас
    let cable = prop("cable", "../assets/props/cable.svg") at (1.25, 0.33)

    place freeman at (0.85, 0.74) facing front
    freeman pose "calm"

    camera wide
    together {
        gear1 rotates 360 over 9s
        gear2 rotates -360 over 9s
        ekg moves-to (-0.15, 0.52) over 8s
        cable moves-to (0.72, 0.33) over 7s
        do {
            // VO-7: «Пока ты читаешь эту фразу — прошивка работает.»
            // декламирующий палец вверх — силуэт, не бормотание в костюм
            freeman pose "point"
            wait 0.8s
            //lip 7
            freeman speaks for 3.8s
        }
        do {
            // Врез на середине оживающей картинки: шестерни и кабель едут
            // девять секунд, и без ката это один неподвижный план при среднем
            // по ролику 1.7. На врезе виден кабель, ползущий к голове-схеме, —
            // то самое «прошивка работает», о чём идёт реплика.
            wait 4.2s
            camera medium freeman
            wait 2.6s
            camera wide
        }
    }

    // СКЛЕЙКА → средний. VO-8: «Мы разберём её на детали. Что твоё. Что вшитое.»
    camera medium freeman
    freeman pose "think"
    wait 0.4s
    //lip 8
    together {
        freeman speaks for 4.7s
        do {
            wait 2.3s
            camera close-up freeman
        }
    }
    // тишина-удар перед приговором
    wait 0.7s

    // СКЛЕЙКА → крупно. VO-9: «И перепишем. Строчка за строчкой.»
    // ОБЩИЙ ПЕРЕД ФИНАЛЬНЫМ УДАРОМ: подряд идущие крупные съедают друг друга,
    // и последний перестаёт читаться как усиление. Отход на общий возвращает
    // масштаб, и следующий врез снова работает.
    camera wide
    wait 0.35s
    camera close-up freeman
    freeman pose "stern"
    //lip 9
    together {
        freeman speaks for 2.9s
        do {
            wait 1.4s
            camera extreme-close-up freeman
        }
    }

    // обрыв сцены в ТВ-шум → финал в пустоте
    transition static 0.5s
}

// === СЦЕНА 4: ПУСТОТА — ПАНЧ (10 с) ===
// Эталонная композиция: крошечная фигура в пустоте на штрихованном полу,
// тишина. Затем — сверхкруп, флэш-морды, гротескный оскал с VO-10.
scene "void-punch" (duration: 10s, set: void) {
    // толпа одинаковых кукол в пустоте — «таких, как ты, здесь тысячи»
    place clone1 at (0.12, 0.74) facing front
    place clone2 at (0.31, 0.74) facing front
    place freeman at (0.5, 0.74) facing front
    place clone3 at (0.69, 0.74) facing front
    place clone4 at (0.88, 0.74) facing front
    clone1 pose "puppet"
    clone2 pose "puppet"
    clone3 pose "puppet"
    clone4 pose "puppet"
    freeman pose "calm"

    // тишина: строй кукол, снег... герой ломает строй криком к небу
    camera wide
    wait 1.0s
    // НИЖНИЙ РАКУРС: объектив снизу — герой ВОЗВЫШАЕТСЯ над строем кукол,
    // форшортенинг делает фигуру монументальной (наклон держится в склейку).
    camera angle low freeman
    freeman pose "despair"
    wait 1.2s

    // СКЛЕЙКА → сверхкруп + крен + очередь флэш-морд + тряска + VO-10
    // (нижний ракурс перешёл в склейку — крик «в упор» с угрозой снизу)
    // Начинали финал с экстремального крупного — зритель терял, где он и
    // сколько их. Общий сначала, врез после.
    camera wide
    camera dutch -2
    freeman pose "flash_scream"
    wait 0.08s
    freeman pose "flash_rage"
    wait 0.08s
    freeman pose "flash_dead"
    wait 0.08s
    camera shake 0.22s intensity 0.5
    freeman pose "grotesque"
    //lip 10
    together {
        freeman speaks for 3.4s
        do {
            wait 1.7s
            camera close-up freeman
        }
    }
    // оскал гаснет в прищур-ухмылку, тишина, обрыв в черноту
    freeman pose "smug"
    wait 1.4s
    transition fade-black 1.2s
}
