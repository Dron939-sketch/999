// =============================================================================
//  «ПАРУС» — интро к курсу «Переход», номер 27.
//  VO — perehod-VO.md, маркеры 1..13.
//
//  ТЕКСТ И РАСКАДРОВКА ПРИШЛИ ОТ СТУДИИ ГОТОВЫМИ. Тринадцать реплик, девять
//  планов и четыре запрета. Здесь — техническая сборка под них: ни одно слово
//  не менялось, ни один план не добавлен и не выброшен.
//
//  1. ПЕРСОНАЖА В КАДРЕ НЕТ, И ЭТО НЕ ОПУЩЕНИЕ. Раскадровка студии — притча,
//     рассказанная поверх рисунков: в ней нет ни одного плана с Фрименом.
//     Гребца рисовать ригом нельзя вдвойне — он СИДИТ, а персонажу серии
//     сидеть запрещено (гейт осанки), — поэтому гребец нарисован в локацию,
//     как и всё остальное. Фримен остаётся голосом за кадром: он объявлен и
//     скрыт (`hides`), а его `speaks for` держат таймлайн и липсинк. Так
//     хронометраж картинки переписывается заводом по ФАКТИЧЕСКОЙ длине
//     озвучки, а не по моей мерке на глаз (`studio.step_hronometrazh`).
//     Убрать его вовсе — значит развязать картинку и голос и поймать разъезд
//     на первом же рендере.
//
//  2. ПАУЗА 3.0 с ПОСЛЕ VO-7 (0:28–0:31) НЕСОКРАЩАЕМАЯ. Запрет студии
//     дословно: «Она отделяет обвинение от разворота. Подрежете — ролик
//     останется упрёком.» Поэтому она стоит одним куском `wait 3.0s` внутри
//     сцены ладоней, и картинка в ней ЗАМИРАЕТ: ни проезда, ни смены плана.
//     Заполнить её движением — то же самое, что подрезать.
//
//  3. ВОДЫ НЕТ НИ В ОДНОМ КАДРЕ. Второй запрет студии. Держат сушу три вещи,
//     невозможные на воде: зебра в перспективе, бордюр с видимым торцом и
//     трещины по плоскости. Первая проба локаций рисовала асфальт двумя
//     параллельными горизонталями — и он честно читался как берег с рябью
//     (разбор в шапке `tools/risuem_perehod.py`).
//
//  4. ОТЪЕЗД И ВЗЛЁТ СДЕЛАНЫ СКЛЕЙКОЙ, А НЕ ТРАНСФОКАТОРОМ. `camera zoom-to`
//     наводится на СУЩНОСТЬ, а единственная сущность ролика скрыта — навести
//     не на что. Поэтому «камера отъезжает» (VO-5) и «камера взлетает» (VO-9)
//     идут резом изнутри реплики через `together`: крупно → широко, не прерывая
//     фразу. Для разрыва это даже точнее плавного отъезда: воды нет ВДРУГ.
//
//  5. НА `camera wide` ПРОЕЗДОВ НЕТ (реестр §XLI). Широкий план показывает
//     локацию целиком, и любой сдвиг выводит в кадр голую подложку. Проезды
//     идут только на `two-shot`, `medium` и `close-up`, и все — внутри запаса,
//     который считает `tools/proezd.py`.
//
//  6. ПАРУС ЛЕЖИТ В ЛОДКЕ С ЕЁ ПЕРВОГО ПОЯВЛЕНИЯ. В сценах 5, 7, 9 он свёрнут
//     и нарисован тушью — вещь среди вещей. Цветным он становится ровно один
//     раз, в последней сцене: одно цветное пятно на ролик (`tools/cvet.py`),
//     и оно стоит на теме.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ ПО РЕГИСТРАМ (`podacha.prognoz`). Завод
//  перепишет их по факту озвучки.
//
//  ХРОНОМЕТРАЖ 60.8 с: речи 51 с, пауз 9.8 с.
// =============================================================================
//
//  МИЗАНСЦЕНЫ ПРОСМОТРЕНЫ: 6b6510c2
import character freeman from "../assets/characters/freeman_rig"
import set spisok_ruka from "../assets/sets/spisok-ruka.svg"
import set spisok_naezd from "../assets/sets/spisok-naezd.svg"
import set spisok_pyl from "../assets/sets/spisok-pyl.svg"
import set lodka_pyl from "../assets/sets/lodka-iz-pyli.svg"
import set lodka_asfalt from "../assets/sets/lodka-asfalt.svg"
import set ladoni from "../assets/sets/ladoni-vyosla.svg"
import set vzglyad from "../assets/sets/vzglyad-grebca.svg"
import set dvor from "../assets/sets/dvor-potok.svg"
import set lodka_krupno from "../assets/sets/lodka-krupno.svg"
import set vopros from "../assets/sets/vopros-chern.svg"
import set parus from "../assets/sets/parus.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.12
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ===== 0:00.0–0:02.6 — РУКА ПИШЕТ СПИСОК =====================================
scene "s1" (duration: 1s, set: spisok_ruka) {
    //  Рассказчик объявлен и скрыт: голос за кадром, рта в кадре нет.
    //  Скрытая фигура исключена из проверок перекрытия (DSL §Overlap), но
    //  `speaks for` продолжает вести таймлайн — ради этого он и объявлен.
    place freeman at (0.50, 0.99) facing front on floor
    freeman scales 0.90 over 0.01s
    freeman hides over 0.01s
    camera two-shot

    //lip 1
    //  «Ты опять составил список.» — ровно, почти скучающе. Проезд идёт по
    //  строке вслед за грифелем: глаз ведут туда, где пишут.
    together {
        freeman speaks for 2.20s
        do {
            camera pan-to (0.464, 0.536) over 2.10s ease-in-out
        }
    }
    wait 0.273s
}

// ===== 0:02.6–0:08.0 — СТРОКИ НАПОЛЗАЮТ ДРУГ НА ДРУГА ========================
scene "s2" (duration: 1s, set: spisok_naezd) {
    transition static 0.10s
    camera medium
    camera pan-to (0.44, 0.38) over 0.01s

    //lip 2
    //  «Выучиться. Открыть своё. Переехать. Начать с понедельника.» — пулемёт,
    //  четыре щелчка. Камера идёт ВНИЗ по списку в темпе перечисления и
    //  доезжает до последней строки ровно на слове «понедельника»: под ней
    //  видны прошлогодние следы тех же четырёх обещаний.
    together {
        freeman speaks for 4.80s
        do {
            camera pan-to (0.52, 0.62) over 4.60s ease-in-out
        }
    }
    wait 0.473s
}

// ===== 0:08.0–0:11.0 — БУМАГА ОСЫПАЕТСЯ В ПЫЛЬ ==============================
scene "s3" (duration: 1s, set: spisok_pyl) {
    transition static 0.10s
    camera two-shot
    camera pan-to (0.50, 0.44) over 0.01s

    //lip 3
    //  «Красивый список. Мёртвый.» — второе слово отдельно и вниз. Камера
    //  тоже идёт вниз, к съеденной кромке: приговор произносится ровно там,
    //  где буквы кончаются.
    together {
        freeman speaks for 2.40s
        do {
            camera pan-to (0.50, 0.564) over 2.30s ease-in
        }
    }
    wait 0.473s
}

// ===== 0:11.0–0:15.0 — ИЗ ПЫЛИ СОБИРАЕТСЯ ЧЕЛОВЕК В ЛОДКЕ ====================
scene "s4" (duration: 1s, set: lodka_pyl) {
    transition static 0.10s
    camera medium
    camera pan-to (0.50, 0.52) over 0.01s

    //lip 4
    //  «Потому что в каждой строчке ты обещаешь себе одно и то же.» —
    //  объяснение, ровно. Камера медленно отходит к центру облака: фигура
    //  собирается из той же пыли, в которую только что осыпался список.
    together {
        freeman speaks for 3.60s
        do {
            camera pan-to (0.50, 0.46) over 3.50s ease-out
        }
    }
    wait 0.273s
}

// ===== 0:15.0–0:21.4 — РАЗРЫВ: ВОДЫ НЕТ =====================================
scene "s5" (duration: 1s, set: lodka_asfalt) {
    transition static 0.10s
    //  Начинаем КРУПНО на гребце: он работает, и кроме него в кадре ничего.
    camera medium
    camera pan-to (0.42, 0.56) over 0.01s

    //  Регистр «тепло», а не «приговор»: иначе на скорости смена лица
    //  «ты → я» проскакивает и цитата звучит словами рассказчика (вычитка).
    //
    //  РЕЗ НА «ИЗ НИЧЕГО» — ЭТО И ЕСТЬ ОПЛАТА РАЗРЫВА. Не плавный отъезд:
    //  воды нет ВДРУГ, ровно на словах «из ничего», и достроить нечем.
    //
    //  МАРКЕР ДЕРЖИТСЯ ТОЛЬКО ЧЕРЕЗ ШЕСТЬ СТРОИТЕЛЬНЫХ СТРОК (реестр §XXXVII),
    //  поэтому разбор стоит ВЫШЕ него, а не между ним и репликой.
    //lip 5
    //  «Я сам создам движение там, где его нет. Из ничего. На тех силах,
    //  которых у меня уже нет.» — чужая речь: обещание зрителя самому себе.
    together {
        freeman speaks for 6.00s
        do {
            camera pan-to (0.46, 0.56) over 2.60s linear
            camera wide
        }
    }
    wait 0.273s
}

// ===== 0:21.4–0:31.0 — ЛАДОНИ, И ТРИ СЕКУНДЫ ТИШИНЫ ==========================
scene "s6" (duration: 1s, set: ladoni) {
    transition static 0.10s
    //  ПЛАН НЕ КРУПНЕЕ `two-shot`, И ЭТО ПРОВЕРЕНО ГОТОВЫМ ФАЙЛОМ. Первый
    //  рендер снимал ладонь на `close-up` (зум 3.4): в кадре остались четыре
    //  чёрных столба и светлые пятна, кисть не читалась вовсе. Рисунок уже
    //  КРУПНЫЙ ПЛАН сам по себе — ладонь занимает весь холст, — и наводить на
    //  него ещё и трансфокатор значит срезать ровно ту половину, ради которой
    //  кадр рисовался (реестр §XLII).
    camera two-shot
    camera pan-to (0.455, 0.515) over 0.01s

    //lip 6
    //  «Ты гребёшь. Годами.» — два куска, второй тяжелее.
    together {
        freeman speaks for 2.20s
        do {
            camera pan-to (0.50, 0.50) over 2.10s linear
        }
    }
    wait 0.4s

    //lip 7
    //  «Стёр ладони до кости и называешь это характером.» — самое жёсткое
    //  место ролика и станок шутки 3: мозоли предъявлены как мера характера,
    //  единица со склада приложена к тому, что складом не меряется. Проезд
    //  идёт по четырём светлым пятнам — их считают глазом.
    together {
        freeman speaks for 4.00s
        do {
            camera pan-to (0.545, 0.485) over 3.90s linear
        }
    }

}

// ===== 0:28.0–0:31.0 — ТРИ СЕКУНДЫ ТИШИНЫ ====================================
//  ПАУЗА — ОТДЕЛЬНЫЙ ПЛАН, И ЭТО НЕ ФОРМАЛЬНОСТЬ. В раскадровке студии у неё
//  своя строка (00:28–00:31, «Пауза. Всё замирает. Вёсла останавливаются»), и
//  своей сценой она становится по той же причине: в ней НЕТ реплики. Гейт
//  тишины считает сцену без `//lip` законной, а ту же паузу внутри говорящей
//  сцены — дырой, и он прав в общем случае: обычно это сцена, добитая
//  застывшим кадром до объявленной длительности.
//
//  Локация та же и камера та же — рез в паузе отнял бы у неё ровно то, ради
//  чего она стоит. Меняется только то, что ничего не меняется.
scene "s6b" (duration: 1s, set: ladoni) {
    camera two-shot
    camera pan-to (0.545, 0.485) over 0.01s
    wait 2.99s
}

// ===== 0:31.0–0:34.0 — ПЕРВЫЙ ПРЯМОЙ ВЗГЛЯД ==================================
scene "s7" (duration: 1s, set: vzglyad) {
    transition static 0.10s
    //  СТАТИКА НАМЕРЕННАЯ. Взгляд в камеру — единственное событие плана;
    //  любое движение камеры отняло бы его на себя.
    camera two-shot

    //lip 8
    //  «Оторви взгляд от вёсел.» — тише предыдущей, как совет, а не команда.
    freeman speaks for 2.40s
    wait 0.473s
}

// ===== 0:34.0–0:47.2 — ДВОР: ПОТОК, КОТОРЫЙ ИДЁТ БЕЗ НЕГО ====================
scene "s8" (duration: 1s, set: dvor) {
    transition static 0.10s
    //  Начинаем внизу, у лодки, и на «двести человек» уходим наверх — это и
    //  есть «камера взлетает» из раскадровки.
    camera medium
    camera pan-to (0.36, 0.68) over 0.01s

    //lip 9
    //  «Через твой двор каждое утро проходит двести человек. В одно и то же
    //  время. Годами. Без тебя.» — сводка без нажима, последнее слово
    //  отдельно. Взлёт стоит на слове «двести»: счёт называют, и кадр
    //  открывает то, что считают.
    together {
        freeman speaks for 7.80s
        do {
            camera pan-to (0.44, 0.60) over 1.90s ease-in
            camera wide
        }
    }
    wait 0.6s

    //lip 10
    //  «Всё это уже движется. И ты не видишь ничего.» — вверх на первой
    //  половине, вниз на второй. Возвращаемся к лодке: на фоне потока она
    //  крошечная и стоит поперёк.
    together {
        freeman speaks for 4.20s
        do {
            camera medium
            camera pan-to (0.36, 0.70) over 4.00s ease-in-out
        }
    }
    wait 0.473s
}

// ===== 0:47.2–0:52.0 — ВОЗВРАТ В ЛОДКУ ======================================
scene "s9" (duration: 1s, set: lodka_krupno) {
    transition static 0.10s
    camera two-shot
    camera pan-to (0.44, 0.50) over 0.01s

    //lip 11
    //  «Не потому, что ты ленивый. Потому что тебе никто не задал вопрос.» —
    //  теплее всего до этого места. Проезд идёт к свёрнутому полотнищу на
    //  дне: оно лежит здесь с первого появления лодки и ни разу не названо.
    together {
        freeman speaks for 4.20s
        do {
            camera pan-to (0.556, 0.52) over 4.10s ease-out
        }
    }
    wait 0.483s
}

// ===== 0:52.0–0:56.6 — ВОПРОС НА ЧЁРНОМ =====================================
scene "s10" (duration: 1s, set: vopros) {
    transition static 0.10s
    //  СТАТИКА И ПУСТОТА. Пауза перед догадкой — рабочее время зрителя;
    //  всё, что появится в этом кадре, будет у него отобрано.
    camera wide

    //lip 12
    //  «Вот он. Что рядом с тобой уже движется само?» — вопрос повисает.
    freeman speaks for 3.80s
    wait 0.673s
}

// ===== 0:56.6–1:00.8 — ПАРУС ================================================
scene "s11" (duration: 1s, set: parus) {
    transition static 0.10s
    camera two-shot
    camera pan-to (0.50, 0.54) over 0.01s

    //  Ветер сдувает надпись и выпрямляет полотнище ДО реплики: зритель
    //  видит ответ раньше, чем слышит его. Рассказчик приходит вторым.
    wait 0.383s

    //lip 13
    //  «Ветер дул всё это время. Ты просто не поднимал парус.» — почти
    //  шёпотом, тише всего остального. Кольцо: то же полотнище, что лежало
    //  свёрнутым в сценах 5, 7 и 9, и единственный цвет ролика.
    together {
        freeman speaks for 3.80s
        do {
            camera pan-to (0.50, 0.462) over 3.70s ease-out
        }
    }
}
