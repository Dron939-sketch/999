// =============================================================================
//  «ГНЕВ И АГРЕССИЯ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/gnev-i-agressiya — 10 лекций, ~2,3 часа).
//
//  СКВОЗНАЯ: держаться — не стратегия, а причина срыва. Гнев приходит в тело
//  за пару секунд до слов, и поймать его можно только там.
//
//  ЛОКАЦИИ СНЯТЫ ПОД ЭТОТ СЦЕНАРИЙ. Каждая доказывает свою реплику деталью,
//  а не подписью, и две зарифмованы кадр в кадр:
//
//    void           пустота до всякой вспышки      приветствие
//    gnev-kuhnya    вечер: кружка опрокинута, чай  хук: вчера вы рявкнули
//                   течёт со стола, детский стул   из-за пролитого чая;
//                   пуст, силуэт уходит в дверь    потом полночи себя грызли
//    gnev-kryshka   кастрюля кипит, крышка прижата пулемёт: держаться? не
//                   камнем, пар бьёт из-под неё    работает. выпустить пар? хуже
//    gnev-dver      дверь приоткрыта, в щели сидит разворот: не на всех —
//                   маленький силуэт; вешалка ПУСТА только на тех, кто не уйдёт
//    gnev-utro      та же кухня: кружка стоит,     взлёт: не душа — тело;
//                   кружек две, стулья друг к другу два часа, и поймаете сигнал
//    void снова     кольцо: срываться не на ком    жало
//
//  РИФМА ВЕЧЕР ↔ УТРО — главный приём видеоряда. Вечером кружка опрокинута,
//  чай течёт со стола, ребёнок уходит из кадра. Утром та же кружка стоит,
//  рядом вторая, и два стула развёрнуты друг к другу. Ролик обещает не
//  спокойствие, а разговор после — лекция 6 курса, «Разговор после: как чинить».
//
//  КАМЕНЬ НА КРЫШКЕ — ЭТО «ДЕРЖАТЬСЯ», а не гнев вообще. Он лежит весь
//  пулемёт и никуда не девается: снять его — это «выпустить пар», второй миф
//  курса (лекция 3), и он тоже не ответ. Оба способа зритель уже пробовал.
//
//  МИМИКА — ТОЛЬКО СЛОЕМ, И ТОЛЬКО ЛИЦЕВАЯ (PRAVILA-DVIZHENIYA.md §5).
//
//    · персонаж — канон (SIMILARITY.md), пластика слоя «повадок» (RULES.md);
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, наезд на переломе,
//      второй план играет ту же мысль, ≥3 разных поля за ролик (здесь пять);
//    · сценарий (SCRIPT-FREEMAN.md) — gnev-intro-VO.md, //lip 1..9.
//
//  ЖЕСТЫ СТОЯТ НА СЛОВАХ. Пауза в блоке `do` — это ДОЛЯ реплики, а не секунды
//  (доля записана в комментарии рядом с позой). `prep_lipsync` тянет блок под
//  фактическую длину mp3 и дотягивает каждую смену позы до ближайшей атаки
//  слога — см. RULES.md, «Жест ставится на слово, а не на секунду».
//
//  ДЛИНА при потолке приёмщика 60с. `duration` у сцены — ПОЛ, а не потолок.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pustota from "../assets/sets/void.svg"
import set kuhnya from "../assets/sets/gnev-kuhnya.svg"
import set kryshka from "../assets/sets/gnev-kryshka.svg"
import set dver from "../assets/sets/gnev-dver.svg"
import set utro from "../assets/sets/gnev-utro.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 1.9
    snow: 0.35
    on-twos: 2

    line-boil: 0.0
    gate-weave: 0.0
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    film-scratch: 0.25
    film-dust: 0.5

    ground-shadow: true
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ═══════════════ СЦЕНА 1: ПУСТОТА — до всякой вспышки ═════════════════════
scene "pustota" (duration: 5.9s, set: pustota) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "calm"
    wait 0.7s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.3s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) ─────────────────────────────────────
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 4.5s
        do {
            wait 3.4s
            freeman pose "open"          // «Дороги́е мои́» (0.75) — руки в стороны
            wait 1.1s
        }
    }
    wait 0.15s
}

// ═══════════════ СЦЕНА 2: КУХНЯ — здесь только что кричали ════════════════
//  ХУК (VO-2) и добивка (VO-3). Общий план первым: кружка, лужа, пустой
//  детский стульчик и уходящий силуэт — это и есть локация, её надо прочитать
//  до слов.
scene "kuhnya" (duration: 1.0s, set: kuhnya) {
    transition static 0.22s

    place freeman at (0.34, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "hips"
    wait 0.2s
    //lip 2
    together {
        freeman speaks for 3.1s
        do {
            wait 1.9s
            freeman pose "point"         // «проли́того ча́я» (0.62) — тычок в лужу
            camera medium freeman
            wait 0.9s
        }
    }
    wait 0.1s

    // Добивка: та же кухня, но уже про ночь после — и лицо крупно.
    freeman pose "hunch"
    //lip 3
    together {
        freeman speaks for 2.2s
        do {
            wait 1.2s
            freeman pose "za_golovu"     // «себя́ гры́зли» (0.55) — схватился за голову
            camera close-up freeman
            wait 0.7s
        }
    }
    freeman overlays "hero_skeptic"
    wait 0.2s
}

// ═══════════════ СЦЕНА 3: КАСТРЮЛЯ — «держаться» ══════════════════════════
//  ПУЛЕМЁТ (VO-4, VO-5, VO-6). Камень на крышке — это и есть стратегия, о
//  которой речь. Он давит крышку вместе с камнем, потом отмахивается от обоих
//  советов, потом в упор: «вы копите».
scene "kryshka" (duration: 1.0s, set: kryshka) {
    transition static 0.22s

    place freeman at (0.30, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let slovo = text("НА КОГО?", 120) at (0.5, -2.0) layer 6
    slovo scales 2.4 over 0.01s

    camera wide
    freeman pose "calm"
    freeman overlays "gab"
    wait 0.2s
    //lip 4
    together {
        freeman speaks for 3.6s
        do {
            wait 1.1s
            freeman pose "v_upor"        // «держа́ться» (0.30) — давит крышку
            wait 1.4s
            freeman pose "puppet_jerk"   // «сорва́лись» (0.70) — рвануло
            camera medium freeman
            wait 0.9s
        }
    }
    wait 0.15s

    // Пулемёт 2: два совета — и оба в отмах.
    camera wide
    freeman pose "shrug"
    //lip 5
    together {
        freeman speaks for 5.9s
        do {
            wait 1.8s
            freeman pose "no"            // «Не рабо́тает» (0.30) — отмах
            wait 2.6s
            freeman pose "otvraschenie"  // «Ху́же» (0.75) — отвращение
            camera medium freeman
            wait 1.2s
        }
    }
    wait 0.1s

    // Финал пулемёта: «Вы не боретесь. Вы копите.»
    // `stern` — мимическая поза (4 кости, ни одной руки): только слоем, иначе
    // тело сбрасывается в стойку смирно и отвращение из прошлой реплики
    // стирается (PRAVILA-DVIZHENIYA.md §5).
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 3.1s
        do {
            wait 1.7s
            freeman pose "v_upor"        // «Вы ко́пите» (0.55) — в упор
            camera close-up freeman
            wait 1.0s
        }
    }
    // ── СЛОВО-УДАР + инверсия-панч ────────────────────────────────────────
    slovo moves-to (0.5, 0.28) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.2s
    slovo moves-to (0.5, -2.0) over 0.18s ease-in
}

// ═══════════════ СЦЕНА 4: ДВЕРЬ — на тех, кто не уйдёт ════════════════════
//  ПЕРЕЛОМ (VO-7). Общий план держится: пустую вешалку и силуэт в щели надо
//  успеть прочитать. «Кто не уйдёт» наезжает одним долгим ходом.
scene "dver" (duration: 1.0s, set: dver) {
    transition static 0.22s

    place freeman at (0.56, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "puppet"
    freeman overlays "stern"
    wait 0.1s
    //lip 7
    together {
        freeman speaks for 5.6s
        do {
            wait 3.4s
            freeman pose "point"         // «кто не уйдёт» (0.60) — указал на дверь
            camera zoom-to freeman over 1.9s ease-in
            wait 0.3s
        }
    }
    camera shake 0.3s intensity 2
    wait 0.2s
}

// ═══════════════ СЦЕНА 5: УТРО — та же кухня ══════════════════════════════
//  ВЗЛЁТ (VO-8). Общий план первым: рифма читается только целиком — кружка
//  стоит, кружек две, стулья развёрнуты друг к другу.
scene "utro" (duration: 1.0s, set: utro) {
    transition static 0.22s

    place freeman at (0.34, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "calm"
    wait 0.4s
    //lip 8
    together {
        freeman speaks for 8.4s
        do {
            wait 2.5s
            freeman pose "hunch"         // «Мя́со и хи́мия» (0.30) — рука к горлу
            camera close-up freeman
            wait 3.4s
            freeman pose "raskryl"       // «пойма́ете сигна́л» (0.70) — раскрылся
            camera medium freeman
            wait 1.6s
        }
    }
    wait 0.3s
}

// ═══════════════ СЦЕНА 6: ПУСТОТА СНОВА — КОЛЬЦО ══════════════════════════
//  ЖАЛО-CTA (VO-9). Между двумя пустотами прошли кухня, кастрюля, дверь и
//  утро. Снять их — оставить его один на один с вопросом, на ком он сорвётся
//  сегодня, а срываться не на ком.
scene "pustota-final" (duration: 1.0s, set: pustota) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 5.6s
        do {
            camera medium freeman
            wait 3.1s
            freeman pose "point"         // «На ко́м» (0.55) — палец в зрителя
            wait 1.5s
            freeman pose "v_upor"        // «сего́дня» (0.82) — в упор
            camera close-up freeman
            wait 0.8s
        }
    }
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.3s
}

// ═══════════════ СЦЕНА 7: ТИТРЫ ═══════════════════════════════════════════
scene "titry" (duration: 3.4s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.9s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 1.2s
    transition fade-black 0.7s
}
