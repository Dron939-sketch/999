// =============================================================================
//  «ГНЕВ И АГРЕССИЯ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/gnev-i-agressiya — 10 лекций, ~2,3 часа).
//
//  СКВОЗНАЯ: держаться — не стратегия, а причина срыва. Гнев приходит в тело
//  за пару секунд до слов, и поймать его можно только там.
//
//  ЛОКАЦИИ СНЯТЫ ПОД ЭТОТ СЦЕНАРИЙ. Каждая доказывает свою реплику деталью,
//  а не подписью, и две зарифмованы кадр в кадр:
//
//    void           пустота до всякой вспышки      приветствие
//    gnev-kuhnya    вечер: кружка опрокинута, чай  хук: вчера вы рявкнули
//                   течёт со стола, детский стул   из-за пролитого чая;
//                   опрокинут, ребёнок уходит      потом полночи себя грызли
//    gnev-kryshka   кастрюля кипит, крышка прижата пулемёт: держаться? не
//                   камнем, пар бьёт из-под неё    работает. выпустить пар? хуже
//    gnev-dver      дверь закрывается, в щели      разворот: не на всех —
//                   сидит ребёнок; вешалка         только на тех, кто не уйдёт
//    gnev-utro      та же кухня: кружка стоит,     взлёт: не душа — тело;
//                   кружек две, стулья друг к другу два часа, и поймаете сигнал
//    void снова     кольцо: срываться не на ком    жало
//
//  ЧТО ДВИЖЕТСЯ И ПОЧЕМУ. Первая версия была снята «говорящей головой перед
//  задником»: фон нарисован, фигура жестикулирует на месте, за спиной не
//  происходит ничего. Смотреть такое пятьдесят секунд нечем. Теперь каждая
//  локация ИГРАЕТ свою реплику ровно в тот момент, когда та звучит:
//
//    · РЕБЁНОК УХОДИТ из кухни на словах «из-за пролитого чая» — он был
//      нарисован в фоне и стоял в проёме неподвижно весь хук;
//    · КАМЕНЬ вдавливается на «держа́ться», подскакивает на «сорвали́сь»,
//      СНИМАЕТСЯ с крышки на «Вы́пустить па́р?» и рушится обратно на «Ху́же» —
//      оба мифа курса показаны предметом, а не сказаны голосом;
//    · ДВЕРЬ ЗАКРЫВАЕТСЯ все пять с половиной секунд разворота: щель со
//      светом и ребёнком сужается, пока зритель слышит «кто не уйдёт»;
//    · В УТРО ПЕРСОНАЖ ВХОДИТ ШАГОМ (`shag_levoj`/`shag_pravoj`) — переход
//      вечер → утро сшит растворением, и в новый мир он приходит, а не
//      оказывается в нём;
//    · приветствие идёт на медленном наезде, а не на стоячем плане.
//
//  Предметы, которые играют, вынесены из сетов в `assets/props/`: нарисованный
//  в фоне не умеет двигаться, и деталь, которую задумывали как событие,
//  превращается в обои.
//
//  КАМЕНЬ НА КРЫШКЕ — ЭТО «ДЕРЖАТЬСЯ», а не гнев вообще. Он лежит весь
//  пулемёт и никуда не девается: снять его — это «выпустить пар», второй миф
//  курса (лекция 3), и он тоже не ответ. Оба способа зритель уже пробовал.
//
//  РИФМА ВЕЧЕР ↔ УТРО — главный приём видеоряда. Вечером кружка опрокинута,
//  чай течёт со стола, ребёнок уходит из кадра. Утром та же кружка стоит,
//  рядом вторая, и два стула развёрнуты друг к другу.
//
//  МИМИКА — ТОЛЬКО СЛОЕМ, И ТОЛЬКО ЛИЦЕВАЯ (PRAVILA-DVIZHENIYA.md §5).
//
//    · персонаж — канон (SIMILARITY.md), пластика слоя «повадок» (RULES.md);
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, наезд на переломе,
//      второй план играет ту же мысль, ≥3 разных поля за ролик (здесь пять);
//    · сценарий (SCRIPT-FREEMAN.md) — gnev-intro-VO.md, //lip 1..9.
//
//  ЖЕСТЫ СТОЯТ НА СЛОВАХ. Пауза в блоке `do` — это ДОЛЯ реплики, а не секунды
//  (доля записана в комментарии рядом с позой). `prep_lipsync` тянет ПЕРВЫЙ
//  `do` после `speaks` под фактическую длину mp3 и дотягивает каждую смену
//  позы до ближайшей атаки слога — см. RULES.md, «Жест ставится на слово».
//  Второй `do` в том же `together` — дорожка предметов; она идёт параллельно
//  и НЕ растягивается, поэтому предметам даются свои, независимые паузы.
//
//  ДЛИНА при потолке приёмщика 60с. `duration` у сцены — ПОЛ, а не потолок.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pustota from "../assets/sets/void.svg"
import set kuhnya from "../assets/sets/gnev-kuhnya.svg"
import set kryshka from "../assets/sets/gnev-kryshka.svg"
import set dver from "../assets/sets/gnev-dver.svg"
import set utro from "../assets/sets/gnev-utro.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 1.9
    snow: 0.35
    on-twos: 2

    line-boil: 0.0
    gate-weave: 0.0
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    film-scratch: 0.25
    film-dust: 0.5

    ground-shadow: true
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ═══════════════ СЦЕНА 1: ПУСТОТА — до всякой вспышки ═════════════════════
scene "pustota" (duration: 5.9s, set: pustota) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "calm"
    wait 0.7s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.3s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) ─────────────────────────────────────
    //  Наезд идёт всю реплику: стоячий план на четыре с половиной секунды —
    //  это первое, на чём зритель уходит.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 4.5s
        do {
            wait 3.4s
            freeman pose "open"          // «Дороги́е мои́» (0.75) — руки в стороны
            wait 1.1s
        }
        camera zoom-to freeman over 4.4s ease-in-out
    }
    wait 0.15s
}

// ═══════════════ СЦЕНА 2: КУХНЯ — здесь только что кричали ════════════════
//  ХУК (VO-2) и добивка (VO-3). Общий план первым: кружка, лужа, опрокинутый
//  стул и ребёнок в проёме — это и есть локация, её надо прочитать до слов.
//  А потом ребёнок уходит, и уходит он ровно на «из-за пролитого чая».
scene "kuhnya" (duration: 1.0s, set: kuhnya) {
    transition static 0.22s

    place freeman at (0.34, 0.585) facing front
    freeman scales 0.80 over 0.01s
    // ПРОП МАСШТАБИРУЕТСЯ ПО ВЫСОТЕ: движок кладёт ЛЮБОЙ предмет в 30% высоты
    // кадра (216px), рисунок сохраняет только пропорции. Поэтому `scales` —
    // это желаемая высота, делённая на 216: ребёнок ростом 330px → 1.53.
    let rebenok = prop("rebenok", "../assets/props/gnev-rebenok.svg") at (0.934, 0.557)
    rebenok scales 1.53 over 0.01s
    let kaplya = prop("kaplya", "../assets/props/gnev-kaplya.svg") at (0.466, 0.761)
    kaplya scales 0.11 over 0.01s
    kaplya hides

    camera wide
    freeman pose "hips"
    wait 0.2s
    //lip 2
    together {
        freeman speaks for 3.1s
        do {
            wait 1.9s
            freeman pose "point"         // «проли́того ча́я» (0.62) — тычок в лужу
            camera medium freeman
            wait 0.9s
        }
        do {
            wait 0.5s
            rebenok moves-to (1.16, 0.557) over 1.5s ease-in
            kaplya shows
            kaplya moves-to (0.466, 0.833) over 0.28s ease-in
            kaplya hides
            kaplya moves-to (0.466, 0.761) over 0.01s
        }
    }
    wait 0.1s

    // Добивка: та же кухня, но уже про ночь после — и лицо крупно.
    freeman pose "hunch"
    //lip 3
    together {
        freeman speaks for 2.2s
        do {
            wait 1.2s
            freeman pose "za_golovu"     // «себя́ гры́зли» (0.55) — схватился за голову
            camera close-up freeman
            wait 0.7s
        }
        do {
            wait 0.35s
            kaplya shows
            kaplya moves-to (0.466, 0.833) over 0.28s ease-in
            kaplya hides
        }
    }
    freeman overlays "hero_skeptic"
    wait 0.2s
}

// ═══════════════ СЦЕНА 3: КАСТРЮЛЯ — «держаться» ══════════════════════════
//  ПУЛЕМЁТ (VO-4, VO-5, VO-6). Камень на крышке — это и есть стратегия, о
//  которой речь, и он играет её сам: вдавливается, подскакивает, снимается
//  и рушится обратно.
scene "kryshka" (duration: 1.0s, set: kryshka) {
    transition static 0.22s

    place freeman at (0.30, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let kamen = prop("kamen", "../assets/props/gnev-kamen.svg") at (0.695, 0.293)
    kamen scales 0.51 over 0.01s     // высота 110px из 216 базовых
    let slovo = text("НА КОГО?", 120) at (0.5, -2.0) layer 6
    slovo scales 2.4 over 0.01s

    camera wide
    freeman pose "calm"
    freeman overlays "gab"
    wait 0.2s
    //lip 4
    together {
        freeman speaks for 3.6s
        do {
            wait 1.1s
            freeman pose "v_upor"        // «держа́ться» (0.30) — давит крышку
            wait 1.4s
            freeman pose "puppet_jerk"   // «сорвали́сь» (0.70) — рвануло
            camera medium freeman
            camera shake 0.25s intensity 2
            wait 0.65s
        }
        do {
            wait 1.1s
            kamen moves-to (0.695, 0.303) over 0.5s ease-in-out   // вдавился
            wait 1.3s
            kamen moves-to (0.695, 0.246) over 0.12s ease-out     // подскочил
            kamen moves-to (0.695, 0.298) over 0.16s ease-in      // сел обратно
        }
    }
    wait 0.15s

    // Пулемёт 2: два совета — и оба в отмах. Камень СНИМАЕТСЯ с крышки на
    // «Вы́пустить па́р?» и рушится обратно на «Ху́же»: второй миф показан
    // предметом, а не назван голосом.
    camera wide
    freeman pose "shrug"
    //lip 5
    together {
        freeman speaks for 5.9s
        do {
            wait 1.8s
            freeman pose "no"            // «Не рабо́тает» (0.30) — отмах
            wait 2.6s
            freeman pose "otvraschenie"  // «Ху́же» (0.75) — отвращение
            camera medium freeman
            wait 1.2s
        }
        do {
            wait 3.2s
            kamen moves-to (0.695, 0.215) over 0.45s ease-out     // камень снят
            wait 0.85s
            kamen moves-to (0.695, 0.300) over 0.14s ease-in      // рухнул обратно
        }
    }
    wait 0.1s

    // Финал пулемёта: «Вы не боретесь. Вы копите.»
    // `stern` — мимическая поза (4 кости, ни одной руки): только слоем, иначе
    // тело сбрасывается в стойку смирно и отвращение из прошлой реплики
    // стирается (PRAVILA-DVIZHENIYA.md §5).
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 3.1s
        do {
            wait 1.7s
            freeman pose "v_upor"        // «Вы ко́пите» (0.55) — в упор
            camera close-up freeman
            wait 1.0s
        }
        do {
            wait 1.7s
            kamen moves-to (0.695, 0.310) over 1.2s ease-in-out   // давит глубже
        }
        freeman scales 0.855 over 3.1s ease-in-out                // наступает на зрителя
    }
    // ── СЛОВО-УДАР + инверсия-панч ────────────────────────────────────────
    slovo moves-to (0.5, 0.28) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.2s
    slovo moves-to (0.5, -2.0) over 0.18s ease-in
}

// ═══════════════ СЦЕНА 4: ДВЕРЬ — на тех, кто не уйдёт ════════════════════
//  ПЕРЕЛОМ (VO-7). Дверь закрывается всю реплику: щель со светом и ребёнком
//  сужается, пока зритель слышит «кто не уйдёт». Наезд доезжает к концу.
scene "dver" (duration: 1.0s, set: dver) {
    transition static 0.22s

    place freeman at (0.56, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let stvorka = prop("stvorka", "../assets/props/gnev-stvorka.svg") at (0.910, 0.468)
    stvorka scales 2.13 over 0.01s   // высота 460px из 216 базовых

    camera wide
    freeman pose "puppet"
    freeman overlays "stern"
    wait 0.1s
    //lip 7
    together {
        freeman speaks for 5.6s
        do {
            wait 3.4s
            freeman pose "point"         // «кто не уйдёт» (0.60) — указал на дверь
            camera zoom-to freeman over 1.9s ease-in
            wait 0.3s
        }
        do {
            wait 1.1s
            stvorka moves-to (0.866, 0.468) over 3.6s ease-in-out
        }
    }
    camera shake 0.3s intensity 2
    wait 0.2s
}

// ═══════════════ СЦЕНА 5: УТРО — та же кухня ══════════════════════════════
//  ВЗЛЁТ (VO-8). Вечер сшит с утром растворением, а не встык: между ними
//  прошла ночь, и склейка обязана это сказать. В новый мир персонаж ВХОДИТ
//  шагом — общий план держится, пока рифма читается целиком.
scene "utro" (duration: 1.0s, set: utro) {
    transition dissolve 0.5s

    place freeman at (0.13, 0.585) facing front
    freeman scales 0.80 over 0.01s
    // Пар над кружками: восемь секунд взлёта были самым мёртвым местом ролика
    // (зал, раунд 5). Высота пропа 90px → scales 0.42 из 216 базовых.
    let par = prop("par", "../assets/props/gnev-par.svg") at (0.556, 0.415)
    par scales 0.42 over 0.01s
    par fades-to 0.0 over 0.01s

    camera wide
    together {
        freeman moves-to (0.34, 0.585) over 1.3s ease-out
        do {
            freeman pose "shag_pravoj"
            wait 0.32s
            freeman pose "shag_levoj"
            wait 0.32s
            freeman pose "shag_pravoj"
            wait 0.32s
            freeman pose "calm"
            wait 0.34s
        }
    }
    wait 0.3s
    //lip 8
    together {
        freeman speaks for 8.4s
        do {
            wait 2.5s
            freeman pose "hunch"         // «Мя́со и хи́мия» (0.30) — рука к горлу
            camera close-up freeman
            wait 3.4s
            freeman pose "raskryl"       // «пойма́ете сигна́л» (0.70) — раскрылся
            camera medium freeman
            wait 1.0s
            camera wide                  // воздух перед жалом и седьмая крупность
            wait 0.6s
        }
        do {
            par fades-to 0.85 over 0.5s
            par moves-to (0.556, 0.325) over 3.0s
            par fades-to 0.0 over 0.6s
            par moves-to (0.556, 0.415) over 0.01s
            par fades-to 0.8 over 0.5s
            par moves-to (0.556, 0.330) over 2.8s
            par fades-to 0.0 over 0.6s
        }
    }
    wait 0.3s
}

// ═══════════════ СЦЕНА 6: ПУСТОТА СНОВА — КОЛЬЦО ══════════════════════════
//  ЖАЛО-CTA (VO-9). Между двумя пустотами прошли кухня, кастрюля, дверь и
//  утро. Снять их — оставить его один на один с вопросом, на ком он сорвётся
//  сегодня, а срываться не на ком.
scene "pustota-final" (duration: 1.0s, set: pustota) {
    transition static 0.22s

    place freeman at (0.40, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // Шов утро → пустота был вторым мёртвым местом (зал, раунд 5): картинка
    // менялась, а движения в ней не было. Теперь он ВЫХОДИТ на своё место.
    camera medium freeman
    together {
        freeman moves-to (0.5, 0.585) over 0.9s ease-out
        do {
            freeman pose "shag_levoj"
            wait 0.3s
            freeman pose "shag_pravoj"
            wait 0.3s
            freeman pose "lunge"
            wait 0.3s
        }
    }
    //lip 9
    together {
        freeman speaks for 5.6s
        freeman scales 0.88 over 5.5s ease-in-out                 // подходит к зрителю
        do {
            wait 3.1s
            freeman pose "point"         // «На ко́м» (0.55) — палец в зрителя
            wait 1.5s
            freeman pose "v_upor"        // «сего́дня» (0.82) — в упор
            camera close-up freeman
            wait 0.8s
        }
    }
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.3s
}

// ═══════════════ СЦЕНА 7: ТИТРЫ ═══════════════════════════════════════════
scene "titry" (duration: 3.4s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.9s

    stamp moves-to (0.5, 0.66) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 1.2s
    transition fade-black 0.7s
}
