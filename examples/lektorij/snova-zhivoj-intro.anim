// =============================================================================
//  «СНОВА ЖИВОЙ» — продающее интро курса (meysternlp.ru/blog/lektorij/snova-zhivoj).
//  ПЕРВЫЙ ролик, собранный целиком по методике завода:
//    · персонаж — канон (SIMILARITY.md): плоская белая маска W/H 0.60, жирный
//      контур, крупная голова, тело-масса, руки-веточки, асимметрия покоя;
//    · поле — ПУСТОЕ светлое (дефолт оригинала), без павильона;
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, ракурсы high/low,
//      флэш-морды, наезд-удар, слово-удар + инверсия, отъезд-одиночество;
//    · сценарий (SCRIPT-FREEMAN.md): хук → пулемёт → разворот → взлёт → жало,
//      тайм-якоря 3–7–21; VO — snova-zhivoj-intro-VO.md, //lip 1..8;
//    · мелочи (MELOCHI.md): мерцание, гуляние кадра, царапины, пылинки.
//  Тема: «выключенный» человек — дышит, но не живёт. Открытие: мёртвая маска.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set titry from "../assets/sets/lektorij-final.svg"
import set pole from "../assets/sets/field-empty.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab        // тон земли: поле задаёт сет field-empty
    monochrome: true
    mono-contrast: 2.2         // тональные блоки неба и земли должны выжить
    snow: 0.35                 // частицы есть в 100% кадров оригинала
    on-twos: 2
    line-boil: 1.25
    film-grain: 0.05           // после замера дёрганья: фактура без шипения
    vignette: 0.12
    film-flicker: 0.04
    gate-weave: 0.8
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0           // канон: лицо плоское
    rim-light: 0.0
}

// ============================ СЦЕНА 1: ПУСТОТА ==============================
scene "pustota" (duration: 42s, set: pole) {
    transition static 0.35s

    place freeman at (0.5, 0.62) facing front
    freeman scales 0.72
    let hand = prop("hand", "../assets/props/hand-point.svg") at (-1.5, 1.5) layer 5
    let slovo = text("ЖИВОЙ?", 160) at (0.5, -2.0) layer 6
    slovo scales 2.6

    // ── t=0..3.5 БЕЗ СЛОВ: «выключен» — мёртвая маска в пустоте ────────────
    camera wide
    freeman pose "hero_dead"
    wait 1.9s
    camera medium freeman
    freeman pose "calm"
    wait 0.6s

    // ── ХУК (VO-1): фигура ВПРАВО-треть, ракурс СВЕРХУ (зритель мелкий) ────
    freeman moves-to (0.63, 0.62) over 0.01s
    freeman pose "talk"
    //lip 1
    together {
        freeman speaks for 1.7s
        do {
            camera angle high freeman
            wait 0.85s
            camera medium freeman
        }
    }
    // ── ХУК-добивка (VO-2): КАТ крупный, фигура ВЛЕВО-треть ───────────────
    freeman moves-to (0.37, 0.62) over 0.01s
    freeman pose "talk"
    //lip 2
    together {
        freeman speaks for 1.8s
        do {
            camera close-up freeman
            wait 0.9s
            camera extreme-close-up freeman
        }
    }
    freeman pose "flash_dead"
    wait 0.08s
    freeman pose "skeptic"
    wait 0.5s

    // ── ПУЛЕМЁТ 1 (VO-3): «Утро. Работа. Лента. Сон.» ─────────────────────
    freeman moves-to (0.5, 0.62) over 0.01s
    freeman pose "talk"
    //lip 3
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 1.1s
            camera close-up freeman
        }
    }
    // ── ПУЛЕМЁТ 2 (VO-4): ТЕ ЖЕ слова — монотонность как приём ────────────
    freeman moves-to (0.5, 0.62) over 0.01s
    freeman pose "talk"
    //lip 4
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 1.1s
            camera close-up freeman
        }
    }
    // ── ПУЛЕМЁТ финал (VO-5): ECU + тряска ────────────────────────────────
    freeman pose "talk"
    //lip 5
    together {
        freeman speaks for 2.2s
        do {
            camera extreme-close-up freeman
            wait 1.1s
            camera wide
        }
    }
    camera shake 0.35s intensity 2
    freeman pose "flash_disgust"
    wait 0.08s
    freeman pose "stern"
    wait 0.7s

    // ── t≈21 ПЕРЕЛОМ: РАЗВОРОТ (VO-6), ракурс СНИЗУ + рука в камеру ───────
    freeman moves-to (0.44, 0.62) over 0.01s
    freeman pose "talk"
    //lip 6
    together {
        freeman speaks for 4.5s
        do {
            camera angle low freeman
            wait 1.5s
            camera extreme-close-up freeman
            wait 1.5s
            camera medium freeman
        }
    }
    hand moves-to (0.72, 0.72) over 0.01s
    camera shake 0.3s intensity 2
    wait 0.7s
    hand moves-to (-1.5, 1.5) over 0.01s
    wait 0.5s

    // ── ВЗЛЁТ (VO-7): ECU, тепло ──────────────────────────────────────────
    freeman pose "talk"
    //lip 7
    together {
        freeman speaks for 3.5s
        do {
            camera extreme-close-up freeman
            wait 1.8s
            camera wide
        }
    }
    // ── СЛОВО-УДАР «ЖИВОЙ?» + негатив-панч ────────────────────────────────
    camera wide
    slovo moves-to (0.5, 0.32) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.9s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    freeman pose "flash_pupils"
    wait 0.08s

    // ── ЖАЛО-CTA (VO-8): наезд-удар, подмиг-издёвка ───────────────────────
    freeman moves-to (0.5, 0.62) over 0.01s
    freeman pose "talk"
    //lip 8
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 1.8s
            camera close-up freeman
            wait 1.7s
            camera wide
        }
    }
    camera zoom-to freeman over 0.18s ease-in
    freeman pose "hero_wink"
    wait 0.6s
    // отъезд-одиночество: снова крошечная фигура в пустоте
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.8s
}

// ============================ СЦЕНА 2: ТИТРЫ ================================
scene "titry" (duration: 6s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.2s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 2.5s
    transition fade-black 0.8s
}
