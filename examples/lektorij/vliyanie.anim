// =============================================================================
//  «СКОЛЬКО СТОИТ СКАЗАТЬ НЕТ» — интро к курсу «Влияние и манипуляции».
//  VO — vliyanie-VO.md, //lip 1..10.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. ОБМАНКА ВЕДЁТ ИЗ МАГАЗИНА ЗА СВОЙ СТОЛ. Ролик открывается ПРИХОЖЕЙ, где
//     стоят три пакета: не момент покупки, а её результат, который уже никуда
//     не денется. Дальше — ряды супермаркета, место, где манипуляцию ЖДУТ, и
//     зритель соглашается легко: продавцы далеко, он ни при чём. Ровно в этот
//     момент разворот уводит за СТОЛ ПОСЛЕ ГОСТЕЙ — чаще всего кнопку нажимает
//     не продавец, а тот, кто рядом. Тема, на которую зритель кивал со стороны,
//     оказывается его вчерашним вечером.
//
//  2. ПРИТЧА О КУРИЦЕ — РУЖЬЁ ЧЕХОВА. На 8-й секунде она подаётся как факт
//     про птиц: курица заклюёт крысу, но писк цыплёнка внутри заставляет
//     её накрыть врага крылом. Выстрел — на 25-й, в сцене пустоты, где
//     выясняется, что кнопки есть и у зрителя. Между этими точками ни намёка:
//     на базаре персонаж ни разу не смотрит в камеру в упор.
//
//  3. ЧЕТЫРЕ ГОЛОСА ВМЕСТО ЧЕТЫРЁХ ТЕРМИНОВ. Пулемёт — это принципы Чалдини,
//     и ни один не назван: «Я же для тебя старался», «Все уже согласились»,
//     «Осталось два места», «Ты же обещал». Термин из учебника нельзя узнать
//     в своей кухне, а эти фразы узнаются мгновенно.
//
//  4. ЛОКАЦИЯ ДОКАЗЫВАЕТ РЕПЛИКУ, А НЕ СТОИТ ФОНОМ. Прихожая с пакетами
//     (результат налицо) → ряды супермаркета (там нажимают открыто) → стол
//     после гостей (там нажимают и не называют это манипуляцией) → ПУСТОТА
//     (механизм и цена) → перекрёсток без знаков (так выглядит оставленный
//     выбор: ни указателя, ни стрелки) → зал Лектория → снова прихожая.
//
//  5. ТЕМП ИДЁТ ПО БИТАМ, а не ровной доской: хук 1.42, пулемёт 1.58, сразу
//     за ним разворот 1.25, дно 1.25. Перепад в четверть скорости стоит ровно
//     на склейке «супермаркет → стол», где меняется мир. Множители заданы
//     явной меткой `темп N` в ремарках VO-таблицы.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — поза `bok_*_govorit` плюс шаг СЛОЕМ `shag_bok_*`;
//      полная поза сбрасывает липсинк (tools/speech_lint.py);
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре
//      (tools/walk.py --check);
//    · фигура НЕ ПРИСЕДАЕТ: поза, роняющая рост больше чем на 8%, валит
//      прогон (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем: `confident` больше
//      не надевает цилиндр тайком (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s.
//      Движок берёт `scene.duration.max(actual)`: объявленное число сцену не
//      обрезает, а ДОБИВАЕТ застывшим кадром. После озвучки содержимое
//      сжимается, объявленное остаётся — и разница уезжает тишиной. Длину
//      задаёт содержимое; ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set prihozhaya from "../assets/sets/prihozhaya-pakety.svg"
import set ryady from "../assets/sets/supermarket-ryady.svg"
import set stol from "../assets/sets/stol-posle-gostej.svg"
import set void from "../assets/sets/void-black.svg"
import set perekrestok from "../assets/sets/perekrestok-bez-znakov.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ПРИХОЖАЯ — ХУК И ДОБИВКА =============================
//  ПАКЕТЫ УЖЕ СТОЯТ. Ролик не показывает, как человека уговорили: он показывает
//  то, что осталось у двери. Зритель узнаёт свою прихожую раньше, чем понимает
//  тему, и это единственный способ, которым Фримен входит, — бытовой деталью.
scene "prihozhaya" (duration: 1s, set: prihozhaya) {
    transition static 0.2s

    //  Стоит СЛЕВА, на пустой половине пола. Пакеты справа в кадре, но он на
    //  них не показывает: они и так первое, что видно.
    place freeman at (0.30, 0.93) facing front on floor
    freeman scales 0.95
    camera wide

    freeman pose "calm"
    wait 0.3s

    // ── ХУК (VO-1): «Вы зашли за хлебом, а вышли с тремя пакетами.» ─────
    //  Подача БУДНИЧНАЯ: он не обвиняет, он напоминает очевидное. Обвинение
    //  придёт на двадцатой секунде, и до него зритель должен соглашаться.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.6s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "no"          // «вышли с тремя пакетами» — развёл руками
        }
    }
    camera wide
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «И вам даже не соврали. Ни единым словом.» ─
    //  БЕЗ СЛОВА «КНОПКА». Раньше термин падал здесь, на пятой секунде, за три
    //  секунды до притчи, которая его объясняет, — и зритель честно не понимал,
    //  о какой кнопке речь. Добивка теперь только ставит вопрос: не соврали, а
    //  пакеты стоят. Отвечает притча, она же и называет кнопку.
    freeman pose "calm"
    freeman overlays "hips"
    //lip 2
    together {
        freeman speaks for 2.5s
        do {
            wait 1.4s
            freeman overlays "shrug"       // «ни единым словом» — пожал плечами
        }
    }
    wait 0.4s
}

// ============ СЦЕНА 2: РЯДЫ СУПЕРМАРКЕТА — ПРИТЧА И ПУЛЕМЁТ =================
//  МЕСТО, ГДЕ МАНИПУЛЯЦИЮ ЖДУТ. Здесь зритель соглашается легко: полки, пустые
//  ценники, продавцов даже не видно. Согласие ему сейчас и понадобится — через
//  двадцать секунд разговор переедет к нему за стол.
scene "ryady" (duration: 1s, set: ryady) {
    transition static 0.2s

    //  Стоит В ПРОХОДЕ, вдали: проход сужается к точке схода, и маленькая
    //  фигура в его глубине читается правильно — человек в ряду, а не перед
    //  ним.
    place freeman at (0.5, 0.72) facing front on floor
    freeman scales 0.34
    camera wide

    // ── ПРИТЧА-ОБМАНКА (VO-3): курица и крыса ──────────────────────────
    //  РУЖЬЁ ЧЕХОВА. Подаётся ровно, как факт про птиц: ни взгляда в упор,
    //  ни указующего жеста. Любая подсветка здесь обесценит выстрел на
    //  двадцать пятой секунде.
    //
    //  ЗДЕСЬ ЖЕ НАЗЫВАЕТСЯ КНОПКА — «этот писк и есть кнопка». Термин вводится
    //  ровно там, где механизм показан, иначе дальше он висит в воздухе. Выстрел
    //  это не тупит: на развороте неожиданность не в том, ЧТО такое кнопка, а в
    //  том, КТО её нажимает.
    //
    //  ПТИЦЫ ЗДЕСЬ НЕ ТЕ, ЧТО В ОПЫТЕ. Опыт ставили на индюшках, но «индю́шка»
    //  и «хорька́» синтез читает со своим ударением и разметку U+0301
    //  игнорирует — проверено двумя сборками. Курица, крыса и цыплёнок
    //  разъехаться не могут: ударение на основе, а у цыплёнка ещё и «ё».
    freeman pose "calm"
    freeman overlays "open"
    //lip 3
    together {
        freeman speaks for 7.6s
        do {
            wait 3.2s
            freeman overlays "think"       // байка: отвёл взгляд
            wait 2.2s
            freeman overlays "open"        // «это кнопка» — вернулся к зрителю
        }
    }
    wait 0.4s

    // ── ПУЛЕМЁТ (VO-4): четыре чужих голоса, ИДЁТ НА КАМЕРУ ────────────
    //  ПОЧЕМУ НЕ ВБОК. Перспектива здесь фронтальная: проход сужается к точке
    //  схода, и боковой проход увёл бы фигуру прямо в полки. Поэтому он идёт
    //  НА ЗРИТЕЛЯ — растёт масштаб и опускается точка посадки. Так лучше и по
    //  смыслу: пока звучат четыре чужих голоса, он наступает.
    //
    //  Ходьба ФРОНТАЛЬНАЯ (`shag_levoj`/`shag_pravoj`), а не профильная: лицо
    //  и так к зрителю, и правило «на ходу лицом к камере» выполняется само.
    //  Обе накладки без рта — липсинк не перебивается.
    freeman pose "calm"
    //lip 4
    together {
        freeman speaks for 5.0s
        do {
            //  ШАГ И ДВИЖЕНИЕ ИДУТ ОДНОВРЕМЕННО. `moves-to ... over` и
            //  `scales ... over` ЗАНИМАЮТ ВРЕМЯ, как `wait`: первая версия
            //  ставила их подряд, а шаги после — ветка вышла 10.2 с против
            //  5.0 с речи, и гейт тишины поймал шесть секунд молчания. Теперь
            //  каждый шаг накладывается перед своим отрезком движения и живёт
            //  ровно столько, сколько тот длится: 4×1.2 = 4.8 с при 5.0 с
            //  реплики.
            freeman overlays "shag_levoj"
            freeman moves-to (0.5, 0.84) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.5 over 1.2s
            freeman overlays "shag_levoj"
            freeman moves-to (0.5, 0.95) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.72 over 1.2s
        }
    }
    //  Остановка полной позой: слои шага сняты, ноги приставлены.
    freeman pose "calm"
    //  Тишина на месте пятого голоса — его нет, и это слышно.
    wait 0.5s
}

// ============ СЦЕНА 3: СТОЛ ПОСЛЕ ГОСТЕЙ — РАЗВОРОТ =========================
//  СМЕНА МИРА НА ОДНОЙ ФРАЗЕ. Двадцать секунд зритель кивал про продавцов — и
//  оказался за своим столом. Здесь только что старались, кормили и угощали,
//  и ровно отсюда растёт «я же для тебя старалась»: услуга и долг в одном
//  кадре. Один стул развёрнут от стола — разговор кончился нехорошо.
//
//  Темп здесь падает до 1.25 сразу после пулемётных 1.58. Смена мира и смена
//  подачи в одной точке — это и есть перелом ролика.
scene "stol" (duration: 1s, set: stol) {
    transition static 0.15s

    //  Стоит ПЕРЕД СТОЛОМ, на пустом полу: не за столом и не на месте гостя.
    //  Сесть сюда нельзя — ролик про того, кто ушёл из-за стола, а не про
    //  того, кто остался (и tools/posture.py такую позу всё равно завалит).
    place freeman at (0.40, 0.97) facing front on floor
    freeman scales 0.98
    camera wide

    //  ВПЕРВЫЕ В УПОР. До этой секунды он ни разу не смотрел в камеру: пока
    //  разговор был про чужих, взгляд в упор был бы преждевременным.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 5.8s
        do {
            wait 4.3s
            camera medium freeman
            freeman overlays "ugryumo"     // «а тот, кто рядом» — лицо
                                           // жёстче. НЕ `stern`: та трогает
                                           // рот и перебила бы липсинк.
        }
    }
    camera wide
    wait 0.3s
}

// ================== СЦЕНА 4: ПУСТОТА — МЕХАНИЗМ И ЦЕНА ======================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Ни рынка, ни кухни: отговорок больше нет. Две
//  реплики подряд без смены плана — сначала механизм, потом цена. Склейка
//  между ними разбила бы мысль ровно там, где она собирается.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между кухней и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`. Пола нет, кадр держит МАСКА:
    //  посадка по ступням увела бы её в верхнюю четверть кадра. Точка
    //  задаётся по якорю и целится в центр, ноги уходят за нижнюю кромку.
    //  План ОБЩИЙ: на нём зум равен единице и маска встаёт куда посажена.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    //  ПАЛЬЦА ЗДЕСЬ БОЛЬШЕ НЕТ. Он стоял тут как третья ступень объяснения:
    //  притча говорит, что кнопка делает, разворот — что кнопки это те четыре
    //  фразы, а палец показывал, где они. В сборке студия увидела не палец, а
    //  «какой-то объект, трость наверное»: белое пятно возникало на секунду в
    //  пустом чёрном кадре, без замаха и без входа, и прочиталось как сбой.
    //  Показать кнопку кадром — мысль верная, исполнение мимо; вернусь к ней
    //  отдельно, если студия захочет, и уже с движением, а не подстановкой.
    //  Реквизит `hand-point-belaya.svg` остаётся в библиотеке: белая рука с
    //  контуром — единственная, которая вообще видна на чёрном.

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-6): «Никто ничего не взламывает.» ────────────
    //  БЕЗ ОСУЖДЕНИЯ. Здесь выстреливает притча: писк цыплёнка оказывается
    //  своим. Если сыграть это обвинением, зритель начнёт защищаться вместо
    //  того, чтобы узнавать себя.
    //lip 6
    together {
        freeman speaks for 9.7s
        do {
            wait 4.8s
            freeman overlays "open"        // «нужны вам самим» — ладони
        }
    }
    wait 0.4s

    // ── ДНО (VO-7): «Сколько стоит сказать нет.» ───────────────────────
    //  ГЛАВНАЯ ФРАЗА РОЛИКА, и потому играется почти неподвижно: любой жест
    //  здесь отвлекает. Внутри реплики только `ugryumo` — накладка без рта;
    //  зрачки и `stern` трогают рот и перебили бы липсинк, поэтому вспышка
    //  вынесена ЗА реплику, в тишину после неё.
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 6.8s
        do {
            wait 4.0s
            freeman overlays "ugryumo"
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 5: ПЕРЕКРЁСТОК БЕЗ ЗНАКОВ — ВЗЛЁТ ========================
scene "perekrestok" (duration: 1s, set: perekrestok) {
    transition static 0.2s

    //  НИ УКАЗАТЕЛЯ, НИ СТРЕЛКИ — и даже пустого столба нет. Пустой столб
    //  читался бы как «указатель сняли»; нужен мир, где его и не было. Так
    //  выглядит оставленный выбор: идти можно в любую сторону, и это ничего
    //  не стоит. Разница с предыдущей сценой не в словах, а в цене отказа.
    place freeman at (0.5, 0.90) facing front on floor
    freeman scales 0.80
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: цена названа, сейчас скажут, что с ней
    //  делать. Реплика сразу после склейки читалась бы продолжением приговора.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): «Заметить цену — уже половина защиты.» ───────────
    freeman pose "calm"
    //lip 8
    together {
        freeman speaks for 5.0s
        do {
            wait 2.6s
            freeman overlays "confident"   // без цилиндра: см. tools/rekvizit.py
        }
    }
    wait 0.2s
}

// ============ СЦЕНА 6: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-9): называет курс ──────────────────────────────
    //lip 9
    together {
        freeman speaks for 4.3s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "wave"        // «влияние и манипуляции»
            wait 1.5s
            freeman overlays "open"        // «бесплатно»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 7: СНОВА ПРИХОЖАЯ — ЖАЛО ================================
scene "final" (duration: 1s, set: prihozhaya) {
    transition static 0.2s

    place freeman at (0.34, 0.93) facing front on floor
    freeman scales 0.95
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.2s

    // ── ЖАЛО (VO-10): «Скажите одно нет — без единого объяснения.» ─────
    //  ИЗМЕРИМЫЙ ЧЕЛЛЕНДЖ, а не мысль на прощание: у оригинала финал —
    //  «помолчать хотя бы недельку», проверяемое действие. Зритель уходит с
    //  заданием, которое можно провалить сегодня же вечером.
    //lip 10
    together {
        freeman speaks for 5.8s
        do {
            camera medium freeman
            wait 3.2s
            freeman overlays "shrug"       // «сколько раз захочется?»
        }
    }
    freeman overlays "hero_wink"
    wait 0.1s

    // ── УХОДИТ, ПАКЕТЫ ОСТАЮТСЯ ────────────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой.
    //  Кольцо замыкается на ПРЕДМЕТЕ, а не на фразе: последнее, что видит
    //  зритель, — те же три пакета у двери, с которых ролик начался.
    //  Молчаливый хвост держится под тремя секундами (tools/pauses.py).
    camera wide
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.93) over 0.6s
    freeman overlays "shag_bok_levoj"
    wait 0.35s
    freeman overlays "shag_bok_pravoj"
    wait 0.35s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы, и последний
    //  кадр застывал бы на разведённых ногах.
    freeman pose "bok_levo"
}

// ========================== СЦЕНА 8: ТИТРЫ ==================================
//  Печать бьёт и кадр гаснет. Титры — событие, а не тишина, и в хвост они не
//  засчитываются; но и растягивать их не на что.
scene "titry" (duration: 1.7s, set: titry) {
    transition static 0.15s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.35s
    transition fade-black 0.25s
}
