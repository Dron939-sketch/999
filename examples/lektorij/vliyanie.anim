// =============================================================================
//  «СКОЛЬКО СТОИТ СКАЗАТЬ НЕТ» — интро к курсу «Влияние и манипуляции».
//  VO — vliyanie-VO.md, //lip 1..10.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. ОБМАНКА ВЕДЁТ ОТ РЫНКА К КУХНЕ. Ролик начинается там, где манипуляцию
//     ЖДУТ, — на базаре обещаний. Первые двадцать секунд зритель уверен, что
//     разговор про продавцов, и соглашается легко: продавцы далеко, он ни при
//     чём. Ровно в этот момент разворот уводит на кухню — чаще всего кнопку
//     нажимает не продавец, а тот, кто рядом. Тема, на которую зритель кивал
//     со стороны, оказывается его вечером.
//
//  2. ПРИТЧА ОБ ИНДЮШКЕ — РУЖЬЁ ЧЕХОВА. На 8-й секунде она подаётся как факт
//     про птиц: индюшка заклюёт хорька, но писк индюшонка внутри заставляет
//     её накрыть врага крылом. Выстрел — на 25-й, в сцене пустоты, где
//     выясняется, что кнопки есть и у зрителя. Между этими точками ни намёка:
//     на базаре персонаж ни разу не смотрит в камеру в упор.
//
//  3. ЧЕТЫРЕ ГОЛОСА ВМЕСТО ЧЕТЫРЁХ ТЕРМИНОВ. Пулемёт — это принципы Чалдини,
//     и ни один не назван: «Я же для тебя старался», «Все уже согласились»,
//     «Осталось два места», «Ты же обещал». Термин из учебника нельзя узнать
//     в своей кухне, а эти фразы узнаются мгновенно.
//
//  4. ЛОКАЦИЯ МЕНЯЕТСЯ ПОД МЫСЛЬ. Базар (манипуляцию ждут) → ночная кухня
//     (не ждут и не называют) → ПУСТОТА (механизм и цена) → коридор с
//     открытыми дверями (так выглядит оставленный выбор) → зал Лектория →
//     снова базар.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — поза `bok_*_govorit` плюс шаг СЛОЕМ `shag_bok_*`;
//      полная поза сбрасывает липсинк (tools/speech_lint.py);
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре
//      (tools/walk.py --check);
//    · фигура НЕ ПРИСЕДАЕТ: поза, роняющая рост больше чем на 8%, валит
//      прогон (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем: `confident` больше
//      не надевает цилиндр тайком (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s.
//      Движок берёт `scene.duration.max(actual)`: объявленное число сцену не
//      обрезает, а ДОБИВАЕТ застывшим кадром. После озвучки содержимое
//      сжимается, объявленное остаётся — и разница уезжает тишиной. Длину
//      задаёт содержимое; ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set bazaar from "../assets/sets/bazaar-obeschanij.svg"
import set kuhnya from "../assets/sets/kuhnya-noch.svg"
import set void from "../assets/sets/void-black.svg"
import set dveri from "../assets/sets/doors-empty.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: БАЗАР — ХУК, ПРИТЧА, ЧЕТЫРЕ ГОЛОСА ===================
scene "bazaar" (duration: 1s, set: bazaar) {
    transition static 0.2s

    //  Стоит МЕЖДУ РЯДАМИ: не за прилавком и не перед ним. Он не продавец и
    //  не покупатель — он показывает механику, в которой участвуют оба.
    place freeman at (0.30, 0.93) facing front on floor
    freeman scales 0.66
    camera wide

    freeman pose "calm"
    wait 0.3s

    // ── ХУК (VO-1): «Вы зашли за хлебом, а вышли с тремя пакетами.» ─────
    //  Подача БУДНИЧНАЯ: он не обвиняет, он напоминает очевидное. Обвинение
    //  придёт на двадцатой секунде, и до него зритель должен соглашаться.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.6s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "no"          // «три пакета» — развёл руками
        }
    }
    camera wide
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «Вам просто нажали кнопку.» ────────────────
    freeman pose "calm"
    freeman overlays "hips"
    //lip 2
    together {
        freeman speaks for 3.2s
        do {
            wait 1.8s
            freeman overlays "point"       // «кнопку» — ткнул в воздух
        }
    }
    wait 0.4s

    // ── ПРИТЧА-ОБМАНКА (VO-3): индюшка и хорёк ─────────────────────────
    //  РУЖЬЁ ЧЕХОВА. Подаётся ровно, как факт про птиц: ни взгляда в упор,
    //  ни указующего жеста. Любая подсветка здесь обесценит выстрел на
    //  двадцать пятой секунде.
    freeman pose "calm"
    freeman overlays "open"
    //lip 3
    together {
        freeman speaks for 5.4s
        do {
            wait 3.0s
            freeman overlays "think"       // отвёл взгляд: рассказывает
        }
    }
    wait 0.4s

    // ── ПУЛЕМЁТ (VO-4): четыре чужих голоса, НА ХОДУ вдоль рядов ───────
    //  Лавки проезжают мимо, как улики. Ветка `do{}` короче реплики: 3.0 с
    //  движения при 5.0 с речи — иначе `together` потянется по ней и
    //  персонаж будет молча доигрывать шаги.
    freeman pose "bok_pravo_govorit"
    //lip 4
    together {
        freeman speaks for 5.0s
        do {
            freeman moves-to (0.62, 0.93) over 3.0s
            freeman overlays "shag_bok_levoj"
            wait 0.75s
            freeman overlays "shag_bok_pravoj"
            wait 0.75s
            camera medium freeman
            freeman overlays "shag_bok_levoj"
            wait 0.75s
            freeman overlays "shag_bok_pravoj"
            wait 0.75s
        }
    }
    //  Остановка полной позой: слой шага снят, ноги приставлены.
    freeman pose "calm"
    camera wide
    //  Тишина на месте пятого голоса — его нет, и это слышно.
    wait 0.5s
}

// ============ СЦЕНА 2: НОЧНАЯ КУХНЯ — РАЗВОРОТ ==============================
//  СМЕНА МИРА НА ОДНОЙ ФРАЗЕ. Зритель двадцать секунд кивал про продавцов —
//  и оказался на своей кухне. Здесь кнопки нажимают чаще, чем на рынке, и
//  здесь это не называют манипуляцией.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.15s

    place freeman at (0.44, 0.94) facing front on floor
    freeman scales 0.68
    camera wide

    //  ВПЕРВЫЕ В УПОР. До этой секунды он ни разу не смотрел в камеру: пока
    //  разговор был про чужих, взгляд в упор был бы преждевременным.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 4.7s
        do {
            wait 2.6s
            camera medium freeman
            freeman overlays "ugryumo"     // «а тот, кто рядом» — лицо
                                           // жёстче. НЕ `stern`: та трогает
                                           // рот и перебила бы липсинк.
        }
    }
    camera wide
    wait 0.3s
}

// ================== СЦЕНА 3: ПУСТОТА — МЕХАНИЗМ И ЦЕНА ======================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Ни рынка, ни кухни: отговорок больше нет. Две
//  реплики подряд без смены плана — сначала механизм, потом цена. Склейка
//  между ними разбила бы мысль ровно там, где она собирается.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между кухней и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`. Пола нет, кадр держит МАСКА:
    //  посадка по ступням увела бы её в верхнюю четверть кадра. Точка
    //  задаётся по якорю и целится в центр, ноги уходят за нижнюю кромку.
    //  План ОБЩИЙ: на нём зум равен единице и маска встаёт куда посажена.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-6): «Никто ничего не взламывает.» ────────────
    //  БЕЗ ОСУЖДЕНИЯ. Здесь выстреливает притча: писк индюшонка оказывается
    //  своим. Если сыграть это обвинением, зритель начнёт защищаться вместо
    //  того, чтобы узнавать себя.
    //lip 6
    together {
        freeman speaks for 7.9s
        do {
            wait 4.6s
            freeman overlays "open"        // «нужны вам самим» — ладони
        }
    }
    wait 0.4s

    // ── ДНО (VO-7): «Сколько стоит сказать нет.» ───────────────────────
    //  ГЛАВНАЯ ФРАЗА РОЛИКА, и потому играется почти неподвижно: любой жест
    //  здесь отвлекает. Внутри реплики только `ugryumo` — накладка без рта;
    //  зрачки и `stern` трогают рот и перебили бы липсинк, поэтому вспышка
    //  вынесена ЗА реплику, в тишину после неё.
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 6.8s
        do {
            wait 4.0s
            freeman overlays "ugryumo"
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: КОРИДОР С ДВЕРЯМИ — ВЗЛЁТ ============================
scene "dveri" (duration: 1s, set: dveri) {
    transition static 0.2s

    //  ДВЕРИ ОТКРЫТЫ И НИКТО НЕ ТОЛКАЕТ. Так выглядит влияние, оставившее
    //  выбор: разница с предыдущей сценой не в словах, а в том, что здесь
    //  можно уйти в любую сторону и это ничего не стоит.
    place freeman at (0.48, 0.92) facing front on floor
    freeman scales 0.7
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: цена названа, сейчас скажут, что с ней
    //  делать. Реплика сразу после склейки читалась бы продолжением приговора.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): «Заметить цену — уже половина защиты.» ───────────
    freeman pose "calm"
    //lip 8
    together {
        freeman speaks for 5.0s
        do {
            wait 2.6s
            freeman overlays "confident"   // без цилиндра: см. tools/rekvizit.py
        }
    }
    wait 0.2s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-9): называет курс ──────────────────────────────
    //lip 9
    together {
        freeman speaks for 4.3s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "wave"        // «влияние и манипуляции»
            wait 1.5s
            freeman overlays "open"        // «бесплатно»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 6: СНОВА БАЗАР — ЖАЛО ===================================
scene "final" (duration: 1s, set: bazaar) {
    transition static 0.2s

    place freeman at (0.5, 0.93) facing front on floor
    freeman scales 0.66
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.2s

    // ── ЖАЛО (VO-10): «Скажите одно нет — без единого объяснения.» ─────
    //  ИЗМЕРИМЫЙ ЧЕЛЛЕНДЖ, а не мысль на прощание: у оригинала финал —
    //  «помолчать хотя бы недельку», проверяемое действие. Зритель уходит с
    //  заданием, которое можно провалить сегодня же вечером.
    //lip 10
    together {
        freeman speaks for 5.8s
        do {
            camera medium freeman
            wait 3.2s
            freeman overlays "shrug"       // «сколько раз захочется?»
        }
    }
    freeman overlays "hero_wink"
    wait 0.1s

    // ── УХОДИТ, РЯДЫ ОСТАЮТСЯ ──────────────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой.
    //  Базар остаётся работать — он никуда не денется, и это часть мысли.
    //  Молчаливый хвост держится под тремя секундами (tools/pauses.py).
    camera wide
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.93) over 0.6s
    freeman overlays "shag_bok_levoj"
    wait 0.35s
    freeman overlays "shag_bok_pravoj"
    wait 0.35s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы, и последний
    //  кадр застывал бы на разведённых ногах.
    freeman pose "bok_levo"
}

// ========================== СЦЕНА 7: ТИТРЫ ==================================
//  Печать бьёт и кадр гаснет. Титры — событие, а не тишина, и в хвост они не
//  засчитываются; но и растягивать их не на что.
scene "titry" (duration: 1.7s, set: titry) {
    transition static 0.15s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.35s
    transition fade-black 0.25s
}
