// =============================================================================
//  «ШТАНГА НЕ ВРЁТ» — интро к курсу «Психология спорта», номер 15.
//  VO — sport-VO.md, маркеры 1..24.
//
//  ОДНА МЫСЛЬ НА РОЛИК: в спорте человек растёт не потому, что там больше воли,
//  а потому, что обратная связь приходит сразу и честно.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ХУК НЕ ОБВИНЯЕТ, А ХВАЛИТ. Единственный ролик серии, начинающийся с
//     достижения зрителя, и это не любезность, а доказательство: если характер
//     есть в зале, объяснить провал в работе характером уже нельзя.
//
//  2. ПЕРВЫЙ РОЛИК ПО РАЗБОРУ ОРИГИНАЛА (STIL-FRIMENA.md). Из него взяты два
//     приёма, которых у нас не было ни разу за тридцать три ролика:
//       · МАНТРА — повтор внутри реплики: «не хвалит, не жалеет, не входит в
//         положение» (VO-7), три отрицания одним дыханием на переломе;
//       · САМОРЕФЕРЕНЦИЯ — ролик называет себя тем же не-решением, над которым
//         смеётся: «Смотреть ролик, где кричит нарисованный человек. Как этот»
//         (VO-18, VO-19).
//     И убраны четыре израсходованные рамки: «А теперь скажите», «Самый
//     популярный ответ», «И не говорите, что», «И вот что важно» — четыре
//     последних ролика были написаны ими как шаблоном.
//
//  3. ВЕЩЬ РОЛИКА — ШТАНГА. Ответ на перелом дают одним словом, и дальше у неё
//     отбирают мистику. Возвращается в жале как задание.
//
//  4. ЛОКАЦИЙ ШЕСТЬ, ОДНА НАРИСОВАНА СТУДИЕЙ: спортзал со штангой. Остальные
//     выбраны по смыслу: стол с ноутбуком — там, где говорят «нормально»;
//     кухня со счетами — там, где считают месяцы; дорога со столбами — там, где
//     закон выходит за пределы зала.
//
//  5. НОМЕР КУРСА 15, метка `nomer-15.svg` в ПЕРВОМ и ПОСЛЕДНЕМ кадре.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). Здесь такой один: `hero_wink` в финале;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · ВИЗЕМЫ ОТКРЫВАЮТ РОТ (tools/rot.py, реестр §XXVI);
//    · МАСШТАБ ФИГУРЫ сверяется с мерой локации (tools/masshtab.py, §XXVII),
//      и читается он вместе с `over` (§XXXI).
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`).
//  Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set zalsp from "../assets/sets/sport-shtanga.svg"
import set void from "../assets/sets/void-black.svg"
import set stol from "../assets/sets/stol-noutbuk.svg"
import set kuhnya from "../assets/sets/kuhnya-schet.svg"
import set doroga from "../assets/sets/doroga-stolby.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}


// ============ СЦЕНА 1: zalsp ============================================
//  Штанга стоит в кадре с первой секунды и молчит все пять реплик: слово ей
//  дадут только на переломе.
scene "s1" (duration: 1s, set: zalsp) {
    place freeman at (0.24, 0.82) facing front on floor
    freeman scales 0.90 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-15.svg") at (0.255, 0.585) layer 9
    nomer scales 0.16 over 0.01s
    nomer hides
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.177 over 0.05s ease-out
    nomer scales 0.16 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"
    wait 0.1s

    //lip 1
    //  «Вы три года не пропускаете тренировки.»
    together {
        freeman speaks for 2.56s
        do {
            freeman overlays "raskryl"
            wait 1.40s
            freeman overlays "prishchur"
        }
    }
    wait 0.4s

    //lip 2
    //  «В зале тяжелее. И вы туда ходите.»
    together {
        freeman speaks for 4.57s
        do {
            freeman overlays "lokti"
            wait 1.55s
            freeman overlays "doshlo"
        }
    }
    wait 0.5s

    //lip 3
    //  «Отчёт. Английский. Ремонт. Тот самый проект.»
    together {
        freeman speaks for 4.52s
        do {
            freeman overlays "rubit"
            wait 1.79s
            freeman overlays "rubit_l"
            wait 1.79s
            freeman overlays "vniz"
        }
    }
    wait 0.35s

    //lip 4
    //  «Четвёртый месяц на том же месте.»
    together {
        freeman speaks for 1.55s
        do {
            freeman overlays "yorik"
        }
    }
    wait 0.7s

    //lip 5
    //  «Один и тот же человек. Одна и та же воля.»
    together {
        freeman speaks for 3.39s
        do {
            camera medium freeman
            freeman overlays "razvel"
            wait 1.80s
            freeman overlays "somnenie"
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 2: void =============================================
//  Вопрос в лоб и «Ну?» без разбега — рамки перед ним нет намеренно
//  (STIL-FRIMENA §II.3).
scene "s2" (duration: 1s, set: void) {
    transition static 0.2s

    place freeman at (0.50, 0.46) facing front
    freeman scales 2.00 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 6
    //  «Кто в зале говорит вам правду? Ну?»
    together {
        freeman speaks for 2.51s
        do {
            freeman overlays "vozzvanie"
            wait 1.30s
            freeman overlays "vzglyad"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: zalsp ============================================
//  ПЕРЕЛОМ и МАНТРА: три отрицания одним дыханием, каждому свой слой.
scene "s3" (duration: 1s, set: zalsp) {
    transition static 0.2s

    place freeman at (0.24, 0.82) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 7
    //  «Штанга. Она не хвалит, не жалеет, не входит в положение.»
    together {
        freeman speaks for 5.20s
        do {
            freeman overlays "no"
            wait 1.09s
            freeman overlays "otverg"
            wait 1.09s
            freeman overlays "stop_ladon"
        }
    }
    wait 0.4s

    //lip 8
    //  «Просто не поднимается.»
    together {
        freeman speaks for 1.52s
        do {
            freeman overlays "ladoni_vniz"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 4: stol =============================================
//  Там, где говорят «нормально»: ноутбук и ни одного честного ответа.
scene "s4" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.26, 0.92) facing front on floor
    freeman scales 1.10 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 9
    //  «А на работе скажут «нормально» — и вы полгода думаете, что растёте.»
    together {
        freeman speaks for 6.35s
        do {
            freeman overlays "otmahnulsya"
            wait 1.66s
            freeman overlays "prishchur"
            wait 1.35s
            freeman overlays "ostyl"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 5: kuhnya ===========================================
//  Кухня со счетами: место, где считают месяцы и разговаривают сами с собой.
scene "s5" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.55, 0.90) facing front on floor
    freeman scales 0.95 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 10
    //  «Значит, я мало стараюсь, надо ещё поднажать.»
    together {
        freeman speaks for 3.06s
        do {
            freeman overlays "yarost_telom"
            wait 1.6s
            freeman overlays "za_golovu"
        }
    }
    wait 0.35s

    //lip 11
    //  «Так вы жмёте сильнее туда, где результата всё равно не видно.»
    together {
        freeman speaks for 3.85s
        do {
            freeman overlays "u_viska"
            wait 2.00s
            freeman overlays "gorech"
        }
    }
    wait 0.8s

    //lip 12
    //  «Сколько месяцев вы шли, не зная — вперёд или на месте?»
    together {
        freeman speaks for 5.17s
        do {
            camera medium freeman
            freeman overlays "dengi"
            wait 1.86s
            freeman overlays "vzves"
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 6: zalsp ============================================
//  Достоинство возвращают там же, где его доказали, и возвращают
//  ДОКАЗАТЕЛЬСТВОМ, а не утешением (STIL-FRIMENA §III.9).
scene "s6" (duration: 1s, set: zalsp) {
    transition static 0.2s

    place freeman at (0.24, 0.82) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 13
    //  «Характер у вас есть. Три года тренировок — доказательство.»
    together {
        freeman speaks for 3.89s
        do {
            freeman overlays "teplo"
            wait 2.04s
            freeman overlays "doshlo"
        }
    }
    wait 0.35s

    //lip 14
    //  «Не хватает не воли. Не хватает весов.»
    together {
        freeman speaks for 3.71s
        do {
            freeman overlays "razmer"
            wait 1.95s
            freeman overlays "klin"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 7: doroga ===========================================
//  Закон выходит за пределы зала — и кадр выходит на улицу.
scene "s7" (duration: 1s, set: doroga) {
    transition static 0.2s

    place freeman at (0.50, 0.80) facing front on floor
    freeman scales 1.10 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 15
    //  «Спорт здесь не тема, а лаборатория: в нём всё видно за неделю.»
    together {
        freeman speaks for 4.91s
        do {
            freeman overlays "dve_storony"
            wait 2.89s
            freeman overlays "chelo"
        }
    }
    wait 0.4s

    //lip 16
    //  «В работе то же самое, только правда опаздывает на полгода.»
    together {
        freeman speaks for 4.57s
        do {
            freeman overlays "vdal"
            wait 2.74s
            freeman overlays "ugryumo"
        }
    }
    wait 0.9s

    //lip 17
    //  «Смысл не в том, чтобы нарастить мясо, а в том, чтобы завести весы там,
    //  где вам врут.»
    together {
        freeman speaks for 5.36s
        do {
            freeman overlays "raspahnul"
            wait 1.71s
            freeman overlays "oba_vverh"
            wait 1.42s
            freeman overlays "vzglyad"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 8: zalsp ============================================
//  ШУТКА и САМОРЕФЕРЕНЦИЯ: ролик записывает себя в то же не-решение, над
//  которым смеётся, и поэтому смех не сверху вниз.
scene "s8" (duration: 1s, set: zalsp) {
    transition static 0.2s

    place freeman at (0.24, 0.82) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 18
    //  «Обычно тут идут за мотивацией. Смотреть ролик, где кричит нарисованный
    //  человек.»
    together {
        freeman speaks for 6.47s
        do {
            freeman overlays "krik"
            wait 2.9s
            freeman overlays "shrug"
            wait 1.9s
            freeman overlays "prishchur"
        }
    }
    wait 0.35s

    //lip 19
    //  «Как этот. Работает ровно до вторника.»
    together {
        freeman speaks for 3.05s
        do {
            freeman overlays "gladit_grud"
            wait 1.95s
            freeman overlays "ugryumo"
        }
    }
    wait 1.0s
}

// ============ СЦЕНА 9: zal ==============================================
//  Служебная часть говорится в другом пространстве.
scene "s9" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 20
    //  «Курс называется «Психология спорта».»
    together {
        freeman speaks for 2.31s
        do {
            freeman overlays "vozzvanie"
        }
    }
    wait 0.4s

    //lip 21
    //  «Десять лекций, и всё бесплатно.»
    together {
        freeman speaks for 2.17s
        do {
            camera medium freeman
            freeman overlays "palec_vverh"
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 10: zalsp ===========================================
//  ЖАЛО и ПОДПИСЬ. Кольцо: последний кадр тождествен первому.
scene "s10" (duration: 1s, set: zalsp) {
    transition static 0.2s

    place freeman at (0.24, 0.82) facing front on floor
    freeman scales 0.90 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-15.svg") at (0.255, 0.585) layer 9
    nomer2 scales 0.16 over 0.01s
    nomer2 hides
    camera wide
    freeman pose "calm"

    //lip 22
    //  «Сегодня возьмите одно дело и решите, что будет в нём вашей штангой.»
    together {
        freeman speaks for 7.39s
        do {
            freeman overlays "manit"
            wait 2.60s
            freeman overlays "vdal_l"
            wait 1.80s
            freeman overlays "chelo"
        }
    }
    wait 0.5s

    //lip 23
    //  «И кто скажет вам правду в пятницу?»
    together {
        freeman speaks for 2.08s
        do {
            camera medium freeman
            freeman overlays "v_upor"
        }
    }
    camera wide
    wait 1.1s

    //  ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ, И ТА ЖЕ МЕТКА.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.02 over 0.01s
    nomer2 scales 0.177 over 0.05s ease-out
    nomer2 scales 0.16 over 0.02s

    //lip 24
    //  «Всё, идём дальше. Лекторий Мейстера, курс лекций. Поехали!»
    together {
        freeman speaks for 4.88s
        do {
            freeman overlays "gladit_grud_niz"
            wait 1.84s
            freeman overlays "wave"
        }
    }
    nomer2 hides
    freeman overlays "hero_wink"
}
