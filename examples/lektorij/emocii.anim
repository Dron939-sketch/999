// =============================================================================
//  «ГДЕ ОГОНЬ» — интро к курсу «Эмоциональный интеллект».
//  VO — emocii-VO.md, //lip 1..11.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. ОБМАНКА ВЕДЁТ ОТ СОВЕТА К ТОЧКЕ. Двадцать секунд зритель слышит ровно то,
//     что слышал всегда: успокойся, дыши, считай до десяти. Он согласен — это и
//     есть «работа с эмоциями». Разворот сообщает, что все пять советов про
//     ОДНУ точку, и она последняя. Тема, в которой зритель считал себя слабым,
//     оказывается темой, в которой он просто опоздал.
//
//  2. ЧАЙНИК ДЕРЖИТ ВЕСЬ РОЛИК И НЕ ТРЕБУЕТ НИ ОДНОГО ТЕРМИНА. Свисток —
//     выражение эмоции, с ним все и борются. Вода — само переживание: заткнули
//     свисток, вода кипит по-прежнему. Огонь — то, что эмоцию вызывает. Снять с
//     огня — ранняя точка, которая стоит секунды. Всё это видно в первом же
//     кадре, до единого слова.
//
//  3. ПЯТЬ ТОЧЕК ГРОССА БЕЗ ИМЁН. Вместо «выбор ситуации, изменение ситуации,
//     развёртывание внимания, когнитивная переоценка, подавление» — «Куда
//     пойти. Что изменить. Куда смотреть. Как назвать. И только последнее —
//     держать лицо». Порядок сохранён точно: он и есть содержание, и подавление
//     стоит последним потому, что оно самое дорогое.
//
//  4. КРАСНОЕ — ЭТО ОГОНЬ, И БОЛЬШЕ НИЧЕГО. Насыщенный пиксель переживает
//     монохромный проход движка, и в этом ролике цветное пятно ровно одно:
//     пламя конфорки. В ванной огня не видно — там кадр строго ч/б. В финале
//     конфорка погашена, и в ролике НЕ ОСТАЁТСЯ НИ ОДНОГО цветного пикселя:
//     финал сказан цветом, а не словом.
//
//  5. ТЕМП ИДЁТ ПО БИТАМ: хук 1.42, пулемёт 1.59, сразу за ним разворот 1.25,
//     дно 1.25. Перепад в четверть скорости стоит ровно на склейке «ванная →
//     пустота», где меняется мир.
//
//  ЛОКАЦИИ: ДВЕ ИЗ ТРЁХ НА МЕСТЕ. Кухня с чайником пришла от студии, карта пола
//  снята по картинке (0.56). Финальная кухня СДЕЛАНА ИЗ НЕЁ ЖЕ: те же пиксели,
//  погашено пламя и убран пар — так кольцо получается точным, чего от повторной
//  генерации не добьёшься. ВАННАЯ ПОКА ЗАГЛУШКА: в присланной картинке стоит
//  человек, а второй человек в кадре Фримену не нужен; промт на перегенерацию —
//  в emocii-VO.md.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set kuhnya from "../assets/sets/kuhnya-chajnik.svg"
import set vannaya from "../assets/sets/vannaya-zerkalo.svg"
import set void from "../assets/sets/void-black.svg"
import set tiho from "../assets/sets/kuhnya-chajnik-tiho.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: КУХНЯ С ЧАЙНИКОМ — ХУК, ДОБИВКА, ОБРАЗ ===============
//  ЧАЙНИК УЖЕ СВИСТИТ, КОГДА РОЛИК НАЧИНАЕТСЯ. Первая секунда без слов: свист
//  и пар. Зритель узнаёт звук раньше, чем тему, — и это единственный способ,
//  которым Фримен входит: бытовой деталью, а не заявлением.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    //  Стоит СПРАВА ОТ ПЛИТЫ, не у неё: он пока рассказывает про чайник, а не
    //  берётся за него. К плите подойдёт только на взлёте.
    place freeman at (0.62, 0.92) facing front on floor
    freeman scales 0.88

    //  НОМЕР КУРСА НА БАЛАХОНЕ, справа на груди. Ролик уходит в ленту, где
    //  «смотреть или листать» решается за две секунды — меньше, чем длится
    //  первая реплика. Зацепить в них можно только картинкой, и номер работает
    //  сразу на два: держит взгляд и говорит «это серия».
    //
    //  Пропом, а не частью рига: часть рига поехала бы за костями и на профиле
    //  ползла бы по ткани. Номер нужен там, где он работает, — на статичном
    //  общем плане в первые секунды; как только персонаж пойдёт, он уезжает.
    //  Белым, а не чёрным: балахон — сплошное чёрное пятно.
    let nomer = prop("nomer", "../assets/props/nomer-06.svg") at (0.645, 0.70) layer 9
    nomer scales 0.30
    camera wide

    freeman pose "calm"
    wait 0.4s

    // ── ХУК (VO-1): «Вы досчитали до десяти. И всё равно сорвались.» ───
    //  БЕЗ СОЧУВСТВИЯ. Жалость здесь читалась бы как «ну ничего, бывает», а
    //  ролик утверждает обратное: дело не в вас, дело в точке.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.6s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "shrug"       // «и всё равно сорвались» — плечами
        }
    }
    camera wide
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «Вы вмешались слишком поздно.» ────────────
    freeman pose "calm"
    freeman overlays "hips"
    //lip 2
    together {
        freeman speaks for 3.2s
        do {
            wait 1.8s
            freeman overlays "k_sebe"      // «дело не в выдержке» — про зрителя
        }
    }
    wait 0.4s

    // ── ОБРАЗ (VO-3): «Эмоция — как чайник на плите.» ─────────────────
    //  ПОКАЗЫВАЕТ, А НЕ ОБЪЯСНЯЕТ. Метафора подаётся как бытовая очевидность:
    //  подчеркнёшь голосом или жестом — станет нравоучением, и выстрел на
    //  подъёме пропадёт.
    //  Номер отработал первые восемь секунд и уезжает: дальше он мешал бы
    //  жестам и ездил бы по ткани на каждом движении.
    nomer moves-to (-1.5, 1.5) over 0.01s
    freeman pose "calm"
    //lip 3
    together {
        freeman speaks for 5.4s
        do {
            wait 1.6s
            freeman overlays "point"       // «чайник на плите» — показал на него
            wait 2.0s
            freeman overlays "otmahnulsya" // «свисток можно заткнуть» — отмашка
        }
    }
    wait 0.4s
}

// ============ СЦЕНА 2: ВАННАЯ — ПУЛЕМЁТ И РАЗВОРОТ ==========================
//  МЕСТО, ГДЕ ДЕРЖАТ ЛИЦО. Пять советов звучат ровно там, где человек
//  репетирует спокойствие перед зеркалом. Огня здесь не видно — и в этом смысл
//  сцены: он всё равно горит, просто в другой комнате.
scene "vannaya" (duration: 1s, set: vannaya) {
    transition static 0.2s

    place freeman at (0.5, 0.78) facing front on floor
    freeman scales 0.50
    camera wide

    // ── ПУЛЕМЁТ (VO-4): пять советов, ИДЁТ НА КАМЕРУ ──────────────────
    //  СОВЕТЫ НЕ ОТДАЛЯЮТ, ОНИ ПОДСТУПАЮТ — поэтому движение на зрителя, а не
    //  вбок, и заканчивается проход у зеркала. Шаг фронтальный, обе накладки
    //  без рта: липсинк не перебивается.
    //
    //  Шаг и движение ОДНОВРЕМЕННО: `moves-to ... over` и `scales ... over`
    //  занимают время как `wait`, поэтому накладка ставится ПЕРЕД своим
    //  отрезком. 4×1.2 = 4.8 с при 5.8 с реплики.
    freeman pose "calm"
    //lip 4
    together {
        freeman speaks for 5.8s
        do {
            freeman overlays "shag_levoj"
            freeman moves-to (0.5, 0.86) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.62 over 1.2s
            freeman overlays "shag_levoj"
            freeman moves-to (0.5, 0.95) over 1.2s
            freeman overlays "shag_pravoj"
            freeman scales 0.80 over 1.2s
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты. Поза смысловая — `ruki_v_boki`
    //  здесь была бы вызовом, а он пока ещё пробует советы на себе.
    freeman pose "calm"
    //  Тишина на месте шестого совета — его нет, и это слышно.
    wait 0.5s

    // ── РАЗВОРОТ (VO-5): «Все пять советов — про одно.» ───────────────
    //  ВПЕРВЫЕ В УПОР. До этой секунды он ни разу не смотрел в камеру: пока шли
    //  чужие советы, взгляд в упор был бы преждевременным.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 4.3s
        do {
            wait 2.6s
            camera medium freeman
            freeman overlays "ugryumo"     // «где уже поздно» — лицо жёстче.
                                           // НЕ `stern`: та трогает рот.
        }
    }
    camera wide
    wait 0.3s
}

// ================== СЦЕНА 3: ПУСТОТА — МЕХАНИЗМ И ОЦЕНКА ====================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Ни кухни, ни ванной: механизм называется там, где
//  нечем отвлечься. Две реплики подряд без смены плана — сначала что делает
//  подавление, потом что такое эмоция.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между ванной и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-6): «Подавление не выключает эмоцию.» ───────
    //  БЕЗ ОБВИНЕНИЯ. Здесь выстреливает чайник: заткнутый свисток оказывается
    //  своим. Если сыграть это упрёком, зритель начнёт защищаться вместо того,
    //  чтобы узнавать себя.
    //lip 6
    together {
        freeman speaks for 6.5s
        do {
            wait 2.8s
            freeman overlays "think"       // «оно её прячет» — отвёл взгляд
            wait 2.4s
            freeman overlays "v_upor"      // «собеседник всё видит» — в упор
        }
    }
    wait 0.4s

    // ── ДНО (VO-7): «Эмоция — не помеха. Это оценка.» ─────────────────
    //  ГЛАВНАЯ ФРАЗА РОЛИКА, и потому играется почти неподвижно: любой жест
    //  здесь отвлекает. Вспышка вынесена ЗА реплику, в тишину после неё.
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 4.3s
        do {
            wait 2.6s
            freeman overlays "ugryumo"
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: СНОВА КУХНЯ — ВЗЛЁТ И ПОДЪЁМ =========================
scene "vozvrat" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    //  ТЕПЕРЬ ОН У ПЛИТЫ. Пять точек называются в том самом месте, где их видно
    //  руками: огонь всё ещё горит, чайник всё ещё свистит.
    place freeman at (0.40, 0.93) facing front on floor
    freeman scales 0.90
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: оценка названа, сейчас скажут, что с ней
    //  делать. Реплика сразу после склейки читалась бы продолжением приговора.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): «Вмешаться можно в пяти точках.» ────────────────
    //  ПЯТЬ ТОЧЕК — СПИСОК ДЕЛ, А НЕ ОТКРОВЕНИЕ. Перечисление идёт ровно, и на
    //  последней («держать лицо») жест меняется на отмашку: это та самая
    //  точка, с которой все начинают и которая стоит дороже всех.
    freeman pose "calm"
    //lip 8
    together {
        freeman speaks for 6.8s
        do {
            wait 1.8s
            freeman overlays "open"        // «куда пойти» — ладони
            wait 1.6s
            freeman overlays "vdal"        // «куда смотреть» — рука вдаль
            wait 1.7s
            freeman overlays "otmahnulsya" // «держать лицо» — отмашка
        }
    }
    wait 0.4s

    // ── ПОДЪЁМ (VO-9): «Снять чайник с огня стоит секунды.» ───────────
    //  ЦЕНА ВМЕСТО МОРАЛИ. Ролик не уговаривает быть лучше — он считает:
    //  секунды против вечера. Арифметике нечего возразить, а морали есть.
    freeman pose "calm"
    //lip 9
    together {
        freeman speaks for 5.8s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "point"       // «снять с огня» — показал на плиту
            wait 2.0s
            freeman overlays "k_sebe"      // «стоит вечера» — про зрителя
        }
    }
    camera wide
    wait 0.2s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-10): называет курс ────────────────────────────
    //lip 10
    together {
        freeman speaks for 4.0s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "wave"        // «эмоциональный интеллект»
            wait 1.4s
            freeman overlays "open"        // «бесплатно»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 6: КУХНЯ, ОГОНЬ ПОГАШЕН — ЖАЛО ==========================
//  ТОТ ЖЕ КАДР, ЧТО И В НАЧАЛЕ, НО КОНФОРКА НЕ ГОРИТ И ПАРА НЕТ. Кольцо
//  замыкается не фразой, а состоянием мира: единственное цветное пятно ролика
//  ГАСНЕТ, и последние секунды идут без единого цветного пикселя. Зритель не
//  обязан это осознавать — он это увидит.
scene "final" (duration: 1s, set: tiho) {
    transition static 0.2s

    place freeman at (0.40, 0.93) facing front on floor
    freeman scales 0.90
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-11): «Спросите: где огонь?» ──────────────────────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: у зрителя есть один вопрос,
    //  который можно задать себе сегодня же вечером, как только засвистит.
    //lip 11
    together {
        freeman speaks for 4.3s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "ruka_vverh"  // «где огонь?» — рука вверх
        }
    }
    freeman overlays "hero_wink"
    wait 0.1s

    // ── УХОДИТ, ЧАЙНИК ОСТАЁТСЯ СНЯТЫМ ────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой.
    //  Хвост держится под тремя секундами (tools/pauses.py): гейт считает
    //  молчание после последнего слова, и три секунды там уже дыра.
    camera wide
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.93) over 0.5s
    freeman overlays "shag_bok_levoj"
    wait 0.25s
    freeman overlays "shag_bok_pravoj"
    wait 0.25s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы.
    freeman pose "bok_levo"
}

// ========================== СЦЕНА 7: ТИТРЫ ==================================
scene "titry" (duration: 1.7s, set: titry) {
    transition static 0.15s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.35s
    transition fade-black 0.25s
}
