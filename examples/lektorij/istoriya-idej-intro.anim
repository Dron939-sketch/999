// =============================================================================
//  «ИСТОРИЯ ИДЕЙ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/istoriya-idej — 10 лекций, ~4 часа).
//
//  ПЕРЕСНЯТО ЦЕЛИКОМ. Первая версия была шаблоном «Теорий личности»: та же
//  единственная локация, тот же порядок поз (ugryumo → doubt → smug → open →
//  calm → smug → no → v_upor → point → flash_pupils → hero_skeptic → puppet,
//  совпадение подряд), тот же приём второго плана. Из 124 поз рига брались
//  те же 23. Это не режиссура, а заполнение бланка, и на экране это видно.
//
//  ЗАМЫСЕЛ: ОН ИДЁТ СКВОЗЬ ЭПОХИ, А НЕ СТОИТ В ПОЛЕ. Тема курса — идеи
//  путешествуют через века и достаются нам подержанными. Значит мир за спиной
//  ОБЯЗАН меняться под голос, иначе ролик говорит одно, а показывает другое:
//
//    void          пустота до всего            приветствие
//    field-pismena земля исписана чужим        хук: «думаете, что думаете сами»
//    doors-empty   дверь, в которую вошли      пулемёт: у каждой идеи своя дата
//    wasteland     руины прожитых эпох         «каждая мысль старше вас»
//    field-emblem  знак на земле = наследство  разворот, взлёт, жало
//
//  Персонаж один и тот же, мир меняется — мысль ролика показана, а не сказана.
//  Требование `HOLLYWOOD.md` §7 «≥3 разных поля за ролик» выполнено впервые:
//  прошлая версия давала одно.
//
//  ТРОСТЬ ПОЯВЛЯЕТСЯ ПО ДЕЛУ. В прошлой версии в кадр вползал припаркованный
//  за кадром проп `hand` — при наезде камеры точка (-1.5, 1.5) перестаёт быть
//  за кадром, и он читался как обломок неизвестно чего. Теперь пропы прячутся
//  `hides`, а трость приходит честно: поза `confident` даёт её в руку ровно на
//  слове «наследство» — атрибут наследника, единственное её появление.
//
//    · персонаж — канон (SIMILARITY.md);
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, флэш-морды НА СВЕРХКРУПЕ
//      (§2), наезд камеры на переломе (§4), второй план играет ту же мысль (§4a);
//    · сценарий (SCRIPT-FREEMAN.md) — istoriya-idej-intro-VO.md, //lip 1..9.
//
//  ДЛИНА — 54.0с при потолке приёмщика 60с. `duration` у сцены это ПОЛ, а не
//  потолок: движок досыпает тишину до объявленного значения, и завышенное
//  число даёт не паузу, а замершую фигуру в хвосте сцены. Числа подогнаны под
//  фактический контент — так ушли 3.8 лишних секунды, ни одной паузы не тронув.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
// ВТОРАЯ ФИГУРА — ПРЕДШЕСТВЕННИК. Тот же риг, отдельная сущность: на взлёте
// он встаёт позади и мельче — тот, кто владел этой мыслью до тебя. Движок это
// умеет (проверено рендером), и это сильнее висящих дат.
import character predok from "../assets/characters/freeman_rig"
import set pustota from "../assets/sets/void.svg"
import set pismena from "../assets/sets/field-pismena.svg"
import set dveri from "../assets/sets/doors-empty.svg"
import set ruiny from "../assets/sets/wasteland.svg"
import set znak from "../assets/sets/field-emblem.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ═══════════════ СЦЕНА 1: ПУСТОТА — до всякой мысли ═══════════════════════
scene "pustota" (duration: 5.4s, set: pustota) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "ugryumo"
    wait 0.7s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.3s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) — сквозное для всех подводок ────────
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.2s
        do {
            wait 1.1s
            camera close-up freeman
            wait 1.0s
            freeman pose "open"          // «дорогие мои» — раскрыл руки
            camera medium freeman
            wait 0.6s
        }
    }
    wait 0.2s
}

// ═══════════════ СЦЕНА 2: ЗЕМЛЯ ИСПИСАНА — он стоит на чужих словах ═══════
// `duration` — ПОЛ, а не потолок: движок досыпает тишину до объявленного
// значения. Числа подогнаны под фактический контент (6.42/3.93/6.17), иначе
// сцена доигрывает с замершей фигурой — это и были лишние 3.5с.
scene "pismena" (duration: 6.5s, set: pismena) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ХУК (VO-2). Ирония реплики отыграна позой: он МЫСЛИТЕЛЬ — ровно та поза,
    // которую зритель считает признаком собственной мысли.
    camera wide
    freeman pose "myslitel"
    wait 0.4s
    //lip 2
    together {
        freeman speaks for 2.4s
        do {
            camera angle high freeman
            camera zoom-to freeman over 1.2s ease-in
            freeman overlays "no"
            camera medium freeman
            wait 0.4s
        }
    }
    wait 0.3s

    // ХУК-добивка (VO-3): «получили подержанными» — пожал плечами, потом в упор.
    freeman moves-to (0.37, 0.585) over 0.01s
    freeman pose "shrug"
    //lip 3
    together {
        freeman speaks for 2.8s
        do {
            camera medium freeman
            wait 1.2s
            freeman pose "v_upor"
            camera close-up freeman
            wait 0.7s
            camera extreme-close-up freeman
            wait 0.5s
        }
    }
    // ФЛЭШ-МОРДА НА СВЕРХКРУПЕ (HOLLYWOOD.md §2): кадр уже сверхкрупный.
    freeman overlays "flash_pupils"
    wait 0.08s
    freeman overlays "hero_skeptic"
    wait 0.2s
}

// ═══════════════ СЦЕНА 3: ДВЕРЬ — в неё когда-то вошли ════════════════════
scene "dveri" (duration: 4s, set: dveri) {
    transition static 0.22s

    place freeman at (0.62, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ПУЛЕМЁТ 1 (VO-4): три приговора, у каждого своя дата. Дверь за спиной —
    // та самая, в которую эта идея вошла в мир. Ритм рваный и ускоряющийся.
    camera medium freeman
    freeman pose "gab"                   // тараторит чужое
    wait 0.3s
    //lip 4
    together {
        freeman speaks for 3.2s
        do {
            wait 1.0s
            freeman pose "bow"           // кланяется каждой дате
            camera close-up freeman
            wait 0.9s
            freeman pose "facepalm"      // «Ты уникален» — позавчера
            camera medium freeman
            wait 0.6s
            camera extreme-close-up freeman
            wait 0.3s
        }
    }
    wait 0.2s
}

// ═══════════════ СЦЕНА 4: РУИНЫ — что осталось от эпох ════════════════════
scene "ruiny" (duration: 6.3s, set: ruiny) {
    transition static 0.22s

    place freeman at (0.44, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ПУЛЕМЁТ 2 (VO-5): «каждая мысль старше вас» — сутулится под её весом.
    camera wide
    freeman pose "hunch"
    wait 0.3s
    //lip 5
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 0.9s
            freeman pose "weary"
            camera close-up freeman
            wait 0.7s
        }
    }
    // ПУЛЕМЁТ финал (VO-6): «жуёте чужую жвачку» — отвращение, тряска.
    freeman moves-to (0.56, 0.585) over 0.01s
    freeman pose "otvraschenie"
    //lip 6
    together {
        freeman speaks for 2.8s
        do {
            camera close-up freeman
            wait 1.1s
            freeman overlays "za_golovu"
            camera medium freeman
            wait 0.8s
            camera extreme-close-up freeman
            wait 0.5s
        }
    }
    camera shake 0.35s intensity 2
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 0.2s
}

// ═══════════════ СЦЕНА 5: ЗНАК НА ЗЕМЛЕ — наследство ══════════════════════
scene "znak" (duration: 24s, set: znak) {
    transition static 0.22s

    place predok at (0.26, 0.545) facing front
    predok scales 0.50 over 0.01s
    predok pose "bow"
    predok hides

    place freeman at (0.46, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let slovo = text("ЧЬЯ?", 170) at (0.5, -2.0) layer 6
    slovo scales 2.6 over 0.01s

    // ── t≈24 ПЕРЕЛОМ: РАЗВОРОТ (VO-7) ────────────────────────────────────
    // «Вы не думаете. Вы цитируете.» — он ДЕКЛАМИРУЕТ: поклон, как чтец чужого
    // текста. Вопрос «а кого — не помните» не режется катом, а НАЕЗЖАЕТ.
    camera angle low freeman
    freeman pose "bow"
    //lip 7
    together {
        freeman speaks for 5.4s
        do {
            wait 1.3s
            freeman pose "gab"
            camera extreme-close-up freeman
            wait 0.9s
            camera close-up freeman
            wait 0.5s
            freeman pose "v_upor"
            camera zoom-to freeman over 1.8s ease-in
            camera close-up freeman
            wait 0.6s
        }
    }
    camera shake 0.3s intensity 2
    wait 0.3s

    // ── ВЗЛЁТ (VO-8): наследство, и оно не одно ──────────────────────────
    // ТРОСТЬ ПРИХОДИТ ЗДЕСЬ И ТОЛЬКО ЗДЕСЬ: поза `confident` даёт её в руку на
    // слове «наследство» — атрибут наследника, а не случайный обломок.
    freeman moves-to (0.52, 0.585) over 0.01s
    freeman pose "confident"
    camera medium freeman
    //lip 8
    together {
        freeman speaks for 7.8s
        do {
            wait 1.4s
            // «Два́дцать пя́ть веко́в его́ копи́ли» — ПРЕДШЕСТВЕННИК ВСТАЁТ
            // ПОЗАДИ. Второй план здесь не надпись, а вторая фигура: тот, кто
            // владел этой мыслью до тебя. Мельче и дальше — он уже история.
            predok shows
            camera wide
            wait 1.1s
            freeman pose "raskryl"
            predok pose "wave"           // передал и уходит
            wait 1.1s
            camera close-up freeman
            wait 0.9s
            predok hides
            camera extreme-close-up freeman
            wait 1.0s
            camera wide
        }
    }
    // ── СЛОВО-УДАР «ЧЬЯ?» + негатив-панч ─────────────────────────────────
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.5s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    camera extreme-close-up freeman
    freeman overlays "flash_grin"
    wait 0.08s

    // ── ЖАЛО-CTA (VO-9) ──────────────────────────────────────────────────
    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 10.2s
        do {
            camera medium freeman
            wait 2.0s
            freeman pose "point"
            camera close-up freeman
            wait 2.0s
            freeman pose "confident"     // трость возвращается на счёт курса
            camera wide
            wait 2.0s
            freeman pose "hips"
            camera medium freeman
            wait 2.0s
            freeman pose "v_upor"
            camera close-up freeman
            wait 1.2s
        }
    }
    // ПОДМИГ — ПУАНТ, И ОН НА СВЕРХКРУПЕ.
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.3s
}

// ═══════════════ СЦЕНА 6: ТИТРЫ ═══════════════════════════════════════════
scene "titry" (duration: 4.5s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.9s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 1.2s
    transition fade-black 0.7s
}
