// =============================================================================
//  «ИСТОРИЯ ИДЕЙ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/istoriya-idej — 10 лекций, ~4 часа).
//
//  ПЕРЕСНЯТО ЦЕЛИКОМ, ДВАЖДЫ. Первая версия была шаблоном «Теорий личности»:
//  та же единственная локация, тот же порядок поз, тот же приём второго плана.
//  Вторая развела сцены по разным полям — но полями из общего склада, снятыми
//  под другие ролики: «горизонт плюс пустая серая плита на весь верх кадра».
//  Замер каждой локации отдельным кадром это и показал: верхняя половина кадра
//  мертва весь ролик, а в `doors-empty` чёрная фигура тонула в чёрном полотне
//  двери. Отсюда и претензия студии, что видеоряд писал ребёнок.
//
//  ТЕПЕРЬ ЛОКАЦИИ СНЯТЫ ПОД ЭТОТ СЦЕНАРИЙ. Шесть штук, каждая доказывает свою
//  реплику деталью, а не подписью:
//
//    void          пустота до всякой мысли      приветствие
//    idej-lavka    барахолка ПОДЕРЖАННЫХ голов  хук: «думаете, что думаете сами»
//    idej-zapasnik запасник: головы по полкам,  пулемёт: у каждой идеи свой
//                  на каждой инвентарный ярлык  номер и год
//    idej-raskop   раскоп: чем глубже слой, тем «каждая мысль старше вас» —
//                  древнее вещь в нём           доказано геометрией, не словом
//    idej-zal      пустой зал, кафедра, книги   разворот: «вы цитируете» —
//                                               и некому
//    idej-stena    недостроенная стена из сотен взлёт и жало: наследство;
//                  РАЗНЫХ камней, верх открыт   «каждый добавил своё» — буквально
//
//  Ремесло: картинки сгенерированы по промтам под канон `LOCATION_STYLE.md`,
//  уплощены до нескольких тонов и обведены художником (`tools/vectorize.py`,
//  VTracer). ВЕКТОР, А НЕ ВСТАВЛЕННЫЙ РАСТР: камера в ролике наезжает до 2.01×,
//  и на сверхкрупном плане растровая стена рассыпается в кашу — сверено двумя
//  прогонами одного кадра. Из «стены» убрана посторонняя фигурка: место у
//  подножия занимает наш персонаж.
//
//  ТРОСТЬ ПОЯВЛЯЕТСЯ ПО ДЕЛУ. Раньше в кадр вползал припаркованный за кадром
//  проп `hand` — при наезде точка (-1.5, 1.5) перестаёт быть за кадром, и он
//  читался как обломок неизвестно чего. Теперь пропы прячутся `hides`, а трость
//  приходит честно: поза `confident` даёт её в руку ровно на слове
//  «наследство» — атрибут наследника, единственное её появление.
//
//  МИМИКА — ТОЛЬКО СЛОЕМ. `gab`, `weary` и прочие лицевые позы задают лишь
//  лицевые кости; поставленные как `pose`, они сбрасывают остальное тело в
//  дефолт и гасят жест. Пишем `overlays` (PRAVILA-DVIZHENIYA.md §5).
//
//    · персонаж — канон (SIMILARITY.md);
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, флэш-морды НА СВЕРХКРУПЕ
//      (§2), наезд камеры на переломе (§4), второй план играет ту же мысль
//      (§4a), ≥3 разных поля за ролик (§7 — здесь шесть);
//    · сценарий (SCRIPT-FREEMAN.md) — istoriya-idej-intro-VO.md, //lip 1..9.
//
//  ДЛИНА при потолке приёмщика 60с. `duration` у сцены — ПОЛ, а не потолок:
//  движок досыпает тишину до объявленного значения, и завышенное число даёт не
//  паузу, а замершую фигуру в хвосте сцены. Числа подогнаны под фактический
//  контент — так ушли 3.8 лишних секунды, ни одной паузы не тронув.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
// ВТОРАЯ ФИГУРА — ПРЕДШЕСТВЕННИК. Тот же риг, отдельная сущность: на взлёте
// он встаёт у стены позади и мельче — тот, кто клал камень до тебя.
import character predok from "../assets/characters/freeman_rig"
import set pustota from "../assets/sets/void.svg"
import set lavka from "../assets/sets/idej-lavka.svg"
import set zapasnik from "../assets/sets/idej-zapasnik.svg"
import set raskop from "../assets/sets/idej-raskop.svg"
import set zal from "../assets/sets/idej-zal.svg"
import set stena from "../assets/sets/idej-stena.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    // 1.9, а не 2.2: новые локации несут настоящую графику — полки, слои,
    // кладку. На 2.2 тонкая линия схлопывалась в шум за головой на крупных
    // планах. Контраст всё ещё «плоская тушь», но рисунок под ним виден.
    mono-contrast: 1.9
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ═══════════════ СЦЕНА 1: ПУСТОТА — до всякой мысли ═══════════════════════
scene "pustota" (duration: 5.4s, set: pustota) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "ugryumo"
    wait 0.7s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.3s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) — сквозное для всех подводок ────────
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 3.2s
        do {
            wait 1.1s
            camera close-up freeman
            wait 1.0s
            freeman pose "open"          // «дорогие мои» — раскрыл руки
            camera medium freeman
            wait 0.6s
        }
    }
    wait 0.2s
}

// ═══════════════ СЦЕНА 2: БАРАХОЛКА — мысли с рук ═════════════════════════
//  Сквозное слово ролика — «подержанное». Локация берёт его буквально: столы
//  чужих голов, масок и очков, на каждой болтается ценник, над головой верёвка
//  с тем же товаром. Он тут покупатель, и выбирать не из чего.
scene "lavka" (duration: 6.5s, set: lavka) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ХУК (VO-2). Ирония реплики отыграна позой: он МЫСЛИТЕЛЬ — ровно та поза,
    // которую зритель считает признаком собственной мысли. А стоит он среди
    // прилавка с чужими головами.
    camera wide
    freeman pose "myslitel"
    wait 0.4s
    //lip 2
    together {
        freeman speaks for 2.4s
        do {
            camera angle high freeman
            camera zoom-to freeman over 1.2s ease-in
            freeman overlays "no"
            camera medium freeman
            wait 0.4s
        }
    }
    wait 0.3s

    // ХУК-добивка (VO-3): «получили подержанными» — пожал плечами, потом в упор.
    freeman moves-to (0.37, 0.585) over 0.01s
    freeman pose "shrug"
    //lip 3
    together {
        freeman speaks for 2.8s
        do {
            camera medium freeman
            wait 1.2s
            freeman pose "v_upor"
            camera close-up freeman
            wait 0.7s
            camera extreme-close-up freeman
            wait 0.5s
        }
    }
    // ФЛЭШ-МОРДА НА СВЕРХКРУПЕ (HOLLYWOOD.md §2): кадр уже сверхкрупный.
    freeman overlays "flash_pupils"
    wait 0.08s
    freeman overlays "hero_skeptic"
    wait 0.2s
}

// ═══════════════ СЦЕНА 3: ЗАПАСНИК — у каждой головы свой номер ═══════════
//  ПУЛЕМЁТ 1 (VO-4): три приговора, у каждого своя дата. Стеллажи от пола за
//  потолок, на каждой полке ряды одинаковых голов, к каждой пришпилен ярлык.
//  Дату не надо подписывать — видно, что всё это уже описано и поставлено на
//  учёт до тебя.
scene "zapasnik" (duration: 4s, set: zapasnik) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera medium freeman
    // `gab` — МИМИКА (рот), а не поза тела: при `pose` движок сбросил бы все
    // неназванные кости в дефолт, и фигура встала бы по стойке смирно. Тело
    // даёт `hips` — руки в боки, вещает чужой список; рот тараторит слоем.
    freeman pose "hips"
    freeman overlays "gab"
    wait 0.3s
    //lip 4
    together {
        freeman speaks for 3.2s
        do {
            wait 1.0s
            freeman pose "bow"           // кланяется каждой дате
            camera close-up freeman
            wait 0.9s
            freeman pose "facepalm"      // «Ты уникален» — позавчера
            camera medium freeman
            wait 0.6s
            camera extreme-close-up freeman
            wait 0.3s
        }
    }
    wait 0.2s
}

// ═══════════════ СЦЕНА 4: РАСКОП — глубина и есть возраст ═════════════════
//  «Ка́ждая мы́сль ста́рше ва́с» доказывается геометрией кадра, а не словом: он
//  стоит на дне траншеи, стены уходят выше рамки, и в каждом слое вещь своей
//  эпохи — черепки и кость на дне, таблички, свитки, книги, а под самым
//  дёрном очки и наручные часы. Всё, что он считает своим, лежит в верхнем
//  слое — самом тонком.
scene "raskop" (duration: 6.3s, set: raskop) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ПУЛЕМЁТ 2 (VO-5): сутулится под весом слоёв над головой.
    camera wide
    freeman pose "hunch"
    wait 0.3s
    //lip 5
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 0.9s
            freeman pose "gore"          // тело оседает дальше, чем `hunch`
            freeman overlays "weary"     // лицо — слоем, иначе сотрёт оседание
            camera close-up freeman
            wait 0.7s
        }
    }
    // ПУЛЕМЁТ финал (VO-6): «жуёте чужую жвачку» — отвращение, тряска.
    freeman moves-to (0.6, 0.585) over 0.01s
    freeman pose "otvraschenie"
    //lip 6
    together {
        freeman speaks for 2.8s
        do {
            camera close-up freeman
            wait 1.1s
            freeman overlays "za_golovu"
            camera medium freeman
            wait 0.8s
            camera extreme-close-up freeman
            wait 0.5s
        }
    }
    camera shake 0.35s intensity 2
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 0.2s
}

// ═══════════════ СЦЕНА 5: ПУСТОЙ ЗАЛ — цитировать некому ══════════════════
//  ПЕРЕЛОМ (VO-7). Своя локация, и она снята под одну реплику: кафедра с
//  раскрытой книгой, за ней ряды пустых кресел до самого верха кадра, за ними
//  стена книг. «Вы цити́руете» получает и трибуну, и отсутствующий зал: он
//  декламирует чужой текст в пустоту. Он стоит рядом с кафедрой, а не за ней —
//  чтец, которого никто не звал.
scene "zal" (duration: 6.5s, set: zal) {
    transition static 0.22s

    place freeman at (0.55, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ОБЩИЙ ПЛАН ПЕРВЫМ, И ЭТО НЕ ФОРМАЛЬНОСТЬ: локация работает только если
    // зритель увидел ПУСТЫЕ КРЕСЛА. На крупном от зала остаётся полоса за
    // спиной, и вся сцена сводится к смене фона.
    camera wide
    freeman pose "bow"                   // поклон чтеца — до первого слова
    wait 0.5s
    camera angle low freeman
    //lip 7
    together {
        freeman speaks for 5.4s
        do {
            camera medium freeman
            wait 1.3s
            // «Вы не ду́маете. Вы цити́руете.» — МАРИОНЕТКА. Поза `puppet` тут
            // не украшение: цитировать значит быть управляемым, и это ровно
            // тот кадр, где мысль ролика видна без слов. Рот — слоем.
            freeman pose "puppet"
            freeman overlays "gab"
            camera extreme-close-up freeman
            wait 0.9s
            camera close-up freeman
            wait 0.5s
            // «А кого́ — не по́мните» не режется катом, а НАЕЗЖАЕТ.
            freeman pose "v_upor"
            camera zoom-to freeman over 1.8s ease-in
            camera close-up freeman
            wait 0.6s
        }
    }
    camera shake 0.3s intensity 2
    wait 0.2s
}

// ═══════════════ СЦЕНА 6: СТЕНА — наследство, и оно недостроено ═══════════
//  Сотни РАЗНЫХ камней: каждый клал свой, и это видно без слов — «и ка́ждый
//  доба́вил своё». Верхний ряд оборван, в нём пустое гнездо: очередь твоя.
scene "stena" (duration: 9.9s, set: stena) {
    transition static 0.22s

    place predok at (0.24, 0.60) facing front
    predok scales 0.45 over 0.01s
    predok pose "bow"
    predok hides

    place freeman at (0.52, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let slovo = text("ЧЬЯ?", 170) at (0.5, -2.0) layer 6
    slovo scales 2.6 over 0.01s

    // ── ВЗЛЁТ (VO-8): наследство, и оно не одно ──────────────────────────
    // ТРОСТЬ ПРИХОДИТ ЗДЕСЬ И ТОЛЬКО ЗДЕСЬ: поза `confident` даёт её в руку на
    // слове «наследство» — атрибут наследника, а не случайный обломок.
    freeman pose "confident"
    camera medium freeman
    //lip 8
    together {
        freeman speaks for 7.8s
        do {
            wait 1.4s
            // «Два́дцать пя́ть веко́в его́ копи́ли» — ПРЕДШЕСТВЕННИК ВСТАЁТ У
            // СТЕНЫ. Второй план здесь не надпись, а вторая фигура: тот, кто
            // клал камень до тебя. Мельче и дальше — он уже история.
            predok shows
            camera wide
            wait 1.1s
            freeman pose "raskryl"
            predok pose "wave"           // передал и уходит
            wait 1.1s
            camera close-up freeman
            wait 0.9s
            predok hides
            camera extreme-close-up freeman
            wait 1.0s
            camera wide
        }
    }
    // ── СЛОВО-УДАР «ЧЬЯ?» + негатив-панч ─────────────────────────────────
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.5s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    camera extreme-close-up freeman
    freeman overlays "flash_grin"
    wait 0.08s
}

// ═══════════════ СЦЕНА 7: ПУСТОТА СНОВА — КОЛЬЦО ══════════════════════════
//  ЖАЛО-CTA (VO-9) возвращается туда, где ролик начался. Причина не в экономии
//  картинок, а в двух вещах.
//
//  Во-первых, драматургия: между пустотой и пустотой прошли барахолка, полки,
//  раскоп, зал и стена — весь мир, который зритель успел получить в наследство.
//  Снять его в финале значит показать, сколько останется, если наследство не
//  брать. Кольцо закрывает вопрос «ва́ша мы́сль — кото́рого го́да?»: отвечать
//  теперь не на что, кроме себя.
//
//  Во-вторых, ремесло: реплика идёт 10.2с, и держать её на кладке значило бы
//  просидеть в одной локации 18 секунд подряд — треть ролика. Ровно та
//  претензия («локации как под копирку»), от которой ролик и переснимали;
//  красивая локация не отменяет её, а маскирует.
scene "pustota-final" (duration: 12s, set: pustota) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 10.2s
        do {
            camera medium freeman
            wait 2.0s
            freeman pose "point"
            camera close-up freeman
            wait 2.0s
            freeman pose "confident"     // трость возвращается на счёт курса
            camera wide
            wait 2.0s
            freeman pose "hips"
            camera medium freeman
            wait 2.0s
            freeman pose "v_upor"
            camera close-up freeman
            wait 1.2s
        }
    }
    // ПОДМИГ — ПУАНТ, И ОН НА СВЕРХКРУПЕ.
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.3s
}

// ═══════════════ СЦЕНА 7: ТИТРЫ ═══════════════════════════════════════════
scene "titry" (duration: 4.5s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.9s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 1.2s
    transition fade-black 0.7s
}
