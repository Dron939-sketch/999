// =============================================================================
//  «ИНФОЦЫГАНЕ КАК ВИД» — ВВОДНАЯ ПРЕЗЕНТАЦИЯ ЛЕКТОРИЯ.
//  VO — lektorij-manifest-VO.md, //lip 1..12.
//
//  ЧЕМ ЭТОТ РОЛИК ОТЛИЧАЕТСЯ ОТ ОСТАЛЬНЫХ
//
//  1. ФИГУРА ХОДИТ. Прежние ролики играли позами на месте: персонаж стоял и
//     менял жесты. Здесь он РАСХАЖИВАЕТ и думает вслух, и ходьба несёт смысл:
//     идёт на размышлении, ОСТАНАВЛИВАЕТСЯ НА УДАРАХ (остановка — знак
//     препинания), разворачивается там, где поворачивает рассуждение. К
//     зрителю поворачивается ровно дважды: на развороте и в жале.
//     Технически шаг — это `moves-to` за время реплики плюс чередование
//     `shag_levoj`/`shag_pravoj` СЛОЯМИ (полные позы внутри реплики сбрасывают
//     липсинк — см. tools/speech_lint.py).
//
//  2. ЛОКАЦИЯ МЕНЯЕТСЯ ПОД МЫСЛЬ. Пять площадок, каждая — довод:
//     пустое поле (задача в вакууме) → камера с фамилиями на стене (сажали) →
//     ярмарка обещаний (вышел — торговля идёт) → руины кафе (тупик) →
//     двери (выход, который был рядом) → зал Лектория (полки вместо касс) →
//     снова поле (ушёл, зритель остался с выбором).
//     Каждая сцена — отдельный `scene`: сет задаётся сценой, и это
//     единственный способ сменить его посреди ролика.
//
//  3. ФИНАЛ — КАССЕТНИК. Персонаж ставит магнитофон и жмёт клавишу; ролик
//     уходит на песне. Музыку подмешивает сборщик звука (SFX-дорожка VO),
//     здесь — только жест и предмет.
//
//  ФИГУРА СТОИТ НА ЗЕМЛЕ: у каждой локации есть `*.surfaces.json`, и все
//  `place` идут через `on floor` — заданная точка это СТУПНИ.
//  БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pole from "../assets/sets/field-empty.svg"
import set tyurma from "../assets/sets/prison-infocygane.svg"
import set yarmarka from "../assets/sets/bazaar-obeschanij.svg"
import set ruiny from "../assets/sets/cafe-ruins.svg"
import set dveri from "../assets/sets/doors-empty.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ===================== СЦЕНА 1: ПОЛЕ — ЗАДАЧА В ВАКУУМЕ ======================
scene "pole" (duration: 10s, set: pole) {
    transition static 0.35s

    place freeman at (0.30, 0.88) facing front on floor
    freeman scales 0.8
    camera wide

    // ── t=0..3 БЕЗ СЛОВ: идёт. Мысль началась до нас ──────────────────────
    freeman pose "idet"
    freeman moves-to (0.46, 0.88) over 3.0s
    freeman overlays "shag_levoj"
    wait 0.75s
    freeman overlays "shag_pravoj"
    wait 0.75s
    freeman overlays "shag_levoj"
    wait 0.75s
    freeman overlays "shag_pravoj"
    wait 0.75s

    // ── ХУК (VO-1): «Без тебя решили. Извести инфоцыган. Как вид.» ────────
    //  Идёт и говорит: тело не замирает ради речи.
    freeman pose "idet"
    //lip 1
    together {
        freeman speaks for 3.0s
        freeman moves-to (0.66, 0.88) over 3.0s
        do {
            freeman overlays "shag_levoj"
            wait 1.0s
            freeman overlays "shag_pravoj"
            wait 1.0s
            freeman overlays "shag_levoj"
        }
    }
    // ── ХУК-добивка (VO-2): разворот на каблуках ──────────────────────────
    freeman pose "calm"
    freeman overlays "smug"
    //lip 2
    together {
        freeman speaks for 2.4s
        do {
            camera medium freeman
            wait 1.2s
            freeman overlays "shrug"       // «амбициозная», плечами
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 2: КАМЕРА — САЖАЛИ, НЕ ПОМОГАЛО ==========================
scene "tyurma" (duration: 6s, set: tyurma) {
    transition static 0.3s

    // Фамилии на стене видны РАНЬШЕ слов: сначала общий план камеры, потом
    // персонаж идёт вдоль стены. Улика предъявлена, а не названа.
    place freeman at (0.30, 0.92) facing front on floor
    freeman scales 0.62
    camera wide
    freeman pose "idet"
    wait 0.9s

    // ── ПУЛЕМЁТ 1 (VO-3): «Их сажали. Штрафовали. Запрещали.» ─────────────
    //lip 3
    together {
        freeman speaks for 2.2s
        freeman moves-to (0.56, 0.92) over 2.2s
        do {
            freeman overlays "shag_levoj"
            wait 0.75s
            freeman overlays "shag_pravoj"
            wait 0.75s
            freeman overlays "shag_levoj"
        }
    }
    // ── ПУЛЕМЁТ 2 (VO-4): «Не помогало. Всплывали снова.» ─────────────────
    freeman pose "calm"
    freeman overlays "stern"
    //lip 4
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 1.1s
            freeman overlays "shrug"
        }
    }
    wait 0.5s
}

// ================ СЦЕНА 3: ЯРМАРКА — ВЫШЕЛ, А ТОРГОВЛЯ ИДЁТ ==================
scene "yarmarka" (duration: 7s, set: yarmarka) {
    // Склейка без затемнения: лязг решётки обрывается базарным гулом, и
    // зритель обнаруживает персонажа в той же ярмарке, что была до посадок.
    transition static 0.25s

    place freeman at (0.62, 0.90) facing front on floor
    freeman scales 0.78
    camera wide

    // ── ПУЛЕМЁТ 3 (VO-5): те же вывески. Идёт мимо них ────────────────────
    freeman pose "idet"
    //lip 5
    together {
        freeman speaks for 2.6s
        freeman moves-to (0.38, 0.90) over 2.6s
        do {
            freeman overlays "shag_levoj"
            wait 0.85s
            freeman overlays "shag_pravoj"
            wait 0.85s
            freeman overlays "shag_levoj"
        }
    }
    // ── ПУЛЕМЁТ финал (VO-6): ОСТАНОВИЛСЯ. «И ты платишь…» ────────────────
    //  Остановка и есть знак препинания: до этого он ходил, теперь встал.
    freeman pose "v_upor"
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 2.6s
        do {
            camera medium freeman
            wait 1.3s
            freeman overlays "point"
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 1.0s
}

// ==================== СЦЕНА 4: РУИНЫ — ТУПИК ================================
scene "ruiny" (duration: 6s, set: ruiny) {
    transition static 0.3s

    place freeman at (0.42, 0.88) facing front on floor
    freeman scales 0.75
    camera wide

    // ── ТУПИК (VO-7): думает вслух и ходит кругами ────────────────────────
    freeman pose "idet"
    //lip 7
    together {
        freeman speaks for 4.0s
        freeman moves-to (0.60, 0.88) over 4.0s
        do {
            freeman overlays "shag_levoj"
            wait 1.0s
            freeman overlays "shag_pravoj"
            wait 1.0s
            freeman overlays "think"      // «пока людям нужны ответы…»
            wait 1.0s
            freeman overlays "shag_levoj"
        }
    }
    // тупик повис: шаг. Ещё шаг. И — нашёл.
    freeman pose "calm"
    wait 1.2s
}

// ============ СЦЕНА 5: ДВЕРИ — РАЗВОРОТ, ОТВЕТ БЫЛ РЯДОМ =====================
scene "dveri" (duration: 7s, set: dveri) {
    transition static 0.3s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let slovo = text("БЕСПЛАТНО", 150) at (0.5, -2.0) layer 6
    slovo scales 2.4
    camera wide
    freeman pose "calm"
    wait 0.7s

    // ── РАЗВОРОТ (VO-8): ОСТАНОВИЛСЯ и повернулся к зрителю ───────────────
    freeman pose "v_upor"
    //lip 8
    together {
        freeman speaks for 4.5s
        do {
            camera medium freeman
            wait 2.2s
            freeman overlays "raskryl"     // «отдать то же самое»
        }
    }
    // ── СЛОВО-УДАР «БЕСПЛАТНО» + негатив-панч ─────────────────────────────
    camera wide
    slovo moves-to (0.5, 0.30) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.9s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    wait 0.4s
}

// ============= СЦЕНА 6: ЗАЛ ЛЕКТОРИЯ — ВЗЛЁТ И ПРЕЗЕНТАЦИЯ ==================
scene "zal" (duration: 24s, set: zal) {
    transition static 0.4s

    place freeman at (0.34, 0.93) facing front on floor
    freeman scales 0.72
    camera wide

    // ── ВЗЛЁТ (VO-9): шагает вдоль полок ──────────────────────────────────
    freeman pose "idet"
    //lip 9
    together {
        freeman speaks for 5.5s
        freeman moves-to (0.62, 0.93) over 5.5s
        do {
            freeman overlays "shag_levoj"
            wait 1.4s
            freeman overlays "shag_pravoj"
            wait 1.4s
            freeman overlays "open"        // «его не убудет, если раздать»
            wait 1.4s
            freeman overlays "shag_levoj"
        }
    }
    wait 1.0s

    // ── ПРЕЗЕНТАЦИЯ (VO-10): идёт мимо полок, называет по делу ────────────
    freeman pose "idet"
    //lip 10
    together {
        freeman speaks for 6.5s
        freeman moves-to (0.40, 0.93) over 6.5s
        do {
            freeman overlays "shag_pravoj"
            wait 1.6s
            freeman overlays "shag_levoj"
            wait 1.6s
            freeman overlays "shag_pravoj"
            wait 1.6s
            freeman overlays "open"
        }
    }
    wait 1.0s

    // ── ПОЛЬЗА СЕЙЧАС (VO-11): ОСТАНОВИЛСЯ у кафедры, ближе к камере ──────
    freeman pose "calm"
    //lip 11
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "point"       // «начни с „Как думать“»
        }
    }
    wait 0.8s
}

// ============== СЦЕНА 7: ПОЛЕ — ЖАЛО И КАССЕТНИК =============================
scene "final" (duration: 20s, set: pole) {
    transition static 0.35s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let deck = prop("deck", "../assets/props/tape-deck.svg") at (0.72, 0.93) on floor
    deck scales 0.5
    deck hides
    camera wide

    // ── ЖАЛО (VO-12): подколка в хвосте ───────────────────────────────────
    freeman pose "v_upor"
    freeman overlays "smug"
    //lip 12
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "gopnik"      // вразвалку: «тебе ведь важна бумажка?»
        }
    }
    freeman overlays "hero_wink"
    wait 0.8s

    // ── КАССЕТНИК: поставил и нажал клавишу ───────────────────────────────
    //  Последнее движение ролика. Магнитофон появляется у ног (он `on floor`,
    //  якорь — низ рисунка, поэтому стоит на земле, а не парит), персонаж
    //  наклоняется к нему — и уходит уже под музыку.
    camera wide
    deck shows
    freeman pose "bow"                     // наклонился к магнитофону
    wait 1.0s
    freeman pose "calm"
    camera shake 0.2s intensity 1          // щелчок клавиши
    wait 1.4s

    // ── УХОДИТ ПОД ПЕСНЮ: 12 секунд трека начинаются здесь ────────────────
    freeman pose "idet"
    freeman moves-to (0.06, 0.88) over 6.0s
    freeman overlays "shag_levoj"
    wait 1.2s
    freeman overlays "shag_pravoj"
    wait 1.2s
    freeman overlays "shag_levoj"
    wait 1.2s
    freeman overlays "shag_pravoj"
    wait 1.2s
    freeman overlays "shag_levoj"
    wait 1.5s
}

// ========================== СЦЕНА 8: ТИТРЫ ==================================
scene "titry" (duration: 6s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.2s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 2.6s
    transition fade-black 0.8s
}
