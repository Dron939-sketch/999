// =============================================================================
//  «ИНФОЦЫГАНЕ КАК ВИД» — ВВОДНАЯ ПРЕЗЕНТАЦИЯ ЛЕКТОРИЯ.
//  VO — lektorij-manifest-VO.md, //lip 1..11.
//
//  ЧЕМ ЭТОТ РОЛИК ОТЛИЧАЕТСЯ ОТ ОСТАЛЬНЫХ
//
//  1. ФИГУРА ХОДИТ И ГОВОРИТ НА ХОДУ. Прежние ролики играли позами на месте:
//     персонаж стоял и менял жесты. Здесь он думает вслух на ходу, и ходьба
//     несёт смысл: идёт на размышлении, ОСТАНАВЛИВАЕТСЯ НА УДАРАХ (остановка —
//     знак препинания).
//     ХОДИТ ОН В ПРОФИЛЬ, а не анфасом вбок. Анфасная фигура, едущая по
//     экрану, читается как скольжение декорации: ноги шагают, а тело плывёт.
//     Профильные позы разворачивают корпус ТУДА, КУДА он идёт, и шаг сразу
//     читается шагом.
//     РЕЧЬ НА ХОДУ УСТРОЕНА ДВУМЯ ВЕЩАМИ (обе — tools/walk.py):
//       · поза `bok_*_govorit` — корпус в профиль, МАСКА К ЗРИТЕЛЮ. Профиль
//         хорош для движения и плох для речи: сбоку видно один глаз и
//         половину рта, говорящая фигура читается отвернувшейся. И рот там
//         профильный (`mouth_side`), виземами он не бывает — липсинку нечего
//         подменять;
//       · шаг СЛОЕМ (`shag_bok_*`), а не полной позой. Полная поза сбрасывает
//         наложенные слои вместе с липсинком, и рот прыгал бы на каждом шаге
//         (см. tools/speech_lint.py). Слой трогает только ноги и руку.
//     ПРОХОД ЗАКРЫВАЕТСЯ ПОЛНОЙ ПОЗОЙ — иначе брошенный слой шага висит на
//     фигуре, и она доигрывает полушаг уже стоя (гейт: walk.py --check).
//
//  2. ХРОНОМЕТРАЖ — ДО МИНУТЫ. Прежний монтаж шёл 98 секунд при 46 секундах
//     речи: больше половины ролика зритель ждал. Резалось НЕ содержание, а
//     простой — проходы без слов, добор кадра после реплики, холостые хвосты
//     сцен. Плюс сама речь разогнана общим темпом ×1.12 (шапка VO). Отсюда
//     правило для правок: `duration` сцены держим впритык к содержимому, а не
//     «с запасом» — запас превращается в стоящий кадр.
//
//  3. ЛОКАЦИЯ МЕНЯЕТСЯ ПОД МЫСЛЬ. Семь площадок, каждая — довод:
//     пустое поле (задача в вакууме) → камера с фамилиями на стене (сажали) →
//     ярмарка обещаний (вышел — торговля идёт) → улица (тупик) →
//     двери (выход, который был рядом) → зал Лектория (полки вместо касс) →
//     снова поле (ушёл, зритель остался с выбором).
//     Каждая сцена — отдельный `scene`: сет задаётся сценой, и это
//     единственный способ сменить его посреди ролика.
//
//  4. ФИНАЛ — КАССЕТНИК. Персонаж жмёт клавишу; ролик уходит на песне.
//     Музыку подмешивает сборщик звука, здесь — только жест и предмет.
//
//  ФИГУРА СТОИТ НА ЗЕМЛЕ: у каждой локации есть `*.surfaces.json`, и все
//  `place` идут через `on floor` — заданная точка это СТУПНИ. Одной посадки
//  мало: пока под ногами ничего нет, фигура всё равно читается наклеенной на
//  фон. ТЕНЬ и есть то, что кладёт её на пол — `ground-shadow` даёт пятно
//  контакта под ступнями, `cast-shadow` бросает силуэт по земле в сторону от
//  света.
//  ФИГУРА НЕ ПРИСЕДАЕТ: любое сгибание коленей читается осадкой. Проверяется
//  замером — tools/posture.py роняет прогон на позе, которая просаживает рост
//  больше чем на 8% (так вылетела `gopnik`: 0.84 эталона).
//  БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pole from "../assets/sets/field-empty.svg"
import set tyurma from "../assets/sets/prison-infocygane.svg"
import set yarmarka from "../assets/sets/bazaar-obeschanij.svg"
import set ulica from "../assets/sets/biznes-street.svg"
import set dveri from "../assets/sets/doors-empty.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true        // пятно контакта под ступнями
    cast-shadow: 0.32          // силуэт по земле: фигура лежит на полу, а не на фоне
}

// ===================== СЦЕНА 1: ПОЛЕ — ЗАДАЧА В ВАКУУМЕ ======================
scene "pole" (duration: 5.5s, set: pole) {
    transition static 0.15s

    place freeman at (0.32, 0.88) facing front on floor
    freeman scales 0.8
    camera wide

    // ── t=0..0.6 БЕЗ СЛОВ: один шаг. Мысль началась до нас ────────────────
    freeman pose "bok_pravo_govorit"
    freeman moves-to (0.40, 0.88) over 0.35s
    freeman overlays "shag_bok_levoj"
    wait 0.3s

    // ── ХУК (VO-1): ГОВОРИТ НА ХОДУ ───────────────────────────────────────
    //  «Инфоцыган решили извести. Как вид.» Он не останавливается, чтобы
    //  сообщить это: мысль идёт вместе с ним, и зритель входит в середину.
    //lip 1
    together {
        freeman speaks for 2.6s
        do {
            freeman moves-to (0.56, 0.88) over 2.0s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            camera medium freeman
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            freeman overlays "shag_bok_levoj"
        }
    }
    //  ОСТАНОВКА — ПОЛНОЙ ПОЗОЙ. Слой шага иначе остаётся висеть, и фигура
    //  стоит с разведёнными ногами: «доигрывает полушаг».
    freeman pose "calm"
    freeman overlays "flash_dead"          // вспышка-морда на стыке: ролик не едет ровно
    wait 0.08s
    // ── ХУК-добивка (VO-2): встал, развернулся к нам — и сказал ───────────
    freeman overlays "smug"
    //lip 2
    together {
        freeman speaks for 1.8s
        do {
            wait 0.6s
            freeman overlays "hips"        // руки в боки: «прямо скажем»
            wait 0.6s
            freeman overlays "no"          // «амбициозная», развёл руками
        }
    }
    camera wide
    wait 0.2s
}

// ============ СЦЕНА 2: КАМЕРА — САЖАЛИ, НЕ ПОМОГАЛО ==========================
scene "tyurma" (duration: 4.5s, set: tyurma) {
    transition static 0.15s

    place freeman at (0.32, 0.92) facing front on floor
    freeman scales 0.62
    camera wide
    freeman pose "bok_pravo_govorit"
    wait 0.15s

    // ── ПУЛЕМЁТ 1 (VO-3): «Их сажали. Штрафовали. Запрещали.» ─────────────
    //  ГОВОРИТ НА ХОДУ, ПРОХОДЯ ВДОЛЬ СТЕНЫ. Улика — три фамилии, нацарапанные
    //  на бетоне, — проезжает у него за спиной ровно в тот момент, когда он
    //  перечисляет, что с ними делали. Так она предъявлена походя, а не
    //  показана крупно: зритель находит её сам.
    //lip 3
    together {
        freeman speaks for 2.4s
        do {
            freeman moves-to (0.56, 0.92) over 1.7s
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            camera medium freeman
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            camera wide
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
        }
    }
    freeman pose "calm"                    // встал, повернулся к нам
    camera shake 0.2s intensity 2
    // ── ПУЛЕМЁТ 2 (VO-4): «Не помогало. Всплывали снова.» ─────────────────
    freeman overlays "stern"
    //lip 4
    together {
        freeman speaks for 2.0s
        do {
            camera medium freeman
            wait 0.55s
            freeman overlays "hunch"       // ссутулился: «не помогало»
            wait 0.55s
            freeman overlays "shrug"       // и развёл руками: «всплывали снова»
        }
    }
    wait 0.25s
}

// ================ СЦЕНА 3: ЯРМАРКА — ВЫШЕЛ, А ТОРГОВЛЯ ИДЁТ ==================
scene "yarmarka" (duration: 6.5s, set: yarmarka) {
    // Склейка без затемнения: лязг решётки обрывается базарным гулом, и
    // зритель обнаруживает персонажа в той же ярмарке, что была до посадок.
    transition static 0.15s

    place freeman at (0.62, 0.90) facing front on floor
    freeman scales 0.78
    camera wide

    //  ЗДЕСЬ ОН НЕ ХОДИТ. Смысл сцены — «вышел и попал в ту же ярмарку», и
    //  он считывается в первом же кадре: те же вывески вокруг.
    freeman pose "calm"
    freeman overlays "hero_skeptic"
    wait 0.15s

    // ── ПУЛЕМЁТ 3 (VO-5): те же вывески ───────────────────────────────────
    //lip 5
    together {
        freeman speaks for 3.0s
        do {
            camera medium freeman
            wait 0.75s
            freeman overlays "otvraschenie"   // «Марафон желаний» — поморщился
            camera wide
            wait 0.75s
            freeman overlays "no"             // «Наставник. Закрытый клуб.»
            camera medium freeman
        }
    }
    camera wide
    freeman overlays "flash_disgust"
    wait 0.08s
    // ── ПУЛЕМЁТ финал (VO-6): В УПОР. «И ты платишь…» ─────────────────────
    freeman pose "v_upor"
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 4.3s
        do {
            camera medium freeman
            wait 1.1s
            freeman overlays "hips"           // «Три платежа»
            wait 1.1s
            freeman overlays "point"          // «и ты платишь» — в зрителя
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 0.15s                                 // пауза-удар после «жвачки»
}

// ==================== СЦЕНА 4: УЛИЦА — ТУПИК И ПОВОРОТ ======================
//  ЛОКАЦИЯ — УЛИЦА, А НЕ РУИНЫ. Замер сетов: cafe-ruins после монохромного
//  прохода с контрастом 2.2 даёт среднюю яркость 1 из 255 — кадр чёрный
//  целиком, и фигура висит в «космосе». Улица (210 из 255) держит тот же
//  смысл — город, где всё продаётся, — и при этом читается.
scene "ulica" (duration: 5s, set: ulica) {
    transition static 0.15s

    place freeman at (0.42, 0.88) facing front on floor
    freeman scales 0.75
    camera wide

    //  ТУПИК ИГРАЕТСЯ НЕПОДВИЖНОСТЬЮ. Здесь ролик поворачивается к зрителю:
    //  «платят за право не думать» — и ходьба тут только помешала бы.
    // ── ТУПИК (VO-7): думает вслух, к концу — в упор ──────────────────────
    //  ОБЩИЙ ПЛАН, А НЕ СРЕДНИЙ: на среднем камера уходит выше линии пола, и
    //  в кадре остаётся чернота с белой маской, «космос».
    freeman pose "think"
    //lip 7
    together {
        freeman speaks for 4.4s
        do {
            wait 1.5s
            freeman overlays "myslitel"    // «продавца кормит не жадность»
            camera medium freeman
            wait 1.3s
            freeman overlays "point"       // «платят за право не думать» — в зрителя
            camera wide
        }
    }
    freeman pose "calm"
    wait 0.05s
}

// ============ СЦЕНА 5: ДВЕРИ — РАЗВОРОТ, ОТВЕТ БЫЛ РЯДОМ =====================
scene "dveri" (duration: 5s, set: dveri) {
    transition static 0.15s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let slovo = text("БЕСПЛАТНО", 150) at (0.5, -2.0) layer 6
    slovo scales 2.4
    //  ДОБОРА ПЕРЕД РАЗВОРОТОМ НЕТ. Перелом обязан начаться в окне 14–28с
    //  (§5.0), и каждая десятая доля здесь уводит его за край: сцена входит
    //  сразу в реплику, поза ставится вместе с первым словом.
    freeman pose "v_upor"

    // ── РАЗВОРОТ (VO-8): повернулся к зрителю ────────────────────────────
    //  Главный кадр ролика играется АНФАС и на ОБЩЕМ плане: зритель должен
    //  видеть и фигуру целиком, и светлый проём за ней — «выход, который был
    //  рядом».
    //lip 8
    together {
        freeman speaks for 4.0s
        do {
            wait 1.1s
            freeman overlays "lunge"       // «забрать товар» — подался вперёд
            wait 1.1s
            freeman overlays "raskryl"     // «отдать всё то же самое» — раскрылся
        }
    }
    // ── СЛОВО-УДАР «БЕСПЛАТНО» + негатив-панч ─────────────────────────────
    camera wide
    //  Надпись ставится ВЫШЕ середины: на 0.30 её нижний край наезжал на
    //  кромку дверного проёма, и слово читалось сквозь косяк. 0.20 — над
    //  притолокой, на чистом фоне.
    slovo moves-to (0.5, 0.20) over 0.01s
    slovo scales 1.0 over 0.16s ease-in
    transition invert 0.14s
    camera shake 0.25s intensity 3
    wait 0.55s
    slovo moves-to (0.5, -2.0) over 0.2s ease-in
    wait 0.1s
}

// ============= СЦЕНА 6: ЗАЛ ЛЕКТОРИЯ — ВЗЛЁТ И ПРЕЗЕНТАЦИЯ ==================
scene "zal" (duration: 9.5s, set: zal) {
    transition static 0.15s

    place freeman at (0.34, 0.93) facing front on floor
    freeman scales 0.72
    camera wide

    // ── вошёл в зал и ГОВОРИТ НА ХОДУ, проходя вдоль по́лок ────────────────
    //  Довод и картинка совпадают: он идёт мимо открытых полок и в этот же
    //  момент говорит, что знание не убывает от раздачи.
    freeman pose "bok_pravo_govorit"
    wait 0.15s
    // ── ВЗЛЁТ (VO-9): отдаёт мысль на ходу ───────────────────────────────
    //lip 9
    together {
        freeman speaks for 5.3s
        do {
            freeman moves-to (0.58, 0.93) over 4.0s
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            camera medium freeman
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            camera wide
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
        }
    }
    // остановка полной позой: слой шага снят, ноги приставлены
    freeman pose "raskryl"                 // повернулся к нам, раскрыл руки
    camera wide
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-10): называет площадку, а не курс ────────────────
    //  Отдельной рекламы курса здесь больше нет: достаточно назвать Лекторий
    //  и сказать, что всё бесплатно, — конкретное направление зритель
    //  выберет сам.
    //lip 10
    together {
        freeman speaks for 3.8s
        do {
            camera medium freeman
            wait 1.1s
            freeman overlays "wave"        // «Лекторий. Университет Мейстера.»
            wait 1.1s
            freeman overlays "confident"   // «Всё бесплатно. Совсем.»
        }
    }
    camera wide
    wait 0.15s
}

// ============== СЦЕНА 7: ПОЛЕ — ЖАЛО И КАССЕТНИК =============================
scene "final" (duration: 9s, set: pole) {
    transition static 0.15s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let deck = prop("deck", "../assets/props/tape-deck.svg") at (0.72, 0.93) on floor
    deck scales 0.5
    deck hides
    camera wide

    // ── ЖАЛО (VO-11): подколка в хвосте ───────────────────────────────────
    freeman pose "v_upor"
    freeman overlays "smug"
    camera zoom-to freeman over 0.4s ease-in     // наезд-удар перед подколкой
    //lip 11
    together {
        freeman speaks for 4.4s
        do {
            camera medium freeman
            wait 1.25s
            freeman overlays "hips"        // «или заплати сорок тысяч»
            wait 1.25s
            //  НЕ `gopnik`: гейт осанки меряет рост позы и роняет прогон на
            //  всём, что просаживает фигуру больше чем на 8%. Вразвалку у
            //  этого персонажа = присед (0.84 эталона), и в кадре это
            //  читается «сел на корточки». Пожатие плечами держит рост и
            //  говорит ровно то же: «ну как знаешь».
            freeman overlays "shrug"       // «тебе ведь важна бумажка?»
        }
    }
    freeman overlays "hero_wink"
    wait 0.15s

    // ── КАССЕТНИК: нажал клавишу СТОЯ ─────────────────────────────────────
    //  Магнитофон уже стоит на земле (он `on floor`, якорь — низ рисунка),
    //  персонаж включает его стоя: тычок — жест, а не поза. НЕ ПРИСЕДАЕТ и
    //  не садится (см. шапку про гейт осанки).
    camera wide
    deck shows
    freeman pose "point"                   // потянулся к клавише
    wait 0.5s
    camera shake 0.18s intensity 1         // щелчок клавиши
    freeman pose "calm"
    wait 0.35s

    // ── УХОДИТ ПОД ПЕСНЮ ──────────────────────────────────────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой,
    //  профиль — просто «мне туда». Сумма ожиданий сведена с длиной проезда:
    //  при расхождении фигура доезжает стоя, и это видно.
    freeman pose "bok_levo"
    freeman moves-to (0.06, 0.88) over 1.4s
    freeman overlays "shag_bok_levoj"
    wait 0.35s
    freeman overlays "shag_bok_pravoj"
    wait 0.35s
    freeman overlays "shag_bok_levoj"
    wait 0.35s
    freeman overlays "shag_bok_pravoj"
    wait 0.35s
    //  Проход ЗАКАНЧИВАЕТСЯ СТОЙКОЙ, а не шаговым слоем: слои держатся до
    //  полной позы, и последний кадр застывал на разведённых ногах.
    freeman pose "bok_levo"
    wait 0.2s
}

// ========================== СЦЕНА 8: ТИТРЫ ==================================
scene "titry" (duration: 2.8s, set: titry) {
    transition static 0.15s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.35s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.2s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 0.6s
    transition fade-black 0.35s
}
