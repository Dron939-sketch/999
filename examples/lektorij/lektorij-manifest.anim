// =============================================================================
//  «ИНФОЦЫГАНЕ КАК ВИД» — ВВОДНАЯ ПРЕЗЕНТАЦИЯ ЛЕКТОРИЯ.
//  VO — lektorij-manifest-VO.md, //lip 1..12.
//
//  ЧЕМ ЭТОТ РОЛИК ОТЛИЧАЕТСЯ ОТ ОСТАЛЬНЫХ
//
//  1. ФИГУРА ХОДИТ И ГОВОРИТ НА ХОДУ. Прежние ролики играли позами на месте:
//     персонаж стоял и менял жесты. Здесь он РАСХАЖИВАЕТ и думает вслух, и
//     ходьба несёт смысл: идёт на размышлении, ОСТАНАВЛИВАЕТСЯ НА УДАРАХ
//     (остановка — знак препинания), разворачивается там, где поворачивает
//     рассуждение.
//     ХОДИТ ОН В ПРОФИЛЬ, а не анфасом вбок. Анфасная фигура, едущая по
//     экрану, читается как скольжение декорации: ноги шагают, а тело плывёт.
//     Профильные позы разворачивают корпус ТУДА, КУДА он идёт, и шаг сразу
//     читается шагом.
//     РЕЧЬ НА ХОДУ УСТРОЕНА ДВУМЯ ВЕЩАМИ (обе — tools/walk.py):
//       · поза `bok_*_govorit` — корпус в профиль, МАСКА К ЗРИТЕЛЮ. Профиль
//         хорош для движения и плох для речи: сбоку видно один глаз и
//         половину рта, говорящая фигура читается отвернувшейся. И рот там
//         профильный (`mouth_side`), виземами он не бывает — липсинку нечего
//         подменять;
//       · шаг СЛОЕМ (`shag_bok_*`), а не полной позой. Полная поза сбрасывает
//         наложенные слои вместе с липсинком, и рот прыгал бы на каждом шаге
//         (см. tools/speech_lint.py). Слой трогает только ноги и руку.
//     ПРОХОД ЗАКРЫВАЕТСЯ ПОЛНОЙ ПОЗОЙ — иначе брошенный слой шага висит на
//     фигуре, и она доигрывает полушаг уже стоя (гейт: walk.py --check).
//
//  2. ЛОКАЦИЯ МЕНЯЕТСЯ ПОД МЫСЛЬ. Пять площадок, каждая — довод:
//     пустое поле (задача в вакууме) → камера с фамилиями на стене (сажали) →
//     ярмарка обещаний (вышел — торговля идёт) → руины кафе (тупик) →
//     двери (выход, который был рядом) → зал Лектория (полки вместо касс) →
//     снова поле (ушёл, зритель остался с выбором).
//     Каждая сцена — отдельный `scene`: сет задаётся сценой, и это
//     единственный способ сменить его посреди ролика.
//
//  3. ФИНАЛ — КАССЕТНИК. Персонаж ставит магнитофон и жмёт клавишу; ролик
//     уходит на песне. Музыку подмешивает сборщик звука (SFX-дорожка VO),
//     здесь — только жест и предмет.
//
//  ФИГУРА СТОИТ НА ЗЕМЛЕ: у каждой локации есть `*.surfaces.json`, и все
//  `place` идут через `on floor` — заданная точка это СТУПНИ. Одной посадки
//  мало: пока под ногами ничего нет, фигура всё равно читается наклеенной на
//  фон. ТЕНЬ и есть то, что кладёт её на пол — `ground-shadow` даёт пятно
//  контакта под ступнями, `cast-shadow` бросает силуэт по земле в сторону от
//  света. На ходу тень едет вместе с фигурой, и шаг перестаёт быть
//  скольжением.
//  БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается (PR #15).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pole from "../assets/sets/field-empty.svg"
import set tyurma from "../assets/sets/prison-infocygane.svg"
import set yarmarka from "../assets/sets/bazaar-obeschanij.svg"
import set ruiny from "../assets/sets/biznes-street.svg"
import set dveri from "../assets/sets/doors-empty.svg"
import set zal from "../assets/sets/lektorij-zal.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true        // пятно контакта под ступнями
    cast-shadow: 0.32          // силуэт по земле: фигура лежит на полу, а не на фоне
}

// ===================== СЦЕНА 1: ПОЛЕ — ЗАДАЧА В ВАКУУМЕ ======================
scene "pole" (duration: 10s, set: pole) {
    transition static 0.35s

    place freeman at (0.30, 0.88) facing front on floor
    freeman scales 0.8
    camera wide

    // ── t=0..1.4 БЕЗ СЛОВ: два шага. Мысль началась до нас ────────────────
    freeman pose "bok_pravo_govorit"
    freeman moves-to (0.40, 0.88) over 1.4s
    freeman overlays "shag_bok_levoj"
    wait 0.45s
    freeman overlays "shag_bok_pravoj"
    wait 0.45s

    // ── ХУК (VO-1): ГОВОРИТ НА ХОДУ ───────────────────────────────────────
    //  «Инфоцыган решили извести. Как вид.» Он не останавливается, чтобы
    //  сообщить это: мысль идёт вместе с ним, и зритель входит в середину.
    //  Корпус в профиль — шаг читается шагом; маска повёрнута к нам — речь
    //  читается речью. Шаг идёт СЛОЕМ, поэтому липсинк держит рот сам.
    //lip 1
    together {
        freeman speaks for 3.0s
        do {
            freeman moves-to (0.56, 0.88) over 2.6s
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            camera medium freeman
            freeman overlays "shag_bok_levoj"
            wait 0.5s
            freeman overlays "shag_bok_pravoj"
            wait 0.5s
            freeman overlays "shag_bok_levoj"
        }
    }
    //  ОСТАНОВКА — ПОЛНОЙ ПОЗОЙ. Слой шага иначе остаётся висеть, и фигура
    //  стоит с разведёнными ногами: «доигрывает полушаг».
    freeman pose "calm"
    // вспышка-морда на стыке реплик: ролик не должен ехать ровно
    freeman overlays "flash_dead"
    wait 0.08s
    // ── ХУК-добивка (VO-2): встал, развернулся к нам — и сказал ───────────
    freeman pose "calm"
    freeman overlays "smug"
    //lip 2
    together {
        freeman speaks for 2.4s
        do {
            wait 0.8s
            freeman overlays "hips"        // руки в боки: «прямо скажем»
            wait 0.8s
            freeman overlays "no"          // «амбициозная», развёл руками
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 2: КАМЕРА — САЖАЛИ, НЕ ПОМОГАЛО ==========================
scene "tyurma" (duration: 6s, set: tyurma) {
    transition static 0.3s

    // Фамилии на стене видны РАНЬШЕ слов: сначала общий план камеры, потом
    // персонаж идёт вдоль стены. Улика предъявлена, а не названа.
    place freeman at (0.30, 0.92) facing front on floor
    freeman scales 0.62
    camera wide
    freeman pose "bok_pravo_govorit"
    wait 0.4s

    // ── ПУЛЕМЁТ 1 (VO-3): «Их сажали. Штрафовали. Запрещали.» ─────────────
    //  ГОВОРИТ НА ХОДУ, ПРОХОДЯ ВДОЛЬ СТЕНЫ. Улика — три фамилии, нацарапанные
    //  на бетоне, — проезжает у него за спиной ровно в тот момент, когда он
    //  перечисляет, что с ними делали. Так она предъявлена походя, а не
    //  показана крупно: зритель находит её сам.
    //  Ровный план на перечислении усыпляет — камера меняет крупность прямо
    //  посреди реплики, шаг идёт слоем и липсинку не мешает.
    //lip 3
    together {
        freeman speaks for 2.2s
        do {
            freeman moves-to (0.56, 0.92) over 2.0s
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            camera medium freeman
            freeman overlays "shag_bok_pravoj"
            wait 0.55s
            camera wide
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            freeman overlays "shag_bok_pravoj"
        }
    }
    freeman pose "calm"                    // встал, повернулся к нам
    camera shake 0.25s intensity 2
    // ── ПУЛЕМЁТ 2 (VO-4): «Не помогало. Всплывали снова.» ─────────────────
    freeman overlays "stern"
    //lip 4
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 0.7s
            freeman overlays "hunch"       // ссутулился: «не помогало»
            wait 0.7s
            freeman overlays "shrug"       // и развёл руками: «всплывали снова»
        }
    }
    wait 0.5s
}

// ================ СЦЕНА 3: ЯРМАРКА — ВЫШЕЛ, А ТОРГОВЛЯ ИДЁТ ==================
scene "yarmarka" (duration: 7s, set: yarmarka) {
    // Склейка без затемнения: лязг решётки обрывается базарным гулом, и
    // зритель обнаруживает персонажа в той же ярмарке, что была до посадок.
    transition static 0.25s

    place freeman at (0.62, 0.90) facing front on floor
    freeman scales 0.78
    camera wide

    //  ЗДЕСЬ ОН НЕ ХОДИТ. Смысл сцены — «вышел и попал в ту же ярмарку», и
    //  он считывается в первом же кадре: те же вывески вокруг. Проход этого
    //  не добавлял, только тянул время. Персонаж стоит посреди торговли —
    //  и она работает фоном за ним.
    freeman pose "calm"
    freeman overlays "hero_skeptic"
    wait 0.5s

    // ── ПУЛЕМЁТ 3 (VO-5): те же вывески ───────────────────────────────────
    //lip 5
    together {
        freeman speaks for 2.6s
        do {
            camera medium freeman
            wait 0.85s
            freeman overlays "otvraschenie"   // «Марафон желаний» — поморщился
            camera wide
            wait 0.85s
            freeman overlays "no"             // «Наставник. Закрытый клуб.»
            camera medium freeman
        }
    }
    camera wide
    freeman overlays "flash_disgust"
    wait 0.08s
    // ── ПУЛЕМЁТ финал (VO-6): ОСТАНОВИЛСЯ. «И ты платишь…» ────────────────
    //  Остановка и есть знак препинания: до этого он ходил, теперь встал.
    freeman pose "v_upor"
    freeman overlays "stern"
    //lip 6
    together {
        freeman speaks for 2.6s
        do {
            camera medium freeman
            wait 0.9s
            freeman overlays "hips"           // «Три платежа» — счёт на пальцах не нужен, нужен упор
            wait 0.9s
            freeman overlays "point"          // «и ты платишь» — в зрителя
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 1.0s
}

// ==================== СЦЕНА 4: УЛИЦА — ТУПИК ================================
//  ЛОКАЦИЯ СМЕНЕНА С РУИН НА УЛИЦУ. Замер сетов: cafe-ruins после
//  монохромного прохода с контрастом 2.2 даёт среднюю яркость 1 из 255 —
//  кадр чёрный целиком, и фигура висит в «космосе». Это не кадрирование, а
//  сама локация: она рисовалась под мягкий контраст. Улица (210 из 255,
//  90% светлого) держит тот же смысл — город, где всё продаётся, и тупик
//  посреди него, — и при этом читается.
scene "ruiny" (duration: 6s, set: ruiny) {
    transition static 0.3s

    place freeman at (0.42, 0.88) facing front on floor
    freeman scales 0.75
    camera wide

    //  ТУПИК ИГРАЕТСЯ НЕПОДВИЖНОСТЬЮ. Хождение кругами тут спорило с самим
    //  словом: «спрос никуда не денется» — это про то, что ничего не
    //  меняется, и лучше всего это читается со стоящей фигуры.
    // ── ТУПИК (VO-7): думает вслух ───────────────────────────────────────
    //  ОБЩИЙ ПЛАН, А НЕ СРЕДНИЙ. У руин и дверей верх кадра — тёмное небо, и
    //  на среднем плане камера уходит выше линии пола: в кадре остаётся
    //  чернота с белой маской, «космос». Локация при этом пропадает вместе с
    //  доводом, ради которого её и взяли. На общем видно и пол, и стены.
    freeman pose "think"
    //lip 7
    together {
        freeman speaks for 4.0s
        do {
            wait 1.4s
            freeman overlays "myslitel"    // «спрос никуда не денется»
            wait 1.4s
            freeman overlays "za_golovu"   // «продают надежду не думать самому»
        }
    }
    // и пошёл обратно — мысль повернула вместе с ним. Молча: тупик держится
    // тишиной, а не словами.
    freeman pose "bok_levo"
    freeman moves-to (0.44, 0.88) over 1.0s
    freeman overlays "shag_bok_levoj"
    wait 0.5s
    freeman overlays "shag_bok_pravoj"
    wait 0.5s
    // тупик повис: шаг. Ещё шаг. И — нашёл. Останавливает полная поза.
    freeman pose "calm"
    wait 1.2s
}

// ============ СЦЕНА 5: ДВЕРИ — РАЗВОРОТ, ОТВЕТ БЫЛ РЯДОМ =====================
scene "dveri" (duration: 7s, set: dveri) {
    transition static 0.3s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let slovo = text("БЕСПЛАТНО", 150) at (0.5, -2.0) layer 6
    slovo scales 2.4
    camera wide
    freeman pose "calm"
    wait 0.7s

    // ── РАЗВОРОТ (VO-8): ОСТАНОВИЛСЯ и повернулся к зрителю ───────────────
    //  Главный кадр ролика играется АНФАС и на ОБЩЕМ плане: зритель должен
    //  видеть и фигуру целиком, и светлый проём за ней — «выход, который был
    //  рядом». Средний план здесь давал чёрный кадр (см. выше про небо) и
    //  съедал сам довод.
    freeman pose "v_upor"
    //lip 8
    together {
        freeman speaks for 4.5s
        do {
            wait 1.5s
            freeman overlays "lunge"       // «забрать у них товар» — подался вперёд
            wait 1.5s
            freeman overlays "raskryl"     // «отдать то же самое» — раскрылся
        }
    }
    // ── СЛОВО-УДАР «БЕСПЛАТНО» + негатив-панч ─────────────────────────────
    camera wide
    //  Надпись ставится ВЫШЕ середины: на 0.30 её нижний край наезжал на
    //  кромку дверного проёма, и слово читалось сквозь косяк. 0.20 — над
    //  притолокой, на чистом фоне.
    slovo moves-to (0.5, 0.20) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.9s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    wait 0.4s
}

// ============= СЦЕНА 6: ЗАЛ ЛЕКТОРИЯ — ВЗЛЁТ И ПРЕЗЕНТАЦИЯ ==================
scene "zal" (duration: 24s, set: zal) {
    transition static 0.4s

    place freeman at (0.34, 0.93) facing front on floor
    freeman scales 0.72
    camera wide

    // ── вошёл в зал и ГОВОРИТ НА ХОДУ, проходя вдоль по́лок ────────────────
    //  Здесь проход работает буквально: он идёт мимо открытых полок и в этот
    //  же момент говорит, что знание не убывает от раздачи. Довод и картинка
    //  совпадают, поэтому останавливаться незачем.
    freeman pose "bok_pravo_govorit"
    wait 0.4s
    // ── ВЗЛЁТ (VO-9): отдаёт мысль на ходу ───────────────────────────────
    //lip 9
    together {
        freeman speaks for 5.5s
        do {
            freeman moves-to (0.58, 0.93) over 4.4s
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            freeman overlays "shag_bok_pravoj"
            wait 0.55s
            camera medium freeman
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            freeman overlays "shag_bok_pravoj"
            wait 0.55s
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            camera wide
            freeman overlays "shag_bok_pravoj"
            wait 0.55s
            freeman overlays "shag_bok_levoj"
            wait 0.55s
            freeman overlays "shag_bok_pravoj"
        }
    }
    // остановка полной позой: слой шага снят, ноги приставлены
    freeman pose "raskryl"                 // повернулся к нам, раскрыл руки
    camera wide
    wait 0.4s

    //  Второй проход убран: зал уже показан, а перечисление курсов сильнее
    //  звучит с места — зритель слушает, а не следит за фигурой.
    // ── ПРЕЗЕНТАЦИЯ (VO-10): называет по делу, стоя ──────────────────────
    //lip 10
    together {
        freeman speaks for 6.5s
        do {
            camera medium freeman
            wait 2.1s
            freeman overlays "wave"        // «Лекторий. Университет Мейстера.»
            wait 2.1s
            freeman overlays "open"        // «Лекции — слушай или читай.»
            wait 1.4s
            freeman overlays "confident"   // «Ноль рублей. Без регистрации.»
        }
    }
    camera wide
    wait 0.6s

    // ── ПОЛЬЗА СЕЙЧАС (VO-11): ОСТАНОВИЛСЯ у кафедры, ближе к камере ──────
    freeman pose "calm"
    //lip 11
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "point"       // «начни с „Как думать“»
            wait 1.8s
            freeman overlays "myslitel"    // «думать вслух и своими словами»
        }
    }
    wait 0.8s
}

// ============== СЦЕНА 7: ПОЛЕ — ЖАЛО И КАССЕТНИК =============================
scene "final" (duration: 20s, set: pole) {
    transition static 0.35s

    place freeman at (0.5, 0.88) facing front on floor
    freeman scales 0.8
    let deck = prop("deck", "../assets/props/tape-deck.svg") at (0.72, 0.93) on floor
    deck scales 0.5
    deck hides
    camera wide

    // ── ЖАЛО (VO-12): подколка в хвосте ───────────────────────────────────
    freeman pose "v_upor"
    freeman overlays "smug"
    camera zoom-to freeman over 0.5s ease-in     // наезд-удар перед подколкой
    //lip 12
    together {
        freeman speaks for 5.5s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "hips"        // «или отдай сорок тысяч»
            wait 1.8s
            freeman overlays "gopnik"      // вразвалку: «тебе ведь важна бумажка?»
        }
    }
    freeman overlays "hero_wink"
    wait 0.8s

    // ── КАССЕТНИК: поставил и нажал клавишу ───────────────────────────────
    //  Последнее движение ролика. Магнитофон появляется у ног (он `on floor`,
    //  якорь — низ рисунка, поэтому стоит на земле, а не парит), персонаж
    //  наклоняется к нему — и уходит уже под музыку.
    //  НЕ ПРИСЕДАЕТ И НЕ САДИТСЯ. Наклон (`bow`) читался как «сел на
    //  корточки» — у фигуры с тонкими ногами и длинным балахоном любое
    //  сгибание выглядит осадкой, а не движением. Магнитофон уже стоит на
    //  земле, персонаж включает его стоя: тычок носком — жест, а не поза.
    camera wide
    deck shows
    freeman pose "point"                   // потянулся к клавише
    wait 0.9s
    camera shake 0.2s intensity 1          // щелчок клавиши
    freeman pose "calm"
    wait 1.3s

    // ── УХОДИТ ПОД ПЕСНЮ: 12 секунд трека начинаются здесь ────────────────
    //  Уходит В ПРОФИЛЬ, влево, за кадр: спина к зрителю читалась бы обидой,
    //  профиль — просто «мне туда».
    //  Уходит МОЛЧА: слово кончилось, дальше говорит песня. Шаг идёт слоем —
    //  тем же, что и в остальных проходах, чтобы походка была одна на весь
    //  ролик.
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.88) over 6.0s
    freeman overlays "shag_bok_levoj"
    wait 1.2s
    freeman overlays "shag_bok_pravoj"
    wait 1.2s
    freeman overlays "shag_bok_levoj"
    wait 1.2s
    freeman overlays "shag_bok_pravoj"
    wait 1.2s
    freeman overlays "shag_bok_levoj"
    //  1.2s, а не 1.0: сумма ожиданий обязана сойтись с длиной проезда
    //  (6.0s). При 5.8 фигура вставала за 0.2 секунды до конца движения и эти
    //  два кадра ЕХАЛА СТОЯ — то самое «лишнее движение после хождения».
    wait 1.2s
    //  Проход ЗАКАНЧИВАЕТСЯ СТОЙКОЙ, а не шаговым слоем: слои держатся до
    //  полной позы, и последний кадр застывал на разведённых ногах — это
    //  читалось как «раскидывает ногами». Полная поза приставляет ногу.
    freeman pose "bok_levo"
    wait 1.2s
}

// ========================== СЦЕНА 8: ТИТРЫ ==================================
scene "titry" (duration: 6s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.2s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6
    stamp rotates -7
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 2.6s
    transition fade-black 0.8s
}
