// =============================================================================
//  «С ДРУГОЙ СТОРОНЫ» — интро к курсу «Личные границы».
//  VO — granicy-VO.md, маркеры 1..19.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН ИНАЧЕ, ЧЕМ ПЯТЬ ПРЕДЫДУЩИХ
//
//  1. ОН НИЧЕГО НЕ ДОКАЗЫВАЕТ. Четыре ролика «Логики» и первая версия «Границ»
//     открывались одинаково — «сейчас я докажу» — и вели цепочку к Q.E.D. К
//     пятому разу заход стал подписью автора, а не работой. Здесь проблема не
//     доказывается, а ОТЫГРЫВАЕТСЯ: первое, что слышит зритель, — не Фримен, а
//     чужая просьба и собственный ответ на неё.
//
//  2. КОНСТРУКЦИЯ — ЗЕРКАЛО, И ОНО ЛОМАЕТСЯ ПОСЕРЕДИНЕ. Первая половина
//     показывает человека, которого продавливают. Вторая — того же человека с
//     другого конца: он пишет второй раз, слышит в «занят» отвержение и не
//     замечает, что делает ровно то, от чего страдает. Возразить он уже не
//     может: согласие дано ДО переворота, на реплике «Знакомо?».
//
//  3. ПЕРЕВОРОТ ВИДЕН РАНЬШЕ, ЧЕМ СЛЫШЕН. Он совпадает с обрывом в чёрное:
//     смена стороны совпадает со сменой кадра, и глаз понимает приём раньше,
//     чем ухо разбирает слова.
//
//  4. СМЕХА НА ПЕРЕВОРОТЕ НЕТ И НЕ БУДЕТ. Смеховая точка там сняла бы стыд,
//     ради которого всё построено, — а стыд здесь рабочий, он и есть дверь в
//     курс. Смех разрешён только ПОСЛЕ того, как ход отдан (сцена черты), и
//     только про чужой способ: «вычеркнуть всех и лечь на диван». Предел
//     назван в добивке — свободы хватает до темноты (`SMESHNO.md` §XII).
//
//  5. ЧЕТЫРЕ ЛОКАЦИИ ИЗ СЕМИ НАРИСОВАНЫ ПОД ЭТОТ РОЛИК. Прежняя версия стояла
//     на заимствованиях: улица вместо коридора, два стула вместо погасшего
//     экрана, две тропы вместо черты. Локация обязана ДОКАЗЫВАТЬ реплику, а не
//     подходить по настроению.
//
//     КРАСНАЯ ЧЕРТА — ЕДИНСТВЕННЫЙ ЦВЕТ ВО ВСЁМ РОЛИКЕ, И ЭТО ЗАМЕРЕНО.
//     Монохромный проход пропускает насквозь пиксели с разбросом каналов
//     больше 55: коридор, кухня и погасший экран дали ровно НОЛЬ таких
//     пикселей, черта — 2.36% кадра на высоте 0.710..0.736. Цвет появляется
//     ровно один раз и ровно там, где назван ход.
//
//     У ПОГАСШЕГО ЭКРАНА НЕТ КАРТЫ ПОЛА, И ЭТО НЕ НЕДОРАБОТКА: в кадре стол у
//     правого края и глухая светлая стена, линии пола не существует вовсе.
//     Фигура ставится БЕЗ `on floor`, масштабом вручную — как в чёрных сценах.
//
//  6. НОМЕР КУРСА — ВОСЕМЬ, ПРИСВОЕН СТУДИЕЙ. Восьмёрка нарисована под серию
//     (`props/nomer-08.svg`) — две незамкнутые петли, верхняя уже нижней, как
//     выходит у руки, а не у шрифта.
//
//     ПРАВИЛО ПРОПА НА ТЕЛЕ: он живёт в координатах КАДРА, а не на фигуре, и
//     потому существует только пока камера неподвижна. Голый `scales` на пропе,
//     до которого не было АНИМИРОВАННОЙ смены масштаба, не применяется вовсе —
//     метка встаёт в натуральную величину и закрывает торс. Рабочий рисунок
//     один: спрятать, показать, вырастить с 0.02. Отсюда же следует, что на
//     нулевом кадре метки быть не может — значит и в последнем её нет, иначе
//     при зацикливании виден шов.
//
//  7. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): зеркальная
//     цепочка 6.3, дно 4.4 — перепад в полтора раза. Ухо слышит не скорость, а
//     смену скорости.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/mouth_ownership.py);
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` РАСЧЁТНЫЕ — ролик новый. Модель «0.59 с на внутренний
//  знак», поправленная коэффициентом 0.93. Модель врёт неравномерно по битам
//  (`KONVEJER.md` §4.1); завод перепишет числа по факту.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set koridor from "../assets/sets/koridor-lovushka.svg"
import set kuhnya from "../assets/sets/kuhnya-tri-kruga.svg"
import set void from "../assets/sets/void-black.svg"
import set ekran from "../assets/sets/ekran-pogas.svg"
import set detskaya from "../assets/sets/detskaya.svg"
import set cherta from "../assets/sets/porog-cherta.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: КОРИДОР-ЛОВУШКА — ПРОСЬБА И ОТВЕТ ===================
//  ОДНА ДВЕРЬ ИЗ ПЯТИ ПРИОТКРЫТА, И КЛИН СВЕТА ЛЕЖИТ ПОПЕРЁК ПУТИ. Просьба
//  приходит между делом, на ходу, и мимо неё не пройти — положение читается
//  раньше первого слова.
scene "koridor" (duration: 1s, set: koridor) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании, и
    //  вспышка помех на ней заметнее любого шва.
    //  Пол коридора уходит в перспективу (карта: back_y 0.589) — фигура
    //  ставится к переднему краю, иначе окажется в стене.
    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer scales 0.19 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ (разбор — п.6
    //  в шапке). Метка проявляется через четверть секунды после стыка и
    //  снимается до первого движения камеры.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.21 over 0.05s ease-out
    nomer scales 0.19 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): чужая просьба и собственный ответ ─────────────────
    //  ДВА ГОЛОСА ДЕЛАЮТСЯ РАЗНОСТЬЮ, А НЕ АКТЁРСТВОМ: просьба бодрая и
    //  близкая, ответ тише и на полтона ниже. Это не диалог двоих — это
    //  запись, которую зритель узнаёт. Пережмёшь — станет пародией.
    //  Тело почти неподвижно: жест на просьбе выдал бы, что просят не его.
    //lip 1
    together {
        freeman speaks for 5.77s
        do {
            freeman overlays "hips"
            wait 2.37s
            freeman overlays "k_sebe"      // «Да, конечно» — рука уже согласилась
            wait 1.74s
            freeman overlays "ostyl"
        }
    }
    wait 0.4s

    // ── ХУК-ДОБИВКА (VO-2): кто именно это сказал ─────────────────────
    //  БУДНИЧНО, КАК СООБЩАЮТ ФАКТ. Ни капли сочувствия: посочувствуешь —
    //  зритель успокоится и сойдёт с крючка на второй секунде.
    //lip 2
    together {
        freeman speaks for 3.71s
        do {
            camera medium freeman
            wait 1.9s
            freeman overlays "obvinil"     // «это сказали вы» — в зрителя
        }
    }
    wait 0.8s

    // ── ОТРИЦАНИЕ (VO-3): самое лестное объяснение отнимают ───────────
    //  ВОЗРАЖЕНИЕ ЗАКРЫВАЕТСЯ ДО КРУГА, А НЕ ПОСЛЕ. Первое, чем зритель
    //  защищается, — «я согласился, потому что я добрый»; пока это цело,
    //  дальше слушают вполуха. Отнимают без укора и одной строкой — и заодно
    //  кладут в ролик слово ВЫБОР, на котором стоит вся вторая половина.
    //lip 3
    together {
        freeman speaks for 2.97s
        do {
            freeman overlays "klin"        // «доброта выбирает»
        }
    }
    camera wide
    wait 0.5s
}

// ============ СЦЕНА 2: НОЧНАЯ КУХНЯ — ТРИ КРУГА ============================
//  СТОЛ СДВИНУТ К КРАЮ, ЦЕНТР ПУСТ. Человек остаётся один со своей злостью, а
//  не сидит за столом: круг замыкается стоя, посреди кухни, и выйти из него
//  некуда.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.15s

    //  Пол начинается низко (карта: back_y 0.799) — фигура встаёт в пустую
    //  правую треть кадра, а не к столу.
    place freeman at (0.58, 0.94) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПУЛЕМЁТ (VO-4): три коротких удара подряд ─────────────────────
    //  КАЖДАЯ ФРАЗА ТИШЕ ПРЕДЫДУЩЕЙ — КРУГ СУЖАЕТСЯ. Слой на каждую фразу,
    //  и все три с одной стороны: тело не разворачивается, потому что
    //  повернуться в этом круге не к кому.
    //lip 4
    together {
        freeman speaks for 3.92s
        do {
            freeman overlays "vzglyad"     // «злость на него»
            wait 1.3s
            freeman overlays "k_sebe"      // «потом на себя»
            wait 1.2s
            freeman overlays "ostyl"       // «стыд за злость»
        }
    }
    wait 0.4s

    // ── УДАР (VO-5): согласие, на котором держится переворот ──────────
    //  ВОПРОС ВВЕРХ, НО БЕЗ НАЖИМА. Это приглашение кивнуть, а не упрёк:
    //  кивок нужен ДО переворота, иначе вторая половина ролика будет
    //  спорить с человеком, который ещё ни с чем не согласился.
    //lip 5
    together {
        freeman speaks for 4.00s
        do {
            camera medium freeman
            wait 2.25s
            freeman overlays "vozzvanie"   // «Знакомо?» — вопрос повисает
        }
    }
    camera wide
    //  САМАЯ ДЛИННАЯ ПАУЗА ПЕРВОЙ ПОЛОВИНЫ. В неё входит кивок зрителя, и
    //  только на нём работает следующая сцена.
    wait 1.2s
}

// ============ СЦЕНА 3: ПУСТОТА — ПЕРЕВОРОТ =================================
//  СМЕНА СТОРОНЫ СОВПАДАЕТ СО СМЕНОЙ КАДРА. Ни кухни, ни коридора: приём
//  работает глазами раньше, чем ухо разберёт слова.
scene "perevorot" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── РАЗВОРОТ (VO-6): вся конструкция в одной строке ───────────────
    //  РОВНО, ПОЧТИ БУДНИЧНО. Это не обвинение, а разворот камеры; нажмёшь
    //  голосом — зритель услышит приговор себе и начнёт защищаться вместо
    //  того, чтобы смотреть.
    //lip 6
    together {
        freeman speaks for 3.52s
        do {
            freeman overlays "calm"
            wait 2.0s
            freeman overlays "dve_storony"  // «только с другой стороны»
        }
    }
    wait 0.8s
}

// ============ СЦЕНА 4: ПОГАСШИЙ ЭКРАН — ЗЕРКАЛО ============================
//  ТЕЛЕФОН НА СТОЛЕ, ЭКРАН ПУСТОЙ И СВЕТИТ В НИКУДА. Единственное, что
//  связывает с другим человеком, — и оно молчит. Здесь зритель видит себя с
//  другого конца той же сцены, и возразить ему нечем: он уже кивнул.
scene "zerkalo" (duration: 1s, set: ekran) {
    transition static 0.15s

    //  КАРТЫ ПОЛА У ЛОКАЦИИ НЕТ (разбор — п.5 в шапке): линии пола в кадре не
    //  существует, поэтому `place` БЕЗ `on floor`, масштаб вручную. Без карты
    //  якорь стоит НЕ У СТУПНЕЙ, и y 0.88 уводило фигуру за нижнюю кромку —
    //  в кадре оставались голова и плечи. Числа сняты пробным контактным
    //  листом: 0.45 и 1.20 дают рост в полный кадр слева от стола.
    place freeman at (0.30, 0.45) facing front
    freeman scales 1.20 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕПОЧКА (VO-7): очередь коротких ударов ───────────────────────
    //  ТЕМП РАСТЁТ, 6.3 СЛОГ/С — САМОЕ БЫСТРОЕ МЕСТО РОЛИКА. Три фразы, три
    //  слоя, между ними ничего: пауза здесь вернула бы зрителю время на
    //  оправдание.
    //lip 7
    together {
        freeman speaks for 3.75s
        do {
            freeman overlays "razvel"      // «вы написали»
            wait 1.2s
            freeman overlays "somnenie"    // «не ответили»
            wait 1.2s
            freeman overlays "poimal"      // «вы написали ещё раз»
        }
    }
    wait 0.35s

    // ── ЦЕПОЧКА (VO-8): свой голос с чужой интонацией ─────────────────
    //  ЗДЕСЬ ЗРИТЕЛЬ СЛЫШИТ СЕБЯ — так же, как в первой реплике ролика, но с
    //  другого конца. Нажмёшь — станет передразниванием, и он отскочит от
    //  собственной фразы.
    //lip 8
    together {
        freeman speaks for 2.72s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "prishchur"   // «Обиделся, что ли?»
        }
    }
    wait 0.4s

    // ── УДАР (VO-9): самая точная реплика ролика ──────────────────────
    //  ДВЕ ПОЛОВИНЫ РАЗВЕДЕНЫ ПАУЗОЙ: сначала что сказали, потом что дошло.
    //  Слитно механизм пропадёт — а он тут показан целиком и без единого
    //  термина: чужая граница воспринята как отвержение, потому что своей нет
    //  и мерить нечем.
    //lip 9
    together {
        freeman speaks for 4.83s
        do {
            freeman overlays "vzglyad"
            wait 2.68s
            freeman overlays "ostyl"       // «ты мне не нужен»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 5: ПУСТОТА — МЕХАНИЗМ ==================================
//  МЕХАНИЗМ НАЗЫВАЕТСЯ ТАМ, ГДЕ НЕЧЕМ ОТВЛЕЧЬСЯ. Тот же чёрный кадр, что и на
//  перевороте: обе стороны названы в одном месте, и это видно.
scene "mehanizm" (duration: 1s, set: void) {
    transition static 0.12s

    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── ПРИГОВОР (VO-10): констатация симметрии ───────────────────────
    //  РОВНО, БЕЗ НАЖИМА. Обвинения в реплике нет — есть симметрия, и
    //  предъявить её можно только спокойно: обвинишь голосом, и зритель
    //  начнёт защищаться вместо того, чтобы узнавать себя.
    //lip 10
    together {
        freeman speaks for 4.52s
        do {
            freeman overlays "dve_storony"  // «там продавили вас»
            wait 2.2s
            freeman overlays "obvinil"      // «здесь продавливаете вы»
        }
    }
    wait 0.5s

    // ── ЦЕНА (VO-11): одна поломка, две видимости ─────────────────────
    //  ОБЕ ПОЛОВИНЫ ПРОИЗНОСЯТСЯ ОДИНАКОВО — В ЭТОМ ВЕСЬ СМЫСЛ. Не «он не
    //  умеет отказывать» плюс «он навязчив»: различение «моё / не моё» либо
    //  работает сразу в обе стороны, либо не работает ни в одну.
    //lip 11
    together {
        freeman speaks for 7.73s
        do {
            freeman overlays "vzves"        // «не умеете сказать»
            wait 4.17s
            freeman overlays "klin"         // «не умеете и услышать»
        }
    }
    freeman overlays "flash_pupils"
    //  ДИАГНОЗ ПОСТАВЛЕН. Сейчас скажут, что с ним делать, и зритель должен
    //  успеть этого захотеть.
    wait 1.0s
}

// ============ СЦЕНА 6: ДЕТСКАЯ — СНЯТИЕ ВИНЫ ===============================
//  ОТВЕТ ПОКАЗАН РАНЬШЕ, ЧЕМ ПРОИЗНЕСЁН. Впервые за ролик светло и впервые
//  тепло: здесь снимают вину, а не ставят диагноз. Без этой сцены зритель
//  уходит пристыжённым и не возвращается.
scene "detskaya" (duration: 1s, set: detskaya) {
    transition static 0.2s

    //  Пол начинается низко (карта: back_y 0.764) — фигура ближе к переднему
    //  краю комнаты.
    place freeman at (0.48, 0.93) facing front on floor
    freeman scales 0.76 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОТРИЦАНИЕ (VO-12): это не характер ────────────────────────────
    //  ВПЕРВЫЕ ТЕПЛЕЕ. Не «ты слабый», а «тебя переучили» — то, ради чего
    //  курс покупают. Диагноз здесь снимается, а не подтверждается.
    //lip 12
    together {
        freeman speaks for 3.50s
        do {
            freeman overlays "otmahnulsya" // «не характер»
            wait 1.89s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    // ── ОБРАЗ (VO-13): доказательство, что кнопка работала ────────────
    //  ЖИВО, ПОЧТИ С УЛЫБКОЙ: двухлетка отказывал безупречно и ни на одном
    //  курсе не был. Это не утешение — это единственное доказательство, что
    //  ход вообще возможен.
    //lip 13
    together {
        freeman speaks for 3.97s
        do {
            camera medium freeman
            wait 2.14s
            freeman overlays "palec_vverh" // «без всяких курсов»
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 7: ЧЕРТА НА ПОЛУ — ХОД И ШУТКА =========================
//  ГРАНИЦА ПЕРЕСТАЁТ БЫТЬ СЛОВОМ И СТАНОВИТСЯ ВЕЩЬЮ. Красная черта лежит
//  поперёк кадра на высоте 0.714..0.736 — единственное цветное пятно ролика.
//  Фигура стоит ЗА ней, со своей стороны: линия оказывается между зрителем и
//  человеком, и обе её стороны видны сразу.
scene "cherta" (duration: 1s, set: cherta) {
    transition static 0.25s

    //  Дальний край пола на y 0.517; ставить можно ДО черты (y<0.71) или ЗА
    //  ней (y>0.74). Здесь — ДО: черта ложится между зрителем и человеком и
    //  видна целиком. Масштаб 1.05 при глубине 0.72 даёт в кадре 0.76 —
    //  сравнимо с остальными сценами; 0.58 давало фигурку вдвое мельче.
    place freeman at (0.44, 0.70) facing front on floor
    freeman scales 1.05 over 0.01s
    camera wide
    freeman pose "think"
    wait 0.3s

    // ── ВЗЛЁТ (VO-14): ход отдают, а не продают ───────────────────────
    //  СПОКОЙНО, С ДОСТОИНСТВОМ, БЕЗ ТОРЖЕСТВА В ГОЛОСЕ. Главное здесь —
    //  «сразу обе»: своя граница и чужая ставятся одним движением, а не двумя
    //  курсами.
    freeman pose "calm"
    //lip 14
    together {
        freeman speaks for 4.93s
        do {
            freeman overlays "raspahnul"   // «кнопку ставят обратно»
            wait 2.4s
            freeman overlays "vzves"       // «своя и чужая»
        }
    }
    wait 0.8s

    // ── ШУТКА (VO-15): самое популярное НЕ-решение ────────────────────
    //  ЛЁГКАЯ ИРОНИЯ, БЕЗ ПРЕВОСХОДСТВА. Смеются над способом, а не над
    //  человеком: «вычеркнуть всех» — это то, что советуют бесплатно и
    //  повсюду, и оно даже работает.
    //lip 15
    together {
        freeman speaks for 3.76s
        do {
            freeman overlays "otmahnulsya" // «вычеркнуть всех»
            wait 1.97s
            freeman overlays "prishchur"
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-16): у способа назван предел ────────────────
    //  ШУТКА ОБЯЗАНА НАЗЫВАТЬ ПРЕДЕЛ, ИНАЧЕ ЭТО НАСМЕШКА. Способ работает —
    //  ровно до темноты, а дальше идёт тот же круг, что и в начале
    //  ролика. Подчеркнёшь предел голосом — станет насмешкой над зрителем.
    //lip 16
    together {
        freeman speaks for 4.02s
        do {
            camera medium freeman
            wait 2.24s
            freeman overlays "poimal"      // «тот же круг»
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 8: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ==========================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ. Деловой тон, как объявляют пункт, — в
//  этом ролике продаёт не обещание, а всё, что было сказано до.
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "raskryl"
    wait 0.2s

    // ── ПРЕЗЕНТАЦИЯ (VO-17): имя курса и объём ────────────────────────
    freeman pose "calm"
    //lip 17
    together {
        freeman speaks for 3.47s
        do {
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            wait 1.85s
            freeman overlays "open"          // «Десять лекций»
        }
    }
    wait 0.5s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-18): цена ────────────────────────────
    //  ОТДЕЛЬНОЙ РЕПЛИКОЙ И ПОСЛЕ ПАУЗЫ, А НЕ ХВОСТОМ ПРЕДЫДУЩЕЙ. Внутри
    //  длинной строки «бесплатно» проскакивает мимо уха вместе с названием и
    //  числом; вынесенное отдельно — слышится. Повтор числа («десять лекций»
    //  → «все десять») и держит эту реплику: он отвечает на немой вопрос
    //  «все или первая», не задавая его вслух.
    //
    //  ГОЛОСОМ НЕ НАЖИМАТЬ. Бесплатное, объявленное с нажимом, читается как
    //  подвох, и зритель начинает искать, где ловушка. Сообщается ровно тем
    //  же будничным тоном, что и число лекций, — как пункт, а не как акция.
    //lip 18
    together {
        freeman speaks for 1.81s
        do {
            freeman overlays "razvel"        // «все десять — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 9: ПОГАСШИЙ ЭКРАН — ЖАЛО ===============================
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ВИДЕН ОТВЕТ: тот же стол, тот же пустой экран, что и
//  в зеркальной половине. Не «подумайте о границах», а точная дата и точный
//  адресат — они у зрителя есть, и они ему не понравятся.
scene "zhalo" (duration: 1s, set: ekran) {
    transition static 0.2s

    place freeman at (0.30, 0.45) facing front
    freeman scales 1.20 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-19) ──────────────────────────────────────────────────
    //lip 19
    together {
        freeman speaks for 2.37s
        do {
            camera medium freeman
            wait 1.3s
            freeman overlays "vozzvanie"   // «второй раз?» — вопрос повисает
        }
    }
    camera wide
    freeman overlays "hero_wink"
    wait 1.3s
}

// ============ СЦЕНА 10: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ ================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: тот же коридор, тот же `place`, тот же
//  масштаб, та же поза поглаживания. Отличается только то, чего не видно, —
//  звучащая реплика. Метка курса проявляется и здесь, и в первом кадре
//  одинаково, а снимается до стыка — потому шва не возникает.
scene "final" (duration: 1s, set: koridor) {
    transition static 0.2s

    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide

    let nomer2 = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer2 scales 0.19 over 0.01s
    nomer2 hides

    //lip 20
    together {
        freeman speaks for 4.69s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Позы поглаживания трогают
            //  только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 1.9s
            nomer2 shows
            nomer2 scales 0.02 over 0.01s
            nomer2 scales 0.21 over 0.29s ease-out
            nomer2 scales 0.19 over 0.15s
            freeman overlays "gladit_grud_niz"
            wait 0.8s
            freeman overlays "gladit_grud"
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания, ГРУДЬ ПУСТАЯ —
    //  ровно то, с чего ролик начинается.
    nomer2 hides
    freeman pose "gladit_grud"
    wait 0.4s
}
