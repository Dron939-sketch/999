// =============================================================================
//  «ДВАДЦАТЬ ЛЕТ» — интро к курсу «Личные границы».
//  VO — granicy-VO.md, маркеры 1..25.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН ИНАЧЕ, ЧЕМ ТРИ ПРЕДЫДУЩИХ
//
//  1. В НЁМ НЕТ ЛОЖНОЙ ПОСЫЛКИ, И ЭТО СОЗНАТЕЛЬНО. В «Логике» ролик доказывал
//     абсурд, а потом показывал, где подменили вход. Здесь доказательство
//     верно ЦЕЛИКОМ, опровергать нечего: «да», которое нельзя не сказать,
//     действительно ничего не сообщает. Бьёт не разоблачение приёма, а то, КТО
//     обесценил согласия зрителя. Не начальник и не родня — его собственное
//     «всегда».
//
//  2. ЦЕПОЧКА ПРОВЕРЕНА НА ПРОЧНОСТЬ. Ответ одинаков во всех случаях → по нему
//     нельзя отличить желание от неспособности отказать → он не сообщает
//     ничего. Каждый шаг следует буквально, придраться не к чему. Ролик,
//     который доказывает зрителю что-то о нём самом, обязан быть безупречен:
//     иначе зритель отобьётся формой вместо содержания (реестр §XVI — на этом
//     уже обожглись однажды).
//
//  3. СЦЕНКА ВМЕСТО АНЕКДОТА. Три ролика «Логики» держал смехом анекдот про
//     зайца; четвёртый раз повторять нельзя — приём становится подписью
//     автора, а не работой. Здесь эскалация просьб, и она смешна по другой
//     причине: зритель узнаёт не чужого персонажа, а СВОЙ ГОЛОС. Панч не в
//     нелепости просьбы, а в том, что он слышит от себя: «ну, если надо».
//
//  4. РАЗВЯЗКИ У СЦЕНКИ НЕТ. Чем кончился отпуск — не говорится. Полторы
//     секунды тишины после панча, и в них входит «а вы уже согласились на то,
//     чего не выбирали» (`SMESHNO.md` §XII).
//
//  5. НОМЕР КУРСА — ВОСЕМЬ, ПРИСВОЕН СТУДИЕЙ. На сайте порядковый номер
//     «Личных границ» не проставлен, и до ответа студии метки в ролике не было
//     вовсе: выдуманная цифра ушла бы в ленту и разошлась с каталогом.
//     Восьмёрка нарисована под этот ролик (`props/nomer-08.svg`) — две
//     незамкнутые петли, верхняя уже нижней, как выходит у руки, а не у шрифта.
//
//     ПРАВИЛО ПРОПА НА ТЕЛЕ: он живёт в координатах КАДРА, а не на фигуре, и
//     потому существует только пока камера неподвижна. Голый `scales` на пропе,
//     до которого не было АНИМИРОВАННОЙ смены масштаба, не применяется вовсе —
//     метка встаёт в натуральную величину и закрывает торс. Рабочий рисунок
//     один: спрятать, показать, вырастить с 0.02. Отсюда же следует, что на
//     нулевом кадре метки быть не может — значит и в последнем её нет, иначе
//     при зацикливании виден шов.
//
//  6. ВОСЕМЬ ЛОКАЦИЙ НА ДВЕ С НЕБОЛЬШИМ МИНУТЫ — по две-три реплики на кадр
//     (`KONVEJER.md` §2.3). Каждая смена локации совпадает со сменой мысли:
//     просьбы звучат в коридоре голосов, определение даётся в чёрном, ход — на
//     развилке двух троп, жало — у двух стульев, второй из которых пуст.
//
//  7. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): хук 4.4, цепочка
//     6.3, просьбы 6.6, дно 4.4. Перепад в полтора раза стоит на обрыве в
//     чёрное после панча.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` РАСЧЁТНЫЕ — ролик новый. Модель «0.59 с на внутренний
//  знак», поправленная коэффициентом 0.93. Модель врёт неравномерно по битам
//  (`KONVEJER.md` §4.1); завод перепишет числа по факту.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set stol from "../assets/sets/stol-posle-gostej.svg"
import set rupory from "../assets/sets/logika-hor-golosov.svg"
import set void from "../assets/sets/void-black.svg"
import set ulica from "../assets/sets/biznes-street.svg"
import set tropy from "../assets/sets/dve-tropy.svg"
import set stulya from "../assets/sets/dva-stula.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: СТОЛ ПОСЛЕ ГОСТЕЙ — ОБЪЯВЛЕНИЕ ======================
//  ВСЕ УШЛИ, УБИРАТЬ ВАМ. Положение читается раньше темы и раньше первого
//  слова: человек один среди чужой посуды. Ролику про безотказность не нужен
//  ни один кадр объяснения — достаточно этого.
scene "stol" (duration: 1s, set: stol) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании, и
    //  вспышка помех на ней заметнее любого шва.
    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer scales 0.19 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ (разбор — п.5
    //  в шапке). Метка проявляется через четверть секунды после стыка и
    //  снимается до первого движения камеры.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.21 over 0.05s ease-out
    nomer scales 0.19 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): «докажу, что вы никому не помогли» ────────────────
    //  САМАЯ МЕДЛЕННАЯ РЕПЛИКА РОЛИКА — 4.4 слог/с, и произносится БЕЗ
    //  вызова. С вызовом это оскорбление, и зритель уходит на второй
    //  секунде. Здесь сообщают результат подсчёта, а не обвиняют.
    //lip 1
    together {
        freeman speaks for 5.75s
        do {
            freeman overlays "hips"
            wait 2.3s
            freeman overlays "vzglyad"     // «и так все двадцать лет»
        }
    }
    wait 0.9s

    // ── ПОСЫЛКА И ПЕТЛЯ (VO-2): «запомните это слово» ─────────────────
    //  ОТКРЫТАЯ ПЕТЛЯ. Зритель получает задание и держит его до самого удара;
    //  всё, что между, слушается внимательнее, потому что обещано
    //  продолжение (`PRODAZHA.md`).
    //lip 2
    together {
        freeman speaks for 5.74s
        do {
            camera medium freeman
            wait 2.5s
            freeman overlays "obvinil"     // «запомните это слово» — в зрителя
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 2: КОРИДОР РУПОРОВ — ЦЕПОЧКА ПРОСЬБ ====================
//  ПРОСЬБЫ ЗВУЧАТ ОТОВСЮДУ И ВСЕ ОДИНАКОВО УБЕДИТЕЛЬНЫ. Локация доказывает
//  реплику: из каждой трубы своё «выручи», и ни одна не спрашивает, можете ли
//  вы. Персонаж идёт НА КАМЕРУ — просьбы не отдаляют, они подступают.
scene "prosby" (duration: 1s, set: rupory) {
    transition static 0.15s

    //  Пол коридора начинается высоко (карта: back_y 0.60) — фигура ставится
    //  вглубь прохода.
    place freeman at (0.5, 0.68) facing front on floor
    freeman scales 0.46 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕПОЧКА, ЗВЕНО 1 (VO-3): три просьбы подряд ───────────────────
    //  ШАГ И НАЕЗД ОДНОВРЕМЕННО, ПО ОДНОМУ НА ПРОСЬБУ. Записанные подряд,
    //  `moves-to` и `scales` и выполняются подряд — в кадре это «подъехал, а
    //  потом раздулся». `together` внутри `do` связывает их в один отрезок.
    //  Числа идут равными приращениями: y +0.075, масштаб +0.12 за шаг.
    //lip 3
    together {
        freeman speaks for 5.25s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "k_sebe"      // «подменить?» — рука за ответом
            together {
                freeman moves-to (0.5, 0.755) over 1.2s
                freeman scales 0.58 over 1.2s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "razvel"      // «одолжить?»
            together {
                freeman moves-to (0.5, 0.83) over 1.2s
                freeman scales 0.70 over 1.2s
            }
            freeman overlays "shag_levoj"
            freeman overlays "somnenie"    // «посидеть с чужим ребёнком?»
            together {
                freeman moves-to (0.5, 0.905) over 1.2s
                freeman scales 0.82 over 1.2s
            }
            freeman overlays "shag_pravoj"
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты.
    freeman pose "calm"
    wait 0.4s

    // ── ЦЕПОЧКА, ЗВЕНО 2 (VO-4): «ответ один и тот же» ────────────────
    //lip 4
    together {
        freeman speaks for 4.05s
        do {
            freeman overlays "vzglyad"
            wait 1.9s
            freeman overlays "ostyl"
        }
    }
    wait 0.4s

    // ── ЦЕПОЧКА, ЗВЕНО 3 (VO-5): «хотели или не смогли отвертеться» ───
    //  ТЕМ ЖЕ ТЕМПОМ, БЕЗ СОЧУВСТВИЯ. Замедлишь — зритель услышит жалость и
    //  поймёт, что его ведут. Спуск обязан идти скоростью подъёма.
    //lip 5
    together {
        freeman speaks for 2.62s
        do {
            camera medium freeman
            wait 2.1s
            freeman overlays "dve_storony" // «вы предсказуемы»
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 3: ПУСТОТА — ОПРЕДЕЛЕНИЕ И ТОЧКА =======================
//  ПЕРЕЛОМ РОЛИКА НА 28-Й СЕКУНДЕ, И ОН СТАВИТСЯ В ЧЁРНОМ. Ни стола, ни
//  коридора: определение даётся там, где нечем отвлечься.
scene "opredelenie" (duration: 1s, set: void) {
    transition static 0.12s

    //  ЕДИНСТВЕННЫЕ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide
    freeman pose "v_upor"

    // ── РАЗВОРОТ (VO-6): «уже не согласие» ────────────────────────────
    //lip 6
    together {
        freeman speaks for 5.45s
        do {
            freeman overlays "calm"
            wait 2.7s
            freeman overlays "klin"        // «просят, чтобы вы захотели»
        }
    }
    wait 0.5s

    // ── УДАР (VO-7): «это автоматизм» ─────────────────────────────────
    //  ДВА СЛОВА И СЕКУНДА ТИШИНЫ. Самая короткая реплика ролика; всё, что
    //  можно было испортить, — это добавить к ней хоть что-нибудь.
    //lip 7
    together {
        freeman speaks for 2.33s
        do {
            freeman overlays "poimal"
        }
    }
    wait 1.0s

    // ── QED (VO-8): «ни одно не считается» ────────────────────────────
    //lip 8
    together {
        freeman speaks for 5.96s
        do {
            freeman overlays "vzglyad"
            wait 3.3s
            freeman overlays "ostyl"       // «а не за вас»
        }
    }
    freeman overlays "flash_pupils"
    wait 1.2s
}

// ============ СЦЕНА 4: ТОТ ЖЕ СТОЛ — КТО ОБЕСЦЕНИЛ =========================
//  «ТЕПЕРЬ ПРО ТО САМОЕ СЛОВО» ЗВУЧИТ ТАМ, ГДЕ ЕГО ОБЕЩАЛИ ЗАПОМНИТЬ. Не в
//  похожем кадре — в том же самом: та же локация, тот же `place`, тот же
//  масштаб. Зритель возвращается туда, откуда начал, вместе с фразой.
scene "vsegda" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕНА (VO-9): «теперь про то самое слово» ──────────────────────
    //lip 9
    together {
        freeman speaks for 2.87s
        do {
            freeman overlays "k_sebe"      // «теперь про то самое слово»
        }
    }
    wait 0.5s

    // ── УДАР (VO-10): «их обесценило ваше „всегда"» ───────────────────
    //  ЗДЕСЬ НЕТ РАЗОБЛАЧЕНИЯ ЧУЖОГО ПРИЁМА, И В ЭТОМ ОТЛИЧИЕ ОТ «ЛОГИКИ».
    //  Виноватого извне не будет. Поэтому реплика идёт БЕЗ нажима: обвинишь
    //  голосом — зритель начнёт защищаться и перестанет слушать.
    //lip 10
    together {
        freeman speaks for 7.99s
        do {
            camera medium freeman
            wait 2.8s
            freeman overlays "ostyl"       // «сами уже не знаете, чего хотели»
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 5: ДЕЛОВАЯ УЛИЦА — СЦЕНКА С ПРОСЬБАМИ ==================
//  МЕСТО, ГДЕ ПРОСЯТ «ВЫРУЧИТЬ». Сценка играется на ходу мимо чужих спин:
//  просьба всегда приходит между делом, и в этом её сила.
scene "scenka" (duration: 1s, set: ulica) {
    transition static 0.15s

    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── ОТРИЦАНИЕ (VO-11): «послушайте, как это звучит» ───────────────
    //lip 11
    together {
        freeman speaks for 5.55s
        do {
            freeman overlays "zakrylsya"   // «зато вы хороший человек?»
            wait 2.7s
            freeman overlays "prishchur"   // козырь
        }
    }
    wait 0.6s

    // ── СЦЕНКА, ПЕРВЫЙ ЗАХОД (VO-12) ──────────────────────────────────
    //  ДВА ГОЛОСА ДЕЛАЮТСЯ ПУНКТУАЦИЕЙ И ДЛИНОЙ ФРАЗЫ, а не актёрством: у
    //  просьбы вопрос целым предложением, у ответа — одно слово.
    freeman pose "calm"
    //lip 12
    together {
        freeman speaks for 3.76s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "poimal"      // «да» — второй раз подряд
        }
    }
    wait 0.35s

    // ── СЦЕНКА, ЭСКАЛАЦИЯ (VO-13): просьба доходит до нелепости ───────
    //  И ВСЁ ЕЩЁ ЗВУЧИТ БУДНИЧНО. Нелепость не подчёркивается ни голосом, ни
    //  жестом: подчеркнёшь — приём объявлен, и панча не будет.
    //lip 13
    together {
        freeman speaks for 2.66s
        do {
            freeman overlays "razvel"      // «мне путёвка горит»
        }
    }
    camera wide
    //  ПАУЗА ПЕРЕД ПАНЧЕМ — САМА ПО СЕБЕ ПРИЁМ. Полторы секунды зритель уже
    //  знает, что сейчас будет сказано, и успевает узнать себя.
    wait 1.4s

    // ── ПАНЧ (VO-14): «ну, если надо» ─────────────────────────────────
    //  СВОИМ ГОЛОСОМ И ТИШЕ ПРОЧЕГО. До этого звучали чужие просьбы бодро, а
    //  здесь человек слышит СЕБЯ. Нажмёшь — станет передразниванием, и
    //  зритель отскочит от собственной фразы.
    //  Тело почти неподвижно: жест на ударном слове крадёт слово.
    freeman pose "v_upor"
    //lip 14
    together {
        freeman speaks for 4.28s
        do {
            freeman overlays "vzglyad"
            wait 2.0s
            freeman overlays "doshlo"      // «ну, если надо»
        }
    }
    //  РАЗВЯЗКИ НЕТ: чем кончился отпуск — не говорится ни словом.
    wait 1.6s
}

// ============ СЦЕНА 6: ПУСТОТА — ДНО =======================================
//  СМЕХ ГАСНЕТ ЗДЕСЬ, И ЭТО ЗАПЛАНИРОВАНО. Обрыв в чёрное сразу после панча:
//  между «смешно» и «это про меня» должна быть не связка, а разрыв.
scene "dno" (duration: 1s, set: void) {
    transition static 0.12s

    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide
    freeman pose "v_upor"

    // ── ПРИГОВОР (VO-15) ──────────────────────────────────────────────
    //lip 15
    together {
        freeman speaks for 5.11s
        do {
            freeman overlays "calm"
            wait 2.4s
            freeman overlays "obvinil"     // «чего не выбирали» — в зрителя
        }
    }
    wait 0.5s

    // ── ДНО (VO-16): «предсказуемым» ──────────────────────────────────
    //  ДВЕ ФРАЗЫ РАЗВЕДЕНЫ ПАУЗОЙ НАМЕРЕННО. Первая снимает утешение
    //  («нужным»), вторая ставит диагноз. Между ними зритель и проваливается.
    //lip 16
    together {
        freeman speaks for 4.99s
        do {
            wait 2.5s
            freeman overlays "klin"        // «удобнее»
        }
    }
    freeman overlays "flash_pupils"
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА. Диагноз поставлен; сейчас скажут, что с ним
    //  делать, и зритель должен успеть этого захотеть.
    wait 1.8s
}

// ============ СЦЕНА 7: ДВЕ ТРОПЫ — ХОД =====================================
//  «ДА» И «НЕТ» КАК ДВЕ ДОРОГИ. Пока есть вторая, первая что-то значит — это
//  весь тезис ролика, и он виден картинкой раньше слов. Здесь впервые за ролик
//  светло и впервые звучит тепло.
scene "tropy" (duration: 1s, set: tropy) {
    transition static 0.25s

    //  Пол начинается очень высоко (карта: back_y 0.118) — фигура ставится
    //  ближе к переднему краю, иначе окажется в небе.
    place freeman at (0.44, 0.93) facing front on floor
    freeman scales 0.82 over 0.01s
    camera wide
    freeman pose "think"
    wait 0.4s

    // ── ВЗЛЁТ 1 (VO-17): «не для того, чтобы отгородиться» ────────────
    //  ВОЗРАЖЕНИЕ СНИМАЕТСЯ ДО ТОГО, КАК ПРОЗВУЧИТ. У зрителя «границы»
    //  связаны со стеной и эгоизмом; не назовёшь это вслух — он подумает сам
    //  и уйдёт. Курс отстраивается от того же лозунга в первой лекции.
    freeman pose "calm"
    //lip 17
    together {
        freeman speaks for 3.47s
        do {
            freeman overlays "otmahnulsya" // не стена
            wait 1.5s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    // ── ВЗЛЁТ 2 (VO-18): главная фраза ролика ─────────────────────────
    //  РАДИ ЭТОЙ СТРОКИ ВСЁ И СТРОИЛОСЬ. Отказ здесь не оружие и не защита:
    //  он то, что возвращает смысл согласию. Играется спокойно, с
    //  достоинством — торжества в голосе быть не должно.
    //lip 18
    together {
        freeman speaks for 3.83s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "raspahnul"   // ход открыт
        }
    }
    wait 0.6s

    // ── ВЗЛЁТ 3 (VO-19): «их согласие настоящее» ──────────────────────
    //lip 19
    together {
        freeman speaks for 5.48s
        do {
            freeman overlays "vzves"       // «каждым „да" что-то выбирает»
            wait 3.0s
            freeman overlays "palec_vverh"
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 8: ДВА СТУЛА — ЦЕНА ОТКАЗА И ЖАЛО ======================
//  КОНТАКТ ДВОИХ, И ВТОРОЙ СТУЛ ПУСТ. Ролик про то, что безотказный человек
//  становится предметом, кончается там, где предметов двое, а человек один.
scene "stulya" (duration: 1s, set: stulya) {
    transition static 0.2s

    //  Пол начинается высоко (карта: back_y 0.347) — фигура ближе к переднему
    //  краю, чтобы стулья остались в кадре рядом с ней.
    place freeman at (0.52, 0.92) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПОДЪЁМ (VO-20): «как диван, который всегда на месте» ──────────
    //  ЦЕНА ВМЕСТО МОРАЛИ, И СТОЛКНОВЕНИЕ РЕГИСТРОВ В ОДНОЙ СТРОКЕ. Высокое
    //  («смысл» на взлёте) встречается с бытовым («диван») — так и держится
    //  стиль серии. Сравнение обидное ровно настолько, чтобы стать смешным.
    //lip 20
    together {
        freeman speaks for 7.28s
        do {
            freeman overlays "otmahnulsya" // «можно и не начинать»
            freeman overlays "prishchur"
            wait 3.4s
            freeman overlays "razmer"      // «как диван, который всегда на месте»
        }
    }
    wait 0.4s

    // ── ПРЕДЕЛ (VO-21): «до первой субботы» ───────────────────────────
    //  ШУТКА ОБЯЗАНА НАЗЫВАТЬ ПРЕДЕЛ, ИНАЧЕ ЭТО НАСМЕШКА. Способ работает —
    //  ровно до субботы, которую человек не выбирал. Тогда счёт приходит, а
    //  предъявить его некому.
    //lip 21
    together {
        freeman speaks for 3.36s
        do {
            freeman overlays "u_viska_l"
            wait 1.6s
            freeman overlays "poimal"
        }
    }
    wait 1.2s
}

// ============ СЦЕНА 9: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ==========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "raskryl"
    wait 0.2s

    // ── ПРЕЗЕНТАЦИЯ 1 (VO-22) ─────────────────────────────────────────
    //lip 22
    together {
        freeman speaks for 4.14s
        do {
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            wait 2.0s
            freeman overlays "open"
        }
    }
    wait 0.4s

    // ── ПРЕЗЕНТАЦИЯ 2 (VO-23): «вернуть вес своему слову» ─────────────
    //  ОБЕЩАНИЕ СКРОМНОЕ И ПРОВЕРЯЕМОЕ. Не «вы научитесь отказывать всем», а
    //  «ваше слово снова будет весить». Обещай больше — не поверят ничему.
    //lip 23
    together {
        freeman speaks for 5.03s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "teplo"       // приглашение, а не продажа
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 10: ДВА СТУЛА — ЖАЛО ===================================
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ВИДЕН ОТВЕТ: второй стул пуст. «Остались собой» —
//  значит, остались, а не ушли вместе с теми, кто просил.
scene "zhalo" (duration: 1s, set: stulya) {
    transition static 0.2s

    place freeman at (0.52, 0.92) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-24) ──────────────────────────────────────────────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: на этот вопрос есть точная
    //  дата, и зритель её знает. Обычно она давняя.
    //lip 24
    together {
        freeman speaks for 3.36s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "vozzvanie"   // вопрос повисает
            freeman overlays "doshlo"
        }
    }
    camera wide
    freeman overlays "hero_wink"
    wait 1.8s
}

// ============ СЦЕНА 11: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ ================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: тот же стол после гостей, тот же
//  `place`, тот же масштаб, та же поза поглаживания. Отличается только то,
//  чего не видно, — звучащая реплика. Метка курса проявляется и здесь, и в
//  первом кадре одинаково, а снимается до стыка — потому шва не возникает.
scene "final" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide

    let nomer2 = prop("nomer", "../assets/props/nomer-08.svg") at (0.487, 0.70) layer 9
    nomer2 scales 0.19 over 0.01s
    nomer2 hides

    //lip 25
    together {
        freeman speaks for 5.91s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Позы поглаживания трогают
            //  только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.4s
            nomer2 shows
            nomer2 scales 0.02
            nomer2 scales 0.21 over 0.35s ease-out
            nomer2 scales 0.19 over 0.18s
            freeman overlays "gladit_grud_niz"
            wait 1.0s
            freeman overlays "gladit_grud"
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания, ГРУДЬ ПУСТАЯ —
    //  ровно то, с чего ролик начинается.
    nomer2 hides
    freeman pose "gladit_grud"
    wait 0.4s
}
