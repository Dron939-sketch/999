// =============================================================================
//  «ОСВОБОДИТЕ ЛИНИЮ» — интро к курсу «Стресс-менеджмент», номер 23.
//  VO — stress-VO.md, маркеры 1..19.
//
//  ОДНА МЫСЛЬ НА РОЛИК: вредит не стресс, а отсутствие возврата к покою.
//  Реакция, которая спасает за минуты, разрушает, если не выключается неделями.
//  Механизм исправен — не работает выключение.
//
//  РЕДАКЦИЯ МИНУТНАЯ. Первая шла 2:05 при двадцати девяти репликах; здесь их
//  девятнадцать и около 1:13. Резалось СОДЕРЖАНИЕ, не подача: паузы 1.8 с перед
//  догадкой и 1.2 с внутри опыта на месте, слоги в секунду по регистрам не
//  тронуты. Ушли сцена отпуска целиком, закон «спринт кончается — ваш нет»,
//  мерка после вопроса, три реплики презентации из четырёх, две сцены дня из
//  четырёх и адресат пересылки. Локаций стало четыре вместо шести.
//
//  1. ЯКОРЬ — ЭТО ТЕЗИС КУРСА, СПРЯТАННЫЙ В ПРИКАЗ. «Освободите линию. Вашу.» —
//     команда из чужой профессии: диспетчер говорит так связисту. Фраза
//     грамматически полна, а достроить её нечем — линии у зрителя нет. «Вашу»
//     отвечает только на «чья», но не на «что за линия», и загадка держится.
//     Посажена в первой секунде, не объясняется шестнадцать реплик, возвращена
//     ДОСЛОВНО в VO-18 и В ТОЙ ЖЕ ЛОКАЦИИ (STIL-FRIMENA.md §II.8–9).
//
//  2. РАЗРЫВ СТОИТ В ОБОИХ КАНАЛАХ. В тексте — приказ. В картинке — НАСТОЛЬНАЯ
//     ЛАМПА, которая горит во всех локациях: на кухне при свете дня, на кухне
//     ночью, в зале. Предмет исправен и не на своём месте. Её никто не трогает
//     и НИ РАЗУ НЕ НАЗЫВАЕТ СЛОВОМ — назвать значит объяснить якорь. Проп
//     нарисован вручную: генератор рисует локацию целиком, а тут нужна одна
//     вещь поверх готового кадра.
//
//  3. ТРЕТИЙ КАНАЛ — ЗВУК. Свисток чайника вступает на восьмой секунде и не
//     смолкает до перелома: то же «включилось и не выключается», но ухом.
//     Выключить его никто не приходит.
//
//  4. КОЛЬЦО ЗАКРЫВАЕТСЯ ЦЕЛИКОМ. Ролик в ленте зациклен: на втором круге
//     «освободите линию» значит уже не «какую линию?», а «линия — это я, и она
//     занята с утра». Смысл перевёрнут, вес вырос — потому кадр и фраза
//     обязаны сойтись в одном месте.
//
//  5. ПАУЗА 1.8 с ПОСЛЕ VO-18 — НЕ ВОЗДУХ, А РАБОЧЕЕ ВРЕМЯ ЗРИТЕЛЯ. И пауза
//     1.2 с внутри опыта с плечами (VO-11 → VO-12) той же природы: срежется —
//     и шутка окажется рассказанной, а не проделанной на зрителе.
//
//  6. ЦВЕТ ЖИВЁТ В ЛОКАЦИИ, А НЕ В ПРОПЕ. Гейт `tools/cvet.py` считает цветное
//     пятно только по локациям, реквизит он не видит. Поэтому тёплая лужа
//     света лежит в самой кухне (`stress-kuhnya-lampa`, 0.13% кадра), а лампа
//     поверх неё — тушь без цвета, одна и та же во всех локациях.
//
//  7. ФИНАЛ УХОДИТ В ТИШИНУ. Комната замолкает на возврате якоря и больше не
//     возвращается. Метить окном в паузу бесполезно: таймлайн, который реально
//     рендерится, собирает липсинк уже внутри CI, и снаружи его не увидеть
//     (реестр §XXXIX). Тишина до конца файла надёжна по построению.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ и НЕ ЛОЖИТСЯ (tools/posture.py) — в VO-5 «тело в
//      кровати» сказано словом, а в кадре персонаж стоит;
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после; мимику полной позой не ставим вовсе (tools/speech_lint.py);
//    · локация с мерой человека ниже 0.5 не годится для говорящей сцены
//      (реестр §XL) — поэтому поля и дороги в минутной редакции нет вовсе.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`).
//  Завод перепишет их по факту озвучки.
// =============================================================================
//
//  МИЗАНСЦЕНЫ ПРОСМОТРЕНЫ: 98311f96
import character freeman from "../assets/characters/freeman_rig"
import set kuhnya from "../assets/sets/stress-kuhnya-lampa.svg"
import set noch from "../assets/sets/kuhnya-noch.svg"
import set pustota from "../assets/sets/pustota-bumaga.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    //  Снег 0.12, как в «Лебеде»: при 0.2 рябь рвёт маску на крапины и
    //  приёмка по готовому файлу перестаёт находить фигуру.
    snow: 0.12
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}


// ============ СЦЕНА 1: kuhnya — ЯКОРЬ ПОСАЖЕН ============================
//  Кухня утром: чайник на плите, стол справа. На столешнице лежит тёплая лужа
//  света, и над ней горит лампа — при полном дневном свете. Объяснять её
//  никто не будет.
scene "s1" (duration: 1s, set: kuhnya) {
    place freeman at (0.44, 0.95) facing front on floor
    freeman scales 1.10 over 0.01s

    let lampa = prop("lampa", "../assets/props/lampa.svg") at (0.816, 0.415) layer 6
    lampa scales 1.00 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-23.svg") at (0.465, 0.545) layer 9
    nomer scales 0.17 over 0.01s
    nomer hides
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.19 over 0.05s ease-out
    nomer scales 0.17 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"
    wait 0.1s

    //lip 1
    //  «Освободите линию. Вашу.» — БЕЗ РАЗГОНА, как команду в чужую смену.
    //  `stop_ladon` — раскрытая ладонь: жест «стой», а не «слушай». Он и
    //  делает фразу приказом раньше, чем её разберут на слова.
    together {
        freeman speaks for 2.32s
        do {
            freeman overlays "stop_ladon"
            wait 1.5s
            freeman overlays "vzglyad"
        }
    }
    camera medium freeman
    wait 0.45s

    //lip 2
    //  «И стресс тут ни при чём.» — ролик про стресс второй репликой снимает
    //  стресс с обвинения. Вниз, но как вызов тому, с чем зритель пришёл.
    together {
        freeman speaks for 1.65s
        do {
            freeman overlays "otmahnulsya"
            wait 0.9s
            freeman overlays "somnenie"
        }
    }
    wait 0.45s

    freeman pose "calm"
    wait 0.15s

    //lip 3
    //  «Он не враг, а сигнал.» — закрывает защиту «надо меньше нервничать».
    together {
        freeman speaks for 2.00s
        do {
            freeman overlays "palec_vverh"
            wait 1.1s
            freeman overlays "manit"
        }
    }
    camera wide
    wait 0.45s

    //  ПЕРЕМЕЩЕНИЕ ПО КАДРУ. Ролик о том, что человек не останавливается, — и
    //  один проход в нём обязан быть, иначе шесть сцен подряд стоят на месте.
    freeman overlays "turn34"
    wait 0.1s
    freeman pose "shag_pravoj"
    wait 0.12s
    freeman moves-to (0.58, 0.95) over 0.5s ease-in-out
    freeman pose "shag_levoj"
    wait 0.12s
    freeman pose "calm"
    wait 0.1s

    //lip 4
    //  «Утро. Чайник свистит третью минуту.» — первая из двух сцен дня. Ни
    //  одной оценки и ни одного «вы»: событие названо мерой, вывод складывает
    //  зритель. Здесь же вступает свисток и дальше не смолкает.
    together {
        freeman speaks for 2.77s
        do {
            freeman overlays "vdal"
            wait 1.48s
            freeman overlays "prishchur"
        }
    }
    wait 0.4s
}


// ============ СЦЕНА 2: noch — НОЧЬ И ПЕРЕЛОМ ============================
//  Та же кухня ночью: чёрное окно, конус света от плафона над столом. Взята
//  именно эта локация, а не светлая кухня «Паруса»: реплика говорит «Ночь», и
//  кадр обязан это подтверждать, иначе слово спорит с картинкой. Меру человека
//  пришлось снять — её у локации не было (0.55 по обеденному столу).
scene "s2" (duration: 1s, set: noch) {
    transition static 0.12s

    place freeman at (0.50, 0.96) facing front on floor
    freeman scales 0.92 over 0.01s

    //  Лампа стоит на обеденном столе — там же, где она стояла утром. Плафон
    //  над столом горит по делу, настольная лампа рядом с ним — нет.
    let lampa2 = prop("lampa", "../assets/props/lampa.svg") at (0.26, 0.575) layer 6
    lampa2 scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 5
    //  «Ночь. Тело в кровати. Мысли — нет.» — тело в кровати СЛОВОМ, а в кадре
    //  персонаж стоит: он не садится и не ложится нигде в серии. Первая
    //  редакция говорила «Тело лежит. Вы — нет», и вычитка это сняла: «тело» и
    //  «вы» — один человек, и фраза читалась как противоречие.
    together {
        freeman speaks for 3.92s
        do {
            freeman overlays "ladoni_vniz"
            wait 1.96s
            freeman overlays "vniz"
        }
    }
    wait 0.7s

    freeman pose "calm"
    wait 0.15s

    //  ПЕРЕЛОМ. Обрыв звука в тишину, и камера идёт на угол: событий не
    //  прибавилось, назвали ОТСУТСТВИЕ.
    camera angle low freeman
    //lip 6
    //  «Ни одной угрозы за весь день. И ни одной остановки.»
    //  Ровно, без нажима: нажим превращает перелом в упрёк.
    together {
        freeman speaks for 4.40s
        do {
            freeman overlays "razvel"
            wait 1.5s
            freeman overlays "gorech"
            wait 1.4s
            freeman overlays "ostyl"
        }
    }
    camera reset
    wait 0.7s
}


// ============ СЦЕНА 3: kuhnya — МАНТРА ==================================
//  Та же кухня днём. Дом звучит тем же звуком, что и до отъезда.
scene "s3" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.44, 0.95) facing front on floor
    freeman scales 1.10 over 0.01s

    let lampa3 = prop("lampa", "../assets/props/lampa.svg") at (0.816, 0.415) layer 6
    lampa3 scales 1.00 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 7
    //  «Тише не стало. Ни в отпуске, ни дома, ни разу.» — МАНТРА: ритм вместо
    //  доказательства. Сцены отпуска в минутной редакции нет, и слово держится
    //  само: это элемент перечисления, а не отсылка к снятому кадру.
    together {
        freeman speaks for 4.55s
        do {
            freeman overlays "otschet"
            wait 1.59s
            freeman overlays "ugryumo"
            wait 1.48s
            freeman overlays "luna_pravaya"
        }
    }
    camera close-up freeman
    wait 0.7s
}


// ============ СЦЕНА 4: pustota — ОТКАЗ, МЕРКА И ОПЫТ НА ЗРИТЕЛЕ =========
//  Белый кадр: опыт ставится вне помещения. Ни тона, ни комнаты — чтобы между
//  зрителем и его собственными плечами не стояло ничего.
scene "s4" (duration: 1s, set: pustota) {
    transition static 0.3s

    place freeman at (0.50, 0.95) facing front on floor
    freeman scales 1.04 over 0.01s
    camera medium freeman
    freeman pose "idle"

    //lip 8
    //  «Считать за вас никто не станет.» — ОТКАЗ ДАВАТЬ ИНСТРУКЦИЮ, сказанный
    //  вслух. Без него монолог, который знает ответ и его не даёт, читается
    //  как кокетство; с ним — как условие игры.
    together {
        freeman speaks for 1.93s
        do {
            freeman overlays "razvel"
            wait 1.04s
            freeman overlays "otverg"
        }
    }
    wait 0.45s

    //lip 9
    //  «Мерьте не нагрузку, а возврат.» — ВЗЛЁТ: другая мерка вместо другого
    //  совета.
    together {
        freeman speaks for 2.80s
        do {
            freeman overlays "vzves_r"
            wait 1.5s
            freeman overlays "vzves"
        }
    }
    wait 0.45s

    freeman pose "calm"
    wait 0.15s

    //lip 10
    //  «За сколько минут вы спускаетесь?» — вопрос в лоб, без разбега.
    together {
        freeman speaks for 2.17s
        do {
            freeman overlays "hips"
            wait 1.16s
            freeman overlays "obvinil"
        }
    }
    wait 0.7s

    freeman pose "luna_levaya"
    wait 0.15s

    //  ШУТКА СТОИТ ПОСЛЕ РЕШЕНИЯ И ДО ЖАЛА. Опыт проделывается тогда, когда
    //  зритель уже знает, ЧТО мерить, — иначе он смеётся над тем, чего ещё не
    //  услышал (SCRIPT-FREEMAN, порядок битов).
    //lip 11
    //  «Расслабьте плечи.» — опыт занимает секунду и реквизита не требует.
    //  Легко и буднично: объявишь шутку голосом — она умрёт до добивки.
    together {
        freeman speaks for 1.60s
        do {
            freeman overlays "ladoni_vniz"
        }
    }

    //  ПАУЗА 1.2 с. Зритель проверяет плечи. Меньше — не успеет, и шутка
    //  окажется рассказанной, а не проделанной на нём.
    wait 1.2s

    //lip 12
    //  «Получилось? Значит, они были подняты.» — выиграть опыт нельзя:
    //  не вышло — плечи держатся, вышло — держались до этой секунды.
    together {
        freeman speaks for 3.30s
        do {
            freeman overlays "ladon_pusta"
            wait 1.7s
            freeman overlays "doshlo"
        }
    }
    wait 0.45s

    freeman pose "calm"
    wait 0.15s

    //lip 13
    //  «Опустились. Ровно до следующего сообщения.» — ПРЕДЕЛ способа. Без него
    //  шутка смеётся над человеком; с ним — называет цену приёма.
    together {
        freeman speaks for 4.47s
        do {
            freeman overlays "ruki_za_spinu"
            wait 2.37s
            freeman overlays "kozyrek"
        }
    }
    camera wide
    wait 0.7s
}


// ============ СЦЕНА 5: zal — ПРЕЗЕНТАЦИЯ ================================
//  Зал Лектория. Лампа стоит на краю сцены и горит и здесь.
scene "s5" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.48, 0.95) facing front on floor
    freeman scales 0.86 over 0.01s

    let lampa4 = prop("lampa", "../assets/props/lampa.svg") at (0.19, 0.52) layer 6
    lampa4 scales 0.70 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 14
    //  «Есть курс «Стресс-менеджмент» — десять лекций в Лектории Мейстера,
    //  бесплатно.» — цена названа отдельной строкой, без подмигивания. В
    //  минутной редакции это ЕДИНСТВЕННАЯ реплика презентации из четырёх.
    together {
        freeman speaks for 5.20s
        do {
            freeman overlays "raskryl"
            wait 2.6s
            freeman overlays "teplo"
            wait 1.6s
            freeman overlays "ladon_pusta"
        }
    }
    camera medium freeman
    wait 0.45s

    //lip 15
    //  «Он про то, где кончается усталость и начинается выгорание.» — граница
    //  обратимого и необратимого, без смягчения и без нажима. Эта реплика и
    //  держит ролик выше минуты, и снята она не будет: без неё ролик про стресс
    //  становится бодрее курса.
    together {
        freeman speaks for 4.30s
        do {
            freeman overlays "klin"
            wait 2.2s
            freeman overlays "chelo"
        }
    }
    wait 0.45s

    freeman pose "calm"
    wait 0.15s

    //lip 16
    //  «У меня и плеч-то нет. Нарисованному легко советовать.» — ролик
    //  записывает СЕБЯ в тот же ряд. Без подмигивания.
    together {
        freeman speaks for 4.26s
        do {
            freeman overlays "shrug"
            wait 2.07s
            freeman overlays "zatylok_l"
        }
    }
    wait 0.7s
}


// ============ СЦЕНА 6: kuhnya — ЖАЛО, ВОЗВРАТ ЯКОРЯ, КОЛЬЦО =============
//  Кадр VO-1 целиком. Кольцо смыкается и в картинке, и в тексте: то же место,
//  та же лампа, те же два слова.
scene "s6" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.44, 0.95) facing front on floor
    freeman scales 1.10 over 0.01s

    let lampa5 = prop("lampa", "../assets/props/lampa.svg") at (0.816, 0.415) layer 6
    lampa5 scales 1.00 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-23.svg") at (0.465, 0.545) layer 9
    nomer2 scales 0.17 over 0.01s
    nomer2 hides
    camera medium freeman
    freeman pose "calm"

    //lip 17
    //  «Сегодня вечером — двадцать минут, когда вас нельзя позвать.» —
    //  измеримое действие на сегодня, а не намерение.
    together {
        freeman speaks for 4.40s
        do {
            freeman overlays "palec_vverh"
            wait 1.8s
            freeman overlays "k_sebe"
            wait 1.5s
            freeman overlays "odna_v_bok"
        }
    }
    wait 0.7s

    //  КРУПНО НА ЛАМПУ. Предмет, молчавший весь ролик и ни разу не названный,
    //  впервые занимает кадр — ровно там, где зритель ищет свою линию.
    camera pan-to (0.816, 0.415) over 0.8s ease-in-out
    wait 0.3s

    //lip 18
    //  «Освободите линию.» — дословно, тем же тоном, что в начале.
    together {
        freeman speaks for 1.70s
        do {
            freeman overlays "stop_ladon"
        }
    }
    camera zoom-to lampa5 over 0.6s ease-out

    //  ПАУЗА 1.8 с. Здесь зритель складывает вывод сам: линия — это он.
    //  Рассказчик молчит, потому что назвать связку значит её отобрать.
    //  Резать паузу нельзя ни при каком монтаже.
    wait 1.8s

    //lip 19
    //  «Она у вас одна…» — рассказчик приходит вторым и подтверждает мысль
    //  ЗРИТЕЛЯ в три слова, с обрывом. «У вас» стоит здесь не для вежливости:
    //  без него «одна» читается как «одинока», и вычитка это поймала.
    together {
        freeman speaks for 1.30s
        do {
            freeman overlays "ostyl"
        }
    }

    //  КОЛЬЦО ЗАКРЫВАЕТСЯ ПОВТОРОМ. Последний кадр тождествен первому — то же
    //  место, та же лампа, та же поза, метка курса на груди, — и ролик в ленте
    //  уходит на второй круг. Первая реплика возвращается сама, но уже с
    //  другим весом: «освободите линию» значит теперь «линия — это я».
    camera wide
    wait 0.6s

    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.02 over 0.01s
    nomer2 scales 0.19 over 0.05s ease-out
    nomer2 scales 0.17 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    freeman pose "calm"
    wait 1.1s
}
