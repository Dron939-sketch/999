// =============================================================================
//  «ОСОЗНАННОСТЬ» — продающее интро курса
//
//  ФИШКА — ТЕЛЕВИЗОР, КОТОРЫЙ НИКТО НЕ СМОТРИТ (PRODAZHA.md §2). Блуждающий
//  ум — это шипящий ящик в голове, и весь монтаж построен на нём:
//
//    · ролик открывается СО СПИНЫ: Фримен стоит лицом к телевизору и смотрит
//      в шум. Зритель первые секунды смотрит туда же, куда он;
//    · на хуке он ОБОРАЧИВАЕТСЯ — «ты сейчас не здесь» сказано тому, кто
//      только что сам пялился в этот же шум;
//    · на отрицании ИДЁТ НА КАМЕРУ, уходя от ящика, — как зритель уходит от
//      мысли «я-то здесь»;
//    · на пулемёте за спиной ОДИН ЗА ДРУГИМ ВСТАЮТ ЕЩЁ ДВА ЯЩИКА: каждое
//      «не помнишь» — экран. Ни слова про «каждый день» — это видно;
//    · на взлёте, на слове «вернулся», все три ящика РАЗОМ ГАСНУТ. Первый
//      раз в ролике пусто и тихо: вот как выглядит «здесь»;
//    · под жало первый ящик ТИХО ВКЛЮЧАЕТСЯ СНОВА за его спиной. Он не
//      оборачивается. Вопрос «сколько этих секунд ты был в сознании?» повисает
//      над экраном, который уже опять бормочет.
//
//  Проверка фишки: выключи звук — понятно, о чём ролик. Инверсия штампа:
//  зомбоящик стоит не в углу комнаты, а в голове.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set titry from "../assets/sets/lektorij-final.svg"
import set pole from "../assets/sets/void.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b9bbb4
    monochrome: true
    mono-contrast: 2.2
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.14
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

scene "ekran" (duration: 58s, set: pole) {
    transition static 0.35s

    place freeman at (0.38, 0.66) facing front
    freeman scales 0.62 over 0.01s
    let tv1 = prop("tv", "../assets/props/tv.svg") at (0.67, 0.47) layer 1
    tv1 scales 0.55 over 0.01s
    let tv2 = prop("tv", "../assets/props/tv.svg") at (0.5, -1.0) layer 1
    tv2 scales 0.45 over 0.01s
    let tv3 = prop("tv", "../assets/props/tv.svg") at (0.5, -1.0) layer 1
    tv3 scales 0.45 over 0.01s
    let slovo = text("ГДЕ ТЫ?", 130) at (0.5, -2.0) layer 6
    slovo scales 2.4 over 0.01s

    // ── БЕЗ СЛОВ: он стоит СПИНОЙ, лицом к шипящему ящику ─────────────────
    camera wide
    freeman pose "spina"
    wait 1.2s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1): всё ещё спиной ──────────────────────
    //lip 1
    together {
        freeman speaks for 3.3s
        do {
            wait 1.6s
            camera medium freeman
        }
    }

    // ── ХУК (VO-2): ОБОРАЧИВАЕТСЯ. «Ты сейчас не здесь» ───────────────────
    //lip 2
    together {
        freeman speaks for 6.0s
        do {
            wait 1.2s                  // первая фраза — ещё в ящик
            freeman pose "polu_spina"
            wait 0.7s
            camera close-up freeman
            freeman pose "chetvert_levo"
            wait 0.9s
            freeman pose "v_upor"
            wait 0.8s
            freeman pose "point"       // «и этот ролик» — палец в зрителя
            camera medium freeman
        }
    }

    // ── ОТРИЦАНИЕ (VO-3): ИДЁТ НА КАМЕРУ, уходя от ящика ──────────────────
    freeman pose "calm"
    freeman overlays "smug"
    //lip 3
    together {
        freeman speaks for 6.0s
        do {
            camera wide
            freeman moves-to (0.45, 0.71) over 2.2s
            wait 0.3s
            camera medium freeman
            freeman pose "idet"        // идёт на камеру, переставляя ноги
            freeman overlays "doubt"
            freeman moves-to (0.43, 0.78) over 2.0s
            wait 0.4s
            camera close-up freeman
            freeman pose "hips"        // остановился: «а дорогу домой помнишь?»
            freeman overlays "hero_skeptic"
        }
    }

    // ── ПУЛЕМЁТ (VO-4): за спиной встают ещё два ящика ────────────────────
    freeman pose "no"
    //lip 4
    together {
        freeman speaks for 8.6s
        do {
            camera wide
            wait 1.5s
            tv2 moves-to (0.16, 0.44) over 0.01s
            tv2 shows                  // «Ехал. Не помнишь.» — второй экран
            camera shake 0.18s intensity 1
            wait 1.1s
            camera medium freeman
            freeman pose "shrug"
            wait 0.9s
            camera wide
            freeman pose "facepalm"
            tv3 moves-to (0.88, 0.44) over 0.01s
            tv3 shows                  // «Обнимал. Тебя там не было.» — третий экран
            camera shake 0.18s intensity 1
            wait 1.7s
            camera close-up freeman
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 0.4s

    // ── РАЗВОРОТ (VO-5): ракурс СНИЗУ, он один среди экранов ──────────────
    //lip 5
    together {
        freeman speaks for 7.9s
        do {
            camera angle low freeman
            freeman pose "chetvert_pravo"
            wait 1.8s
            camera wide
            freeman overlays "flash_pupils"
            wait 0.16s
            freeman pose "v_upor"
            wait 1.6s
            camera medium freeman
            freeman overlays "stern"
        }
    }
    wait 0.5s

    // ── ВЗЛЁТ (VO-6): на «вернулся» все ящики разом ГАСНУТ ────────────────
    freeman pose "raskryl"
    //lip 6
    together {
        freeman speaks for 7.9s
        do {
            camera wide
            wait 6.0s                  // «Эти годы не вернуть. Следующая минута — вот она.»
            tv1 hides
            tv2 hides
            tv3 hides                  // «Вернулся» — тишина, пустое поле
            camera shake 0.15s intensity 1
            freeman pose "povorot_levo"    // оглянулся: экранов нет
            wait 0.8s
            camera medium freeman
            freeman pose "open"
            freeman overlays "hero_wow"
        }
    }

    // ── ВЗЛЁТ-добивка (VO-7): «без мантр» — лотос с ухмылкой ─────────
    //lip 7
    together {
        freeman speaks for 7.3s
        do {
            camera medium freeman
            wait 1.6s
            freeman pose "point"       // «десять лекций»
            wait 3.6s
            freeman pose "lotos"       // «без мантр» — пародия на позу
            freeman overlays "hero_skeptic"
            wait 1.6s
            freeman pose "open"        // встал: цирк окончен
            camera wide
        }
    }

    // ── СЛОВО-УДАР «ГДЕ ТЫ?» + негатив-панч ───────────────────────────────
    slovo moves-to (0.5, 0.26) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.8s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    freeman overlays "flash_grin"
    wait 0.08s

    // ── ЖАЛО-CTA (VO-8): ящик ТИХО ВКЛЮЧАЕТСЯ СНОВА ───────────────────────
    freeman pose "calm"
    freeman pose "lunge"
    //lip 8
    together {
        freeman speaks for 6.0s
        do {
            camera medium freeman
            wait 1.2s
            freeman pose "point"       // «сколько этих секунд»
            freeman overlays "hero_sly"
            wait 1.4s
            tv1 shows                  // ум уже снова бормочет — он не оборачивается
            camera shake 0.12s intensity 1
            wait 0.6s
            freeman pose "hips"
            camera close-up freeman
        }
    }
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.8s
}

scene "titry" (duration: 5s, set: titry) {
    transition static 0.45s
    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.0s
    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s
    wait 2.2s
    transition fade-black 0.8s
}
