// =============================================================================
//  «СПИСОК» — интро к курсу «О чём думать». Номер курса 12.
//  VO — o-chem-dumat-VO.md, маркеры 1..20.
//
//  ОДНА МЫСЛЬ НА РОЛИК: вы не выбирали, о чём думать. Список тем принесли,
//  вопрос к ним выдали, и этот вопрос десять лет делает из вас человека
//  определённого сорта.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. НАЧИНАЕТСЯ С ПРОВАЛА ПАМЯТИ. Первая реплика ничего не утверждает: она
//     просит вспомнить, о чём человек думал сегодня. Он честно пробует и не
//     может. Дальше можно говорить что угодно — он уже согласился, что не
//     владеет собственным днём, и согласился на своём опыте.
//
//  2. ГЛАВНАЯ СТРОЧКА — «ДЕСЯТЬ ЛЕТ ЭТО НЕ СТАЖ, ЭТО СРОК ИЗГОТОВЛЕНИЯ»
//     (VO-10). Стаж — то, что человек накопил; срок изготовления — то, что
//     накопили из него. Одно слово переворачивает десять лет из достижения в
//     результат чужой работы.
//
//  3. ЗРИТЕЛЯ НЕ НАЗЫВАЮТ ДУРАКОМ. Достоинство возвращают РАЗДЕЛЕНИЕМ, а не
//     утешением: тему запретить нельзя, а вопрос сменить можно (VO-12). Одно
//     действительно не в его власти, другое — в его, и курс занимается вторым.
//
//  4. ШУТКА НЕ ПО ИЗРАСХОДОВАННОЙ ЗАГОТОВКЕ. «Можно и без курса» запрещено
//     (`GLUBINA-I-SMEH.md` §5). Здесь не-решение названо ВЕЩЬЮ: белым
//     медведем. Зритель ставит опыт Вегнера на себе за секунду и проигрывает
//     опыту, а не рассказчику.
//
//  5. МАСШТАБ ФИГУРЫ ПОДОБРАН ЗАМЕРОМ, А НЕ НА ГЛАЗ — по замечанию студии на
//     прошлой версии («размер персонажа не соответствует локации»). Там чайник
//     был нарисован в 6.4 раза крупнее нормы, и фигура читалась куклой.
//     Мерка: 1 метр = 26% высоты кадра. В кухне опора — холодильник (1.8 м,
//     434 px), от него фигура выходит 411 px = 57% кадра при `scales 1.00`.
//     Остальные локации подогнаны пробным рендером под тот же рост.
//
//  6. НОМЕР КУРСА 12, метка `nomer-12.svg` белой тушью на груди, в ПЕРВОМ и
//     ПОСЛЕДНЕМ кадре. Проявляется через 0.02с после стыка и снимается до
//     первого слова: на нулевом кадре её быть не может, иначе при зацикливании
//     в ленте виден шов.
//
//  7. ЦВЕТА НЕТ НИ В ОДНОЙ ЛОКАЦИИ, и это проверено: в прошлой версии под
//     чайником горело красное пламя, которого никто не заказывал. Все три
//     новые локации прогнаны на цветные пиксели — ноль.
//
//  8. ЛОКАЦИЙ ШЕСТЬ, ТРИ НАРИСОВАНЫ СТУДИЕЙ ПОД ЭТОТ РОЛИК по промтам
//     (`o-chem-dumat-IMAGE-PROMPTS.md`): кухня с записками на холодильнике,
//     цех с токарным станком и развилка двух троп с низким горизонтом.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). В этом ролике таких два: `smug` и
//      `hero_wink`, оба вынесены в паузы;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · ВИЗЕМЫ ОТКРЫВАЮТ РОТ (tools/rot.py, реестр §XXVI);
//    · координаты и МАСШТАБ фигуры снимаются ПРОБНЫМ РЕНДЕРОМ (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`,
//  реестр §XXIII). Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set kuhnya from "../assets/sets/kuhnya-spisok.svg"
import set void from "../assets/sets/void-black.svg"
import set ceh from "../assets/sets/ceh-stanok.svg"
import set okno from "../assets/sets/okno-vetka.svg"
import set tropy from "../assets/sets/razvilka-trop.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: КУХНЯ УТРОМ — ХУК И СПИСОК ==========================
//  ЗАПИСКИ ПОД МАГНИТАМИ И ЕСТЬ СПИСОК. Их кто-то принёс, они пожелтели, и
//  никто не помнит, когда они появились. Локация доказывает реплику раньше,
//  чем реплика прозвучит.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании.
    //  Координаты и масштаб сняты пробным рендером (карта пола: back_y 0.700).
    //  Фигура стоит в ПРАВОЙ трети, в пустом поле: левее 0.55 её начинает
    //  резать тумба, и повторяется ровно тот дефект, за который студия
    //  забраковала прошлую версию.
    place freeman at (0.62, 0.95) facing front on floor
    freeman scales 1.00 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-12.svg") at (0.637, 0.585) layer 9
    nomer scales 0.34 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ. Метка
    //  проявляется через мгновение после стыка и снимается до первого слова.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.03 over 0.01s
    nomer scales 0.37 over 0.05s ease-out
    nomer scales 0.34 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"
    wait 0.15s

    // ── ХУК (VO-1): прямой вопрос ─────────────────────────────────────
    //  НЕ РИТОРИКА: зритель обязан начать вспоминать. Ровно и почти буднично,
    //  как спрашивают о погоде. Нажмёшь — он поймёт, что его ловят, и
    //  вспоминать не станет.
    //lip 1
    together {
        freeman speaks for 1.77s
        do {
            freeman overlays "vozzvanie"   // «о чём вы думали сегодня?»
        }
    }
    wait 0.6s

    // ── ХУК-ДОБИВКА (VO-2): отвечают за него ──────────────────────────
    //  УСТАЛО, БЕЗ НАСМЕШКИ. Он только что провалил проверку; насмешка здесь
    //  закрывает ролик на второй реплике.
    //lip 2
    together {
        freeman speaks for 5.79s
        do {
            freeman overlays "razvel"      // «плохо вспоминается»
            wait 2.36s
            freeman overlays "rubit"       // «что-то про работу, что-то про деньги»
        }
    }
    wait 0.45s

    // ── УДАР (VO-3): список существует ────────────────────────────────
    //  ПЕРВЫЙ УДАР ГОЛОСОМ. Пауза между фразами длиннее второй: зритель
    //  успевает согласиться, что список есть, и только потом слышит, что он
    //  не менялся годами.
    //lip 3
    together {
        freeman speaks for 6.58s
        do {
            camera medium freeman
            freeman overlays "ostyl"       // «а список тем у вас есть»
            wait 2.68s
            freeman overlays "vniz"        // «годами одни и те же»
        }
    }
    camera wide
    wait 0.8s

    // ── ОТРИЦАНИЕ (VO-4): список не ваш ───────────────────────────────
    //  ЗАКРЫВАЕТ ПЕРВУЮ ЗАЩИТУ: зритель уже готов сказать «ну это мои темы».
    //  Сухо и коротко — сообщают факт, а не обвиняют.
    //lip 4
    together {
        freeman speaks for 1.94s
        do {
            freeman overlays "klin"        // «вы его не составляли»
        }
    }
    wait 0.5s

    // ── ПУЛЕМЁТ (VO-5): что именно принесли ───────────────────────────
    //  ОЧЕРЕДЬ, самый быстрый кусок ролика. Каждый пункт буднично и одинаково:
    //  перечисляют доставленное, а не обвиняют.
    //lip 5
    together {
        freeman speaks for 4.63s
        do {
            freeman overlays "rubit"       // «их принесли»
            wait 1.5s
            freeman overlays "rubit_l"     // «работу. деньги»
            wait 1.5s
            freeman overlays "razvel"      // «чужое мнение»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 2: ПУСТОТА — РАЗВОРОТ ==================================
//  ЧЁРНЫЙ КАДР НА ПЕРЕЛОМЕ. Локация уходит целиком: вопрос задают не на кухне,
//  а зрителю. ФИГУРА СТОИТ У ПЕРЕДНЕГО КРАЯ ПОЛА — в прошлой версии карта пола
//  (back_y 0.972) отправила её к горизонту, и главный вопрос ролика играла
//  точка размером с ноготь.
scene "pustota" (duration: 1s, set: void) {
    transition static 0.2s

    place freeman at (0.50, 0.99) facing front on floor
    freeman scales 1.05 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ (VO-6): кто выбрал ───────────────────────────────────
    //  ПЕРЕЛОМ РОЛИКА. Вопрос вверх и без нажима — приглашение проверить, а
    //  не упрёк. Дальше пауза: зритель отвечает себе сам.
    //lip 6
    together {
        freeman speaks for 3.96s
        do {
            freeman overlays "vozzvanie"   // «а теперь скажите»
            wait 2.1s
            freeman overlays "v_upor"      // «кто выбрал, о чём вам думать?»
        }
    }
    wait 0.9s

    // ── УЗНАВАНИЕ (VO-7): не вы ───────────────────────────────────────
    //  ГЛАВНОЕ УЗНАВАНИЕ И ЦИТАТА НА СКРИНШОТ. Обе фразы коротко и ровно;
    //  вторая суше первой, без всякого нажима на «только».
    //lip 7
    together {
        freeman speaks for 3.14s
        do {
            camera medium freeman
            freeman overlays "klin"        // «не вы»
            wait 1.7s
            freeman overlays "vniz"        // «вы только исполняете»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 3: ЦЕХ СО СТАНКОМ — ЗАКОН ==============================
//  СТАНОК НЕ ИЛЛЮСТРИРУЕТ МЫСЛЬ, А ДОКАЗЫВАЕТ ЕЁ. Заготовку никто не
//  спрашивал, какой формы она хочет быть, — её десять лет точили одним резцом.
//  Стружка на полу — это прожитые годы, и она видна.
scene "ceh" (duration: 1s, set: ceh) {
    transition static 0.2s

    //  Карта пола: back_y 0.656. Масштаб 1.05 подобран так, чтобы станина
    //  станка приходилась фигуре по грудь, а не выше головы.
    place freeman at (0.68, 0.95) facing front on floor
    freeman scales 1.05 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЗАКОН (VO-8): вопрос делает вас ───────────────────────────────
    //  ЗДЕСЬ ЗРИТЕЛЬ УЗНАЁТ, О ЧЁМ КУРС. Первая фраза буднично, вторая
    //  медленнее и ровнее; «вас» без подчёркивания, иначе выйдет проповедь.
    //lip 8
    together {
        freeman speaks for 7.71s
        do {
            freeman overlays "vzves"       // «каждый день — один и тот же вопрос»
            wait 3.37s
            freeman overlays "v_upor"      // «он делает не ответ, он делает вас»
        }
    }
    wait 0.9s

    // ── ДОКАЗАТЕЛЬСТВО (VO-9): две судьбы ─────────────────────────────
    //  ОБЕ ПОЛОВИНЫ ИГРАЮТСЯ ОДИНАКОВО РОВНО. Сыграешь вторую мрачнее —
    //  выйдет, что следователь хуже мастера, а ролик этого не утверждает.
    //lip 9
    together {
        freeman speaks for 8.39s
        do {
            freeman overlays "rubit"       // «десять лет — и вы мастер»
            wait 4.5s
            freeman overlays "rubit_l"     // «десять лет — и вы следователь»
        }
    }
    wait 0.5s

    // ── ЦЕНА (VO-10): срок изготовления ───────────────────────────────
    //  ГЛАВНАЯ СТРОЧКА РОЛИКА. Между «не стаж» и «это срок изготовления» —
    //  пауза длиннее второй фразы: слово должно упасть в тишину.
    //lip 10
    together {
        freeman speaks for 6.03s
        do {
            camera medium freeman
            freeman overlays "ostyl"       // «десять лет — это не стаж»
            wait 3.0s
            freeman overlays "vniz"        // «это срок вашего изготовления»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 4: ОКНО С ВЕТКОЙ — КАЧЕЛИ И ХОД ========================
//  ЕДИНСТВЕННАЯ ЛОКАЦИЯ, ГДЕ ЕСТЬ ЧТО-ТО ЖИВОЕ. Ветка за окном — не символ, а
//  смена воздуха: ровно здесь зрителю возвращают достоинство, и кадр обязан
//  перестать быть тесным.
scene "okno" (duration: 1s, set: okno) {
    transition static 0.2s

    //  Карта пола: back_y 0.735.
    place freeman at (0.30, 0.95) facing front on floor
    freeman scales 1.02 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ВОЗВРАТНЫЙ ВОПРОС (VO-11): а ваш какой ────────────────────────
    //  САМЫЙ КОРОТКИЙ ВОПРОС РОЛИКА, и он не риторический: зритель начинает
    //  искать. Вверх, почти участливо.
    //lip 11
    together {
        freeman speaks for 1.78s
        do {
            freeman overlays "vozzvanie"   // «а ваш вопрос — какой?»
        }
    }
    wait 0.9s

    // ── КАЧЕЛИ И ХОД (VO-12): что можно сменить ───────────────────────
    //  ЕДИНСТВЕННОЕ МЕСТО, ГДЕ КУРС ЧТО-ТО ДАЁТ, и достоинство возвращают
    //  РАЗДЕЛЕНИЕМ, а не утешением. Спокойно, ровно, с достоинством.
    //lip 12
    together {
        freeman speaks for 4.93s
        do {
            camera medium freeman
            freeman overlays "ladoni_vniz" // «тему запретить нельзя»
            wait 2.7s
            freeman overlays "teplo"       // «а вопрос сменить можно»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 5: РАЗВИЛКА ТРОП — ВЗЛЁТ И ШУТКА =======================
//  РАЗВИЛКА ПОКАЗЫВАЕТ НЕ СВОБОДУ КАК ПОНЯТИЕ, а то, что выбор физически
//  существует и лежит прямо под ногами. Фигура стоит В ТОЧКЕ РАЗВИЛКИ: в
//  прошлой версии она стояла в стороне от троп, и кадр читался «человек в
//  поле», а не «человек перед выбором».
scene "tropy" (duration: 1s, set: tropy) {
    transition static 0.2s

    //  Горизонт низкий (карта: back_y 0.246), поэтому масштаб здесь МЕНЬШЕ:
    //  на пейзаже фигура ростом в две трети кадра закрывает обе тропы.
    place freeman at (0.45, 0.92) facing front on floor
    freeman scales 0.70 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ВЗЛЁТ (VO-13): свобода и жевание ──────────────────────────────
    //  СОЕДИНЕНИЕ В ОДНОМ ПРЕДЛОЖЕНИИ (GLUBINA-I-SMEH.md §3): «свобода» и
    //  «жуёте» стоят в одной фразе, а не в соседних. Уберите жевание —
    //  останется лозунг без довода.
    //lip 13
    together {
        freeman speaks for 7.60s
        do {
            freeman overlays "teplo"       // «свобода — это когда вы выбираете»
            wait 3.09s
            freeman overlays "otverg"      // «а не жуёте тот, что достался»
        }
    }
    wait 0.9s

    // ── ШУТКА (VO-14): белый медведь ──────────────────────────────────
    //  СМЕЮТСЯ НАД СПОСОБОМ, НЕ НАД ЧЕЛОВЕКОМ, и способ назван ВЕЩЬЮ. Вторая
    //  фраза — как предлагают проверить, а не как ловят.
    //lip 14
    together {
        freeman speaks for 5.61s
        do {
            freeman overlays "otmahnulsya" // «проще всего — перестать думать»
            wait 3.0s
            freeman overlays "prishchur"   // «не думайте о белом медведе»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-15): предел назван ──────────────────────────
    //  СПОКОЙНАЯ ДОБИВКА, ВНИЗ, БЕЗ УЛЫБКИ. Предел не-решения назван точным
    //  моментом провала: слово произнесено — и медведь уже пришёл.
    //lip 15
    together {
        freeman speaks for 4.76s
        do {
            camera medium freeman
            freeman overlays "v_upor"
            wait 2.6s
            freeman overlays "doshlo"      // «дальше он ваш до ночи»
        }
    }
    camera wide
    //  УХМЫЛКА — ПОСЛЕ РЕПЛИКИ, НЕ ВНУТРИ: `smug` трогает рот.
    freeman overlays "smug"
    wait 1.0s
}

// ============ СЦЕНА 6: ЗАЛ ЛЕКТОРИЯ — КУРС =================================
//  ДЕЛОВАЯ ЧАСТЬ И ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ЗВУЧИТ СЛОВО «КУРС». Тон тот же,
//  что и во всём ролике: ничего не продают, называют.
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    //  Карта пола: back_y 0.62.
    place freeman at (0.32, 0.94) facing front on floor
    freeman scales 1.00 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПРЕЗЕНТАЦИЯ (VO-16): название ─────────────────────────────────
    //  БЕЗ ПОДМИГИВАНИЯ. Название курса — не каламбур, хотя и выглядит
    //  продолжением фразы.
    //lip 16
    together {
        freeman speaks for 2.83s
        do {
            freeman overlays "razvel"      // «курс так и называется»
        }
    }
    wait 0.45s

    // ── ПРЕЗЕНТАЦИЯ (VO-17): цена ─────────────────────────────────────
    //  РЕПЛИКА САМОДОСТАТОЧНА: числа до неё не звучало, и «все четырнадцать»
    //  без слова «лекций» повисло бы без опоры — на этом уже обжигались.
    //lip 17
    together {
        freeman speaks for 2.64s
        do {
            camera medium freeman
            freeman overlays "palec_vverh" // «четырнадцать лекций, и всё бесплатно»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 7: КУХНЯ УТРОМ — ЖАЛО И ПОДПИСЬ ========================
//  КОЛЬЦО. Возврат ровно туда, где ролик начался: то же утро, тот же список на
//  холодильнике, но теперь у зрителя есть, что с ним сделать.
scene "zhalo" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.62, 0.95) facing front on floor
    freeman scales 1.00 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-12.svg") at (0.637, 0.585) layer 9
    nomer2 scales 0.34 over 0.01s
    nomer2 hides

    camera wide
    freeman pose "calm"

    // ── ЖАЛО (VO-18): измеримое действие ──────────────────────────────
    //  ДЕЙСТВИЕ ЗАНИМАЕТ ОДНУ СЕКУНДУ, и это условие: домашнее задание на
    //  полчаса зритель не сделает. КОЛЬЦО К VO-3: там список читали, здесь в
    //  него заглядывают за своим вопросом.
    //lip 18
    together {
        freeman speaks for 5.46s
        do {
            freeman overlays "vozzvanie"   // «загляните в свой список тем»
            wait 2.9s
            freeman overlays "palec_vverh" // «поймайте вопрос, который вы к ним задаёте»
        }
    }
    wait 0.5s

    // ── ЖАЛО-ДОБИВКА (VO-19): финал вопросом ──────────────────────────
    //  ЗРИТЕЛЬ УХОДИТ НАВЕРХ ПО СТАТУСУ. Почти дружелюбно, вверх на конце: у
    //  него в руках работа, а не приговор.
    //lip 19
    together {
        freeman speaks for 5.81s
        do {
            camera medium freeman
            freeman overlays "teplo"       // «и спросите: этот вопрос»
            wait 2.1s
            freeman overlays "raskryl"     // «делает из меня того, кем я хочу быть?»
        }
    }
    camera wide
    wait 1.2s

    // ── ПОДПИСЬ (VO-20): кольцо для ленты ─────────────────────────────
    //  ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ, И ТА ЖЕ МЕТКА. Ролик уходит в ленту, где он
    //  зациклен, и последняя реплика — не удар, а сшивка.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.03 over 0.01s
    nomer2 scales 0.37 over 0.05s ease-out
    nomer2 scales 0.34 over 0.02s
    //lip 20
    together {
        freeman speaks for 5.68s
        do {
            freeman overlays "gladit_grud_niz"  // «лекторий мейстера»
            wait 2.57s
            freeman overlays "vozzvanie"        // «поехали!»
        }
    }
    nomer2 hides
    //  ПОДМИГИВАНИЕ — ПОСЛЕ РЕПЛИКИ: `hero_wink` трогает рот.
    freeman overlays "hero_wink"
    wait 0.6s
}
