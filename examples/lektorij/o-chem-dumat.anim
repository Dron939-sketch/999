// =============================================================================
//  «ЖВАЧКА» — интро к курсу «О чём думать».
//  VO — o-chem-dumat-VO.md, маркеры 1..20.
//
//  ОДНА МЫСЛЬ НА РОЛИК: усилие — не продукт. Вечер честного думанья утомляет
//  ровно как смена, а произвести может ноль, и изнутри эти два вечера
//  неотличимы.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ГЛАВНОЕ РЕШЕНИЕ — НЕ НАЗЫВАТЬ ЭТО РУМИНАЦИЕЙ и вообще никак не называть
//     по-научному. Жвачка — вещь, которую зритель держал во рту: челюсть
//     работает, желудок пустой, калорий ноль. Весь закон курса помещается в
//     предмет целиком, и объяснять его не надо.
//
//  2. ИМЯ ОТЛОЖЕНО НА ЧЕТЫРЕ РЕПЛИКИ. Сначала «устали как после смены, а
//     сделано ничего» (VO-3), и только в пулемёте — «это жвачка». Назовёшь
//     сразу — выйдет метафора; назовёшь после узнавания — выйдет диагноз.
//
//  3. ЗРИТЕЛЯ НЕ НАЗЫВАЮТ ДУРАКОМ, И ЭТО НЕ ОСТОРОЖНОСТЬ. Ролик про думанье,
//     который унижает думающего, сам себя опровергает: он тогда тоже ничего не
//     произвёл. Поэтому в качелях (VO-11) достоинство возвращают
//     ДОКАЗАТЕЛЬСТВОМ — «голова не сломана, она работала», — а не утешением.
//
//  4. ШУТКА ВПЕРВЫЕ НЕ ПРО «МОЖНО И БЕЗ КУРСА». Заготовка израсходована семью
//     роликами подряд и запрещена (`GLUBINA-I-SMEH.md` §5). Здесь не-решение
//     названо ВЕЩЬЮ: белым медведем. Зритель ставит опыт Вегнера на себе за
//     одну секунду и проигрывает опыту, а не рассказчику.
//
//  5. НОМЕРА КУРСА В РОЛИКЕ НЕТ: его присваивает студия. Первый и последний
//     кадры тождественны и стоят в позе поглаживания груди — метка добавится
//     одной сценой.
//
//  6. ЦВЕТА НЕТ ВОВСЕ. У серии потолок — одно пятно на ролик, и здесь его
//     тратить не на что: все шесть локаций бытовые, цветное пятно в кухне
//     читалось бы как реквизит, а не как акцент.
//
//  7. ЛОКАЦИЙ ШЕСТЬ, И ПЯТЬ ИЗ НИХ СВЕЖИЕ ПО СЕРИИ: кухня с чайником и стол с
//     непрочитанным не использовались ни разу, окно с веткой — ни разу, две
//     тропы — дважды. Каждая проверена пробным рендером на среднюю яркость
//     (реестр §XXV: неиспользованная локация не значит пригодная).
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). В этом ролике таких два: `smug` и
//      `hero_wink`, оба вынесены в паузы;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · ВИЗЕМЫ ОТКРЫВАЮТ РОТ (tools/rot.py, реестр §XXVI);
//    · координаты фигуры снимаются ПРОБНЫМ РЕНДЕРОМ (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`,
//  реестр §XXIII). Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set kuhnya from "../assets/sets/kuhnya-chajnik.svg"
import set stol from "../assets/sets/stol-neprochitannoe.svg"
import set void from "../assets/sets/void-black.svg"
import set okno from "../assets/sets/okno-vetka.svg"
import set tropy from "../assets/sets/dve-tropy.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: КУХНЯ С ЧАЙНИКОМ — ХУК ==============================
//  ТАМ, ГДЕ ЭТО И ПРОИСХОДИТ. Вечер, кухня, чайник: место, куда садятся
//  «подумать». Никакого действия в кадре нет — и это точно: думанье ничего не
//  оставляет после себя, поэтому и вспомнить его нечем.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании.
    //  Координаты сняты пробным рендером (карта пола: back_y 0.56).
    place freeman at (0.22, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ. Поза поглаживания груди держит место
    //  под метку курса: номер присваивает студия.
    freeman pose "gladit_grud"
    wait 0.15s
    freeman pose "v_upor"
    wait 0.1s

    // ── ХУК (VO-1): вчерашний вечер ───────────────────────────────────
    //  РОВНО И НЕГРОМКО, как напоминают об общеизвестном. «Часа три» — мягче:
    //  это оговорка, за которую зритель ухватится, и она нужна, чтобы он
    //  согласился прежде, чем поймёт, с чем согласился.
    //lip 1
    together {
        freeman speaks for 2.91s
        do {
            freeman overlays "hips"        // «вчера вечером вы думали»
            wait 1.9s
            freeman overlays "vzglyad"     // «часа три»
        }
    }
    wait 0.35s

    // ── ХУК-ДОБИВКА (VO-2): три темы ──────────────────────────────────
    //  ИХ ПЕРЕЧИСЛЯЮТ ВСЕРЬЁЗ, БЕЗ ИРОНИИ: темы настоящие, и зритель обязан
    //  узнать свои. Сыграешь насмешку — он поймёт, что его ловят.
    //lip 2
    together {
        freeman speaks for 4.58s
        do {
            freeman overlays "rubit"       // «о работе»
            wait 1.5s
            freeman overlays "rubit_l"     // «о деньгах»
            wait 1.5s
            freeman overlays "razvel"      // «о том разговоре»
        }
    }
    wait 0.45s

    // ── УДАР (VO-3): усилие без продукта ──────────────────────────────
    //  ПЕРВЫЙ УДАР ГОЛОСОМ И ВЕСЬ РОЛИК СРАЗУ. Пауза между фразами длиннее
    //  второй фразы: зритель успевает согласиться с усталостью, и только
    //  потом у него забирают объяснение.
    //lip 3
    together {
        freeman speaks for 4.35s
        do {
            camera medium freeman
            freeman overlays "ostyl"       // «устали как после смены»
            wait 2.6s
            freeman overlays "vniz"        // «а сделано ничего»
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 2: СТОЛ С НЕПРОЧИТАННЫМ — ИМЯ ==========================
//  СТОЛ, ГДЕ НИЧЕГО НЕ СДВИНУЛОСЬ. Локация показывает продукт вечера, не
//  называя его: всё лежит там же, где лежало.
scene "stol" (duration: 1s, set: stol) {
    transition static 0.2s

    //  Пол начинается низко (карта: back_y 0.737).
    place freeman at (0.28, 0.95) facing front on floor
    freeman scales 0.84 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОТРИЦАНИЕ (VO-4): лень отбирают ───────────────────────────────
    //  ЗАКРЫВАЕТ ПЕРВУЮ ЗАЩИТУ: зритель уже готов обозвать себя лентяем и на
    //  этом успокоиться. Устало, почти с сочувствием — отбирают удобное
    //  объяснение, а не добивают.
    //lip 4
    together {
        freeman speaks for 3.68s
        do {
            freeman overlays "otmahnulsya" // «не называйте это ленью»
            wait 2.1s
            freeman overlays "teplo"       // «вы честно трудились»
        }
    }
    wait 0.4s

    // ── ПУЛЕМЁТ (VO-5): имя и три свойства ────────────────────────────
    //  ОЧЕРЕДЬ ИЗ ТРЁХ ПУНКТОВ, и все три про один предмет. Ровно, без
    //  нажима: жвачка обязана объяснить себя сама, комментарий её убьёт.
    //lip 5
    together {
        freeman speaks for 5.41s
        do {
            freeman overlays "razmer"      // «это жвачка»
            wait 1.8s
            freeman overlays "rubit"       // «челюсть работает»
            wait 1.8s
            freeman overlays "razvel"      // «желудок пустой, калорий ноль»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: ПУСТОТА — РАЗВОРОТ ==================================
//  ЧЁРНЫЙ КАДР НА ПЕРЕЛОМЕ. Локация уходит целиком: вопрос задают не в кухне
//  и не за столом, а зрителю. Смотреть, кроме фигуры, не на что — и это
//  единственное место ролика, где так.
scene "pustota" (duration: 1s, set: void) {
    transition static 0.2s

    //  Пол почти у самого низа кадра (карта: back_y 0.972).
    place freeman at (0.50, 0.96) facing front on floor
    freeman scales 0.86 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ (VO-6): что вы произвели ─────────────────────────────
    //  ПЕРЕЛОМ РОЛИКА. Вопрос вверх и без нажима — приглашение проверить, а
    //  не упрёк. Дальше пауза: зритель отвечает себе сам, и ответ у него
    //  выходит пустой.
    //lip 6
    together {
        freeman speaks for 4.14s
        do {
            freeman overlays "vozzvanie"   // «а теперь скажите»
            wait 2.2s
            freeman overlays "v_upor"      // «что вы произвели?»
        }
    }
    wait 0.9s

    // ── УЗНАВАНИЕ (VO-7): усилие против продукта ──────────────────────
    //  ГЛАВНОЕ УЗНАВАНИЕ И ЦИТАТА НА СКРИНШОТ. Первая фраза — про то, в чём
    //  зритель уверен; вторая забирает у него основание для уверенности.
    //  Пауза между ними длиннее второй фразы.
    //lip 7
    together {
        freeman speaks for 4.09s
        do {
            camera medium freeman
            freeman overlays "klin"        // «усилие вы помните»
            wait 2.6s
            freeman overlays "vniz"        // «продукт — нет»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 4: СТОЛ С НЕПРОЧИТАННЫМ — ЦЕНА =========================
//  ВОЗВРАТ В ТУ ЖЕ ТОЧКУ, где уже был вечер. Цену называют там же, где её и
//  заплатили, — повтор локации тут работает как счёт, а не как экономия.
scene "cena" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.30, 0.95) facing front on floor
    freeman scales 0.84 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕНА (VO-8): восемь и пять ────────────────────────────────────
    //  ЧИСЛО БЕЗ ОЦЕНКИ. Ровно, как читают опись; «ничего» — вниз и тяжелее
    //  всего в реплике.
    //lip 8
    together {
        freeman speaks for 5.79s
        do {
            freeman overlays "vzves"       // «способов думать — восемь»
            wait 3.2s
            freeman overlays "vniz"        // «пять из них не производят ничего»
        }
    }
    wait 0.45s

    // ── ЦЕНА-ДОБИВКА (VO-9): усталость одинаковая ─────────────────────
    //  САМОЕ НЕПРИЯТНОЕ МЕСТО РОЛИКА, и играется оно буднично. Нажмёшь —
    //  выйдет упрёк, и зритель начнёт защищаться вместо того, чтобы считать.
    //lip 9
    together {
        freeman speaks for 3.63s
        do {
            camera medium freeman
            freeman overlays "ugryumo"     // «а устаёте вы от всех восьми одинаково»
        }
    }
    camera wide
    wait 1.0s

    // ── ВОЗВРАТНЫЙ ВОПРОС (VO-10): счёт вечеров ───────────────────────
    //  СЧЁТ, И ОН НЕ РИТОРИЧЕСКИЙ: зритель начинает считать. Вверх, почти
    //  участливо — иначе вопрос читается как обвинение и счёт не идёт.
    //lip 10
    together {
        freeman speaks for 3.15s
        do {
            freeman overlays "vozzvanie"   // «сколько вечеров ушло на эти пять способов»
        }
    }
    wait 0.5s
}

// ============ СЦЕНА 5: ОКНО С ВЕТКОЙ — КАЧЕЛИ И ХОД ========================
//  ЕДИНСТВЕННАЯ ЛОКАЦИЯ, ГДЕ ЕСТЬ ЧТО-ТО ЖИВОЕ. Ветка за окном — не символ, а
//  смена воздуха: ровно здесь зрителю возвращают достоинство, и кадр обязан
//  перестать быть тесным.
scene "okno" (duration: 1s, set: okno) {
    transition static 0.2s

    //  Карта пола: back_y 0.735.
    place freeman at (0.34, 0.95) facing front on floor
    freeman scales 0.84 over 0.01s
    camera wide
    freeman pose "calm"

    // ── КАЧЕЛИ (VO-11): голова не сломана ─────────────────────────────
    //  ВОЗВРАТ ДОСТОИНСТВА ДОКАЗАТЕЛЬСТВОМ, А НЕ УТЕШЕНИЕМ. Ровно, как
    //  констатируют исправность прибора. Ролик про думанье, который объявит
    //  зрителя дураком, сам себя опровергнет.
    //lip 11
    together {
        freeman speaks for 6.50s
        do {
            freeman overlays "ladoni_vniz" // «голова не сломана»
            wait 3.5s
            freeman overlays "teplo"       // «она работала — просто вхолостую»
        }
    }
    wait 0.7s

    // ── ХОД (VO-12): по чему отличают ─────────────────────────────────
    //  ЕДИНСТВЕННОЕ МЕСТО, ГДЕ КУРС ЧТО-ТО ДАЁТ, и унести это можно прямо
    //  отсюда. Вопрос в конце — не риторический: его задают буквально.
    //lip 12
    together {
        freeman speaks for 6.70s
        do {
            camera medium freeman
            freeman overlays "stop_ladon"  // «отличить эти способы изнутри нельзя»
            wait 3.7s
            freeman overlays "palec_vverh" // «что у меня в руках?»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 6: ДВЕ ТРОПЫ — ВЗЛЁТ И ШУТКА ===========================
//  ДВЕ ТРОПЫ БУКВАЛЬНО ПРО ВЫБОР ВОПРОСА. Локация не иллюстрирует свободу —
//  она показывает, что выбор вообще существует, а это ровно то, что отрицает
//  жующий.
scene "tropy" (duration: 1s, set: tropy) {
    transition static 0.2s

    //  Пол начинается очень высоко (карта: back_y 0.118) — горизонт далеко.
    //  Фигура в левой трети: по центру она встаёт ровно на развилку и обе
    //  тропы уходят из кадра за её спину.
    place freeman at (0.24, 0.90) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ВЗЛЁТ (VO-13): свобода и жевание ──────────────────────────────
    //  СОЕДИНЕНИЕ В ОДНОМ ПРЕДЛОЖЕНИИ (GLUBINA-I-SMEH.md §3): «свобода» и
    //  «жуёте» стоят в одной фразе, а не в соседних. Уберите жевание —
    //  останется «свобода это когда вы выбираете вопрос», лозунг без довода.
    //lip 13
    together {
        freeman speaks for 6.70s
        do {
            freeman overlays "teplo"       // «свобода — это когда вы выбираете»
            wait 3.6s
            freeman overlays "otverg"      // «а не жуёте тот, что достался»
        }
    }
    wait 0.9s

    // ── ШУТКА (VO-14): белый медведь ──────────────────────────────────
    //  СМЕЮТСЯ НАД СПОСОБОМ, НЕ НАД ЧЕЛОВЕКОМ, и способ назван ВЕЩЬЮ. Вторая
    //  фраза — как предлагают проверить, а не как ловят: зритель ставит опыт
    //  на себе и проигрывает опыту, а не рассказчику.
    //lip 14
    together {
        freeman speaks for 6.96s
        do {
            freeman overlays "otmahnulsya" // «самое популярное решение — перестать думать»
            wait 3.7s
            freeman overlays "prishchur"   // «не думайте о белом медведе»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-15): предел назван ──────────────────────────
    //  СПОКОЙНАЯ ДОБИВКА, ВНИЗ, БЕЗ УЛЫБКИ. Предел не-решения назван и тут же
    //  оплачен вещью, которая уже пришла и не уйдёт.
    //lip 15
    together {
        freeman speaks for 4.83s
        do {
            camera medium freeman
            freeman overlays "v_upor"
            wait 2.6s
            freeman overlays "doshlo"      // «дальше он ваш до ночи»
        }
    }
    camera wide
    //  УХМЫЛКА — ПОСЛЕ РЕПЛИКИ, НЕ ВНУТРИ: `smug` трогает рот.
    freeman overlays "smug"
    wait 1.0s
}

// ============ СЦЕНА 7: ЗАЛ ЛЕКТОРИЯ — КУРС =================================
//  ДЕЛОВАЯ ЧАСТЬ И ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ЗВУЧИТ СЛОВО «КУРС». Тон тот же,
//  что и во всём ролике: ничего не продают, называют.
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    //  Карта пола: back_y 0.62.
    place freeman at (0.30, 0.94) facing front on floor
    freeman scales 0.82 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПРЕЗЕНТАЦИЯ (VO-16): название ─────────────────────────────────
    //  БЕЗ ПОДМИГИВАНИЯ. Название курса — не шутка и не каламбур, хотя и
    //  выглядит как продолжение фразы.
    //lip 16
    together {
        freeman speaks for 2.83s
        do {
            freeman overlays "razvel"      // «курс так и называется»
        }
    }
    wait 0.45s

    // ── ПРЕЗЕНТАЦИЯ (VO-17): цена ─────────────────────────────────────
    //  РЕПЛИКА САМОДОСТАТОЧНА: числа до неё не звучало, и «все четырнадцать»
    //  без слова «лекций» повисло бы без опоры — на этом уже обжигались.
    //lip 17
    together {
        freeman speaks for 2.64s
        do {
            camera medium freeman
            freeman overlays "palec_vverh" // «четырнадцать лекций, и всё бесплатно»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 8: КУХНЯ С ЧАЙНИКОМ — ЖАЛО И ПОДПИСЬ ===================
//  КОЛЬЦО. Возврат ровно туда, где ролик начался: тот же вечер, та же кухня,
//  но теперь у зрителя есть, что там сделать.
scene "zhalo" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.22, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЖАЛО (VO-18): измеримое действие ──────────────────────────────
    //  ДЕЙСТВИЕ ЗАНИМАЕТ ОДНУ СЕКУНДУ, и это условие: домашнее задание на
    //  полчаса зритель не сделает. Кольцо к VO-5: там жвачку назвали, здесь
    //  на ней ловят.
    //lip 18
    together {
        freeman speaks for 5.08s
        do {
            freeman overlays "vozzvanie"   // «поймайте себя на жвачке»
            wait 2.9s
            freeman overlays "palec_vverh" // «что у меня в руках?»
        }
    }
    wait 0.5s

    // ── ЖАЛО-ДОБИВКА (VO-19): вечер остаётся ваш ──────────────────────
    //  ЗРИТЕЛЬ УХОДИТ НАВЕРХ ПО СТАТУСУ. Почти дружелюбно, вверх на конце:
    //  вечер не потерян, он в его распоряжении.
    //lip 19
    together {
        freeman speaks for 3.97s
        do {
            camera medium freeman
            freeman overlays "teplo"       // «смените вопрос»
            wait 2.2s
            freeman overlays "raskryl"     // «вечер всё ещё ваш»
        }
    }
    camera wide
    wait 1.2s

    // ── ПОДПИСЬ (VO-20): кольцо для ленты ─────────────────────────────
    //  ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ. Ролик уходит в ленту, где он зациклен, и
    //  последняя реплика — не удар, а сшивка.
    freeman pose "gladit_grud"
    //lip 20
    together {
        freeman speaks for 5.68s
        do {
            freeman overlays "gladit_grud_niz"  // «лекторий мейстера»
            wait 3.6s
            freeman overlays "vozzvanie"        // «поехали!»
        }
    }
    //  ПОДМИГИВАНИЕ — ПОСЛЕ РЕПЛИКИ: `hero_wink` трогает рот.
    freeman overlays "hero_wink"
    wait 0.6s
}
