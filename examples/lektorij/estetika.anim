// =============================================================================
//  «ЗА КРАСОТУ» — интро к курсу «Эстетика».
//  VO — estetika-VO.md, маркеры 1..19.
//
//  ОДНА МЫСЛЬ НА РОЛИК: вкус не выбирают, его набирают глазами. А показывают
//  вам то, что кто-то выбрал заранее.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ХУК ОБВИНЯЕТ НЕ В ПОСТУПКЕ, А В ОБЪЯСНЕНИИ. «Свой телефон вы выбрали за
//     красоту… а потом придумали про камеру.» Сам выбор зритель защищать не
//     станет — защищать он станет свою рациональность, и ровно её у него и
//     забирают.
//
//  2. ПУЛЕМЁТ РАСШИРЯЕТ ОБВИНЕНИЕ ДО ЧЕЛОВЕКА (VO-5). Чайник, куртка, человек,
//     с которым живёте. Третий пункт играется ТЕМ ЖЕ ТОНОМ, что и чайник:
//     подчеркнёшь — выйдет обвинение в поверхностности, и зритель уйдёт в
//     защиту вместо узнавания.
//
//  3. ГЛАВНОЕ УЗНАВАНИЕ — ОТСУТСТВУЮЩИЙ УЧИТЕЛЬ (VO-6, VO-7). «Кто вам
//     объяснил, что красиво? Никто. Вы просто насмотрелись.» Зритель ищет
//     учителя вкуса и не находит ни одного; значит образец попал в него через
//     глаза, и попал оттуда, куда он смотрел. Кадр отвечает вместе с репликой:
//     сцена стоит в ХОРЕ ГОЛОСОВ, где рупоров много и ни один не назвать.
//
//  4. ОБРАЗ ПЕРЕВЁРНУТ. Телефон в первой реплике выбран ЗА красоту; в жале он
//     оказывается тем, кто теперь выбирает красоту ЗА зрителя — «найдите
//     красивую вещь, не в телефоне». Одна вещь в двух ролях, и вторая роль —
//     разгадка первой.
//
//  5. РОЛИК ПРОВЕРЕН ВЫЧИТКОЙ (`VYCHITKA.md`), И ОНА НАШЛА ДВА МЕСТА.
//     Первое: «в ленте выбрали за вас» — глагол без подлежащего, ухо ищет, кто
//     выбрал, и не находит. Стало «за вас уже выбрала лента». Второе:
//     «одну за весь день» — числительное без существительного, повисает, если
//     предыдущую реплику пропустил мимо ушей. Ровно та грабля, урок про
//     которую я записал в реестр после прошлого ролика И НЕ ПРИМЕНИЛ к
//     собственной реплике. Стало «одну вещь за весь день».
//
//  6. НОМЕРА КУРСА В РОЛИКЕ НЕТ: его присваивает студия. Первый и последний
//     кадры тождественны и стоят в позе поглаживания груди — метка добавится
//     одной сценой.
//
//  7. ЛОКАЦИЙ СЕМЬ, И НИ ОДНА НЕ ПОВТОРЯЕТ ПРОШЛЫЙ РОЛИК. Ряды супермаркета не
//     появлялись шесть роликов подряд; прихожая с пакетами и две тропы
//     использовались по одному разу за всю серию. Каждая проверена рендером
//     перед первым использованием (реестр §XXV: «руины кафе» числились
//     свободными, а на рендере дали чёрный кадр).
//
//  8. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): пулемёт 6.4,
//     узнавание и цена 4.2 — перепад в полтора раза.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). В этом ролике таких два: `smug` и
//      `hero_wink`, оба вынесены в паузы;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · координаты фигуры снимаются ПРОБНЫМ РЕНДЕРОМ (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`,
//  реестр §XXIII). Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set super from "../assets/sets/supermarket-ryady.svg"
import set prihozhaya from "../assets/sets/prihozhaya-pakety.svg"
import set hor from "../assets/sets/logika-hor-golosov.svg"
import set void from "../assets/sets/void-black.svg"
import set derevo from "../assets/sets/derevo-pen.svg"
import set tropy from "../assets/sets/dve-tropy.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: РЯДЫ СУПЕРМАРКЕТА — ХУК =============================
//  МЕСТО, ГДЕ ВЫБОР СОВЕРШАЕТСЯ ГЛАЗАМИ И НАЗЫВАЕТСЯ РАЗУМНЫМ. Полки уходят в
//  перспективу с обеих сторон: смотреть есть на что, а выбирать нечем, кроме
//  вида. В серии не появлялось шесть роликов подряд.
scene "ryady" (duration: 1s, set: super) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании.
    //  Координаты сняты пробным рендером: при 0.50/0.62 фигура уходит вглубь
    //  прохода и теряется среди полок (карта пола: back_y 0.3).
    place freeman at (0.46, 0.80) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ. Поза поглаживания груди держит место
    //  под метку курса: номер присваивает студия.
    freeman pose "gladit_grud"
    wait 0.15s
    freeman pose "v_upor"
    wait 0.1s

    // ── ХУК (VO-1): обвинение в выборе ────────────────────────────────
    //  РОВНО, БЕЗ НАСМЕШКИ. Насмешка ставит зрителя в защиту раньше, чем он
    //  поймёт, в чём его обвиняют, — и дальше он слушает не ролик, а спор.
    //lip 1
    together {
        freeman speaks for 2.70s
        do {
            freeman overlays "hips"        // «свой телефон вы выбрали за красоту»
        }
    }
    wait 0.35s

    // ── ДОБИВКА (VO-2): два отрицания и вывод ─────────────────────────
    //  ТРИАДА. Буднично, как вычёркивают пункты; последнее слово тяжелее двух
    //  первых.
    //lip 2
    together {
        freeman speaks for 4.28s
        do {
            freeman overlays "rubit"       // «не за память»
            wait 1.4s
            freeman overlays "rubit_l"     // «не за камеру»
            wait 1.4s
            freeman overlays "razvel"      // «за внешность»
        }
    }
    wait 0.45s

    // ── УДАР (VO-3): нож поворачивают ─────────────────────────────────
    //  ОБВИНЯЮТ НЕ В ВЫБОРЕ, А В ОБЪЯСНЕНИИ. Выбор зритель защищать не станет,
    //  свою рациональность — станет, и её у него забирают.
    //lip 3
    together {
        freeman speaks for 3.15s
        do {
            camera medium freeman
            freeman overlays "ostyl"       // «а потом придумали про камеру»
        }
    }
    camera wide
    wait 0.8s

    // ── ОТРИЦАНИЕ (VO-4): защита закрыта фактом ───────────────────────
    //  «МНЕ ВООБЩЕ-ТО ВСЁ РАВНО» — первое, чем зритель прикроется. Закрывается
    //  проверяемой мелочью, а не спором. Устало, как отмахиваются.
    //lip 4
    together {
        freeman speaks for 4.00s
        do {
            freeman overlays "otmahnulsya" // «и не надо «мне всё равно»»
            wait 2.2s
            freeman overlays "prishchur"   // «цвет вы выбирали полчаса»
        }
    }
    wait 0.35s
}

// ============ СЦЕНА 2: ПРИХОЖАЯ С ПАКЕТАМИ — ПУЛЕМЁТ =======================
//  ТО, ЧТО УЖЕ ПРИНЕСЛИ ДОМОЙ: чайник, куртка — всё стоит тут, в пакетах.
//  Локация использовалась ОДИН раз за всю серию.
scene "prineseno" (duration: 1s, set: prihozhaya) {
    transition static 0.2s

    place freeman at (0.34, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПУЛЕМЁТ (VO-5): чайник, куртка, человек ───────────────────────
    //  САМЫЙ БЫСТРЫЙ КУСОК РОЛИКА — 6.4 слога в секунду. ТРЕТИЙ ПУНКТ ТЕМ ЖЕ
    //  ТОНОМ, ЧТО И ЧАЙНИК: ради него очередь и затевалась, но подчеркнёшь —
    //  выйдет обвинение в поверхностности, и зритель уйдёт в защиту.
    //lip 5
    together {
        freeman speaks for 5.09s
        do {
            freeman overlays "razvel"      // «так же вы выбрали чайник»
            wait 1.7s
            freeman overlays "raskryl"     // «и куртку»
            wait 1.7s
            freeman overlays "vzves"       // «и человека, с которым живёте»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: ХОР ГОЛОСОВ — ПЕРЕЛОМ И УЗНАВАНИЕ ===================
//  КАДР БУКВАЛЬНО ОТВЕЧАЕТ НА РЕПЛИКУ. «Кто вам объяснил, что красиво?» —
//  вокруг рупоры, их много, и ни один не назвать по имени. Учителя нет, а
//  голосов полно; ровно это и есть ответ.
scene "hor" (duration: 1s, set: hor) {
    transition static 0.2s

    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.76 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ (VO-6): перелом ролика ───────────────────────────────
    //  ВОПРОС ВВЕРХ И БЕЗ НАЖИМА — приглашение поискать, а не упрёк. Дальше
    //  девять десятых тишины: зритель перебирает, кто его учил вкусу, и не
    //  находит никого.
    //lip 6
    together {
        freeman speaks for 4.47s
        do {
            freeman overlays "v_upor"
            wait 2.8s
            freeman overlays "vozzvanie"   // «кто вам объяснил, что красиво?»
        }
    }
    wait 0.9s

    // ── УДАР (VO-7): учителя не было ──────────────────────────────────
    //  ГЛАВНОЕ УЗНАВАНИЕ И ЦИТАТА НА СКРИНШОТ. «Никто» отдельно и суше всего;
    //  вторая фраза тише и медленнее — она объясняет, и объяснять надо тихо.
    //lip 7
    together {
        freeman speaks for 3.29s
        do {
            freeman overlays "otverg"      // «никто»
            wait 1.9s
            freeman overlays "vniz"        // «вы просто насмотрелись»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 4: ПУСТОТА — ЦЕНА ======================================
//  ИЩУТ ПРИМЕР ТАМ, ГДЕ НЕЧЕМ ОТВЛЕЧЬСЯ. После хора голосов чёрный кадр
//  работает вдвойне: только что было шумно, и вдруг не осталось ничего.
scene "obrazec" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.46) facing front
    freeman scales 2.0 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕНА (VO-8): у образца есть автор ─────────────────────────────
    //  «ПОКАЗЫВАЛИ» — последнее слово и самое тяжёлое: показывал кто-то, и
    //  это не зритель. Ровно, как читают справку.
    //lip 8
    together {
        freeman speaks for 4.72s
        do {
            freeman overlays "razvel"      // «и насмотрелись того»
            wait 2.8s
            freeman overlays "ugryumo"     // «что вам показывали»
        }
    }
    wait 0.45s

    // ── ВОЗВРАТНЫЙ ВОПРОС (VO-9) ──────────────────────────────────────
    //  ОН НЕ РИТОРИЧЕСКИЙ: зритель начинает искать пример и не находит.
    //  Вверх, почти участливо — сочувствие тут бьёт сильнее обвинения.
    //lip 9
    together {
        freeman speaks for 4.54s
        do {
            camera medium freeman
            wait 2.9s
            freeman overlays "vozzvanie"   // «чего до вас никто не хвалил?»
        }
    }
    camera wide
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА: зритель перебирает свои покупки.
    wait 1.1s
}

// ============ СЦЕНА 5: ДЕРЕВО И ПЕНЬ — СНЯТИЕ ВИНЫ И ХОД ===================
//  ЕДИНСТВЕННАЯ В РОЛИКЕ КРАСОТА, КОТОРУЮ НИКТО НИКОМУ НЕ ПОКАЗЫВАЛ. После
//  супермаркета и рупоров кадр сам по себе снимает обвинение.
scene "derevo" (duration: 1s, set: derevo) {
    transition static 0.25s

    place freeman at (0.5, 0.90) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── КАЧЕЛИ (VO-10): возврат достоинства ───────────────────────────
    //  ВИНОВАТ НЕ ХАРАКТЕР ЗРИТЕЛЯ, А УСТРОЙСТВО ГЛАЗА. Это вторая лекция
    //  курса, сказанная без слова «эволюция». Ровно, как констатируют.
    //lip 10
    together {
        freeman speaks for 5.12s
        do {
            freeman overlays "ladoni_vniz" // «вы не поверхностный»
            wait 2.7s
            freeman overlays "teplo"       // «так устроен глаз»
        }
    }
    wait 0.5s

    // ── ХОД (VO-11): курс отдаёт своё ─────────────────────────────────
    //  ЕДИНСТВЕННОЕ МЕСТО, ГДЕ КУРС ЧТО-ТО ДАЁТ, и оно же опровергает главное
    //  оправдание зрителя — «ну такой у меня вкус». Спокойно, с достоинством.
    //lip 11
    together {
        freeman speaks for 5.52s
        do {
            camera medium freeman
            freeman overlays "stop_ladon"  // «вкус не даётся с рождения»
            wait 3.4s
            freeman overlays "point"       // «набрать можно другой»
        }
    }
    camera wide
    wait 0.7s
}

// ============ СЦЕНА 6: ДВЕ ТРОПЫ — ВЗЛЁТ И ШУТКА ===========================
//  СВОБОДА ВЫБРАТЬ ИНАЧЕ — ЭТО БУКВАЛЬНО ВТОРАЯ ТРОПА. Локация использовалась
//  ОДИН раз за всю серию; фигура стоит ровно в развилке.
scene "tropy" (duration: 1s, set: tropy) {
    transition static 0.2s

    //  Горизонт очень высоко (карта: back_y 0.118) — фигура ставится к
    //  переднему краю, в точку развилки.
    place freeman at (0.46, 0.90) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ВЗЛЁТ (VO-12): единственное высокое место ролика ──────────────
    //  СТОЛКНОВЕНИЕ РЕГИСТРОВ: «свобода» и «лента» в одной строке. От этого
    //  свобода перестаёт звучать лозунгом: она означает ровно одно — выбирать
    //  не из показанного.
    //
    //  «ЗА ВАС УЖЕ ВЫБРАЛА ЛЕНТА», А НЕ «В ЛЕНТЕ ВЫБРАЛИ ЗА ВАС»: во втором
    //  варианте глагол оставался без подлежащего, и ухо искало, кто выбрал.
    //  Поймано вычиткой.
    //lip 12
    together {
        freeman speaks for 5.20s
        do {
            freeman overlays "razvel"      // «за вас уже выбрала лента»
            wait 2.9s
            freeman overlays "teplo"       // «свобода выбрать иначе»
        }
    }
    wait 0.9s

    // ── ШУТКА (VO-13): самое популярное не-решение ────────────────────
    //  СМЕЮТСЯ НАД СПОСОБОМ, НЕ НАД ЧЕЛОВЕКОМ. Раз красота обманывает —
    //  покупать всё некрасивое. Способ рабочий, у него просто есть предел.
    //lip 13
    together {
        freeman speaks for 3.87s
        do {
            freeman overlays "otmahnulsya" // «можно и без курса»
            wait 2.2s
            freeman overlays "shrug"       // «покупать всё некрасивое»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-14): предел назван ──────────────────────────
    //  СПОКОЙНАЯ ДОБИВКА, ВНИЗ. Предел не подчёркивается: подчеркнёшь —
    //  получится спор, а не смешно.
    //lip 14
    together {
        freeman speaks for 4.26s
        do {
            freeman overlays "v_upor"
            wait 2.6s
            freeman overlays "doshlo"      // «как вы принесёте это домой»
        }
    }
    //  УХМЫЛКА — ПОСЛЕ РЕПЛИКИ, НЕ ВНУТРИ: `smug` трогает рот. В паузе она и
    //  работает лучше — панч сначала договаривают.
    freeman overlays "smug"
    wait 1.0s
}

// ============ СЦЕНА 7: ЗАЛ ЛЕКТОРИЯ — КУРС =================================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ.
scene "kurs" (duration: 1s, set: zal) {
    transition static 0.25s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПРЕЗЕНТАЦИЯ (VO-15): трудное слово и перевод ──────────────────
    //  ЕДИНСТВЕННОЕ ТРУДНОЕ СЛОВО В РОЛИКЕ, и оно тут же переведено. Перевод
    //  идёт ТЕМ ЖЕ ТОНОМ, без подмигивания: это не шутка про умное слово, это
    //  помощь.
    //lip 15
    together {
        freeman speaks for 5.99s
        do {
            freeman overlays "raskryl"     // «курс так и называется: эстетика»
            wait 4.0s
            freeman overlays "razmer"      // «почему нам красиво»
        }
    }
    wait 0.45s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-16): цена ────────────────────────────
    //  РЕПЛИКА САМОДОСТАТОЧНА: числа до неё в ролике не звучало, и «все
    //  десять» без слова «лекций» повисло бы без опоры — на этом уже
    //  обжигались в прошлом ролике.
    //
    //  ГОЛОСОМ НЕ НАЖИМАТЬ: бесплатное с нажимом читается как подвох.
    //lip 16
    together {
        freeman speaks for 2.00s
        do {
            freeman overlays "razvel"      // «все десять лекций — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 8: ТЕ ЖЕ РЯДЫ — ЖАЛО ===================================
//  ДЕЙСТВИЕ НАЗНАЧАЮТ ТАМ, ГДЕ НАЧАЛОСЬ ОБВИНЕНИЕ: те же полки, тот же выбор
//  глазами. Только теперь зрителя просят выбрать не отсюда.
scene "zhalo" (duration: 1s, set: super) {
    transition static 0.2s

    place freeman at (0.46, 0.80) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-17): измеримое действие ──────────────────────────────
    //  ПЛАНКА НАРОЧНО НИЗКАЯ — одна вещь за день; высокая планка и есть то,
    //  чем зритель отговорится. «Не в телефоне» — отдельно и тише: здесь
    //  образ замыкается, и вещь, выбранная за красоту, оказывается той, что
    //  теперь выбирает красоту за зрителя.
    //lip 17
    together {
        freeman speaks for 5.56s
        do {
            camera medium freeman
            freeman overlays "palec_vverh" // «найдите одну красивую вещь»
            wait 3.6s
            freeman overlays "stop_ladon"  // «не в телефоне»
        }
    }
    camera wide
    wait 0.5s

    // ── ЖАЛО-ДОБИВКА (VO-18): вызов ───────────────────────────────────
    //  «ОДНУ ВЕЩЬ», А НЕ «ОДНУ»: числительное без существительного повисало,
    //  если предыдущую реплику пропустили мимо ушей. Поймано вычиткой.
    //lip 18
    together {
        freeman speaks for 2.50s
        do {
            freeman overlays "vozzvanie"   // «одну вещь за весь день. найдёте?»
        }
    }
    //  ПОДМИГИВАНИЕ — ПОСЛЕ ПОСЛЕДНЕГО СЛОВА: `hero_wink` трогает рот.
    freeman overlays "hero_wink"
    wait 1.2s
}

// ============ СЦЕНА 9: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ =================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: те же ряды, тот же `place`, тот же
//  масштаб, та же поза поглаживания. Когда студия присвоит номер, метка
//  встанет сюда и в первый кадр одинаково.
scene "final" (duration: 1s, set: super) {
    transition static 0.2s

    place freeman at (0.46, 0.80) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide

    //lip 19
    together {
        freeman speaks for 5.50s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.7s
            freeman overlays "gladit_grud_niz"
            wait 1.5s
            freeman overlays "palec_vverh" // «Поехали!»
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания — ровно то, с чего
    //  ролик начинается.
    freeman pose "gladit_grud"
    wait 0.4s
}
