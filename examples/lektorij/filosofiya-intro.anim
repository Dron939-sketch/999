// =============================================================================
//  «ФИЛОСОФИЯ» — продающее интро курса
//  (meysternlp.ru/blog/lektorij/filosofiya — 10 лекций, ~2,9 часа).
//
//  СКВОЗНАЯ: вы живёте по ответам, которых не выбирали, — они стоят в голове
//  готовыми, как бумажки из автомата. Философия — не заумь, а право самому
//  ответить на пять вопросов, на которые вы всё равно отвечаете каждым днём.
//
//  ЛОКАЦИИ СНЯТЫ ПОД ЭТОТ СЦЕНАРИЙ. Каждая доказывает свою реплику деталью,
//  а не подписью, и две зарифмованы кадр в кадр:
//
//    void            пустота до всякого вопроса      приветствие
//    filo-avtomat    автомат готовых ответов, в       хук: живёте своей головой;
//                    ячейках одинаковые бумажки,      смысл жизни — третья кнопка
//                    лоток, гора скомканных на полу   сверху (ружьё: бумажка падает)
//    filo-ochered    хвост одинаковых силуэтов с      пулемёт 1: утро, работа,
//                    той же бумажкой над головой      лента, так надо
//    filo-rupor      столб с рупором на пустой         пулемёт 2 и финал: кто сказал —
//                    площади, земля в бумажках        кто-то; вы цитируете
//    filo-golova     чёрный профиль с распахнутой     разворот: голова своя,
//                    дверцей, внутри полки с теми же  внутри чужое
//                    бумажками
//    filo-stol       та же бумажка РАЗВЁРНУТА и       взлёт: пять вопросов, ответ
//                    пуста, рядом карандаш            пишете вы
//    void снова      кольцо: отвечать некому          жало
//
//  РИФМА АВТОМАТ ↔ СТОЛ — главный приём видеоряда. Из автомата бумажка
//  выпадает скрученной, с готовым ответом внутри. На столе та же бумажка
//  развёрнута — и пуста, рядом карандаш. Ролик не обещает «мудрость», он
//  обещает чистый лист и право заполнить его самому — ровно то, что курс и
//  делает (лекция 10: «собираем свою философию»).
//
//  ГОЛОВА С ДВЕРЦЕЙ — РАЗВОРОТ. Лекции 5–6 курса: «свободен ли я» и «кто такой
//  „я“». В голове полки, на полках чужое. Дверца распахнута — заглянуть можно,
//  и это страшнее запертой. «Голова́ своя́. А внутри́ — чужо́е» — это и есть кадр.
//
//  МИМИКА — ТОЛЬКО СЛОЕМ, И ТОЛЬКО ЛИЦЕВАЯ (PRAVILA-DVIZHENIYA.md §5).
//
//    · персонаж — канон (SIMILARITY.md), пластика слоя «повадок» (RULES.md);
//    · режиссура (HOLLYWOOD.md): каты ВНУТРИ реплик, флэш-морды на сверхкрупе
//      (§2), наезд на переломе (§4), второй план играет ту же мысль (§4a),
//      ≥3 разных поля за ролик (§7 — здесь шесть);
//    · сценарий (SCRIPT-FREEMAN.md) — filosofiya-intro-VO.md, //lip 1..9.
//
//  ДЛИНА при потолке приёмщика 60с. `duration` у сцены — ПОЛ, а не потолок.
//  `speaks for` вписаны `tools/vo_budget.py --patch-anim`, не на глаз.
//
//  ЖЕСТЫ СТОЯТ НА СЛОВАХ, А НЕ НА СЕКУНДАХ. Первая версия ставила паузы в
//  блоках `do` на глаз, и на озвучке жесты разъехались с речью: обвис на
//  «Так надо» приходился на «Ленту», голова втягивалась на «сказал?» вместо
//  «Кто-то», раскрытие на «Ответ пишете вы» случалось посреди предыдущего
//  предложения, а хук и самая презрительная реплика обходились вообще без
//  жеста рук. Теперь каждая пауза — ДОЛЯ реплики: доли сняты с готовой дорожки
//  и записаны в комментарии рядом с каждой позой.
//
//  Доли — ЗАМЫСЕЛ, а попадание держит завод. Синтез каждый раз распределяет
//  паузы чуть иначе, и доля, снятая с прошлой дорожки, уезжает от слова на
//  0.1–0.15 реплики. Поэтому `prep_lipsync` не просто тянет блок `do` под
//  фактическую длину mp3, а после растяжки подтягивает каждую смену позы к
//  ближайшей атаке слога, если она ближе 0.35с. Замер на этой подводке:
//  средний промах до слова 0.10с → 0.00с, шестнадцать жестов из шестнадцати.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set pustota from "../assets/sets/void.svg"
import set avtomat from "../assets/sets/filo-avtomat.svg"
import set ochered from "../assets/sets/filo-ochered.svg"
import set rupor from "../assets/sets/filo-rupor.svg"
import set golova from "../assets/sets/filo-golova.svg"
import set stol from "../assets/sets/filo-stol.svg"
import set titry from "../assets/sets/lektorij-final.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 1.9
    snow: 0.35
    on-twos: 2

    line-boil: 0.0
    gate-weave: 0.0
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    film-scratch: 0.25
    film-dust: 0.5

    ground-shadow: true
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

// ═══════════════ СЦЕНА 1: ПУСТОТА — до всякого вопроса ════════════════════
scene "pustota" (duration: 5.9s, set: pustota) {
    transition static 0.35s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s
    // ЗАПИСКА УЖЕ В РУКЕ. Зал (раунд 1) смахивал ролик на второй секунде:
    // пустое поле, фигура стоит, голос тянет «ну-у-у». Готовый ответ у него в
    // руке ДО того, как появится автомат, — и брошен на «Дороги́е мои́».
    let gotovyj = prop("gotovyj", "../assets/props/zapiska.svg") at (0.567, 0.652)
    gotovyj scales 0.34 over 0.01s

    camera wide
    freeman pose "calm"
    wait 0.7s
    camera medium freeman
    freeman overlays "doubt"
    wait 0.3s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1) ─────────────────────────────────────
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 4.5s
        do {
            wait 3.4s
            freeman pose "open"          // «Дороги́е мои́» (0.75) — руки в стороны
            gotovyj moves-to (0.63, 0.80) over 0.35s ease-in
            gotovyj rotates 55 over 0.35s
            wait 0.5s
            gotovyj hides                // отброшен: ответ был готовый, и не нужен
            wait 0.6s
        }
    }
    wait 0.2s
}

// ═══════════════ СЦЕНА 2: АВТОМАТ — ответы покупают ═══════════════════════
//  ХУК (VO-2) и добивка (VO-3). Он стоит перед автоматом готовых ответов,
//  руки в боки — гордится, что живёт своей головой. Добивка: тычет в панель,
//  «смысл жизни — третья кнопка сверху», и бумажка падает в лоток. Ружьё
//  заряжено кадром и стреляет на реплике.
scene "avtomat" (duration: 1.0s, set: avtomat) {
    transition static 0.22s

    place freeman at (0.36, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let zapiska = prop("zapiska", "../assets/props/zapiska.svg") at (0.742, 0.63)
    zapiska scales 0.4 over 0.01s
    zapiska hides

    // ОБЩИЙ ПЛАН ПЕРВЫМ: автомат и гора бумажек на полу — это и есть локация.
    camera wide
    freeman pose "hips"
    wait 0.25s
    //lip 2
    together {
        freeman speaks for 3.6s
        do {
            camera zoom-to freeman over 2.2s ease-in
            freeman overlays "smug"
            wait 2.9s
            freeman pose "confident"     // «Го́рдо» (0.81) — грудь колесом, иронично
            wait 0.5s
        }
    }
    wait 0.1s

    // Добивка: тычет в кнопку — бумажка падает — и в упор: «третья сверху».
    camera wide
    freeman pose "think"                 // пока только смотрит на панель
    //lip 3
    together {
        freeman speaks for 2.6s
        do {
            wait 1.1s
            freeman pose "point"         // «тре́тья» (0.42) — палец в панель
            wait 0.3s
            zapiska shows                // «кно́пка» (0.54) — записка пошла в лоток
            zapiska moves-to (0.742, 0.755) over 0.3s ease-in
            zapiska rotates 40 over 0.3s
            wait 0.45s
            freeman pose "v_upor"        // «све́рху» (0.71) — в упор к зрителю
            camera extreme-close-up freeman
            wait 0.5s
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "hero_skeptic"
    wait 0.2s
}

// ═══════════════ СЦЕНА 3: ОЧЕРЕДЬ — так надо ══════════════════════════════
//  ПУЛЕМЁТ 1 (VO-4). Хвост одинаковых силуэтов до кромки, у каждого над
//  головой та же бумажка, впереди — тот же автомат. Он в разрыве очереди,
//  один лицом к нам, дёргается марионеткой: «Утро. Работа. Лента. Так надо.»
scene "ochered" (duration: 1.0s, set: ochered) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "puppet"
    freeman overlays "gab"
    wait 0.2s
    //lip 4
    together {
        freeman speaks for 5.4s
        do {
            wait 0.9s
            freeman pose "puppet_jerk"   // «Рабо́та» (0.17) — рывок
            wait 1.5s
            freeman pose "puppet"        // «Ле́нта» (0.44) — дёрнуло обратно
            wait 0.8s
            freeman pose "ugryumo"       // «Та́к на́до» (0.59) — обвис ВСЕМ телом
            freeman overlays "weary"
            camera medium freeman
            wait 1.6s
        }
    }
    wait 0.1s
}

// ═══════════════ СЦЕНА 4: РУПОР — кто-то сказал ═══════════════════════════
//  ПУЛЕМЁТ 2 (VO-5) и финал (VO-6). Столб с рупором на пустой площади, из
//  раструба дуги, земля в бумажках. Под рупором — он один.
scene "rupor" (duration: 1.0s, set: rupor) {
    transition static 0.22s

    place freeman at (0.56, 0.585) facing front
    freeman scales 0.80 over 0.01s
    let slovo = text("ЧЬЯ МЫСЛЬ?", 120) at (0.5, -2.0) layer 6
    slovo scales 2.4 over 0.01s

    camera wide
    freeman pose "shrug"                 // «кто сказал?» — плечами
    wait 0.2s
    //lip 5
    together {
        freeman speaks for 2.6s
        do {
            wait 1.9s
            freeman pose "hunch"          // «Кто́-то» (0.74) — втянул голову
            camera medium freeman
            wait 0.6s
        }
    }
    // Финал пулемёта (VO-6): «Вы не думаете. Вы цитируете.»
    freeman pose "otvraschenie"
    //lip 6
    together {
        freeman speaks for 3.6s
        do {
            wait 2.3s
            freeman pose "point"          // «Вы цити́руете» (0.63) — палец в зрителя
            freeman overlays "hero_skeptic"
            camera close-up freeman
            wait 1.0s
        }
    }
    // ── СЛОВО-УДАР + инверсия-панч ────────────────────────────────────────
    slovo moves-to (0.5, 0.28) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.2s
    slovo moves-to (0.5, -2.0) over 0.18s ease-in
}

// ═══════════════ СЦЕНА 5: ГОЛОВА — внутри чужое ═══════════════════════════
//  ПЕРЕЛОМ (VO-7). Чёрный профиль с распахнутой дверцей в затылке, внутри
//  полки с теми же бумажками. Общий план держится — полки надо успеть
//  прочитать. «Всё» наезжает одним долгим ходом.
scene "golova" (duration: 1.0s, set: golova) {
    transition static 0.22s

    place freeman at (0.34, 0.585) facing front
    freeman scales 0.80 over 0.01s

    camera wide
    freeman pose "puppet"
    freeman overlays "stern"
    wait 0.05s
    //lip 7
    together {
        freeman speaks for 5.0s
        do {
            wait 3.1s
            freeman pose "v_upor"        // «чужо́е» (0.62)
            // наезд доезжает ровно на «Всё» (0.93), а не после него
            camera zoom-to freeman over 1.5s ease-in
            wait 0.2s
        }
    }
    camera shake 0.3s intensity 2
    wait 0.2s
}

// ═══════════════ СЦЕНА 6: СТОЛ — чистый лист ══════════════════════════════
//  ВЗЛЁТ (VO-8). Та же бумажка развёрнута и пуста, рядом карандаш, окно.
//  Медиум, а не крупный: рифма читается только со столом и листом.
scene "stol" (duration: 1.0s, set: stol) {
    transition static 0.22s

    place freeman at (0.34, 0.585) facing front
    freeman scales 0.80 over 0.01s

    // ОБЩИЙ ПЛАН ПЕРВЫМ: рифма с автоматом читается только целиком.
    camera wide
    freeman pose "calm"
    wait 0.4s
    //lip 8
    together {
        freeman speaks for 8.4s
        do {
            wait 4.1s
            freeman pose "raskryl"       // «Отве́т пи́шете вы» (0.49) — открылся
            camera medium freeman
            wait 2.2s
            freeman pose "confident"     // «Э́то и есть свобо́да» (0.75)
            camera close-up freeman
            wait 1.5s
        }
    }
    wait 0.3s
}

// ═══════════════ СЦЕНА 7: ПУСТОТА СНОВА — КОЛЬЦО ══════════════════════════
//  ЖАЛО-CTA (VO-9). Между двумя пустотами прошли автомат, очередь, рупор,
//  голова и стол. Снять их — оставить его один на один с вопросом «чья в
//  ней мысль?», и отвечать некому, кроме него.
scene "pustota-final" (duration: 1.0s, set: pustota) {
    transition static 0.22s

    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s

    freeman pose "lunge"
    //lip 9
    together {
        freeman speaks for 6.1s
        do {
            camera medium freeman
            wait 2.2s
            freeman pose "point"         // «беспла́тно» (0.36)
            wait 1.45s
            freeman pose "calm"          // «Своя́ голова́» (0.60)
            camera wide
            wait 1.4s
            freeman pose "v_upor"        // «а чья́ в не́й мы́сль?» (0.83)
            camera close-up freeman
            wait 0.9s
        }
    }
    camera extreme-close-up freeman
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.3s
}

// ═══════════════ СЦЕНА 8: ТИТРЫ ═══════════════════════════════════════════
scene "titry" (duration: 3.4s, set: titry) {
    transition static 0.45s

    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 0.9s

    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s

    wait 1.2s
    transition fade-black 0.7s
}
