// =============================================================================
//  «ЭТО БЫЛИ ВЫ» — интро к курсу «Самооценка и уверенность».
//  VO — samoocenka-VO.md, маркеры 1..20.
//
//  ОДНА МЫСЛЬ НА РОЛИК: уверенность не входной билет, а осадок от сделанного.
//  Её нельзя установить перед делом — она остаётся после.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ХУК — ЛОВУШКА, А НЕ УДАР. «Сегодня с вами говорили гадости» — зритель
//     три секунды уверен, что речь про чужого хама, и успевает встать на
//     сторону обвинителя. Дальше цитата, дальше «Это были вы». Обвинение, до
//     которого зритель дошёл сам, не спорится: он согласился с ним, пока
//     думал, что оно про другого.
//
//  2. ГРУБОСТЬ ЕСТЬ, И ОНА ЦИТАТА, А НЕ ОБРАЩЕНИЕ. «Идиот. Куда полез. Так и
//     знал.» — это не мы называем зрителя идиотом, это он называет себя сам, и
//     ролик показывает ему запись. Правило серии «шутка бьёт в способ, не в
//     человека» здесь распространено на брань: она летит в голос, а не в того,
//     кто его слушает. Точка максимума одна; после разворота грубости нет
//     вовсе — зритель уже наказан достаточно.
//
//  3. КУРС СПОРИТ СО СВОЕЙ ЖЕ ТЕМОЙ, И РОЛИК СПОРИТ ВМЕСТЕ С НИМ. Вторая
//     лекция называется «Великий миф о самооценке: суд над движением» — то
//     есть «полюби себя» этот курс не продаёт, а разбирает. Поэтому бит
//     отрицания (VO-4) бьёт по самому популярному совету в теме и закрывает
//     защиту зрителя НА ЕГО СТОРОНЕ: мы тоже в этот совет не верим.
//
//  4. ГЛАВНОЕ УЗНАВАНИЕ — ВОСПОМИНАНИЕ, КОТОРОЕ ЗРИТЕЛЬ ДОСТАЁТ САМ (VO-7,
//     VO-8). «Что вы тогда делали? Вы себя не хвалили. Вы умели.» Пять слов,
//     ни одного термина: ни «самоэффективность», ни «внутренний критик», ни
//     «синдром самозванца» в ролике не звучат (реестр §XXI).
//
//  5. КОЛЬЦО ВНУТРИ ПЕРВОЙ ПОЛОВИНЫ. «Куда полез» звучит дважды — в цитате
//     (VO-2) и через час (VO-6), тем же чужим голосом. Ритуал самооценки
//     стоит ровно между ними и ничего не меняет; это показано временем, а не
//     объяснено словами.
//
//  6. НОМЕРА КУРСА В РОЛИКЕ НЕТ, И ЭТО НЕ ЗАБЫВЧИВОСТЬ. Номер присваивает
//     студия; выдуманный номер уходит в серию навсегда. Первый и последний
//     кадры тождественны и уже стоят в позе поглаживания груди — метка
//     добавится одной сценой, как в «Тревоге».
//
//  7. НОВЫХ ЛОКАЦИЙ НЕ РИСУЕМ: все пять уже в каталоге. Но у «веера дорог»
//     координаты сняты ПРОБНЫМ РЕНДЕРОМ — в серии эта локация не
//     использовалась ни разу, и ставить по аналогии там нечего.
//
//  8. ТЕМП ПО БИТАМ, В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`): пулемёт 6.4,
//     узнавание и цена 4.2 — перепад в полтора раза. Ухо слышит не скорость,
//     а смену скорости.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). Проверено по этому файлу: `smug`,
//      `hero_wink`, `chetvert_levo`, `weary` и `sad` трогают рот и стоят
//      только в паузах;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · координаты фигуры на новой локации снимаются ПРОБНЫМ КОНТАКТНЫМ ЛИСТОМ,
//      а не по аналогии с соседней сценой (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` РАСЧЁТНЫЕ — ролик новый. Модель «0.59 с на внутренний
//  знак», поправленная коэффициентом 0.93. Модель врёт неравномерно по битам
//  (`KONVEJER.md` §4.1); завод перепишет числа по факту.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set vannaya from "../assets/sets/vannaya-zerkalo.svg"
import set void from "../assets/sets/void-black.svg"
import set veer from "../assets/sets/logika-veer-dorog.svg"
import set kuhnya from "../assets/sets/kuhnya-chajnik-tiho.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ВАННАЯ — ЛОВУШКА И РИТУАЛ ===========================
//  ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ЧЕЛОВЕК РАЗГОВАРИВАЕТ С СОБОЙ ВСЛУХ И ЗНАЕТ ОБ
//  ЭТОМ. Ритуал самооценки — зеркало, список, «я достоин» — происходит ровно
//  здесь, и жало в конце возвращается сюда же.
scene "zerkalo" (duration: 1s, set: vannaya) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании, и
    //  вспышка помех на ней заметнее любого шва.
    //
    //  Пол от плинтуса под раковиной (карта: back_y 0.62). Координаты сняты
    //  пробным листом из трёх вариантов: при 0.50/0.78 и масштабе 0.50 фигура
    //  теряется в кадре, при 0.44/0.99 голова наезжает на раковину и зеркало
    //  срезается. Взято среднее: фигура стоит перед раковиной, зеркало над
    //  ней целиком в кадре.
    place freeman at (0.50, 0.92) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ. Поза поглаживания груди держит
    //  место под метку курса: номер присваивает студия, и когда он придёт,
    //  проп встанет сюда и в финал одинаково, без правки мизансцены.
    freeman pose "gladit_grud"
    wait 0.15s
    freeman pose "v_upor"
    wait 0.1s

    // ── ХУК (VO-1): ловушка ставится ──────────────────────────────────
    //  СОЧУВСТВЕННО, ПОЧТИ ПО-ДРУЖЕСКИ. Зритель обязан встать на сторону
    //  обвинителя раньше, чем поймёт, что обвиняют его. Дашь голосом понять,
    //  что речь про слушателя, — и через две реплики нечему будет
    //  захлопываться.
    //lip 1
    together {
        freeman speaks for 2.07s
        do {
            freeman overlays "hips"        // «сегодня с вами говорили гадости»
        }
    }
    wait 0.35s

    // ── ДОБИВКА (VO-2): триада-цитата ─────────────────────────────────
    //  ЧУЖИМ ГОЛОСОМ, РОВНО И БЕЗ ВЫРАЖЕНИЯ, как зачитывают запись. Сыграешь
    //  брань всерьёз — получится сценка про хама, и зритель будет сочувствовать
    //  жертве вместо того, чтобы узнавать себя.
    //lip 2
    together {
        freeman speaks for 2.92s
        do {
            freeman overlays "rubit"       // «идиот»
            wait 0.97s
            freeman overlays "obvinil"     // «куда полез»
            wait 0.97s
            freeman overlays "otverg"      // «так и знал»
        }
    }
    wait 0.45s

    // ── УДАР (VO-3): ловушка захлопывается ────────────────────────────
    //  ПЕРВАЯ ФРАЗА БУДНИЧНО, ВТОРАЯ СУШЕ И ВНИЗ. Ни капли упрёка: упрекнёшь
    //  — зритель начнёт оправдываться вместо того, чтобы вспоминать.
    //lip 3
    together {
        freeman speaks for 3.19s
        do {
            camera medium freeman
            freeman overlays "k_sebe"      // «это были вы»
            wait 1.9s
            freeman overlays "ostyl"       // «возражений не было»
        }
    }
    camera wide
    wait 0.9s

    // ── ОТРИЦАНИЕ (VO-4): защита закрыта на стороне зрителя ───────────
    //  МЫ ТОЖЕ НЕ ВЕРИМ В ЭТОТ СОВЕТ, и в этом всё дело: возражение зрителя
    //  («да знаю я, надо себя любить») снимается не спором, а согласием.
    //  Устало, как отмахиваются от давно надоевшего.
    //lip 4
    together {
        freeman speaks for 5.86s
        do {
            freeman overlays "otmahnulsya" // «и не надо про «полюби себя»»
            wait 2.9s
            freeman overlays "ugryumo"     // «а как — ни разу»
        }
    }
    wait 0.35s

    // ── ПУЛЕМЁТ (VO-5): ритуал, проделанный честно ────────────────────
    //  САМЫЙ БЫСТРЫЙ КУСОК РОЛИКА — 6.4 слога в секунду. БЕЗ НАСМЕШКИ:
    //  человек делал единственное, что ему подсказали, и делал честно.
    //  Насмешка здесь превращает снятие вины в унижение.
    //
    //  ЗДЕСЬ САЖАЕТСЯ ОБРАЗ — СПИСОК. Пока выдуманный; настоящая строка
    //  появится в нём только в жале.
    //lip 5
    together {
        freeman speaks for 5.28s
        do {
            freeman overlays "razvel"      // «вы вставали к зеркалу»
            wait 1.75s
            freeman overlays "raskryl"     // «вы писали список достоинств»
            wait 1.75s
            freeman overlays "palec_vverh" // «вы повторяли, что достойны»
        }
    }
    wait 0.4s

    // ── УДАР (VO-6): кольцо внутри первой половины ────────────────────
    //  ТЕМ ЖЕ ЧУЖИМ ГОЛОСОМ, ЧТО И VO-2. Ритуал стоит ровно между двумя
    //  «куда полез» и ничего не меняет; это показано временем, а не
    //  объяснено словами.
    //lip 6
    together {
        freeman speaks for 2.75s
        do {
            camera medium freeman
            freeman overlays "gorech"      // «а через час снова: куда полез»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 2: ПУСТОТА — ПЕРЕЛОМ И УЗНАВАНИЕ =======================
//  ВСПОМИНАЮТ ТАМ, ГДЕ НЕЧЕМ ОТВЛЕЧЬСЯ. Зеркало на этих двух репликах мешало
//  бы: речь уже не про отражение, а про то, что человек умеет.
scene "vspomnite" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.46) facing front
    freeman scales 2.0 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ (VO-7): перелом ролика ───────────────────────────────
    //  ВОПРОС ВВЕРХ И БЕЗ НАЖИМА — приглашение вспомнить, а не упрёк. Дальше
    //  девять десятых тишины: зритель достаёт воспоминание сам, и следующая
    //  реплика ложится на уже найденное им.
    //lip 7
    together {
        freeman speaks for 6.04s
        do {
            freeman overlays "vzves"
            wait 3.6s
            freeman overlays "vozzvanie"   // «что вы тогда делали?»
        }
    }
    wait 0.9s

    // ── УДАР (VO-8): весь курс в пяти словах ──────────────────────────
    //  ПАУЗА МЕЖДУ ФРАЗАМИ ДЛИННЕЕ ВТОРОЙ ИЗ НИХ. Это место, которое будут
    //  цитировать; проглотишь — цитировать нечего.
    //lip 8
    together {
        freeman speaks for 2.97s
        do {
            freeman overlays "stop_ladon"  // «вы себя не хвалили»
            wait 2.0s
            freeman overlays "vniz"        // «вы умели»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: ВЕЕР ДОРОГ — СЧЁТ В ГОДАХ ===========================
//  ДОРОГИ РАСХОДЯТСЯ, И НИ НА ОДНУ НЕ СТУПИЛИ. Счёт предъявляется ровно на
//  этом кадре: он про то, чего не сделано, и кадр про то же самое.
scene "sobiraetes" (duration: 1s, set: veer) {
    transition static 0.2s

    //  Локация в серии НЕ ИСПОЛЬЗОВАЛАСЬ НИ РАЗУ — координаты сняты пробным
    //  листом (карта: back_y 0.35). Из трёх вариантов взят этот: фигура стоит
    //  в точке схода, дороги расходятся мимо неё в обе стороны. При
    //  0.40/0.86 линия дороги режет фигуру пополам, при 0.50/0.98 она
    //  наезжает на правую кромку (реестр §XVIII).
    place freeman at (0.46, 0.92) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕНА (VO-9): счёт в годах ─────────────────────────────────────
    //  РОВНО, КАК ЧИТАЮТ СПРАВКУ. «Готовы» — последнее слово и самое
    //  тяжёлое: именно этого ощущения зритель и ждёт, и именно оно этим
    //  способом не приходит.
    //lip 9
    together {
        freeman speaks for 6.94s
        do {
            freeman overlays "razvel"      // «сколько лет вы уже собираетесь?»
            wait 3.4s
            freeman overlays "vdal"        // «ждёте, когда почувствуете»
            wait 2.2s
            freeman overlays "ugryumo"     // «что готовы»
        }
    }
    wait 0.45s

    // ── ВОЗВРАТНЫЙ ВОПРОС (VO-10): одно слово ─────────────────────────
    //  САМАЯ КОРОТКАЯ РЕПЛИКА СЕРИИ. Не язвительно: ответ у зрителя уже
    //  есть, и спрашивают почти сочувственно.
    //lip 10
    together {
        freeman speaks for 0.54s
        do {
            camera medium freeman
        }
    }
    freeman overlays "vozzvanie"           // «дождались?» — вопрос повисает
    camera wide
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА. В неё входит ответ, который зритель даёт
    //  себе сам и вслух не произносит.
    wait 1.1s
}

// ============ СЦЕНА 4: ТИХАЯ КУХНЯ — ВИНА, ХОД И ВЗЛЁТ =====================
//  ЧАЙНИК МОЛЧИТ, НИКТО НЕ ТОРОПИТ. Здесь впервые за ролик теплеет: зрителя
//  перестают ловить и начинают ему помогать.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    //  Линия пола y≈0.56 (карта снята под парную локацию `kuhnya-chajnik`).
    place freeman at (0.40, 0.93) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    // ── КАЧЕЛИ (VO-11): возврат достоинства ───────────────────────────
    //  СТОЛКНОВЕНИЕ РЕГИСТРОВ: тема самооценки меряется торговым словом.
    //  Ровно, как констатируют, без утешения в голосе — утешение здесь
    //  читалось бы как снисхождение.
    //lip 11
    together {
        freeman speaks for 3.83s
        do {
            freeman overlays "ladoni_vniz" // «вы не трус и не лентяй»
            wait 1.9s
            freeman overlays "teplo"       // «вам продали неправильный порядок»
        }
    }
    wait 0.5s

    // ── ХОД (VO-12): порядок переворачивают ───────────────────────────
    //  ЕДИНСТВЕННОЕ РАЗЛИЧЕНИЕ КУРСА, НАЗВАННОЕ ЦЕЛИКОМ И БЕЗ ТЕРМИНОВ.
    //  Спокойно, с достоинством; повтор «потом» — не нажим, а точка.
    //lip 12
    together {
        freeman speaks for 4.74s
        do {
            camera medium freeman
            freeman overlays "dve_storony" // «сначала делают»
            wait 3.4s
            freeman overlays "point"       // «всегда потом»
        }
    }
    camera wide
    wait 0.6s

    // ── ВЗЛЁТ (VO-13): единственное высокое место ролика ──────────────
    //  ПЕРВАЯ ФРАЗА СУХО, ВТОРАЯ МЕДЛЕННЕЕ И ТЕПЛЕЕ ВСЕГО В РОЛИКЕ. Высокое
    //  слово стоит вплотную к самому бытовому, и от этого перестаёт звучать
    //  проповедью. Это же и девятая лекция курса, сказанная без терминов.
    //lip 13
    together {
        freeman speaks for 5.76s
        do {
            freeman overlays "razvel"      // «в ленте не показывают первые сто попыток»
            wait 3.2s
            freeman overlays "teplo"       // «а достоинство берётся ровно оттуда»
        }
    }
    wait 0.9s

    //  ПОВОРОТ В ЧЕТВЕРТЬ — ДО РЕПЛИКИ, А НЕ ВНУТРИ НЕЁ: `chetvert_levo`
    //  трогает рот, и посреди речи он перебил бы липсинк. Шутку и положено
    //  бросать вполоборота — разворот происходит раньше первого слова.
    freeman overlays "chetvert_levo"

    // ── ШУТКА (VO-14): самое популярное не-решение ────────────────────
    //  СМЕЮТСЯ НАД СПОСОБОМ, НЕ НАД ЧЕЛОВЕКОМ. Лёгкая ирония, без
    //  превосходства: способ и правда рабочий, у него просто есть предел.
    //lip 14
    together {
        freeman speaks for 3.13s
        do {
            freeman overlays "otmahnulsya" // «можно и без курса»
            wait 1.8s
            freeman overlays "prishchur"   // «просто перестать сравнивать»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-15): предел назван ──────────────────────────
    //  СПОКОЙНАЯ ДОБИВКА, ВНИЗ. Предел не подчёркивается: подчеркнёшь —
    //  получится «а вот и нет», то есть спор, а не смешно.
    //lip 15
    together {
        freeman speaks for 3.69s
        do {
            freeman overlays "v_upor"
            wait 2.4s
            freeman overlays "doshlo"      // «как вы открыли телефон»
        }
    }
    //  УХМЫЛКА — ПОСЛЕ РЕПЛИКИ, НЕ ВНУТРИ. `smug` трогает рот; вынесенная в
    //  паузу, она к тому же работает лучше: панч сначала договаривают, и уже
    //  потом лицо признаёт, что это было смешно.
    freeman overlays "smug"
    wait 1.0s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — КУРС =================================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ. Смена пространства слышна и в звуке —
//  эхо шагов; продажа начинается с того, что человек приходит в другое место.
scene "kurs" (duration: 1s, set: zal) {
    transition static 0.25s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПРЕЗЕНТАЦИЯ (VO-16): название и число ─────────────────────────
    //  ДЕЛОВОЙ ТОН, КАК ОБЪЯВЛЯЮТ ПУНКТ.
    //lip 16
    together {
        freeman speaks for 4.82s
        do {
            freeman overlays "raskryl"     // «курс так и называется»
            wait 3.3s
            freeman overlays "razmer"      // «десять лекций»
        }
    }
    wait 0.45s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-17): цена ────────────────────────────
    //  ОТДЕЛЬНОЙ РЕПЛИКОЙ И ПОСЛЕ ПАУЗЫ. Внутри длинной строки «бесплатно»
    //  проскакивает мимо уха вместе с названием и числом; вынесенное
    //  отдельно — слышится. Повтор числа отвечает на немой вопрос «все или
    //  первая». ГОЛОСОМ НЕ НАЖИМАТЬ: бесплатное с нажимом читается как
    //  подвох, и зритель начинает искать, где его обманут.
    //lip 17
    together {
        freeman speaks for 1.56s
        do {
            freeman overlays "razvel"      // «все десять — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 6: ТА ЖЕ ВАННАЯ — ЖАЛО =================================
//  ДЕЙСТВИЕ НАЗНАЧАЮТ ТАМ, ГДЕ ЛЕЖИТ СПИСОК: то же зеркало, та же раковина.
//  За ролик в списке ничего не изменилось — изменится сегодня вечером.
scene "zhalo" (duration: 1s, set: vannaya) {
    transition static 0.2s

    place freeman at (0.50, 0.92) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-18): измеримое действие ──────────────────────────────
    //  «САМУЮ МЕЛКУЮ» ВЫДЕЛЕНО ГОЛОСОМ. Высокая планка и есть то, чем
    //  зритель двадцать лет отговаривался; снижать её надо слышимо, иначе
    //  жало превратится в очередное «начни новую жизнь».
    //lip 18
    together {
        freeman speaks for 7.03s
        do {
            camera medium freeman
            freeman overlays "palec_vverh" // «сделайте самую мелкую вещь»
            wait 4.0s
            freeman overlays "k_sebe"      // «и впишите её в тот список»
        }
    }
    camera wide
    wait 0.5s

    // ── ЖАЛО-ДОБИВКА (VO-19): образ замыкается ────────────────────────
    //  СПИСОК ИЗ VO-5 БЫЛ ВЫДУМАН ЦЕЛИКОМ. Первая настоящая строка
    //  появляется сегодня вечером, и проверить это можно за минуту — потому
    //  обещание и не звучит обещанием.
    //lip 19
    together {
        freeman speaks for 6.24s
        do {
            freeman overlays "vozzvanie"   // «первая строка, которую вы не придумали»
            wait 4.0s
            freeman overlays "teplo"       // «заметите разницу?»
        }
    }
    //  ПОДМИГИВАНИЕ — ПОСЛЕ ПОСЛЕДНЕГО СЛОВА. `hero_wink` трогает рот и
    //  внутри реплики сбил бы липсинк; в паузе оно и стоит правильнее —
    //  сначала вызов, потом «проверьте сами».
    freeman overlays "hero_wink"
    wait 1.2s
}

// ============ СЦЕНА 7: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ =================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: та же ванная, тот же `place`, тот же
//  масштаб, та же поза поглаживания груди. Когда студия присвоит номер, метка
//  встанет сюда и в первый кадр одинаково — мизансцену править не придётся.
scene "final" (duration: 1s, set: vannaya) {
    transition static 0.2s

    place freeman at (0.50, 0.92) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide

    //lip 20
    together {
        freeman speaks for 5.24s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Поза поглаживания трогает
            //  только руку — значит ложится накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.6s
            freeman overlays "gladit_grud_niz"
            wait 1.5s
            freeman overlays "palec_vverh" // «Поехали!»
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания — ровно то, с чего
    //  ролик начинается.
    freeman pose "gladit_grud"
    wait 0.4s
}
