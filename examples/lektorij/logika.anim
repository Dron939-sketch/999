// =============================================================================
//  «ПРОВЕРЬТЕ ПЕРВУЮ СТРОКУ» — интро к курсу «Логика».
//  VO — logika-VO.md, маркеры 1..14.
//
//  УСТРОЙСТВО РОЛИКА: ФОКУС С РАСКРЫТИЕМ КАРТ, И ДВАЖДЫ
//
//  1. СНАЧАЛА ФОКУС ПОКАЗЫВАЮТ, ПОТОМ ПОКАЗЫВАЮТ РУКАВА. Первые двенадцать
//     секунд ролик всерьёз, без единого подмигивания, доказывает, что учиться
//     вредно. Все переходы честные, зритель кивает на каждом. Разворот на
//     19-й секунде приглашает проверить переходы — и они проверяются, —
//     а ложь оказывается в ПЕРВОЙ СТРОКЕ, под которой зритель подписался, не
//     заметив, что подписывается.
//
//  2. ВТОРОЙ ЗАХОД — ЧУЖИМИ РУКАМИ. Здесь стояла вторая цепочка, про самого
//     зрителя («себя вы знаете лучше всех»), и она била в то же место сразу
//     после первого удара: зритель уходил в оборону, и второй разворот не
//     проходил. Теперь вместо неё анекдот про зайца и волка. Конструкция та
//     же самая — «спички есть? значит, куришь; значит, выпиваешь; значит,
//     гуляешь; значит, интересный человек», — но смеются над волком, а не
//     защищаются от рассказчика. Согласие уже дано на первой цепочке,
//     возразить нечем.
//
//  3. ПАНЧ ДЕРЖИТСЯ ОБВАЛОМ РЕГИСТРА. Три аккуратных «значит», выстроенных
//     как теорема, — и следом грубость в лоб: «ну ты и мудак». Смешно не
//     слово, а ПАДЕНИЕ; расстояние между спичками и бранью и есть шутка.
//     Первая версия кончалась на «понятно, скучный ты» — ровное место вместо
//     обвала, и шутки не оставалось (реестр, «состорожничал»).
//
//  4. ПОСЛЕДСТВИЕ ВЕРНУЛОСЬ, И ЭТО ДОКАЗАТЕЛЬСТВО, А НЕ ЖЕСТОКОСТЬ. «Волка
//     потом нашли в кустах» — единственная строка, которая связывает анекдот
//     с тезисом курса: применил форму безупречно и был бит. Без неё анекдот
//     остаётся остроумием, которое ничего не продаёт. Медведь в кадре не
//     появляется и не бьёт: кусты делают всю работу, а достроенное зрителем
//     смешнее показанного.
//
//  5. КОЛЬЦО ДЕРЖИТСЯ ЛОКАЦИЕЙ, А НЕ ТОЛЬКО ЖЕСТОМ. Жало и подпись идут на той
//     же площадке с теми же двумя дверями, что и хук. При зацикливании в ленте
//     зритель видит тот же кадр — и уже с другим вопросом к нему.
//
//  6. ТЕМП ИДЁТ ПО БИТАМ И ЗАДАЁТСЯ В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`),
//     а не множителем к длине файла: хук 5.4, анекдот 6.6, приговор и дно 4.4.
//     Перепад в полтора раза стоит ровно на обрыве в чёрное, где кончается
//     смех.
//
//  ЛОКАЦИИ ВСЕ УЖЕ НАРИСОВАНЫ И ИМЕЮТ КАРТЫ ПОЛА — ролик собирается без
//  ожидания картинок. Это не экономия: локация обязана ДОКАЗЫВАТЬ реплику, и
//  эти четыре доказывают. Площадка с двумя дверями — весь механизм в одном
//  кадре. Коридор рупоров — место, где складная цепочка звучит очередью и ни
//  один голос не проверяет, с чего начал. Пустота — где нечем отвлечься.
//  Перекрёсток без знаков — ровно то, что скрывали две двери: дорог много и
//  ни одна не подписана.
//
//  ЛИЦО РАБОТАЕТ ВНУТРИ РЕПЛИК. Мимика идёт слоями БЕЗ РТА (`vzglyad`,
//  `prishchur`, `poimal`, `klin`, `teplo`, `doshlo`, `somnenie`, `ostyl`,
//  `raspahnul`): рот в это время принадлежит липсинку. До появления этого
//  класса лицо стояло всю реплику, и это читалось однообразием
//  (RABOTA-NAD-OSHIBKAMI §XII). Мерка — `tools/slovar.py`.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА: слой из одних глаз рук
//      не трогает, и поднятая полной позой рука висит забытой (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` ЗДЕСЬ ЗАМЕРЕНЫ ЗАВОДОМ, кроме реплик 6–8: у них текст
//  переписан после замера, и там стоит расчёт по модели «0.59 с на знак»,
//  поправленный коэффициентом того же замера (модель перебирает ~25% на
//  пулемёте, ~19% на добивке). Следующий прогон перепишет и их
//  (`tools/hronometrazh.py`).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set dveri from "../assets/sets/logika-dve-dveri.svg"
import set dveri_vse from "../assets/sets/logika-dve-dveri-vse.svg"
import set rupory from "../assets/sets/logika-hor-golosov.svg"
import set void from "../assets/sets/void-black.svg"
import set veer from "../assets/sets/logika-veer-dorog.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ПРИХОЖАЯ С ДВУМЯ ДВЕРЯМИ — ХУК, ДОБИВКА, ОБРАЗ =======
//  ДВЕ ДВЕРИ УЖЕ СТОЯТ, КОГДА РОЛИК НАЧИНАЕТСЯ. Первая секунда без слов: две
//  двери прямо перед зрителем, и выбирать предлагают из них. Зритель узнаёт
//  положение раньше, чем тему, — и это единственный способ, которым Фримен
//  входит: обстановкой, а не заявлением.
//
//  СЕТ ВЫБРАН ПО КОНТАКТНОМУ ЛИСТУ, А НЕ ПО НАЗВАНИЮ. Сначала сцена звучала
//  как «пустая площадка, больше ничего» — а в кадре стоит комната со столом и
//  бумагами, и слова расходились с картинкой (реестр, «локация не та»).
//  Пробовал `doors-empty.svg`: там дверь ОДНА, и чёрная фигура в неё
//  проваливается — оба пятна чёрные. Сет оставлен, поправлены СЛОВА.
scene "dveri" (duration: 1s, set: dveri) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ, И ЭТО ПРО КОЛЬЦО. Здесь стояла помеховая
    //  врезка `transition static 0.2s` — красивый вход, но первая сцена это
    //  ТОЧКА СТЫКА при зацикливании, и вспышка помех на ней заметнее любого
    //  шва: зритель видит не «ролик пошёл дальше», а «что-то мигнуло».
    //  Чистая склейка на стыке незаметнее.

    //  Стоит МЕЖДУ дверями, но не у них: он пока рассказывает про положение, а
    //  не выбирает. К дверям подойдёт только в образе.
    place freeman at (0.5, 0.94) facing front on floor
    //  ГОЛЫЙ `scales` СТОИТ 0.5с ТАЙМЛАЙНА (умолчание движка). В прологе их
    //  было три подряд — полторы секунды уходили в никуда ещё до первого
    //  слова, а перелом ролика обязан уложиться в 28с (§5.0).
    freeman scales 0.92 over 0.01s

    //  НОМЕР КУРСА НА БАЛАХОНЕ, справа на груди. Ролик уходит в ленту, где
    //  «смотреть или листать» решается за две секунды — меньше, чем длится
    //  первая реплика. Зацепить в них можно только картинкой, и номер работает
    //  сразу на два: держит взгляд и говорит «это серия».
    //
    //  НОМЕР — СЛЕДУЮЩЕГО КУРСА, А НЕ ЭТОГО. Подпись говорит «так, идём
    //  дальше», и метка обязана говорить то же: «Логика» шестая, значит на
    //  груди семёрка. Кольцо от этого становится честнее — при зацикливании
    //  в ленте ролик буквально отправляет зрителя дальше, а не представляет
    //  сам себя во второй раз.
    //
    //  ПРАВИЛО: проп на теле живёт ТОЛЬКО пока камера неподвижна — он стоит в
    //  координатах КАДРА, а не на фигуре. Здесь номер снимается ДО первого
    //  движения камеры.
    let nomer = prop("nomer", "../assets/props/nomer-07.svg") at (0.525, 0.66) layer 9
    nomer scales 0.21 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ОБЯЗАН БЫТЬ ТОЖДЕСТВЕН ПОСЛЕДНЕМУ. Фигура по центру, поза
    //  поглаживания, номер на груди — ровно то, чем ролик кончается. При
    //  зацикливании в ленте шва нет, и зритель не понимает, что смотрит второй
    //  раз.
    //
    //  ШОВ ЗАКРЫТ ПУСТОЙ ГРУДЬЮ, А НЕ ВИДИМЫМ НОМЕРОМ. Сначала я сделал
    //  наоборот — оставил метку видимой с первого кадра, чтобы она совпала с
    //  последним. Рендер показал, почему так нельзя: голый `scales 0.21` на
    //  пропе, до которого не было ни одной АНИМИРОВАННОЙ смены масштаба, не
    //  применяется вовсе — метка встаёт в натуральную величину и закрывает
    //  белым кругом весь торс. Держится это не кадр, а всю сцену.
    //
    //  Рабочий рисунок один: спрятать, показать, вырастить с 0.02. Значит на
    //  нулевом кадре метки ЕСТЬ НЕ МОЖЕТ. Отсюда решение: в последнем кадре её
    //  тоже нет — она снимается перед самым концом. Оба кадра показывают
    //  фигуру с пустой грудью, шов закрыт, а проявление номера идёт через
    //  четверть секунды после стыка — одинаково на каждом круге.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.23 over 0.05s ease-out
    nomer scales 0.21 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    //  Снимается ДО первого движения камеры: проп живёт в координатах кадра,
    //  и `camera medium` внутри первой реплики увёз бы метку с балахона.
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): «докажу вам, что учиться вредно» ──────────────────
    //  ФОКУС, А НЕ МОНОЛОГ. Ролик перестал рассказывать и начал
    //  ПОКАЗЫВАТЬ: цепочка доводится до абсурда всерьёз, без единого
    //  подмигивания. Подчеркнёшь — приём объявлен, и дальше рушить нечего.
    //  Абсурдный пример обязателен: на своей цепочке зритель защищается,
    //  на чужой смеётся и соглашается — а согласившись, не может
    //  возразить, когда та же конструкция повернётся на него.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 5.59s
        do {
            camera medium freeman
            wait 2.75s
            freeman overlays "yorik"       // «знаете вы столько, сколько помните»
        }
    }
    //  ПАУЗА ЗДЕСЬ — ЭТО ТАЙМИНГ ШУТКИ, а не дыра. Обещание прозвучало,
    //  доказательство ещё нет; полсекунды зритель висит на крючке.
    wait 0.35s

    // ── ХУК-ДОБИВКА (VO-2): второй и третий шаг цепочки ───────────────
    //lip 2
    together {
        freeman speaks for 5.13s
        do {
            wait 2.50s
            freeman overlays "poimal"      // «а повторять всё некогда»
        }
    }
    camera wide
    wait 0.3s

    // ── РАСКРЫТИЕ КАРТ (VO-3): «все переходы верны» ───────────────────
    //  ФОКУСНИК ПОКАЗЫВАЕТ РУКАВА. Абсурд только что прозвучал всерьёз;
    //  здесь зрителя приглашают проверить — и он проверяет, и правда всё
    //  сходится. Это обязательная ступень: без неё дальше нечему рушиться.
    freeman pose "calm"
    freeman overlays "hips"
    //lip 3
    together {
        freeman speaks for 4.91s
        do {
            wait 2.72s
            freeman overlays "vzglyad"     // «проверьте переходы»
        }
    }
    wait 0.4s

    // ── РАЗВОРОТ (VO-4): «вся ложь — в первой строке» ─────────────────
    //  ПЕРЕЛОМ РОЛИКА СТОИТ ЗДЕСЬ, на пятнадцатой секунде, а не после
    //  пулемёта. Так требует и формула, и устройство приёма: сначала карты
    //  раскрыты на чужом примере, и только потом это поворачивается на
    //  зрителя. Обратный порядок разрушил бы фокус.
    //lip 4
    together {
        freeman speaks for 4.76s
        do {
            wait 1.88s
            freeman overlays "obvinil"     // «и вы мыслите так же» — в зрителя
        }
    }
    wait 0.4s

}

// ============ СЦЕНА 2: КОРИДОР РУПОРОВ — ОТРИЦАНИЕ, АНЕКДОТ, ДОБИВКА =======
//  РУПОРЫ — ЭТО ЗВУЧАНИЕ СКЛАДНОЙ ЦЕПОЧКИ, А НЕ ЧУЖОЙ СПОР. Здесь
//  рассказывают анекдот, и локация обязана доказывать именно его: цепочка
//  «значит — значит — значит» звучит из каждого рупора одинаково убедительно,
//  и ни один рупор не проверяет, с чего начал.
//
//  ПОЧЕМУ АНЕКДОТ, А НЕ ВТОРАЯ ЦЕПОЧКА ПРО ЗРИТЕЛЯ. Личная цепочка («себя вы
//  знаете лучше всех») ставила зрителя в оборону сразу после разворота — два
//  удара подряд по одному месту, и второй уже не проходит. Анекдот делает то
//  же самое чужими руками: зритель смеётся над волком, а конструкция та же,
//  что он только что признал верной на себе. Согласие уже дано — возразить
//  нечем.
scene "rupory" (duration: 1s, set: rupory) {
    transition static 0.1s

    //  Пол базара начинается высоко (карта: back_y 0.33) — фигура ставится
    //  вглубь прохода и идёт НА КАМЕРУ.
    place freeman at (0.5, 0.70) facing front on floor
    freeman scales 0.46 over 0.01s
    camera wide

    // ── ОТРИЦАНИЕ (VO-5): «Скажете, вы так не мыслите? Тогда анекдот.» ─
    //  Возражение снимается без спора: спор дал бы зрителю сторону, за
    //  которую можно держаться. Вместо спора — козырь из рукава.
    //  ВПЕРВЫЕ В УПОР: разворот только что прилетел зрителю, и теперь на него
    //  смотрят.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 4.35s
        do {
            //  РУКА НАЗЫВАЕТСЯ ПЕРВОЙ: слой из одних глаз её не трогает, и
            //  поднятая `v_upor`-ом рука висела бы всю реплику забытой.
            freeman overlays "zakrylsya"   // «скажете, вы так не мыслите?»
            wait 1.75s
            freeman overlays "prishchur"   // ну-ну
            wait 1.55s
            freeman overlays "poimal"      // «тогда анекдот» — достал козырь
        }
    }
    wait 0.35s

    // ── ПУЛЕМЁТ: АНЕКДОТ (VO-6), ИДЁТ НА КАМЕРУ ───────────────────────
    //  ЦЕПОЧКА ЗАЙЦА — ТА ЖЕ КОНСТРУКЦИЯ, ЧТО И «УЧИТЬСЯ ВРЕДНО». Каждый
    //  переход безупречен, первая строка («спички — значит куришь») никем не
    //  проверена. В этом весь анекдот и весь ролик.
    //  ЦЕПОЧКА НЕ ОТДАЛЯЕТ, ОНА ПОДСТУПАЕТ — поэтому движение на зрителя, а не
    //  вбок. Шаг фронтальный, накладки без рта: липсинк не перебивается.
    freeman pose "calm"
    //lip 6
    together {
        freeman speaks for 8.85s
        do {
            //  ШАГ И НАЕЗД — ОДНОВРЕМЕННО, ПО ОДНОМУ НА КАЖДОЕ «ЗНАЧИТ».
            //
            //  Раньше они шли ПО ОЧЕРЕДИ: `moves-to` полтора шага без роста,
            //  потом `scales` полтора шага без движения. В кадре это читается
            //  не как приближение, а как «подъехал, а потом раздулся» — ровно
            //  то, что увидела студия. Причина простая: оба оператора ЗАНИМАЮТ
            //  ВРЕМЯ, и записанные подряд они и выполняются подряд.
            //
            //  `together` внутри `do` связывает их в один отрезок: за каждый
            //  шаг фигура И едет, И растёт. Пять шагов, все по 1.5 с.
            //
            //  ЧИСЛА ПОДОБРАНЫ В ПАРУ, А НЕ НА ГЛАЗ. Глубина сета линейна
            //  (карта пола: back_y 0.60, front_y 1.0), поэтому и высота, и
            //  масштаб идут РАВНЫМИ приращениями: y +0.046 за шаг
            //  (0.70 → 0.93), масштаб +0.084 за шаг (0.46 → 0.88). Один шаг —
            //  один прирост, и так пять раз.
            //
            //  Сумма 7.5 с при реплике 8.85 с: запас нужен, потому что синтез
            //  не детерминирован и на следующем прогоне реплика может стать
            //  короче на полсекунды (§XI реестра). Без запаса ветка катов
            //  переросла бы речь и потянула бы за собой весь блок.
            freeman overlays "shag_levoj"
            freeman overlays "vzglyad"     // «заяц учит волка логике»
            together {
                freeman moves-to (0.5, 0.746) over 1.5s
                freeman scales 0.544 over 1.5s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "k_sebe"      // «спички есть?» — рука за ответом
            together {
                freeman moves-to (0.5, 0.792) over 1.5s
                freeman scales 0.628 over 1.5s
            }
            freeman overlays "shag_levoj"
            freeman overlays "palec_vverh" // «значит, куришь»
            together {
                freeman moves-to (0.5, 0.838) over 1.5s
                freeman scales 0.712 over 1.5s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "razvel"      // «значит, есть компания»
            together {
                freeman moves-to (0.5, 0.884) over 1.5s
                freeman scales 0.796 over 1.5s
            }
            freeman overlays "shag_levoj"
            freeman overlays "oba_vverh"   // «значит, интересный человек»
            together {
                freeman moves-to (0.5, 0.93) over 1.5s
                freeman scales 0.88 over 1.5s
            }
            freeman overlays "prishchur"   // и всё сошлось
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты. Он дорассказал первую половину
    //  и делает паузу ровно там, где волк поверил.
    freeman pose "calm"
    wait 0.4s

    // ── ДОБИВКА (VO-7): вторая половина анекдота, панч и молчание ──────
    //  ПАНЧ НЕ ТЕРПИТ ХВОСТА. «Ну ты и мудак» — и всё; дальше только пауза, в
    //  которой зритель сам достраивает, что было с волком. Медведь в кадре не
    //  появляется и не должен: показанный медведь — это мультик, названный
    //  медведь — это его собственная картинка.
    //  ОБВАЛ РЕГИСТРА ИГРАЕТСЯ ЛИЦОМ, А НЕ ГОЛОСОМ: `klin` на «нет», `poimal`
    //  на самом панче. Тело при этом неподвижно — жест на панче крадёт слово.
    //lip 7
    together {
        freeman speaks for 5.47s
        do {
            freeman overlays "raspahnul"   // «волк в восторге забрал книжку»
            wait 1.6s
            freeman overlays "k_sebe"      // «спички есть?» — тот же жест, тот же вопрос
            wait 1.6s
            camera medium freeman
            freeman overlays "klin"        // «нет» — и волк уже не остановится
            wait 1.35s
            freeman overlays "poimal"      // ПАНЧ: «ну ты и мудак»
        }
    }
    camera wide
    //  Тишина на месте того, что было дальше. Её слышно, и она смешнее любого
    //  описания.
    wait 0.6s
}

// ================== СЦЕНА 3: ПУСТОТА — МЕХАНИЗМ И РАЗЛИЧИЕ ==================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Ни площадки, ни базара: механизм называется там,
//  где нечем отвлечься. Две реплики подряд без смены плана — сначала что может
//  случиться с безупречным выводом, потом за что логика вообще отвечает.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между рупорами и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── ПРИГОВОР (VO-8): что именно волк унёс с полянки ───────────────
    //  СМЕХ ГАСНЕТ ЗДЕСЬ, И ЭТО ЗАПЛАНИРОВАНО. «Волка потом нашли в кустах» —
    //  ещё смешно, буднично, как сводку. Следующие две фразы гасят смех
    //  насухо: оказывается, смешное описывает зрителя. Диагноз ставят ровно,
    //  без нажима — нажмёшь, и зритель защитится.
    freeman pose "v_upor"
    //lip 8
    together {
        freeman speaks for 5.95s
        do {
            //  РУКА НАЗЫВАЕТСЯ ПЕРВОЙ: слой из одних глаз её не трогает.
            //  Здесь она уходит в покой — главную фразу играют почти
            //  неподвижно, любой жест отвлекает.
            freeman overlays "calm"
            wait 1.75s
            freeman overlays "vzglyad"     // «форму он выучил»
            wait 1.6s
            freeman overlays "somnenie"    // пауза перед главным словом
            wait 1.35s
            freeman overlays "ostyl"       // «и стал увереннее» — вот это и страшно
        }
    }
    wait 0.5s

    // ── УДАР И ДНО ОДНОЙ РЕПЛИКОЙ (VO-9) ──────────────────────────────
    //  РАНЬШЕ ЗДЕСЬ БЫЛО ДВА БИТА, И ОНИ ГОВОРИЛИ ОДНО И ТО ЖЕ: сначала
    //  «вывод может быть безупречным и всё равно ложным», следом «логика
    //  отвечает за переход, а не за вход». Второе — то же первое, другими
    //  словами. Пока ролик ОБЪЯСНЯЛ механизм, повтор был незаметен и даже
    //  полезен. Теперь механизм ПОКАЗАН анекдотом, и объяснять нечего —
    //  остаётся назвать.
    //
    //  «Первая строка» возвращается сюда, на самое дно, теми же словами, что
    //  и в развороте. Это кольцо мысли: формулировка, под которой зритель уже
    //  подписался на чужом примере, теперь стоит под его собственным.
    //lip 9
    together {
        freeman speaks for 7.42s
        do {
            freeman overlays "calm"
            wait 1.9s
            freeman overlays "vzglyad"     // «половина метода»
            wait 1.9s
            freeman overlays "dve_storony" // «опаснее, чем ничего»
            wait 1.8s
            freeman overlays "obvinil"     // «ошибка не в выводе» — в зрителя
            freeman overlays "poimal"      // и перекос: вам сообщают
            wait 1.7s
            freeman overlays "klin"        // «— в первой строке»
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: ПЕРЕКРЁСТОК БЕЗ ЗНАКОВ — ВЗЛЁТ И ПОДЪЁМ ==============
//  РОВНО ТО, ЧТО СКРЫВАЛИ ДВЕ ДВЕРИ: дорог много и ни одна не подписана. Пять
//  проверок называются в том самом месте, где их видно ногами.
scene "veer" (duration: 1s, set: veer) {
    transition static 0.2s

    place freeman at (0.44, 0.95) facing front on floor
    freeman scales 0.86
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: различие названо, сейчас скажут, что с
    //  ним делать. Реплика сразу после склейки читалась бы продолжением
    //  приговора.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): один ход, и он выполним вслух ───────────────────
    //  РЕПЛИКА — ОДНА МЫСЛЬ. Раньше здесь стояло четыре мысли подряд, и на
    //  замере по каталогу выяснилось, чем это оплачено: у ранних роликов в
    //  реплике 8–18 слогов, у поздних 22–34, и студия услышала ровно это —
    //  «реплики воспринимаются как не связанные». Кусок из трёх мыслей
    //  закончен сам в себе, и нить между репликами рвётся.
    freeman pose "calm"
    //lip 10
    together {
        freeman speaks for 4.23s
        do {
            wait 1.53s
            freeman overlays "vzves"       // «усомнитесь в первой строке»
            freeman overlays "raspahnul"   // ход открыт
            wait 1.53s
            freeman overlays "palec_vverh" // «не в выводе — в первой»
        }
    }
    wait 0.4s

    // ── ПОДЪЁМ (VO-11): цена отказа проверять ─────────────────────────
    //  ЦЕНА ВМЕСТО МОРАЛИ. Ролик не уговаривает быть умнее — он называет цену
    //  отказа проверять: способ работает ровно до первого медведя.
    //  КАЛЛБЭК ЗАКРЫВАЕТ БИТ: медведь из анекдота возвращается сюда уже как
    //  единица измерения. Зритель смеялся над волком тридцать секунд назад —
    //  и теперь это его собственная мерка.
    freeman pose "calm"
    //lip 11
    together {
        freeman speaks for 8.25s
        do {
            camera medium freeman
            wait 1.35s
            freeman overlays "otmahnulsya" // «можно и не проверять» — отмашка
            freeman overlays "prishchur"   // с ухмылкой: приём известный
            wait 1.4s
            freeman overlays "razmer"      // «в душе вы правы» — вот настолько
            wait 1.45s
            freeman overlays "u_viska_l"   // «до первого медведя» — серьёзно?
        }
    }
    camera wide
    wait 0.5s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-11): курс и ОБЕЩАНИЕ ──────────────────────────
    //  Раньше здесь было только имя и цена — что у зрителя изменится, не
    //  говорилось нигде. Обещание скромное и проверяемое: слышать подвох
    //  в момент, а не через два дня в душе.
    //lip 12
    together {
        freeman speaks for 5.20s
        do {
            camera medium freeman
            wait 2.4s
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            freeman overlays "teplo"       // и тепло: это приглашение
            wait 2.6s
            freeman overlays "open"        // «замечать подмену и проверять начало»
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 6: ТА ЖЕ ПРИХОЖАЯ — ЖАЛО И ПОДПИСЬ ======================
//  ТОТ ЖЕ КАДР, ЧТО И В НАЧАЛЕ, И ТЕ ЖЕ ДВЕ ДВЕРИ. Кольцо замыкается не только
//  жестом, но и МЕСТОМ: на втором круге зритель видит ту же прихожую и уже с
//  другим вопросом к ней.
// ============ СЦЕНА 6: КОРИДОР — ЖАЛО, И ОТВЕТ ДАН КАРТИНКОЙ ===============
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ОТВЕТ УЖЕ ВИДЕН. «Спросите: где остальные?» звучит в
//  кадре, где остальные двери стоят вдоль всего коридора. Зритель получает
//  ответ раньше, чем успевает задать вопрос, — и это единственный способ
//  сказать «вы их не видели», не обвиняя его.
scene "vopros" (duration: 1s, set: dveri_vse) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-13): «А с какой строки начинается ваш вывод?» ────────
    //  КАЛЛБЭК: «первая строка» возвращается третий раз — в развороте, на дне
    //  и здесь, — но впервые как вопрос к зрителю, а не утверждение о нём.
    //  Коротко намеренно: панч не терпит хвоста.
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: вопрос можно задать себе
    //  сегодня же вечером, на первом же «значит».
    //lip 13
    together {
        freeman speaks for 3.02s
        do {
            camera medium freeman
            wait 0.97s
            freeman overlays "stop_ladon_l" // «а с какой строки» — стоп
            freeman overlays "klin"        // с вызовом, а не с советом
            wait 0.88s
            freeman overlays "vozzvanie"   // «…начинается ваш вывод?»
            freeman overlays "doshlo"      // и вопрос повисает: шар в глазах
        }
    }
    camera wide
    freeman overlays "hero_wink"
    wait 0.3s
}

// ============ СЦЕНА 7: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ =================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ, И ЭТО ГЛАВНОЕ ТРЕБОВАНИЕ К ФИНАЛУ.
//
//  Ролик уходит в ленту, где он ЗАЦИКЛИВАЕТСЯ. Если конец и начало отличаются
//  хоть чем-нибудь — локацией, планом, позой, размером фигуры, — на втором
//  круге зритель видит шов и понимает, что ролик кончился. А он не должен
//  этого понять: пусть смотрит второй раз, не заметив, что смотрит второй раз.
//
//  Поэтому здесь ВСЁ повторяет первую сцену числом в число: та же локация
//  `dveri`, тот же `place` (0.5, 0.94), тот же масштаб 0.92, тот же `camera
//  wide`, та же поза `gladit_grud`, тот же номер на том же месте и того же
//  размера. Отличается только то, что нельзя увидеть, — звучащая реплика.
//
//  УХОДА ЗА КАДР ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ. Он был красивым жестом — «уходит
//  мимо обеих дверей», — но уход оставляет в последнем кадре пустую площадку,
//  а в первом стоит фигура. Это и есть шов. Между красивым жестом и целым
//  кольцом выбрано кольцо.
scene "final" (duration: 1s, set: dveri) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92
    camera wide

    let nomer2 = prop("nomer", "../assets/props/nomer-07.svg") at (0.525, 0.66) layer 9
    nomer2 scales 0.21
    nomer2 hides

    //lip 14
    together {
        freeman speaks for 3.50s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Обе позы поглаживания
            //  трогают только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"       // подпись объявляют тепло, не бьют
            wait 1.7s
            nomer2 shows
            nomer2 scales 0.02
            nomer2 scales 0.23 over 0.30s ease-out
            nomer2 scales 0.21 over 0.15s
            freeman overlays "gladit_grud_niz"
            wait 0.7s
            freeman overlays "gladit_grud"
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура по центру, поза поглаживания, ГРУДЬ ПУСТАЯ.
    //  Ровно то, с чего ролик начинается. Метка снимается здесь намеренно —
    //  на нулевом кадре её быть не может (см. разбор в первой сцене), значит
    //  и в последнем быть не должно, иначе стык видно.
    nomer2 hides
    freeman pose "gladit_grud"
    wait 0.4s
}
