// =============================================================================
//  «ТЕОРЕМА» — интро к курсу «Логика».
//  VO — logika-VO.md, маркеры 1..41.
//
//  УСТРОЙСТВО РОЛИКА: ФОКУС С РАСКРЫТИЕМ КАРТ, И ДВАЖДЫ
//
//  1. ЭТО НЕ МОНОЛОГ, А ДОКАЗАТЕЛЬСТВО. Ролик объявляет теорему («работать
//     хорошо — вредно»), честно её доказывает и ставит «что и требовалось
//     доказать» — всерьёз, без единого подмигивания. Цепочка бытовая до
//     последнего звена: работаешь лучше — клиентов больше — работы больше —
//     устаёшь — делаешь хуже — клиенты уходят — зарплата приползает обратно.
//     Зритель кивает на каждом переходе, потому что нижняя половина круга это
//     верхняя, прочитанная наоборот: правило он уже признал.
//
//  2. ЛОЖЬ В ПЕРВОЙ СТРОКЕ, И ЗРИТЕЛЬ НАХОДИТ ЕЁ САМ. Разворот не объявляет
//     подмену — он отправляет зрителя обратно к первому предложению и
//     спрашивает, чего там нет. Нет слова «кому». Кому станет лучше — не
//     сказано, и никто не спросил. Строку эту произнёс начальник.
//
//  3. ВТОРОЙ ЗАХОД — ЧУЖИМИ РУКАМИ. Второй разворот по тому же человеку не
//     проходит: зритель уже в обороне. Поэтому дальше анекдот про зайца и
//     волка — конструкция та же самая, но смеются над волком, а не защищаются
//     от рассказчика.
//
//  4. ПАНЧ ДЕРЖИТСЯ ОБВАЛОМ РЕГИСТРА. Четыре аккуратных «значит», выстроенных
//     как теорема, — и следом грубость в лоб. Смешно не слово, а ПАДЕНИЕ;
//     расстояние между спичками и бранью и есть шутка. Ровное слово в конце
//     обваливать нечему, и шутки не остаётся (реестр §XIV).
//
//  5. РАЗВЯЗКУ АНЕКДОТА НЕ ОТДАЮТ. Что сделал медведь — не говорится ни
//     словом. Пока в кадре волк, зритель смотрит на волка; поэтому после панча
//     идёт полторы секунды тишины, и в неё входит «а вы делаете то же самое».
//     Недоданная развязка держит крепче отданной.
//
//  6. ДНО ГОВОРИТ ПРО ЗРИТЕЛЯ. «Первую строку вам подсунули — родители, школа,
//     начальник. А приговор вы вынесли себе сами. И подписали. Своей рукой.»
//     Фразы разведены по лицам намеренно: что сделали С НИМ и что сделал ОН.
//
//  7. ОДИННАДЦАТЬ ЛОКАЦИЙ НА ТРИ С ПОЛОВИНОЙ МИНУТЫ, И ЭТО НЕ УКРАШЕНИЕ.
//     Прежняя версия шла 93 с на семи локациях; при 3:40 та же плотность дала
//     бы шесть реплик на кадр — говорящую голову. Здесь на кадр приходится
//     две-три реплики, и каждая смена локации СОВПАДАЕТ со сменой мысли:
//     обещание слышно на деловой улице, усталость на ночной кухне, зарплата
//     у счетов, ненависть у зеркала, приговор в чёрном. Зритель понимает,
//     что мысль сменилась, ещё до того, как услышит слова.
//
//  8. КОЛЬЦО ДЕРЖИТСЯ ЛОКАЦИЕЙ, А НЕ ТОЛЬКО ЖЕСТОМ. Разворот, жало и подпись
//     идут на той же площадке с теми же двумя дверями, что и хук. «Вернитесь
//     к самому первому предложению» звучит в БУКВАЛЬНО первом кадре ролика —
//     зритель возвращается туда, откуда начал, вместе с фразой.
//
//  9. ТЕМП ИДЁТ ПО БИТАМ И ЗАДАЁТСЯ В СЛОГАХ В СЕКУНДУ (`tools/podacha.py`):
//     теорема 4.4, цепочка 6.3, анекдот 6.6, дно 4.4. Перепад в полтора раза
//     стоит на обрыве в чёрное после панча, где кончается смех.
//
//  ЛОКАЦИИ ВСЕ УЖЕ НАРИСОВАНЫ И ИМЕЮТ КАРТЫ ПОЛА — ролик собирается без
//  ожидания картинок. Это не экономия: локация обязана ДОКАЗЫВАТЬ реплику.
//
//  ЛИЦО РАБОТАЕТ ВНУТРИ РЕПЛИК. Мимика идёт слоями БЕЗ РТА (`vzglyad`,
//  `prishchur`, `poimal`, `klin`, `teplo`, `doshlo`, `somnenie`, `ostyl`,
//  `raspahnul`): рот в это время принадлежит липсинку. Мерка — `tools/slovar.py`.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` ЗДЕСЬ РАСЧЁТНЫЕ — текст написан заново. Расчёт по модели
//  «0.59 с на внутренний знак», поправленный коэффициентом 0.93 с прошлого
//  прогона. Завод перепишет их по факту (`tools/hronometrazh.py`).
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set dveri from "../assets/sets/logika-dve-dveri.svg"
import set dveri_vse from "../assets/sets/logika-dve-dveri-vse.svg"
import set ulica from "../assets/sets/biznes-street.svg"
import set ryady from "../assets/sets/supermarket-ryady.svg"
import set kuhnya from "../assets/sets/kuhnya-noch.svg"
import set scheta from "../assets/sets/kuhnya-schet.svg"
import set zerkalo from "../assets/sets/vannaya-zerkalo.svg"
import set void from "../assets/sets/void-black.svg"
import set rupory from "../assets/sets/logika-hor-golosov.svg"
import set les from "../assets/sets/derevo-pen.svg"
import set detskaya from "../assets/sets/detskaya.svg"
import set perekrestok from "../assets/sets/perekrestok-bez-znakov.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ДВЕ ДВЕРИ — ОБЪЯВЛЕНИЕ ТЕОРЕМЫ =======================
//  ДВЕ ДВЕРИ УЖЕ СТОЯТ, КОГДА РОЛИК НАЧИНАЕТСЯ. Первая секунда без слов.
//  Зритель узнаёт положение раньше, чем тему, — и это единственный способ,
//  которым Фримен входит: обстановкой, а не заявлением.
scene "dveri" (duration: 1s, set: dveri) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ, И ЭТО ПРО КОЛЬЦО: первая сцена — точка
    //  стыка при зацикливании, вспышка помех на ней заметнее любого шва.
    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92 over 0.01s

    //  НОМЕР КУРСА НА БАЛАХОНЕ — СЛЕДУЮЩЕГО, а не этого: подпись говорит «идём
    //  дальше», и метка обязана говорить то же. Проп живёт только пока камера
    //  неподвижна: он стоит в координатах КАДРА, а не на фигуре.
    let nomer = prop("nomer", "../assets/props/nomer-07.svg") at (0.525, 0.66) layer 9
    nomer scales 0.21 over 0.01s
    nomer hides

    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ. Голый
    //  `scales` на пропе, до которого не было анимированной смены масштаба, не
    //  применяется вовсе — метка встаёт в натуральную величину и закрывает
    //  торс. Рабочий рисунок один: спрятать, показать, вырастить с 0.02.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.23 over 0.05s ease-out
    nomer scales 0.21 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): «докажу вам простую вещь» ─────────────────────────
    //  САМАЯ МЕДЛЕННАЯ РЕПЛИКА РОЛИКА — 4.4 слог/с. Заявка на доказательство
    //  читается как объявление теоремы, а не как реклама. Разгонишь — станет
    //  зазывалой, и всё, что дальше, зритель будет слушать как рекламу.
    //lip 1
    together {
        freeman speaks for 5.11s
        do {
            freeman overlays "hips"
            wait 2.4s
            camera medium freeman
            freeman overlays "vzglyad"     // «работать хорошо — вредно»
        }
    }
    wait 0.5s

    // ── ХУК-ДОБИВКА (VO-2): «это не шутка. теорема.» ──────────────────
    //  ТРИ ОТДЕЛЬНЫЕ ФРАЗЫ, ТРИ ТОЧКИ. У синтеза пунктуация — главный рычаг
    //  просодии: точка опускает интонацию и ставит паузу. Здесь она нужна
    //  трижды подряд, чтобы форма была объявлена буквально по слогам.
    //lip 2
    together {
        freeman speaks for 3.87s
        do {
            wait 1.3s
            freeman overlays "palec_vverh" // «теорема»
            wait 1.2s
            freeman overlays "klin"        // «с доказательством»
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 2: ДЕЛОВАЯ УЛИЦА — ЧУЖАЯ ПЕРВАЯ СТРОКА =================
//  ОБЕЩАНИЕ ЗВУЧИТ ТАМ, ГДЕ ЕГО ДАЮТ. «Работаешь лучше — жить станешь лучше»
//  это не мысль зрителя, это фраза с улицы: вывески, офисы, чужие спины.
//  Локация обязана доказывать реплику — здесь она доказывает, ЧЬЯ это строка.
scene "ulica" (duration: 1s, set: ulica) {
    transition static 0.15s

    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПОСЫЛКА (VO-3): «нам всем обещали» ────────────────────────────
    //lip 3
    together {
        freeman speaks for 4.26s
        do {
            freeman overlays "razvel"      // «нам всем» — обвёл рукой
            wait 2.1s
            freeman overlays "prishchur"   // «жить станешь лучше» — ну-ну
        }
    }
    wait 0.4s

    // ── ОТКРЫТАЯ ПЕТЛЯ (VO-4): «запомните эту фразу» ──────────────────
    //  ПРЯМОЕ ОБЯЗАТЕЛЬСТВО ВЕРНУТЬСЯ. Зритель получает задание и держит его
    //  до самого разворота; всё, что между, слушается внимательнее, потому
    //  что обещано продолжение (PRODAZHA.md, «открытая петля»).
    //lip 4
    together {
        freeman speaks for 3.34s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "obvinil"     // «мы к ней ещё вернёмся» — в зрителя
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 3: РЯДЫ — ЦЕПОЧКА ИДЁТ ВВЕРХ ===========================
//  «КЛИЕНТОВ БОЛЬШЕ» ВИДНО НОГАМИ. Ряды уходят вглубь, персонаж идёт НА
//  КАМЕРУ: чем дальше цепочка, тем ближе он к зрителю. Пол начинается высоко
//  (карта: back_y 0.30), запас глубины позволяет четыре шага.
scene "ryady" (duration: 1s, set: ryady) {
    transition static 0.12s

    place freeman at (0.5, 0.62) facing front on floor
    freeman scales 0.42 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕПОЧКА ВВЕРХ (VO-5): два звена, ИДЁТ НА КАМЕРУ ───────────────
    //  Шаг и наезд ОДНОВРЕМЕННО, по одному на звено. Записанные подряд,
    //  `moves-to` и `scales` и выполняются подряд — в кадре это «подъехал, а
    //  потом раздулся». `together` внутри `do` связывает их в один отрезок.
    //  Числа идут равными приращениями: y +0.075, масштаб +0.115 за шаг.
    //lip 5
    together {
        freeman speaks for 4.75s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "vzglyad"     // «клиентов больше»
            together {
                freeman moves-to (0.5, 0.695) over 1.05s
                freeman scales 0.535 over 1.05s
            }
            freeman overlays "shag_pravoj"
            together {
                freeman moves-to (0.5, 0.77) over 1.05s
                freeman scales 0.65 over 1.05s
            }
            freeman overlays "shag_levoj"
            freeman overlays "palec_vverh" // «работы больше»
            together {
                freeman moves-to (0.5, 0.845) over 1.05s
                freeman scales 0.765 over 1.05s
            }
            freeman overlays "shag_pravoj"
        }
    }
    //  ОСТАНОВКА ПОЛНОЙ ПОЗОЙ: слои шага сняты, иначе висят на фигуре.
    freeman pose "calm"
    wait 0.35s

    // ── ЛАДОНИ (VO-6): «а рук у вас по-прежнему две» ──────────────────
    //  СКРЫТАЯ ПОСЫЛКА СТАЛА ВИДИМОЙ, И ВИДИМОЙ БУКВАЛЬНО. Вся цепочка
    //  молчаливо считает, что «больше работы» помещается в того же человека.
    //  Здесь это не объясняют, а показывают: две ладони, и всё.
    //  Реплика короткая намеренно — полторы секунды, тормоз посреди разгона.
    //lip 6
    together {
        freeman speaks for 1.49s
        do {
            freeman overlays "razvel"      // ладони — вот они, две
        }
    }
    wait 0.7s
}

// ============ СЦЕНА 4: НОЧНАЯ КУХНЯ — УСТАЛОСТЬ ============================
//  УСТАЛОСТЬ ЖИВЁТ НЕ НА РАБОТЕ. Её видно там, где человек оказывается после:
//  ночью на кухне, когда день кончился, а сил не осталось.
scene "kuhnya" (duration: 1s, set: kuhnya) {
    transition static 0.15s

    place freeman at (0.48, 0.93) facing front on floor
    freeman scales 0.74 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕПОЧКА ВНИЗ (VO-7): «устаёте — делаете хуже» ─────────────────
    //  ТОТ ЖЕ ТЕМП, ЧТО И НА ПОДЪЁМЕ, — 6.3 слог/с. Замедлишь здесь, и
    //  зритель услышит сочувствие, то есть услышит, что его ведут. Спуск
    //  обязан идти той же скоростью, что и подъём: правило-то одно.
    //lip 7
    together {
        freeman speaks for 4.89s
        do {
            freeman overlays "zakrylsya"   // «устаёте» — сложился
            wait 2.4s
            freeman overlays "ostyl"       // «делать хуже»
        }
    }
    wait 0.35s

    // ── ОБРАЗ (VO-8): «по миллиметру в день» ──────────────────────────
    //  СНИМАЕТ ВОЗРАЖЕНИЕ ДО ТОГО, КАК ОНО ВОЗНИКЛО. Без этой реплики зритель
    //  отвечает «я не халтурю» и выходит из цепочки. Три фразы, каждая тише
    //  предыдущей: деградация именно так и ощущается — незаметно.
    //lip 8
    together {
        freeman speaks for 3.24s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "somnenie"    // «по миллиметру в день»
        }
    }
    camera wide
    wait 0.7s
}

// ============ СЦЕНА 5: КУХНЯ СО СЧЕТАМИ — КРУГ ЗАМКНУЛСЯ ===================
//  ЗАРПЛАТА ВИДНА ТАМ, ГДЕ ЕЁ СЧИТАЮТ. Не в кассе и не в договоре — на столе,
//  среди бумаг, в конце месяца.
scene "scheta" (duration: 1s, set: scheta) {
    transition static 0.15s

    place freeman at (0.52, 0.94) facing front on floor
    freeman scales 0.76 over 0.01s
    camera wide
    freeman pose "calm"

    // ── КРУГ ЗАМКНУЛСЯ (VO-9) ─────────────────────────────────────────
    //lip 9
    together {
        freeman speaks for 5.04s
        do {
            freeman overlays "vniz"        // «клиенты уходят»
            wait 2.5s
            freeman overlays "poimal"      // «приползает туда, откуда выползла»
        }
    }
    wait 0.4s

    // ── ДВА СЛОВА (VO-10): «круг замкнулся» ───────────────────────────
    //  САМАЯ КОРОТКАЯ РЕПЛИКА РОЛИКА. Меньше секунды на два слова, и следом
    //  почти секунда тишины: круг замыкается не словами, а паузой после них.
    freeman pose "v_upor"
    //lip 10
    together {
        freeman speaks for 0.85s
        do {
            freeman overlays "klin"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 6: ВАННАЯ, ЗЕРКАЛО — ЦЕНА ==============================
//  НЕНАВИСТЬ НАЗЫВАЮТ ПЕРЕД ЗЕРКАЛОМ, И ЭТО ЕДИНСТВЕННОЕ ВЕРНОЕ МЕСТО.
//  Реплика про то, что ненависть оседает в теле; тело в кадре и должно быть,
//  а зеркало добавляет второе — человек смотрит на себя, пока это слушает.
scene "zerkalo" (duration: 1s, set: zerkalo) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"
    wait 0.3s

    // ── ЦЕНА, ЧАСТЬ 1 (VO-11): к себе, к будильнику, к людям ──────────
    //  ПЕРЕЧИСЛЕНИЕ РОВНОЕ, БЕЗ НАЖИМА. Нажмёшь голосом — станет жалобой, и
    //  зритель отодвинется: жаловаться он умеет сам.
    //lip 11
    together {
        freeman speaks for 7.82s
        do {
            freeman overlays "hips"
            wait 2.4s
            freeman overlays "vzglyad"     // «к себе»
            wait 2.4s
            freeman overlays "ostyl"       // «к будильнику»
            wait 2.3s
            freeman overlays "otmahnulsya" // «к людям, которые что-то просят»
        }
    }
    wait 0.4s

    // ── ЦЕНА, ЧАСТЬ 2 (VO-12): она оседает в теле ─────────────────────
    //  САМАЯ ФИЗИЧНАЯ РЕПЛИКА РОЛИКА. Здесь стояли «давление и бессонница» —
    //  два диагноза, которые ничего не делают с телом зрителя. Шея и сжатые
    //  ночью зубы делают: их можно почувствовать прямо на реплике.
    //lip 12
    together {
        freeman speaks for 7.99s
        do {
            camera medium freeman
            wait 2.6s
            freeman overlays "za_uho"      // «в шее»
            wait 2.6s
            freeman overlays "klin"        // «в зубах, которые вы сжимаете»
            wait 2.5s
            freeman overlays "doshlo"      // и повисло
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 7: ПУСТОТА — ЧТО И ТРЕБОВАЛОСЬ ДОКАЗАТЬ ================
//  ТОЧКА ТЕОРЕМЫ СТАВИТСЯ В ЧЁРНОМ. Ни кухни, ни улицы: доказательство
//  закончено, и вокруг не должно быть ничего, что от него отвлекает.
scene "temnota" (duration: 1s, set: void) {
    transition static 0.12s

    //  ЕДИНСТВЕННЫЕ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide
    freeman pose "v_upor"
    wait 0.4s

    // ── QED (VO-13) ───────────────────────────────────────────────────
    //lip 13
    together {
        freeman speaks for 4.69s
        do {
            freeman overlays "calm"
            wait 2.3s
            freeman overlays "klin"        // «работать хорошо — вредно»
        }
    }
    freeman overlays "flash_pupils"
    wait 1.2s
}

// ============ СЦЕНА 8: ТЕ ЖЕ ДВЕ ДВЕРИ — РАЗВОРОТ ==========================
//  «ВЕРНИТЕСЬ К САМОМУ ПЕРВОМУ ПРЕДЛОЖЕНИЮ» ЗВУЧИТ В ПЕРВОМ КАДРЕ РОЛИКА.
//  Не в похожем — в том же самом: та же локация, тот же `place`, тот же
//  масштаб. Зритель возвращается туда, откуда начал, буквально вместе с
//  фразой, и подмену находит на том самом месте, где её проглотил.
scene "razvorot" (duration: 1s, set: dveri) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ 1 (VO-14): «все шаги верные» ─────────────────────────
    //  ФОКУСНИК ПОКАЗЫВАЕТ РУКАВА. Зрителя приглашают проверить — и он
    //  проверяет, и правда всё сходится. Без этой ступени дальше нечему
    //  рушиться.
    //lip 14
    together {
        freeman speaks for 5.45s
        do {
            freeman overlays "hips"
            wait 2.0s
            freeman overlays "vzglyad"     // «не подкопаешься»
        }
    }
    wait 0.5s

    // ── РАЗВОРОТ 2 (VO-15): «вернитесь к первому предложению» ─────────
    //lip 15
    together {
        freeman speaks for 3.36s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "k_sebe"      // «вернитесь» — рука зовёт назад
        }
    }
    wait 0.9s

    // ── РАЗВОРОТ 3 (VO-16): «одного слова. кому.» ─────────────────────
    //  ПЕРЕЛОМ РОЛИКА. Ложь называется одним словом, и это слово — пропущенное
    //  подлежащее. Не «вас обманули», не «система устроена так»: в строке нет
    //  слова «кому». Проверяемо, произносимо вслух, укладывается в секунду.
    //lip 16
    together {
        freeman speaks for 4.42s
        do {
            freeman overlays "razvel"      // «видите, чего там нет?»
            wait 2.1s
            freeman overlays "palec_vverh" // «одного слова. кому.»
        }
    }
    wait 0.5s

    // ── РАЗВОРОТ 4 (VO-17): «не вам» ──────────────────────────────────
    //lip 17
    together {
        freeman speaks for 5.25s
        do {
            freeman overlays "obvinil"     // «кому вы работаете лучше»
            wait 2.5s
            freeman overlays "klin"        // «не вам»
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 9: КОРИДОР РУПОРОВ — ВОЗРАЖЕНИЕ СНЯТО ==================
//  РУПОРЫ — ЭТО ЗВУЧАНИЕ СКЛАДНОЙ ЦЕПОЧКИ. Место, где убедительное льётся из
//  каждой трубы и ни одна не проверяет, с чего начала.
scene "rupory" (duration: 1s, set: rupory) {
    transition static 0.15s

    place freeman at (0.5, 0.92) facing front on floor
    freeman scales 0.84 over 0.01s
    camera wide
    freeman pose "v_upor"

    // ── ОТРИЦАНИЕ (VO-18): «тогда анекдот» ────────────────────────────
    //  Возражение снимается не спором, а сменой жанра. Спор дал бы зрителю
    //  сторону, за которую можно держаться.
    //lip 18
    together {
        freeman speaks for 5.18s
        do {
            freeman overlays "zakrylsya"   // передразнивает: «я не дурак»
            wait 2.5s
            freeman overlays "prishchur"   // «тогда анекдот» — козырь
        }
    }
    wait 0.6s
}

// ============ СЦЕНА 10: ЛЕС — ЗАЯЦ НА ПОЛЯНЕ ===============================
//  АНЕКДОТ ПОЛУЧАЕТ СВОЮ ЛОКАЦИЮ, И ЭТО РАЗНИЦА МЕЖДУ «РАССКАЗАЛИ» И
//  «ПОКАЗАЛИ». Дерево и пень: поляна, на которой заяц читает книжку.
scene "les" (duration: 1s, set: les) {
    transition static 0.2s

    place freeman at (0.44, 0.90) facing front on floor
    freeman scales 0.70 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЗАВЯЗКА (VO-19): «идёт волк по лесу» ──────────────────────────
    //lip 19
    together {
        freeman speaks for 4.25s
        do {
            freeman overlays "vdal"        // «идёт волк по лесу»
            wait 2.1s
            freeman overlays "vzglyad"     // «видит — заяц книжку читает»
        }
    }
    wait 0.35s

    // ── ДВА ГОЛОСА (VO-20): волк ниже, заяц выше ──────────────────────
    //  РАЗНИЦА ГОЛОСОВ ДЕЛАЕТСЯ ПУНКТУАЦИЕЙ И ДЛИНОЙ ФРАЗЫ, а не актёрством:
    //  у волка вопрос коротким предложением, у зайца ответ с оборотом.
    //lip 20
    together {
        freeman speaks for 3.92s
        do {
            camera medium freeman
            wait 1.9s
            freeman overlays "smel"        // «логику учу»
        }
    }
    camera wide
    wait 0.35s
}

// ============ СЦЕНА 11: КОРИДОР РУПОРОВ — ПУЛЕМЁТ ==========================
//  ЦЕПОЧКА ЗАЙЦА ЗВУЧИТ ТАМ ЖЕ, ГДЕ ВСЁ СКЛАДНОЕ, — и это не случайность, а
//  утверждение: конструкция та же самая, что и в первой половине ролика.
scene "cepochka" (duration: 1s, set: rupory) {
    transition static 0.12s

    place freeman at (0.5, 0.66) facing front on floor
    freeman scales 0.44 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПУЛЕМЁТ 1 (VO-21): «спички есть?» ─────────────────────────────
    //lip 21
    together {
        freeman speaks for 5.29s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "vzglyad"
            together {
                freeman moves-to (0.5, 0.72) over 1.2s
                freeman scales 0.53 over 1.2s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "k_sebe"      // «спички есть?» — рука за ответом
            together {
                freeman moves-to (0.5, 0.78) over 1.2s
                freeman scales 0.62 over 1.2s
            }
            freeman overlays "shag_levoj"
        }
    }
    wait 0.3s

    // ── ПУЛЕМЁТ 2 (VO-22): «значит, куришь. ну да.» ───────────────────
    //  ВСТАВКИ ВОЛКА («ну да», «ну, бывает») ЗАМЕДЛЯЮТ ОЧЕРЕДЬ — и это работа,
    //  а не помеха: каждое согласие волка есть согласие зрителя. Он кивает
    //  вместе с ним и потому не может отскочить на панче.
    //lip 22
    together {
        freeman speaks for 6.38s
        do {
            freeman overlays "palec_vverh" // «значит, куришь»
            together {
                freeman moves-to (0.5, 0.84) over 1.4s
                freeman scales 0.71 over 1.4s
            }
            freeman overlays "shag_pravoj"
            freeman overlays "poimal"      // «ну да»
            together {
                freeman moves-to (0.5, 0.90) over 1.4s
                freeman scales 0.80 over 1.4s
            }
            freeman overlays "shag_levoj"
            freeman overlays "razvel"      // «значит, выпиваешь»
        }
    }
    freeman pose "calm"
    wait 0.3s

    // ── ПУЛЕМЁТ 3 (VO-23): «значит, ты свой, нормальный мужик» ────────
    //lip 23
    together {
        freeman speaks for 5.70s
        do {
            camera medium freeman
            wait 2.7s
            freeman overlays "oba_vverh"   // «значит, ты свой»
            freeman overlays "prishchur"   // и всё сошлось
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 12: ЛЕС — ВОЛК, МЕДВЕДЬ, ПАНЧ ==========================
//  ВОЗВРАТ В ТОТ ЖЕ ЛЕС ЗАМЫКАЕТ АНЕКДОТ КАРТИНКОЙ. Волк унёс книжку с этой
//  поляны и на этой же поляне применил её к медведю.
scene "medved" (duration: 1s, set: les) {
    transition static 0.2s

    place freeman at (0.52, 0.92) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ДОБИВКА 1 (VO-24): «волк в восторге» ──────────────────────────
    //lip 24
    together {
        freeman speaks for 3.71s
        do {
            freeman overlays "raspahnul"   // «волк в восторге»
            wait 2.2s
            freeman overlays "vdal"        // «встретил медведя»
        }
    }
    wait 0.4s

    // ── ПАНЧ (VO-25): «значит, ты, говорит, заднеприводный» ───────────
    //  ПАНЧ НЕ ТЕРПИТ ХВОСТА И НЕ ТЕРПИТ ЖЕСТА. Тело почти неподвижно: любое
    //  движение на ударном слове крадёт слово. Играют лицом — `klin` на
    //  «нет», `poimal` на самом панче.
    //
    //  РАЗВЯЗКИ НЕТ. Что сделал медведь — не говорится ни словом: пока в
    //  кадре волк, зритель смотрит на волка. Полторы секунды тишины после
    //  панча — и в них входит «а вы делаете то же самое».
    freeman pose "v_upor"
    //lip 25
    together {
        freeman speaks for 5.38s
        do {
            freeman overlays "k_sebe"      // «спички есть?» — ТОТ ЖЕ ЖЕСТ
            wait 2.0s
            camera medium freeman
            freeman overlays "klin"        // «нет»
            wait 1.9s
            freeman overlays "poimal"      // ПАНЧ
        }
    }
    camera wide
    wait 1.6s
}

// ============ СЦЕНА 13: ПУСТОТА — ПОВОРОТ НА ЗРИТЕЛЯ =======================
//  СМЕХ ГАСНЕТ ЗДЕСЬ, И ЭТО ЗАПЛАНИРОВАНО. Обрыв в чёрное сразу после панча:
//  между «смешно» и «это про меня» должна быть не связка, а разрыв.
scene "povorot" (duration: 1s, set: void) {
    transition static 0.12s

    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide
    freeman pose "v_upor"

    // ── ПОВОРОТ (VO-26): «но вы делаете то же самое» ──────────────────
    //lip 26
    together {
        freeman speaks for 4.14s
        do {
            freeman overlays "calm"
            wait 2.2s
            freeman overlays "obvinil"     // «с собой» — в зрителя
        }
    }
    wait 0.4s

    // ── ДИАГНОЗ (VO-27): «каждый вечер, когда подводите итоги» ────────
    //lip 27
    together {
        freeman speaks for 3.30s
        do {
            freeman overlays "ostyl"       // без упрёка: это опись
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 14: ДЕТСКАЯ — ОТКУДА ВЗЯЛАСЬ ПЕРВАЯ СТРОКА =============
//  «РОДИТЕЛИ, ШКОЛА, НАЧАЛЬНИК» — ПЕРЕЧИСЛЕНИЕ, КОТОРОЕ НАЧИНАЕТСЯ ЗДЕСЬ.
//  Детская отвечает на вопрос, который зритель задаёт молча: а откуда она у
//  меня взялась. Ответ показан раньше, чем произнесён.
scene "detskaya" (duration: 1s, set: detskaya) {
    transition static 0.2s

    place freeman at (0.5, 0.95) facing front on floor
    freeman scales 0.88 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ИСТОЧНИКИ (VO-28) ─────────────────────────────────────────────
    //lip 28
    together {
        freeman speaks for 6.08s
        do {
            freeman overlays "hips"
            wait 2.9s
            freeman overlays "vzglyad"     // «родители, школа, начальник»
            wait 2.8s
            freeman overlays "ostyl"
        }
    }
    wait 0.4s

    // ── ЧУЖОЙ ВНУТРЕННИЙ ГОЛОС (VO-29) ────────────────────────────────
    //  РЕПЛИКА ЗВУЧИТ ТИШЕ И ПЛОЩЕ ОСТАЛЬНЫХ: это не Фримен говорит, это он
    //  ЦИТИРУЕТ то, что звучит у зрителя в голове по вечерам. Отсюда и
    //  грубость — она не авторская, она подслушанная.
    //lip 29
    together {
        freeman speaks for 6.00s
        do {
            camera medium freeman
            wait 2.9s
            freeman overlays "ugryumo"     // «мир говно»
            wait 2.8s
            freeman overlays "vniz"        // «солнце — сломанный фонарь»
        }
    }
    camera wide
    wait 0.4s
}

// ============ СЦЕНА 15: ПУСТОТА — ДНО ======================================
//  «ПРИГОВОР ВЫ ВЫНЕСЛИ СЕБЕ САМИ» — САМАЯ ВАЖНАЯ ФРАЗА РОЛИКА, и она стоит
//  там, где нечем отвлечься. Три коротких предложения подряд, каждое тяжелее
//  предыдущего; между ними — точки, то есть паузы.
scene "dno" (duration: 1s, set: void) {
    transition static 0.15s

    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide
    freeman pose "v_upor"

    //lip 30
    together {
        freeman speaks for 4.78s
        do {
            freeman overlays "calm"
            wait 1.5s
            freeman overlays "klin"        // «вы вынесли себе сами»
            wait 1.5s
            freeman overlays "obvinil"     // «и подписали своей рукой»
            wait 1.4s
            freeman overlays "doshlo"      // «своей рукой»
        }
    }
    freeman overlays "flash_pupils"
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА — 1.8 с. Диагноз поставлен; сейчас скажут,
    //  что с ним делать, и зритель должен успеть этого захотеть.
    wait 1.8s
}

// ============ СЦЕНА 16: ПЕРЕКРЁСТОК БЕЗ ЗНАКОВ — ХОД =======================
//  ДОРОГ МНОГО И НИ ОДНА НЕ ПОДПИСАНА — ровно то, что скрывала непроверенная
//  первая строка. Здесь впервые за ролик светло и впервые звучит тепло.
scene "perekrestok" (duration: 1s, set: perekrestok) {
    transition static 0.25s

    place freeman at (0.44, 0.94) facing front on floor
    freeman scales 0.84 over 0.01s
    camera wide
    freeman pose "think"
    wait 0.4s

    // ── ВЗЛЁТ 1 (VO-31): «в выводе ошибки нет» ────────────────────────
    freeman pose "calm"
    //lip 31
    together {
        freeman speaks for 2.74s
        do {
            freeman overlays "raspahnul"   // ход открыт
            wait 1.3s
            freeman overlays "teplo"
        }
    }
    wait 0.4s

    // ── ВЗЛЁТ 2 (VO-32): «ошибка — в первой строке» ───────────────────
    //  ХОД ОТДАЁТСЯ РОВНО ОДИН, И ОН ВЫПОЛНИМ ВСЛУХ. Список из пяти проверок
    //  не запоминает никто; одно движение, повторённое в жале, уносят.
    //lip 32
    together {
        freeman speaks for 6.02s
        do {
            camera medium freeman
            wait 2.9s
            freeman overlays "vzves"       // «в той аксиоме»
            wait 2.8s
            freeman overlays "palec_vverh" // «которую вы проглотили не жуя»
        }
    }
    camera wide
    wait 0.8s

    // ── ПОДЪЁМ 1 (VO-33): «диван, сериал, тишина» ─────────────────────
    //  ЦЕНА ВМЕСТО МОРАЛИ. Ролик не уговаривает быть умнее — он называет цену
    //  отказа проверять, и называет её буднично.
    //lip 33
    together {
        freeman speaks for 5.90s
        do {
            freeman overlays "otmahnulsya" // «можно и дальше так жить»
            freeman overlays "prishchur"
            wait 2.8s
            freeman overlays "razmer"      // «диван, сериал, тишина»
        }
    }
    wait 0.35s

    // ── ПОДЪЁМ 2 (VO-34): «до первого медведя» ────────────────────────
    //  КАЛЛБЭК: медведь из анекдота возвращается единицей измерения. Зритель
    //  смеялся над ним минуту назад — теперь это его собственная мерка.
    //lip 34
    together {
        freeman speaks for 3.90s
        do {
            freeman overlays "u_viska_l"   // «вы правы, а мир дурак» — серьёзно?
            wait 1.7s
            freeman overlays "poimal"      // «до первого медведя»
        }
    }
    wait 0.6s

    // ── ЦЕНА (VO-35): «возразить некому» ──────────────────────────────
    //  САМАЯ ВАЖНАЯ ПРОДАЮЩАЯ РЕПЛИКА. Медведь отвечает сразу — потому анекдот
    //  и смешной. Себе человек отвечает годами и не получает возражений
    //  ниоткуда: вывод безупречен, придраться не к чему, пересматривать
    //  нечего. Вот за это и платят.
    freeman pose "v_upor"
    //lip 35
    together {
        freeman speaks for 8.50s
        do {
            freeman overlays "zakrylsya"
            wait 2.7s
            freeman overlays "vzglyad"     // «а когда о себе»
            wait 2.7s
            freeman overlays "klin"        // «возразить некому»
            wait 2.6s
            freeman overlays "doshlo"
        }
    }
    wait 1.2s
}

// ============ СЦЕНА 17: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ =========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "raskryl"
    wait 0.2s

    // ── ПРЕЗЕНТАЦИЯ 1 (VO-36): «не чтобы троллить в интернете» ────────
    //  ВОЗРАЖЕНИЕ СНИМАЕТСЯ ДО ТОГО, КАК ПРОЗВУЧИТ. «Логика» у зрителя
    //  связана с умничаньем в комментариях; не назовёшь это вслух — он
    //  подумает это сам и уйдёт.
    //lip 36
    together {
        freeman speaks for 4.10s
        do {
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            wait 2.0s
            freeman overlays "otmahnulsya"   // «не чтобы троллить»
        }
    }
    wait 0.35s

    // ── ПРЕЗЕНТАЦИЯ 2 (VO-37): что курс делает ────────────────────────
    //lip 37
    together {
        freeman speaks for 2.71s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "open"          // «замечать подмену»
        }
    }
    wait 0.35s

    // ── ПРЕЗЕНТАЦИЯ 3 (VO-38): «ту, которую кто-то в вас посеял» ──────
    //lip 38
    together {
        freeman speaks for 4.65s
        do {
            freeman overlays "teplo"         // приглашение, а не продажа
            wait 2.2s
            freeman overlays "vzglyad"
        }
    }
    camera wide
    wait 1.0s
}

// ============ СЦЕНА 18: КОРИДОР ВСЕХ ДВЕРЕЙ — ЖАЛО =========================
//  ВОПРОС ЗАДАН ТАМ, ГДЕ ОТВЕТ УЖЕ ВИДЕН: помеченных дверей две, а дверей в
//  коридоре двадцать. Зритель получает ответ раньше, чем успевает задать
//  вопрос, — и это единственный способ сказать «вы их не видели», не обвиняя.
scene "vopros" (duration: 1s, set: dveri_vse) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-39): «с какой строки начинается ваш вывод?» ──────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: вопрос можно задать себе
    //  сегодня же вечером, на первом же «значит».
    //lip 39
    together {
        freeman speaks for 3.76s
        do {
            camera medium freeman
            wait 1.8s
            freeman overlays "vozzvanie"   // вопрос повисает
            freeman overlays "klin"        // с вызовом, а не с советом
        }
    }
    wait 0.5s

    // ── ЖАЛО, ВТОРАЯ ПОЛОВИНА (VO-40): не вопрос, а адрес ─────────────
    //  ВТОРОГО ВОПРОСА ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ: два вопроса подряд гасят
    //  друг друга, зритель отвечает на второй и забывает первый. Поэтому
    //  вторая половина — констатация, и она называет ТУ САМУЮ боль, ради
    //  которой зритель досмотрел.
    //lip 40
    together {
        freeman speaks for 4.66s
        do {
            freeman overlays "vniz"        // «не выходит то, что вы хотели»
            wait 2.2s
            freeman overlays "doshlo"      // и повисло
        }
    }
    camera wide
    freeman overlays "hero_wink"
    //  ХВОСТ ПЕРЕД ПОДПИСЬЮ КОРОТКИЙ. Полторы секунды тишины после жала стоят
    //  ЗДЕСЬ, а не в сцене: `transition static` следующей сцены сам держит
    //  четверть секунды, и вместе они дают ровно паузу из партитуры.
    wait 1.5s
}

// ============ СЦЕНА 19: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ ================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: та же локация, тот же `place`, тот же
//  масштаб, та же поза, тот же номер того же размера. Отличается только то,
//  чего не видно, — звучащая реплика. Метка снимается перед самым концом:
//  на нулевом кадре её быть не может, значит и в последнем быть не должно.
scene "final" (duration: 1s, set: dveri) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    //  `over 0.01s` НА ОБОИХ МАСШТАБАХ. Голый `scales` стоит полсекунды
    //  таймлайна (умолчание движка); здесь их два подряд, и вместе с
    //  переходом и хвостом жала они набегали в трёхсекундную дыру перед
    //  подписью. Гейт `pauses.py` её и поймал.
    freeman scales 0.92 over 0.01s
    camera wide

    let nomer2 = prop("nomer", "../assets/props/nomer-07.svg") at (0.525, 0.66) layer 9
    nomer2 scales 0.21 over 0.01s
    nomer2 hides

    //lip 41
    together {
        freeman speaks for 5.75s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Обе позы поглаживания
            //  трогают только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.2s
            nomer2 shows
            nomer2 scales 0.02
            nomer2 scales 0.23 over 0.35s ease-out
            nomer2 scales 0.21 over 0.18s
            freeman overlays "gladit_grud_niz"
            wait 1.0s
            freeman overlays "gladit_grud"
        }
    }
    nomer2 hides
    freeman pose "gladit_grud"
    wait 0.4s
}
