// =============================================================================
//  «ГДЕ ОСТАЛЬНЫЕ ДВЕРИ» — интро к курсу «Логика».
//  VO — logika-VO.md, //lip 1..12.
//
//  УСТРОЙСТВО РОЛИКА
//
//  1. ОБМАНКА ВЕДЁТ ОТ СПОРА К ВОПРОСУ. Двадцать секунд зритель слышит своё:
//     его переспорили, он был прав и всё равно проиграл. Он согласен. Разворот
//     сообщает, что ни одна из пяти уловок с ним вообще не спорила — каждая
//     меняла ВОПРОС. Тема, в которой зритель считал себя недостаточно умным,
//     оказывается темой, в которой ему подменили условие.
//
//  2. ДВЕ ДВЕРИ ДЕРЖАТ ВЕСЬ РОЛИК И НЕ ТРЕБУЮТ НИ ОДНОГО ТЕРМИНА. Две двери —
//     чужое условие, выданное за весь мир. Выбор между ними — БЕЗУПРЕЧНОЕ
//     рассуждение: из «или А, или Б» и «не А» честно следует «Б», форма не
//     подкачала. Ложь сидит не в переходе, а во ВХОДЕ: дверей было больше.
//     Всё это видно в первом же кадре, до единого слова.
//
//  3. ПЯТЬ УЛОВОК БЕЗ ИМЁН. Вместо «ложная дилемма, ad populum, ad verecundiam,
//     апелляция к очевидности, ad hominem» — «Или ты с нами, или против. Стадо
//     не ошибается. Он же профессор. Это же очевидно. А сам-то ты кто?».
//     Порядок ведёт от подмены УСЛОВИЯ к подмене СОБЕСЕДНИКА: от того, что
//     ещё похоже на спор, к тому, что спором уже не является.
//
//  4. КОЛЬЦО ДЕРЖИТСЯ ЛОКАЦИЕЙ, А НЕ ТОЛЬКО ЖЕСТОМ. Жало и подпись идут на той
//     же площадке с теми же двумя дверями, что и хук. При зацикливании в ленте
//     зритель видит тот же кадр — и уже с другим вопросом к нему.
//
//  5. ТЕМП ИДЁТ ПО БИТАМ: хук 1.42, пулемёт 1.59, сразу за ним разворот 1.25,
//     дно 1.25. Перепад в четверть скорости стоит ровно на остановке посреди
//     базара, где кончаются чужие голоса.
//
//  ЛОКАЦИИ ВСЕ УЖЕ НАРИСОВАНЫ И ИМЕЮТ КАРТЫ ПОЛА — ролик собирается без
//  ожидания картинок. Это не экономия: локация обязана ДОКАЗЫВАТЬ реплику, и
//  эти четыре доказывают. Площадка с двумя дверями — весь механизм в одном
//  кадре. Базар обещаний — место, где складное звучит очередью. Пустота —
//  где нечем отвлечься. Перекрёсток без знаков — ровно то, что скрывали две
//  двери: дорог много и ни одна не подписана.
//
//  ЛИЦО РАБОТАЕТ ВНУТРИ РЕПЛИК. Мимика идёт слоями БЕЗ РТА (`vzglyad`,
//  `prishchur`, `poimal`, `klin`, `teplo`, `doshlo`, `somnenie`, `ostyl`,
//  `raspahnul`): рот в это время принадлежит липсинку. До появления этого
//  класса лицо стояло всю реплику, и это читалось однообразием
//  (RABOTA-NAD-OSHIBKAMI §XII). Мерка — `tools/slovar.py`.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ, иначе слой шага висит на фигуре;
//    · в длинной реплике первым слоем называется РУКА: слой из одних глаз рук
//      не трогает, и поднятая полной позой рука висит забытой (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · `moves-to ... over` и `scales ... over` ЗАНИМАЮТ ВРЕМЯ наравне с `wait`;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` ЗДЕСЬ РАСЧЁТНЫЕ — по мерке 0.36 с на слово. Другого
//  способа до озвучки нет; первый прогон завода перепишет их по факту
//  (`tools/hronometrazh.py`), и они уедут: на «Эмоциях» медиана расхождения
//  вышла 0.77 с на реплику.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set ploschadka from "../assets/sets/ploschadka-dve-dveri.svg"
import set bazar from "../assets/sets/bazaar-obeschanij.svg"
import set void from "../assets/sets/void-black.svg"
import set perekrestok from "../assets/sets/perekrestok-bez-znakov.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ПРИХОЖАЯ С ДВУМЯ ДВЕРЯМИ — ХУК, ДОБИВКА, ОБРАЗ =======
//  ДВЕ ДВЕРИ УЖЕ СТОЯТ, КОГДА РОЛИК НАЧИНАЕТСЯ. Первая секунда без слов: две
//  двери прямо перед зрителем, и выбирать предлагают из них. Зритель узнаёт
//  положение раньше, чем тему, — и это единственный способ, которым Фримен
//  входит: обстановкой, а не заявлением.
//
//  СЕТ ВЫБРАН ПО КОНТАКТНОМУ ЛИСТУ, А НЕ ПО НАЗВАНИЮ. Сначала сцена звучала
//  как «пустая площадка, больше ничего» — а в кадре стоит комната со столом и
//  бумагами, и слова расходились с картинкой (реестр, «локация не та»).
//  Пробовал `doors-empty.svg`: там дверь ОДНА, и чёрная фигура в неё
//  проваливается — оба пятна чёрные. Сет оставлен, поправлены СЛОВА.
scene "ploschadka" (duration: 1s, set: ploschadka) {
    transition static 0.2s

    //  Стоит МЕЖДУ дверями, но не у них: он пока рассказывает про положение, а
    //  не выбирает. К дверям подойдёт только в образе.
    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92

    //  НОМЕР КУРСА НА БАЛАХОНЕ, справа на груди. Ролик уходит в ленту, где
    //  «смотреть или листать» решается за две секунды — меньше, чем длится
    //  первая реплика. Зацепить в них можно только картинкой, и номер работает
    //  сразу на два: держит взгляд и говорит «это серия». Логика — направление
    //  ШЕСТОЕ (страница курса), отсюда nomer-06.
    //
    //  ПРАВИЛО: проп на теле живёт ТОЛЬКО пока камера неподвижна — он стоит в
    //  координатах КАДРА, а не на фигуре. Здесь номер снимается ДО первого
    //  движения камеры.
    let nomer = prop("nomer", "../assets/props/nomer-06.svg") at (0.525, 0.66) layer 9
    nomer scales 0.21
    nomer hides

    camera wide

    //  ПЕРВЫЕ СЕКУНДЫ БЕЗ СЛОВ: гладит себя по груди, и номер ПРОЯВЛЯЕТСЯ.
    //  Этот же жест стоит в самом конце: при зацикливании конец сшивается с
    //  началом, и зритель не видит шва.
    freeman pose "gladit_grud"
    wait 0.25s
    nomer shows
    nomer scales 0.02
    nomer scales 0.23 over 0.2s ease-out
    nomer scales 0.21 over 0.1s
    freeman pose "gladit_grud_niz"
    wait 0.2s
    nomer hides
    freeman pose "calm"

    // ── ХУК (VO-1): «Вам показали две двери. Вы выбрали. И проиграли.» ─
    //  БЕЗ СОЧУВСТВИЯ. Жалость читалась бы как «ну ничего, бывает», а ролик
    //  утверждает обратное: дело не в вас, дело во входе.
    freeman overlays "smug"
    //lip 1
    together {
        freeman speaks for 4.0s
        do {
            camera medium freeman
            wait 1.3s
            freeman overlays "vdal"        // «две двери» — показал на них
            wait 1.2s
            freeman overlays "poimal"      // «и проиграли» — перекос, поймал
        }
    }
    camera wide
    wait 0.4s

    // ── ХУК-ДОБИВКА (VO-2): «дверей было больше» ──────────────────────
    freeman pose "calm"
    freeman overlays "hips"
    //lip 2
    together {
        freeman speaks for 3.94s
        do {
            wait 1.17s
            freeman overlays "ostyl"       // диагноз ставят холодно, не зло
            wait 1.09s
            freeman overlays "k_sebe"      // «не потому, что были неправы»
            wait 1.17s
            freeman overlays "razvel"      // «дверей было больше» — а их нет
        }
    }
    wait 0.5s

    // ── ОБРАЗ (VO-3): «Две двери — это не выбор.» ─────────────────────
    //  ПОКАЗЫВАЕТ, А НЕ ОБЪЯСНЯЕТ. Картинка подаётся как бытовая очевидность:
    //  подчеркнёшь голосом или жестом — станет нравоучением, и выстрел в жале
    //  пропадёт.
    freeman pose "calm"
    //lip 3
    together {
        freeman speaks for 5.0s
        do {
            wait 1.5s
            freeman overlays "yorik"       // «две двери» — предъявил на ладони
            freeman overlays "vzglyad"     // очевидность подают ровно
            wait 1.7s
            freeman overlays "stop_ladon"  // «это не выбор» — стоп
            wait 1.4s
            freeman overlays "prishchur"   // «выдали за весь мир» — ну-ну
        }
    }
    wait 0.8s
}

// ============ СЦЕНА 2: БАЗАР ОБЕЩАНИЙ — ПУЛЕМЁТ И РАЗВОРОТ ==================
//  МЕСТО, ГДЕ СКЛАДНОЕ ЗВУЧИТ ОЧЕРЕДЬЮ. Пять уловок произносятся ровно там,
//  где их и произносят: в проходе между рядами, каждым встречным и каждая
//  по-своему убедительно.
scene "bazar" (duration: 1s, set: bazar) {
    transition static 0.2s

    //  Пол базара начинается высоко (карта: back_y 0.33) — фигура ставится
    //  вглубь прохода и идёт НА КАМЕРУ.
    place freeman at (0.5, 0.72) facing front on floor
    freeman scales 0.44
    camera wide

    // ── ПУЛЕМЁТ (VO-4): пять уловок, ИДЁТ НА КАМЕРУ ───────────────────
    //  УЛОВКИ НЕ ОТДАЛЯЮТ, ОНИ ПОДСТУПАЮТ — поэтому движение на зрителя, а не
    //  вбок. Шаг фронтальный, накладки без рта: липсинк не перебивается.
    //
    //  Шаг и движение ОДНОВРЕМЕННО: `moves-to ... over` и `scales ... over`
    //  занимают время наравне с `wait`, поэтому накладка ставится ПЕРЕД своим
    //  отрезком. 4×1.5 = 6.0 с при 7.2 с реплики.
    freeman pose "calm"
    //lip 4
    together {
        freeman speaks for 6.35s
        do {
            freeman overlays "shag_levoj"
            freeman overlays "vzglyad"     // чужие доводы слушают ровно
            freeman moves-to (0.5, 0.80) over 1.32s
            freeman overlays "shag_pravoj"
            freeman scales 0.58 over 1.32s
            freeman overlays "shag_levoj"
            freeman overlays "somnenie"    // на третьей уловке бровь пошла вверх
            freeman moves-to (0.5, 0.93) over 1.32s
            freeman overlays "shag_pravoj"
            freeman scales 0.86 over 1.32s
            freeman overlays "prishchur"   // «а сам-то ты кто?» — ну-ну
        }
    }
    //  Остановка ПОЛНОЙ ПОЗОЙ: слои шага сняты. Поза смысловая — он ещё не
    //  отвечает, он дослушал.
    freeman pose "calm"
    //  Тишина на месте шестой уловки — её нет, и это слышно.
    wait 0.5s

    // ── РАЗВОРОТ (VO-5): «Каждый меняет вопрос.» ──────────────────────
    //  ВПЕРВЫЕ В УПОР. До этой секунды он ни разу не смотрел в камеру: пока
    //  шли чужие голоса, взгляд в упор был бы преждевременным.
    freeman pose "v_upor"
    //lip 5
    together {
        freeman speaks for 6.1s
        do {
            //  РУКА НАЗЫВАЕТСЯ ПЕРВОЙ: слой из одних глаз её не трогает, и
            //  поднятая `v_upor`-ом рука висела бы всю реплику забытой.
            freeman overlays "zakrylsya"   // «все пять — про одно»: закрылся
            wait 1.8s
            freeman overlays "obvinil"     // «ни один не спорит» — всем телом
            wait 1.9s
            camera medium freeman
            freeman overlays "klin"        // «каждый меняет вопрос» — приговор
        }
    }
    camera wide
    wait 0.5s
}

// ================== СЦЕНА 3: ПУСТОТА — МЕХАНИЗМ И РАЗЛИЧИЕ ==================
//  ЧЁРНЫЙ КАДР, БЕЛАЯ МАСКА. Ни площадки, ни базара: механизм называется там,
//  где нечем отвлечься. Две реплики подряд без смены плана — сначала что может
//  случиться с безупречным выводом, потом за что логика вообще отвечает.
scene "temnota" (duration: 1s, set: void) {
    //  Резкая склейка: между базаром и пустотой должен быть обрыв.
    transition static 0.12s

    //  ЕДИНСТВЕННЫЙ `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.44) facing front
    freeman scales 2.2
    camera wide

    freeman pose "v_upor"
    wait 0.5s

    // ── УДАР В ЧЁРНОМ (VO-6): «безупречно и всё равно ложь» ───────────
    //  БЕЗ ОБВИНЕНИЯ. Здесь выстреливают двери: безупречный выбор оказывается
    //  своим. Если сыграть это упрёком, зритель начнёт защищаться вместо того,
    //  чтобы узнавать себя.
    //lip 6
    together {
        freeman speaks for 6.79s
        do {
            freeman overlays "calm"        // руку назвать: дальше идёт лицо
            wait 2.17s
            freeman overlays "ostyl"       // «может следовать безупречно»
            wait 2.04s
            freeman overlays "doshlo"      // «и всё равно быть ложью» — шар
            wait 1.9s
            freeman overlays "vniz_l"      // «вход был кривой» — вот сюда
        }
    }
    wait 0.5s

    // ── ДНО (VO-7): «Логика не говорит, где истина.» ──────────────────
    //  ГЛАВНАЯ ФРАЗА РОЛИКА, и потому играется почти неподвижно: любой жест
    //  здесь отвлекает. Рука всё равно НАЗЫВАЕТСЯ — `calm` опускает её в
    //  покой, и это и есть «почти неподвижно», только сказанное явно.
    freeman pose "v_upor"
    //lip 7
    together {
        freeman speaks for 6.56s
        do {
            freeman overlays "calm"
            wait 1.92s
            freeman overlays "vzglyad"     // «не говорит, где истина» — ровно
            wait 2.03s
            freeman overlays "dve_storony_l" // «это разные вопросы» — вот и вот
            wait 1.81s
            freeman overlays "poimal"      // «путают их постоянно» — перекос
        }
    }
    freeman overlays "flash_pupils"
    wait 0.2s
}

// ============ СЦЕНА 4: ПЕРЕКРЁСТОК БЕЗ ЗНАКОВ — ВЗЛЁТ И ПОДЪЁМ ==============
//  РОВНО ТО, ЧТО СКРЫВАЛИ ДВЕ ДВЕРИ: дорог много и ни одна не подписана. Пять
//  проверок называются в том самом месте, где их видно ногами.
scene "perekrestok" (duration: 1s, set: perekrestok) {
    transition static 0.2s

    place freeman at (0.42, 0.93) facing front on floor
    freeman scales 0.88
    camera wide

    //  ДРАМАТИЧЕСКАЯ ПАУЗА ПОСЛЕ ДНА: различие названо, сейчас скажут, что с
    //  ним делать. Реплика сразу после склейки читалась бы продолжением
    //  приговора.
    freeman pose "think"
    wait 1.2s

    // ── ВЗЛЁТ (VO-8): пять проверок ───────────────────────────────────
    //  ПЯТЬ ПРОВЕРОК — СПИСОК ДЕЛ, А НЕ ОТКРОВЕНИЕ. Перечисление идёт ровно, и
    //  каждый пункт получает СВОЙ жест: перечисление, где рука повторяется,
    //  зритель считает по движениям, а не по словам.
    freeman pose "calm"
    //lip 8
    together {
        freeman speaks for 8.15s
        do {
            wait 1.27s
            freeman overlays "vzves"       // «в двух местах» — две чаши
            freeman overlays "raspahnul"   // список начат
            wait 1.36s
            freeman overlays "palec_vverh" // «верны ли посылки» — первое
            wait 1.36s
            freeman overlays "rubit"       // «следует ли вывод» — отрезал
            wait 1.36s
            freeman overlays "oba_vverh"   // «все ли варианты названы»
            wait 1.27s
            freeman overlays "manit_l"     // «кто задал вопрос» — а ну-ка
            wait 1.27s
            freeman overlays "vniz"        // «если ответить иначе» — вот сюда
            freeman overlays "teplo"       // и тепло: это выполнимо
        }
    }
    wait 0.5s

    // ── ПОДЪЁМ (VO-9): «брать дверь побольше» ─────────────────────────
    //  ЦЕНА ВМЕСТО МОРАЛИ. Ролик не уговаривает быть умнее — он называет цену
    //  отказа разбираться: способ работает ровно до первого «почему».
    freeman pose "calm"
    //lip 9
    together {
        freeman speaks for 6.1s
        do {
            camera medium freeman
            wait 1.6s
            freeman overlays "otmahnulsya" // «разбираться не хочет» — отмашка
            freeman overlays "prishchur"   // с ухмылкой: приём известный
            wait 1.7s
            freeman overlays "razmer"      // «брать побольше» — вот такую, во!
            wait 1.8s
            freeman overlays "u_viska_l"   // «до первого почему» — серьёзно?
        }
    }
    camera wide
    wait 0.5s
}

// ============ СЦЕНА 5: ЗАЛ ЛЕКТОРИЯ — ПРЕЗЕНТАЦИЯ ===========================
scene "zal" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72
    camera wide
    freeman pose "raskryl"
    wait 0.15s

    // ── ПРЕЗЕНТАЦИЯ (VO-10): называет курс ────────────────────────────
    //lip 10
    together {
        freeman speaks for 4.73s
        do {
            camera medium freeman
            wait 1.44s
            freeman overlays "ruki_za_spinu" // курс называют по-лекторски
            freeman overlays "teplo"       // и тепло: это приглашение
            wait 1.58s
            freeman overlays "open"        // «и все бесплатно»
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 6: ТА ЖЕ ПРИХОЖАЯ — ЖАЛО И ПОДПИСЬ ======================
//  ТОТ ЖЕ КАДР, ЧТО И В НАЧАЛЕ, И ТЕ ЖЕ ДВЕ ДВЕРИ. Кольцо замыкается не только
//  жестом, но и МЕСТОМ: на втором круге зритель видит ту же прихожую и уже с
//  другим вопросом к ней.
scene "final" (duration: 1s, set: ploschadka) {
    transition static 0.2s

    place freeman at (0.5, 0.94) facing front on floor
    freeman scales 0.92
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-11): «Спросите: где остальные?» ──────────────────────
    //  ИЗМЕРИМОЕ ДЕЙСТВИЕ, а не мысль на прощание: у зрителя есть один вопрос,
    //  который можно задать сегодня же вечером, как только покажут две двери.
    //lip 11
    together {
        freeman speaks for 5.59s
        do {
            camera medium freeman
            wait 1.69s
            freeman overlays "stop_ladon_l" // «не выбирайте» — стоп
            freeman overlays "klin"        // с вызовом, а не с советом
            wait 1.56s
            freeman overlays "vozzvanie"   // «где остальные?» — рука к небу
            freeman overlays "doshlo"      // и вопрос повисает: шар в глазах
        }
    }
    freeman overlays "hero_wink"
    wait 0.1s

    // ── ПОДПИСЬ-КОЛЬЦО (VO-12) ────────────────────────────────────────
    //  ТОТ ЖЕ ЖЕСТ, ЧТО И В ПЕРВЫХ СЕКУНДАХ, и тот же проявляющийся номер.
    //  ПЛАН ВОЗВРАЩАЕТСЯ НА ОБЩИЙ ПЕРЕД ПОДПИСЬЮ: жало идёт средним планом, а
    //  проп не знает про зум камеры — номер, поставленный тем же масштабом,
    //  что и в начале, раздулся бы во весь торс. Подпись обязана повторять
    //  ПЕРВЫЙ кадр, иначе кольцо не сходится.
    camera wide
    let nomer2 = prop("nomer", "../assets/props/nomer-06.svg") at (0.525, 0.66) layer 9
    nomer2 scales 0.21
    nomer2 hides
    //lip 12
    together {
        freeman speaks for 3.6s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает. Обе позы поглаживания
            //  трогают только руку — значит ложатся накладкой без потерь.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"       // подпись объявляют тепло, не бьют
            wait 1.4s
            nomer2 shows
            nomer2 scales 0.02
            nomer2 scales 0.23 over 0.2s ease-out
            nomer2 scales 0.21 over 0.1s
            freeman overlays "gladit_grud_niz"
            wait 0.5s
            freeman overlays "gladit_grud"
        }
    }
    //  Камера в подписи НЕ ДВИГАЕТСЯ — потому номер и держится ровно на груди.
    //  Снимаем его перед уходом: на ходу он поехал бы по кадру.
    nomer2 hides
    wait 0.2s

    // ── УХОДИТ МИМО ОБЕИХ ДВЕРЕЙ ──────────────────────────────────────
    //  ФИНАЛЬНЫЙ ЖЕСТ РОЛИКА СКАЗАН ХОДЬБОЙ, А НЕ СЛОВОМ: он уходит не в
    //  дверь, а ВБОК, за кадр. Ровно то, чего не сделал зритель в первой
    //  секунде. Уходит в профиль: спина к зрителю читалась бы обидой.
    //  Хвост держится под тремя секундами (tools/pauses.py).
    freeman pose "bok_levo"
    freeman moves-to (0.04, 0.94) over 0.5s
    freeman overlays "shag_bok_levoj"
    wait 0.25s
    freeman overlays "shag_bok_pravoj"
    wait 0.25s
    //  Проход заканчивается СТОЙКОЙ: слои держатся до полной позы.
    freeman pose "bok_levo"
}
