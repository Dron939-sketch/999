// =============================================================================
//  «ТАРАКАНЫ» — интро к курсу «Этика».
//  VO — etika-VO.md, маркеры 1..19.
//
//  ОДНА МЫСЛЬ НА РОЛИК: то, что зовут совестью, поселили в вас чужие люди.
//  Теперь они разговаривают, а вы с ними договариваетесь — и уже поэтому
//  главный не вы.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. ГЛАВНОЕ РЕШЕНИЕ — НЕ НАЗЫВАТЬ ЭТО СОВЕСТЬЮ. «Совесть» — слово, с которым
//     нельзя ничего сделать: его можно только уважать. Таракан — сосед, с
//     которым разговаривают. Как только голос назван соседом, вся середина
//     становится СЦЕНОЙ, а не рассуждением, и зритель начинает вспоминать свои
//     переговоры вместо того, чтобы соглашаться с тезисом.
//
//  2. ИМЯ ОТЛОЖЕНО НА ДВЕ РЕПЛИКИ. Сначала «внутри кто-то зашевелился» (VO-3),
//     и только в пулемёте — «это тараканы». Назовёшь сразу — выйдет шутка;
//     назовёшь после шевеления — выйдет узнавание.
//
//  3. ГРУБОСТЬ НАПРАВЛЕНА В ТАРАКАНОВ, А НЕ В ЗРИТЕЛЯ, И ЭТО НЕ ОСТОРОЖНОСТЬ.
//     Ролик про этику, который унижает зрителя, сам себя опровергает. Презрение
//     достаётся подселенцам и тем, кто их подселил («чужой дядя, который вас не
//     помнит»), а зрителю в качелях возвращают достоинство — доказательством, а
//     не утешением.
//
//  4. ГЛАВНОЕ УЗНАВАНИЕ — САМ ФАКТ ПЕРЕГОВОРОВ (VO-7). «Вы с ними
//     договариваетесь. Значит, не вы.» Переговоры ведут с равным, а не с
//     подчинённым; ответ на вопрос о хозяине даёт не содержание спора, а то,
//     что спор вообще идёт.
//
//  5. РОЛИК ПРОВЕРЕН ВЫЧИТКОЙ (`VYCHITKA.md`), И ОНА НАШЛА ДВА МЕСТА.
//     Первое: в пулемёте стояло «это таракан» в ЕДИНСТВЕННОМ числе, а через
//     реплику шло «вы или они» — и «они» на слух цеплялось за мать, школу и
//     дядю, перечисленных секундой раньше. Множественное введено сразу.
//     Второе: качели начинались с «и это хорошая новость», и на слух это
//     читалось прямой похвалой тем, у кого в голове тихо; ирония жила только в
//     ремарке для озвучки. Переворот вписан В ТЕКСТ: «и вот что страшно».
//
//  6. НОМЕРА КУРСА В РОЛИКЕ НЕТ: его присваивает студия. Первый и последний
//     кадры тождественны и стоят в позе поглаживания груди — метка добавится
//     одной сценой.
//
//  7. ЦВЕТНОЕ ПЯТНО РОВНО ОДНО, И ЭТО ВЫБОР. Красная черта на пороге проходит
//     сквозь монохромный проход и остаётся красной. Вторая локация с цветом —
//     «две двери» с красными метками — БЫЛА ОТВЕРГНУТА: два пятна на ролик выше
//     потолка серии. Черта осталась потому, что для курса про этику она
//     буквально тема кадра.
//
//  8. ЛОКАЦИЙ СЕМЬ, ДВЕ НАРИСОВАНЫ ПОД ЭТОТ РОЛИК студией по промтам: прилавок
//     с забытой сдачей и стадо, идущее в одну сторону. Обе проверены рендером,
//     цвета в исходниках нет.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · речь НА ХОДУ — фронтальный шаг слоем, полная поза сбрасывает липсинк;
//    · проход закрывается ПОЛНОЙ ПОЗОЙ;
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · реквизит носит только поза, объявившая его именем (tools/rekvizit.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). В этом ролике таких два: `smug` и
//      `hero_wink`, оба вынесены в паузы;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · координаты фигуры снимаются ПРОБНЫМ РЕНДЕРОМ (реестр §XVIII);
//    · БЕЗ СВЕРХКРУПНЫХ ПЛАНОВ: растр сета на ECU-зуме взрывается.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`,
//  реестр §XXIII). Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set prilavok from "../assets/sets/prilavok-sdacha.svg"
import set detskaya from "../assets/sets/detskaya.svg"
import set void from "../assets/sets/void-black.svg"
import set kuhnya from "../assets/sets/kuhnya-schet.svg"
import set porog from "../assets/sets/porog-cherta.svg"
import set stado from "../assets/sets/stado-v-odnu-storonu.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}

// ============ СЦЕНА 1: ПРИЛАВОК С ЗАБЫТОЙ СДАЧЕЙ — ХУК =====================
//  НОВАЯ ЛОКАЦИЯ. На стойке мелочь и купюра, за прилавком никого: стул есть,
//  продавца нет. Мелкий поступок показан МЕСТОМ, а не словом — называть его
//  не надо, каждый подставит свой.
scene "sdacha" (duration: 1s, set: prilavok) {
    //  ПЕРЕХОДА В ПЕРВОЙ СЦЕНЕ НЕТ: это точка стыка при зацикливании.
    //  Координаты сняты пробным рендером (карта пола: back_y 0.61). Фигура
    //  стоит в ЛЕВОЙ трети: правее 0.30 она скроется за тумбой прилавка по
    //  пояс, и сдача уйдёт из кадра вместе с ней.
    place freeman at (0.16, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ. Поза поглаживания груди держит место
    //  под метку курса: номер присваивает студия.
    freeman pose "gladit_grud"
    wait 0.15s
    freeman pose "v_upor"
    wait 0.1s

    // ── ХУК (VO-1): мелкий поступок ───────────────────────────────────
    //  РОВНО И НЕГРОМКО, как сообщают известное обоим. «По мелочи» — на
    //  выдохе и мягче: это оговорка, за которую зритель ухватится, и она
    //  нужна, чтобы он согласился прежде, чем поймёт, с чем согласился.
    //lip 1
    together {
        freeman speaks for 3.30s
        do {
            freeman overlays "hips"        // «сегодня вы поступили плохо»
            wait 2.2s
            freeman overlays "vzglyad"     // «по мелочи»
        }
    }
    wait 0.35s

    // ── ДОБИВКА (VO-2): три оправдания ────────────────────────────────
    //  ИХ ПРОИЗНОСЯТ ВСЕРЬЁЗ, БЕЗ ИРОНИИ: они настоящие, и зритель обязан с
    //  ними согласиться. Сыграешь насмешку — он поймёт, что его ловят, и
    //  перестанет вспоминать.
    //lip 2
    together {
        freeman speaks for 5.46s
        do {
            freeman overlays "rubit"       // «никто не видел»
            wait 1.8s
            freeman overlays "rubit_l"     // «никто не узнает»
            wait 1.8s
            freeman overlays "razvel"      // «никому не хуже»
        }
    }
    wait 0.45s

    // ── УДАР (VO-3): шевеление без имени ──────────────────────────────
    //  ПЕРВЫЙ УДАР ГОЛОСОМ. Кто именно зашевелился — не сказано, и в этом вся
    //  работа: имя придёт через две реплики. Назовёшь сразу — выйдет шутка.
    //lip 3
    together {
        freeman speaks for 2.86s
        do {
            camera medium freeman
            freeman overlays "ostyl"       // «а внутри кто-то зашевелился»
        }
    }
    camera wide
    wait 0.8s
}

// ============ СЦЕНА 2: ДЕТСКАЯ — ГДЕ ИХ ПОСЕЛИЛИ ===========================
//  ТАМ, ГДЕ ИХ И ПОСЕЛИЛИ. Кровать, велосипед, чужие вещи — всё выданное,
//  ничего выбранного. Комната объясняет пулемёт раньше, чем он прозвучит.
scene "detskaya" (duration: 1s, set: detskaya) {
    transition static 0.2s

    //  Пол начинается низко (карта: back_y 0.764).
    place freeman at (0.30, 0.95) facing front on floor
    freeman scales 0.85 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ОТРИЦАНИЕ (VO-4): красивое слово отбирают ─────────────────────
    //  ЗРИТЕЛЬ УЖЕ ГОТОВ УВАЖИТЕЛЬНО КИВНУТЬ СЛОВУ «СОВЕСТЬ» — и этот кивок
    //  закрыл бы ролик. Устало, как отмахиваются от чужой торжественности.
    //lip 4
    together {
        freeman speaks for 4.40s
        do {
            freeman overlays "otmahnulsya" // «не называйте это совестью»
            wait 2.5s
            freeman overlays "prishchur"   // «слишком красивое слово»
        }
    }
    wait 0.35s

    // ── ПУЛЕМЁТ (VO-5): имя и список тех, кто подселил ────────────────
    //  САМЫЙ БЫСТРЫЙ КУСОК РОЛИКА — 6.4 слога в секунду. Первые два пункта
    //  буднично, третий — САМАЯ ЗЛАЯ СТРОЧКА РОЛИКА — играется ровно теми же
    //  красками: злость должна быть в словах, а не в голосе.
    //
    //  МНОЖЕСТВЕННОЕ ЧИСЛО С ПЕРВОГО СЛОВА. Стояло «это таракан», и через
    //  реплику «вы или они» цеплялось за мать, школу и дядю, перечисленных
    //  секундой раньше. Поймано вычиткой.
    //lip 5
    together {
        freeman speaks for 6.73s
        do {
            freeman overlays "razvel"      // «это тараканы»
            wait 2.2s
            freeman overlays "raskryl"     // «их поселила мать»
            wait 2.2s
            freeman overlays "vniz"        // «чужой дядя, который вас не помнит»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: ПУСТОТА — ПЕРЕЛОМ И УЗНАВАНИЕ =======================
//  ОТВЕЧАЮТ СЕБЕ ТАМ, ГДЕ НЕЧЕМ ОТВЛЕЧЬСЯ. После детской чёрный кадр работает
//  вдвойне: только что было полно чужих вещей, и вдруг не осталось ничего.
scene "kto_glavnyj" (duration: 1s, set: void) {
    transition static 0.12s

    //  `place` БЕЗ `on floor`: пола нет, кадр держит МАСКА.
    place freeman at (0.5, 0.46) facing front
    freeman scales 2.0 over 0.01s
    camera wide
    freeman pose "calm"

    // ── РАЗВОРОТ (VO-6): перелом ролика ───────────────────────────────
    //  ВОПРОС ВВЕРХ И БЕЗ НАЖИМА — приглашение проверить, а не упрёк. Дальше
    //  девять десятых тишины: зритель отвечает себе сам, и ответ ему не
    //  понравится.
    //lip 6
    together {
        freeman speaks for 5.34s
        do {
            freeman overlays "v_upor"
            wait 3.4s
            freeman overlays "vozzvanie"   // «кто у вас в голове главный?»
        }
    }
    wait 0.9s

    // ── УДАР (VO-7): сам факт переговоров ─────────────────────────────
    //  ГЛАВНОЕ УЗНАВАНИЕ И ЦИТАТА НА СКРИНШОТ. Между фразами пауза длиннее
    //  второй из них: зритель успевает согласиться с первой, и тогда вторая
    //  падает на готовое.
    //lip 7
    together {
        freeman speaks for 5.44s
        do {
            freeman overlays "dve_storony" // «вы с ними договариваетесь»
            wait 3.4s
            freeman overlays "otverg"      // «значит, не вы»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 4: КУХНЯ СО СЧЁТОМ — ЦЕНА ==============================
//  СЧЁТ НА СТОЛЕ И СЧЁТ ПЕРЕГОВОРОВ — ОДИН И ТОТ ЖЕ КАДР. Считать тут
//  привычно, и зритель начинает считать не по нашей просьбе.
scene "schet" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    //  Линия пола y≈0.47 по карте.
    place freeman at (0.42, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ЦЕНА (VO-8): механизм без оценки ──────────────────────────────
    //  РОВНО, КАК ЧИТАЮТ ИНСТРУКЦИЮ. Ни упрёка, ни жалости: описан порядок
    //  действий, который зритель проделывает каждый день. «Каждый раз» — вниз
    //  и тяжелее всего.
    //lip 8
    together {
        freeman speaks for 6.50s
        do {
            freeman overlays "razvel"      // «они шумят, вы объясняете»
            wait 3.6s
            freeman overlays "ugryumo"     // «и так каждый раз»
        }
    }
    wait 0.45s

    // ── ВОЗВРАТНЫЙ ВОПРОС (VO-9): счёт за один день ───────────────────
    //  ОН НЕ РИТОРИЧЕСКИЙ: зритель начинает считать и сбивается. Вверх, почти
    //  участливо — сочувствие тут бьёт сильнее обвинения.
    //lip 9
    together {
        freeman speaks for 2.56s
        do {
            camera medium freeman
            wait 1.5s
            freeman overlays "vozzvanie"   // «сколько раз вы их уговорили?»
        }
    }
    camera wide
    //  САМАЯ ДЛИННАЯ ПАУЗА РОЛИКА: в неё входит счёт, который зритель ведёт
    //  молча и до конца не доводит.
    wait 1.1s
}

// ============ СЦЕНА 5: ПОРОГ С ЧЕРТОЙ — КАЧЕЛИ И ХОД =======================
//  ЕДИНСТВЕННОЕ ЦВЕТНОЕ ПЯТНО РОЛИКА: красная черта на полу. Тот, у кого
//  тараканов нет, переступает её не останавливаясь — и кадр говорит это
//  раньше реплики.
scene "cherta" (duration: 1s, set: porog) {
    transition static 0.25s

    //  Линия пола y≈0.517 по карте. Фигура стоит РОВНО НА ЧЕРТЕ.
    place freeman at (0.44, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"

    // ── КАЧЕЛИ (VO-10): достоинство доказательством ───────────────────
    //  ЗДЕСЬ НЕ УТЕШАЮТ, ЗДЕСЬ ПУГАЮТ — но пугают не зрителя, а тем, что
    //  бывает, когда в голове тихо. Ровно, как констатируют.
    //
    //  «И ВОТ ЧТО СТРАШНО», А НЕ «И ЭТО ХОРОШАЯ НОВОСТЬ»: во втором варианте
    //  фраза на слух читалась прямой похвалой бестараканным, а переворот жил
    //  только в ремарке для озвучки. Поймано вычиткой; теперь он в тексте.
    //lip 10
    together {
        freeman speaks for 7.29s
        do {
            freeman overlays "ladoni_vniz" // «и вот что страшно»
            wait 3.8s
            freeman overlays "vzves"       // «тот просто делает»
        }
    }
    wait 0.5s

    // ── ХОД (VO-11): курс отдаёт своё ─────────────────────────────────
    //  ЕДИНСТВЕННОЕ МЕСТО, ГДЕ КУРС ЧТО-ТО ДАЁТ. Спокойно, с достоинством;
    //  вторая фраза и есть обещание, и произносится она без нажима.
    //lip 11
    together {
        freeman speaks for 5.91s
        do {
            camera medium freeman
            freeman overlays "stop_ladon"  // «выселить их нельзя»
            wait 3.4s
            freeman overlays "teplo"       // «кто из них ваш, а кто чужой»
        }
    }
    camera wide
    wait 0.7s
}

// ============ СЦЕНА 6: СТАДО — ВЗЛЁТ И ШУТКА ===============================
//  НОВАЯ ЛОКАЦИЯ. Плотная вереница одинаковых силуэтов спинами, все в ногу;
//  левая треть мостовой пуста, и фигура стоит там ОДНА. Кадр — сама реплика.
scene "stado" (duration: 1s, set: stado) {
    transition static 0.2s

    //  Координаты сняты пробным рендером (карта: back_y 0.35). Фигура в ЛЕВОЙ
    //  трети: правее 0.35 она войдёт в толпу и потеряется среди силуэтов, а
    //  весь смысл кадра в том, что она стоит ОТДЕЛЬНО.
    place freeman at (0.16, 0.92) facing front on floor
    freeman scales 0.78 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ВЗЛЁТ (VO-12): единственное высокое место ролика ──────────────
    //  СТОЛКНОВЕНИЕ РЕГИСТРОВ: «свобода» и «стадо» в одной строке. От этого
    //  свобода перестаёт звучать лозунгом — она тут означает ровно одно:
    //  шум в голове, которого у идущих мимо нет.
    //lip 12
    together {
        freeman speaks for 6.60s
        do {
            freeman overlays "razvel"      // «в стаде тараканов нет»
            wait 3.6s
            freeman overlays "teplo"       // «ваш шум в голове — это свобода»
        }
    }
    wait 0.9s

    // ── ШУТКА (VO-13): самое популярное не-решение ────────────────────
    //  СМЕЮТСЯ НАД СПОСОБОМ, НЕ НАД ЧЕЛОВЕКОМ. Способ рабочий, у него просто
    //  есть предел, и предел назовут следующей репликой.
    //lip 13
    together {
        freeman speaks for 2.90s
        do {
            freeman overlays "otmahnulsya" // «можно и без курса»
            wait 1.7s
            freeman overlays "prishchur"   // «просто их не слушать»
        }
    }
    wait 0.35s

    // ── ШУТКА-ДОБИВКА (VO-14): предел назван ──────────────────────────
    //  СПОКОЙНАЯ ДОБИВКА, ВНИЗ. Ночью они и становятся слышны — предел не
    //  подчёркивается, иначе получится спор, а не смешно.
    //lip 14
    together {
        freeman speaks for 3.48s
        do {
            freeman overlays "v_upor"
            wait 2.2s
            freeman overlays "doshlo"      // «как вы ляжете спать»
        }
    }
    //  УХМЫЛКА — ПОСЛЕ РЕПЛИКИ, НЕ ВНУТРИ: `smug` трогает рот.
    freeman overlays "smug"
    wait 1.0s
}

// ============ СЦЕНА 7: ЗАЛ ЛЕКТОРИЯ — КУРС =================================
//  ОТКРЫТЫЕ ПОЛКИ: КУРС ЛЕЖИТ И ЖДЁТ.
scene "kurs" (duration: 1s, set: zal) {
    transition static 0.25s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    // ── ПРЕЗЕНТАЦИЯ (VO-15): трудное слово и перевод ──────────────────
    //  ЕДИНСТВЕННОЕ ТРУДНОЕ СЛОВО В РОЛИКЕ, и оно тут же переведено. Перевод
    //  идёт ТЕМ ЖЕ ТОНОМ, без подмигивания: это не шутка про умное слово.
    //lip 15
    together {
        freeman speaks for 5.10s
        do {
            freeman overlays "raskryl"     // «курс так и называется: этика»
            wait 3.3s
            freeman overlays "razmer"      // «кого из них слушать»
        }
    }
    wait 0.45s

    // ── ПРЕЗЕНТАЦИЯ, ДОБИВКА (VO-16): цена ────────────────────────────
    //  РЕПЛИКА САМОДОСТАТОЧНА: числа до неё в ролике не звучало, и «все
    //  десять» без слова «лекций» повисло бы без опоры — на этом уже
    //  обжигались. ГОЛОСОМ НЕ НАЖИМАТЬ: бесплатное с нажимом читается как
    //  подвох.
    //lip 16
    together {
        freeman speaks for 2.00s
        do {
            freeman overlays "razvel"      // «все десять лекций — бесплатно»
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 8: ТОТ ЖЕ ПРИЛАВОК — ЖАЛО ==============================
//  ДЕЙСТВИЕ НАЗНАЧАЮТ ТАМ, ГДЕ НАЧАЛОСЬ ОБВИНЕНИЕ: та же стойка, та же
//  забытая сдача. Кольцо замыкается не словом, а местом.
scene "zhalo" (duration: 1s, set: prilavok) {
    transition static 0.2s

    place freeman at (0.16, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide
    freeman pose "calm"
    freeman overlays "smug"
    wait 0.3s

    // ── ЖАЛО (VO-17): измеримое действие ──────────────────────────────
    //  ОНО ПРО НЕДЕЛАНИЕ, и это самое лёгкое из возможных: не уговаривать.
    //  Планка снижена нарочно — высокая планка и есть то, чем зритель
    //  отговорится.
    //lip 17
    together {
        freeman speaks for 4.89s
        do {
            camera medium freeman
            freeman overlays "stop_ladon"  // «когда они зашумят, не уговаривайте»
        }
    }
    camera wide
    wait 0.5s

    // ── ЖАЛО-ДОБИВКА (VO-18): кольцо замыкается ───────────────────────
    //  ТОТ ЖЕ ВОПРОС, ЧТО И НА ПЕРЕЛОМЕ, но теперь зритель может ответить на
    //  него делом, а не мнением. Почти дружелюбно, вверх на конце.
    //lip 18
    together {
        freeman speaks for 4.32s
        do {
            freeman overlays "vozzvanie"   // «кто там окажется главным?»
        }
    }
    //  ПОДМИГИВАНИЕ — ПОСЛЕ ПОСЛЕДНЕГО СЛОВА: `hero_wink` трогает рот.
    freeman overlays "hero_wink"
    wait 1.2s
}

// ============ СЦЕНА 9: ПОДПИСЬ — ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ =================
//  ПОСЛЕДНИЙ КАДР ТОЖДЕСТВЕН ПЕРВОМУ: тот же прилавок, тот же `place`, тот же
//  масштаб, та же поза поглаживания. Когда студия присвоит номер, метка встанет
//  сюда и в первый кадр одинаково.
scene "final" (duration: 1s, set: prilavok) {
    transition static 0.2s

    place freeman at (0.16, 0.93) facing front on floor
    freeman scales 0.80 over 0.01s
    camera wide

    //lip 19
    together {
        freeman speaks for 5.50s
        do {
            //  ЖЕСТ СЛОЕМ, А НЕ ПОЛНОЙ ПОЗОЙ: полная поза внутри реплики
            //  сбрасывает липсинк и рот прыгает.
            freeman overlays "gladit_grud"
            freeman overlays "teplo"
            wait 2.7s
            freeman overlays "gladit_grud_niz"
            wait 1.5s
            freeman overlays "palec_vverh" // «Поехали!»
        }
    }
    //  ПОСЛЕДНИЙ КАДР: фигура на месте, поза поглаживания — ровно то, с чего
    //  ролик начинается.
    freeman pose "gladit_grud"
    wait 0.4s
}
