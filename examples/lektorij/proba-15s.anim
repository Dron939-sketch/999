// =============================================================================
//  ПРОБА-15с — стенд для проверки гипотез о персонаже.
//
//  НЕ РОЛИК И НЕ ВИТРИНА. Это верстак: пятнадцать секунд, в которых собрано
//  ровно то, что у нас ломается, — чтобы правку персонажа можно было проверить
//  за минуту рендера, а не за прогон каталога.
//
//  Отличие от `etalon-15s.anim`: тот меряет ЗАВОД (длина плана, скорость
//  рендера, громкость, расхождение с золотым кадром). Этот меряет ФИГУРУ:
//  естественность движения и сходство с оригиналом. Голоса здесь нет намеренно —
//  озвучка добавляет минуты к циклу и ничего не говорит о пластике.
//
//  ПОРЯДОК РАБОТЫ:
//      python3 tools/proba.py            # рендер + контактный лист + замеры
//      python3 tools/proba.py --keep до  # сохранить как «до» перед правкой
//      ... правка рига ...
//      python3 tools/proba.py --vs до    # что изменилось, покадрово
//
//  ПЯТЬ ОТРЕЗКОВ, КАЖДЫЙ ПРОВЕРЯЕТ СВОЮ ГИПОТЕЗУ.
//
//  1. РАЗВОРОТ (0–4с). Шесть ракурсов подряд, по 0.6с — дольше, чем 0.25с, за
//     которые поза доезжает (RULES.md). Гипотеза: это одно тело, которое
//     поворачивается. Провал видно сразу — фигура «прыгает» в ширине или
//     проседает по высоте на каком-то ракурсе. Числа даёт `turnaround.py`,
//     глаз ловит то, чего числа не видят: заломы силуэта и потерю массы.
//
//  2. ШАГ (4–7с). Чередование опорных ног. Гипотеза: ноги несут вес, а не
//     болтаются. Смотреть на контакт со стойкой: нога в опоре не должна
//     скользить, тень под фигурой не должна отрываться.
//
//  3. ЖЕСТ И УДЕРЖАНИЕ (7–10с). Поза тела держится, лицо меняется слоем.
//     Гипотеза: мимика НЕ стирает жест. Это тот самый класс ошибок, на котором
//     мы горели дважды (мимика через `pose`, тело через `overlays`).
//
//  4. ЛИЦО НА СВЕРХКРУПЕ (10–13с). Гипотеза: маска похожа на оригинал и держит
//     наезд. Здесь же видно, разваливается ли рисунок на 2.01×.
//
//  5. ПОКОЙ (13–15с). Один план без катов. Гипотеза: фигура живёт и когда её
//     не режут. Если здесь мёртво — «нет динамики» лечится не монтажом.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
// СТЕНД, А НЕ ЛОКАЦИЯ. На `void.svg` верх кадра тёмный, и порог «это тушь»
// ловит небо вместе с фигурой: силуэт становится неизмеримым, а с ним и любое
// суждение о посадке головы. Первый же замер на стенде в это и уткнулся.
import set pole from "../assets/sets/proba-stand.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 1.9
    on-twos: 2
    // Плёночная фактура выключена НАРОЧНО. Зерно, качание кадра и дрожь
    // контура маскируют ровно то, что мы здесь ловим: подмену силуэта и
    // рывок в суставе. Стенд должен показывать голую пластику.
    line-boil: 0.0
    gate-weave: 0.0
    film-grain: 0.0
    film-flicker: 0.0
    vignette: 0.10
    // Опора обязательна: без точки контакта фигура читается парящей, и любое
    // суждение о «естественности» становится необоснованным.
    ground-shadow: true
    form-shadow: 0.0
    rim-light: 0.0
}

scene "proba" (duration: 15s, set: pole) {
    place freeman at (0.5, 0.585) facing front
    freeman scales 0.80 over 0.01s
    camera medium freeman

    // ── 1. РАЗВОРОТ: одно ли это тело ────────────────────────────────────
    freeman pose "calm"
    wait 0.6s
    freeman pose "povorot_pravo"
    wait 0.6s
    freeman pose "chetvert_pravo"
    wait 0.6s
    freeman pose "bok_pravo"
    wait 0.6s
    freeman pose "polu_spina"
    wait 0.6s
    freeman pose "spina"
    wait 0.6s
    freeman pose "calm"
    wait 0.4s

    // ── 2. ШАГ: несут ли ноги вес ────────────────────────────────────────
    camera wide
    freeman pose "shag_levoj"
    wait 0.5s
    freeman pose "shag_pravoj"
    wait 0.5s
    freeman pose "shag_levoj"
    wait 0.5s
    freeman pose "shag_pravoj"
    wait 0.5s
    freeman pose "idet"
    wait 1.0s

    // ── 3. ЖЕСТ И УДЕРЖАНИЕ: не стирает ли лицо жест ─────────────────────
    camera medium freeman
    freeman pose "point"
    wait 0.8s
    freeman overlays "stern"        // сменилось ТОЛЬКО лицо
    wait 0.7s
    freeman overlays "hero_skeptic" // рука обязана остаться поднятой
    wait 0.7s
    freeman overlays "smug"
    wait 0.8s

    // ── 4. ЛИЦО НА СВЕРХКРУПЕ: похоже ли и держит ли наезд ───────────────
    camera extreme-close-up freeman
    freeman overlays "doubt"
    wait 0.7s
    freeman overlays "hero_wink"
    wait 0.7s
    freeman overlays "flash_pupils"
    wait 0.2s
    freeman overlays "hero_grin"
    wait 0.9s
    freeman overlays "calm"
    wait 0.5s

    // ── 5. ПОКОЙ: живёт ли фигура без катов ──────────────────────────────
    camera medium freeman
    freeman pose "calm"
    camera zoom-to freeman over 2.0s ease-in
    wait 2.0s
}
