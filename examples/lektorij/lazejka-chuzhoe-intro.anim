// =============================================================================
//  «ЛАЗЕЙКА», второе интро — ЧУЖИЕ ПРАВИЛА
//
//  ФИШКА — ШЛАГБАУМ, А ТЫ ПЕШКОМ (PRODAZHA.md §2). Запрет настоящий и написан
//  чётко; дыры в нём нет. Он просто не про героя — и весь монтаж об этом:
//
//    · открытие СО СПИНЫ: он покорно стоит перед опущенной стрелой;
//    · на хуке ОБОРАЧИВАЕТСЯ — «и ждёшь, как стадо» сказано тому, кто
//      секунду назад сам смотрел в этот шлагбаум;
//    · на отрицании ИДЁТ НА КАМЕРУ, уходя от стрелы, — как зритель уходит
//      от мысли «так положено»;
//    · на развороте ВПЕЧАТЫВАЕТСЯ надпись «ПРОЕЗД ЗАПРЕЩЁН»: зритель читает
//      слово «проезд» раньше, чем услышит про него в реплике;
//    · на взлёте он ОБХОДИТ шлагбаум справа — стрела кончается, дальше поле.
//      Ни одна деталь не сдвинута: правило цело, человек прошёл;
//    · под жало он уже с той стороны, стрела по-прежнему опущена. Вопрос
//      «сколько раз ты стоял там, где не заперто?» повисает над этим кадром.
//
//  Проверка фишки: выключи звук — видно перекрытую дорогу, надпись про проезд
//  и человека без машины. Понятно, о чём ролик.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set titry from "../assets/sets/lektorij-final.svg"
import set pole from "../assets/sets/field-empty.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b9bbb4
    monochrome: true
    mono-contrast: 2.2
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.14
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

scene "shlagbaum" (duration: 58s, set: pole) {
    transition static 0.35s

    place freeman at (0.30, 0.72) facing front
    freeman scales 0.62 over 0.01s
    // Шлагбаум: столб слева, стрела уходит вправо и КОНЧАЕТСЯ — там проход.
    let bar = prop("shlagbaum", "../assets/props/shlagbaum.svg") at (0.36, 0.545) layer 1
    bar scales 1.4 over 0.01s
    // Надпись на табличке. Ждёт разворота: сначала зритель видит запрет, и
    // только потом слышит, что запрет не про него (ружьё Чехова).
    // Кегль движок игнорирует — размер надписи задаёт ТОЛЬКО scales.
    // 0.27 подобрано замером: текст ровно в белом поле таблички.
    let nadpis = text("ПРОЕЗД ЗАПРЕЩЁН", 34) at (0.5, -2.0) layer 4
    nadpis scales 0.27 over 0.01s
    let slovo = text("А ТЫ ПЕШКОМ", 104) at (0.5, -2.0) layer 6
    slovo scales 2.4 over 0.01s

    // ── БЕЗ СЛОВ: он стоит СПИНОЙ перед опущенной стрелой ─────────────────
    camera wide
    freeman pose "spina"
    wait 1.2s

    // ── ФИРМЕННОЕ ПРИВЕТСТВИЕ (VO-1): всё ещё спиной ──────────────────────
    //lip 1
    together {
        freeman speaks for 3.3s
        do {
            wait 1.6s
            camera medium freeman
        }
    }

    // ── ХУК (VO-2): ОБОРАЧИВАЕТСЯ. «И ждёшь, как стадо» ───────────────────
    //lip 2
    together {
        freeman speaks for 6.0s
        do {
            wait 1.2s                  // первая фраза — ещё к шлагбауму
            freeman pose "polu_spina"
            wait 0.7s
            camera close-up freeman
            freeman pose "chetvert_levo"
            wait 0.9s
            freeman pose "v_upor"
            wait 0.8s
            freeman pose "point"       // палец в зрителя: «ты стоишь»
            camera medium freeman
        }
    }

    // ── ОТРИЦАНИЕ (VO-3): ИДЁТ НА КАМЕРУ, уходя от стрелы ─────────────────
    freeman pose "calm"
    freeman overlays "smug"
    //lip 3
    together {
        freeman speaks for 6.0s
        do {
            camera wide
            freeman moves-to (0.30, 0.77) over 2.2s
            wait 0.3s
            camera medium freeman
            freeman pose "idet"        // идёт на камеру, переставляя ноги
            freeman overlays "doubt"
            freeman moves-to (0.28, 0.83) over 2.0s
            wait 0.4s
            camera close-up freeman
            freeman pose "hips"        // «прочти табличку»
            freeman overlays "hero_skeptic"
        }
    }

    // ── ПУЛЕМЁТ (VO-4): «Запрет на въезд. Ты пешком.» ─────────────────────
    freeman pose "no"
    //lip 4
    together {
        freeman speaks for 8.6s
        do {
            camera wide
            wait 1.6s
            freeman pose "shrug"             // «ты пешком» — а что такого
            wait 1.4s
            camera medium freeman
            freeman pose "hips"
            wait 1.5s
            camera wide
            freeman pose "no"                // «ты без машины»
            wait 1.6s
            camera close-up freeman
        }
    }
    freeman overlays "flash_disgust"
    wait 0.08s
    freeman overlays "stern"
    wait 0.4s

    // ── РАЗВОРОТ (VO-5): ВПЕЧАТЫВАЕТСЯ надпись на табличке ────────────────
    //lip 5
    together {
        freeman speaks for 7.9s
        do {
            camera angle low freeman
            freeman pose "chetvert_pravo"
            wait 1.8s
            camera wide
            nadpis moves-to (0.387, 0.645) over 0.01s  // легла на табличку
            nadpis scales 0.42 over 0.01s
            nadpis scales 0.27 over 0.16s ease-in      // штамп-удар
            camera shake 0.14s intensity 2
            freeman overlays "flash_pupils"
            wait 0.16s
            freeman pose "point"                       // палец в надпись
            wait 1.6s
            camera medium freeman
            freeman overlays "stern"
        }
    }
    wait 0.5s

    // ── ВЗЛЁТ (VO-6): ОБХОДИТ шлагбаум справа — стрела кончилась ──────────
    freeman pose "raskryl"
    //lip 6
    together {
        freeman speaks for 7.9s
        do {
            camera wide
            wait 2.2s                  // «Ты не нарушаешь. Ты читаешь.»
            freeman pose "idet"        // три шага в сторону, мимо конца стрелы
            freeman moves-to (0.78, 0.80) over 3.4s
            wait 3.6s
            freeman pose "open"        // он с той стороны, запрет цел
            freeman overlays "hero_wow"
            camera medium freeman
        }
    }

    // ── ВЗЛЁТ-добивка (VO-7) ──────────────────────────────────────────────
    //lip 7
    together {
        freeman speaks for 7.3s
        do {
            camera medium freeman
            wait 1.6s
            freeman pose "point"       // «десять лекций»
            wait 2.6s
            freeman pose "raskryl"     // «где у текста край»
            camera close-up freeman
            wait 1.8s
            freeman pose "open"
            camera wide
        }
    }

    // ── СЛОВО-УДАР «А ТЫ ПЕШКОМ» + негатив-панч ───────────────────────────
    slovo moves-to (0.5, 0.24) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.8s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in
    freeman overlays "flash_grin"
    wait 0.08s

    // ── ЖАЛО-CTA (VO-8): он за шлагбаумом, стрела опущена ─────────────────
    //  Ничего не двигается: правило работает ровно так же, как в первом кадре.
    //  Изменилось только положение героя — и это весь ответ на вопрос.
    freeman pose "calm"
    freeman pose "lunge"
    //lip 8
    together {
        freeman speaks for 6.0s
        do {
            camera medium freeman
            wait 1.2s
            freeman pose "point"       // «сколько раз ты стоял»
            freeman overlays "hero_sly"
            wait 1.4s
            camera wide
            wait 1.6s
            freeman pose "hips"
            camera close-up freeman
        }
    }
    freeman overlays "hero_wink"
    wait 0.5s
    camera reset over 0.5s
    freeman pose "calm"
    wait 0.8s
}

scene "titry" (duration: 5s, set: titry) {
    transition static 0.45s
    place freeman at (0.5, 3.0) facing front
    let stamp = prop("stamp", "../assets/props/stamp-meister.svg") at (0.5, 2.5)
    stamp hides
    wait 1.0s
    stamp moves-to (0.5, 0.80) over 0.01s
    stamp shows
    stamp scales 2.6 over 0.01s
    stamp rotates -7 over 0.01s
    stamp scales 0.94 over 0.22s ease-in
    stamp scales 1.0 over 0.1s ease-out
    stamp rotates -4 over 0.12s
    wait 2.2s
    transition fade-black 0.8s
}
