// =============================================================================
//  «ДВИГАТЕЛЬ ЕДЕТ САМ» — интро к курсу «Двигатель: лень, амбиции и азарт
//  поиска», номер 18. VO — dvigatel-VO.md, маркеры 1..24.
//
//  ОДНА МЫСЛЬ НА РОЛИК: лень — не поломка, а экономия. Двигатель исправен и
//  едет сам, как только видит куда; направления ему никто не задал, и по
//  умолчанию он едет в ленту.
//
//  ЧЕМ ЭТОТ РОЛИК УСТРОЕН
//
//  1. РОЛИК ПРО ЛЕНЬ НЕ СТЫДИТ. Стыд — это то самое принуждение, которое у
//     зрителя уже не сработало. Вина снимается на восьмой реплике, а до неё
//     его собственный вечер показан как ДОКАЗАТЕЛЬСТВО исправности.
//
//  2. УЛИКА, С КОТОРОЙ НЕЛЬЗЯ СПОРИТЬ: «когда вы заставляли себя открыть
//     ленту?» Ответ у всех один, и он обрушивает диагноз «я безвольный».
//
//  3. ДЕВЯТАЯ РЕПЛИКА — ГРАНИЦА. Ролик про лень, не отделяющий лень от
//     депрессии, вреден: человек с ангедонией услышит «задай направление» и
//     получит ещё один повод считать себя виноватым. Играется сухо.
//
//  4. РАЗНООБРАЗИЕ ДВИЖЕНИЙ СЧИТАЕТСЯ ЧИСЛОМ. Взяты слои, которых не было в
//     трёх предыдущих роликах: `point`, `ruki_za_spinu`, `hips`, `poimal`,
//     `za_uho`, `u_viska_l`, `otvraschenie`, `gore`, `open`, `confident`,
//     `ruka_vverh`, `despair`, `dengi_l`. Поза `myslitel` просилась на перелом
//     и была снята гейтом осанки: она роняет рост до 0.84 эталона, то есть на
//     экране это присед, а не раздумье.
//
//  5. НОМЕР КУРСА 18, метка `nomer-18.svg` белой тушью на груди, в ПЕРВОМ и
//     ПОСЛЕДНЕМ кадре.
//
//  6. ЛОКАЦИЙ СЕМЬ, ОДНА НАРИСОВАНА СТУДИЕЙ ПОД ЭТОТ РОЛИК: кухня с горой
//     посуды. Остальные шесть уже стояли в серии и выбраны не по остатку:
//     перекрёсток без единого знака — буквально «ему не сказали, куда ехать»;
//     на столе с конвертом уже лежит телефон, то есть вещь ролика в кадре без
//     слов; поле днём даёт белое небо, на котором чёрный силуэт отделяется.
//
//  ОБЩИЕ ЗАКОНЫ, которые держат гейты, а не глаз:
//    · в длинной реплике первым слоем называется РУКА (lint_arms);
//    · фигура НЕ ПРИСЕДАЕТ (tools/posture.py);
//    · `duration:` ГОВОРЯЩЕЙ СЦЕНЫ — ПОЛ, А НЕ ЦЕЛЬ, и потому равен 1s;
//      ветка `do{}` не длиннее `speaks for` (tools/pauses.py);
//    · голый `scales` стоит 0.5с таймлайна — всегда `over 0.01s`;
//    · слой, трогающий рот, ВНУТРИ реплики перебивает липсинк — только до или
//      после (tools/speech_lint.py). Здесь такой один: `hero_wink` в финале;
//    · номера реплик и маркеров сходятся (tools/sverka.py);
//    · комментарий цитирует ЖИВУЮ реплику (tools/citaty.py);
//    · КАЖДОЕ ИМЯ ПОЗЫ ЕСТЬ В РИГЕ (tools/imena_poz.py);
//    · ВИЗЕМЫ ОТКРЫВАЮТ РОТ (tools/rot.py, реестр §XXVI);
//    · МАСШТАБ ФИГУРЫ сверяется с мерой локации (tools/masshtab.py, §XXVII);
//    · МАСШТАБ ЧИТАЕТСЯ ВМЕСТЕ С `over` (реестр §XXXI): до починки разбора обе
//      проверки размера работали вхолостую.
//
//  ЧИСЛА `speaks for` — ПРОГНОЗ С ПОПРАВКОЙ ПО РЕГИСТРАМ (`podacha.prognoz`).
//  Завод перепишет их по факту озвучки.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import set kuhnya from "../assets/sets/dvigatel-posuda.svg"
import set stol from "../assets/sets/stol-neprochitannoe.svg"
import set void from "../assets/sets/void-black.svg"
import set perekrestok from "../assets/sets/perekrestok-bez-znakov.svg"
import set okno from "../assets/sets/okno-vetka.svg"
import set pole from "../assets/sets/field-day.svg"
import set zal from "../assets/sets/lektorij-zal.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b0b3ab
    monochrome: true
    mono-contrast: 2.2
    snow: 0.2
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
    ground-shadow: true
    cast-shadow: 0.32
}


// ============ СЦЕНА 1: kuhnya ===========================================
//  Гора посуды стоит в кадре с первой секунды: обвинение зритель уже вынес
//  себе сам, ролику остаётся его повторить вслух.
scene "s1" (duration: 1s, set: kuhnya) {
    place freeman at (0.28, 0.78) facing front on floor
    freeman scales 0.90 over 0.01s

    let nomer = prop("nomer", "../assets/props/nomer-18.svg") at (0.295, 0.545) layer 9
    nomer scales 0.16 over 0.01s
    nomer hides
    camera wide

    //  ПЕРВЫЙ КАДР ТОЖДЕСТВЕН ПОСЛЕДНЕМУ, И ГРУДЬ В ОБОИХ ПУСТАЯ.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer shows
    nomer scales 0.02 over 0.01s
    nomer scales 0.177 over 0.05s ease-out
    nomer scales 0.16 over 0.02s
    freeman pose "gladit_grud_niz"
    wait 0.02s
    nomer hides
    freeman pose "calm"
    wait 0.1s

    //lip 1
    //  «Вы сегодня назвали себя ленивым.»
    together {
        freeman speaks for 2.19s
        do {
            freeman overlays "point"
            wait 1.20s
            freeman overlays "prishchur"
        }
    }
    wait 0.4s

    //lip 2
    //  «И не говорите, что не было времени. Время было.»
    together {
        freeman speaks for 5.71s
        do {
            freeman overlays "ruki_za_spinu"
            wait 2.80s
            freeman overlays "hips"
            wait 1.80s
            freeman overlays "ugryumo"
        }
    }
    wait 0.5s

    //lip 3
    //  «Посуда. Отчёт. Спортзал. Тот самый разговор.»
    together {
        freeman speaks for 3.83s
        do {
            freeman overlays "poimal"
            wait 1.25s
            freeman overlays "za_uho"
            wait 1.25s
            freeman overlays "u_viska_l"
        }
    }
    wait 0.35s

    //lip 4
    //  «А вечером два часа листали ленту.»
    together {
        freeman speaks for 1.86s
        do {
            freeman overlays "otvraschenie"
        }
    }
    wait 0.7s

    //lip 5
    //  «Силы были — ушли не туда.»
    together {
        freeman speaks for 2.27s
        do {
            camera medium freeman
            freeman overlays "gore"
            wait 1.20s
            freeman overlays "somnenie"
        }
    }
    camera wide
    wait 0.6s
}

// ============ СЦЕНА 2: stol =============================================
//  Телефон уже лежит на столе. Вещь ролика попадает в кадр раньше, чем её
//  назовут вслух.
scene "s2" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.22, 0.92) facing front on floor
    freeman scales 1.35 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 6
    //  «А теперь скажите: когда вы заставляли себя открыть ленту?»
    together {
        freeman speaks for 4.26s
        do {
            freeman overlays "open"
            wait 2.20s
            freeman overlays "vzglyad"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 3: void =============================================
//  ПЕРЕЛОМ. Единственная намеренная тишина ролика идёт перед этим кадром.
scene "s3" (duration: 1s, set: void) {
    transition static 0.2s

    place freeman at (0.50, 0.46) facing front
    freeman scales 2.00 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 7
    //  «Никогда. Туда двигатель едет сам.»
    together {
        freeman speaks for 3.66s
        do {
            freeman overlays "vdal"
            wait 1.90s
            freeman overlays "doshlo"
        }
    }
    wait 0.5s
}

// ============ СЦЕНА 4: perekrestok ======================================
//  Перекрёсток без единого знака: реплика «ему не сказали, куда ехать»
//  нарисована раньше, чем произнесена.
scene "s4" (duration: 1s, set: perekrestok) {
    transition static 0.2s

    place freeman at (0.50, 0.80) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 8
    //  «Значит, он исправен — просто ему не сказали, куда ехать.»
    together {
        freeman speaks for 7.30s
        do {
            freeman overlays "ruka_vverh"
            wait 3.60s
            freeman overlays "confident"
            wait 2.40s
            freeman overlays "ostyl"
        }
    }
    wait 0.9s

    //lip 9
    //  «И сразу граница: если давно не тянет вообще ничего — это не лень, это
    //  к врачу.»
    together {
        freeman speaks for 6.80s
        do {
            camera medium freeman
            freeman overlays "stop_ladon"
            wait 3.40s
            freeman overlays "chelo"
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 5: okno =============================================
//  Внутренняя речь звучит там, где тихо: ночное окно и голая ветка.
scene "s5" (duration: 1s, set: okno) {
    transition static 0.2s

    place freeman at (0.34, 0.92) facing front on floor
    freeman scales 1.10 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 10
    //  «Другие могут, а я нет, значит со мной что-то не так.»
    together {
        freeman speaks for 3.81s
        do {
            freeman overlays "despair"
            wait 2.00s
            freeman overlays "zatylok"
        }
    }
    wait 0.35s

    //lip 11
    //  «Так вы поставили себе диагноз, которого нет ни в одной книге.»
    together {
        freeman speaks for 4.01s
        do {
            freeman overlays "obvinil"
            wait 2.10s
            freeman overlays "prishchur"
        }
    }
    wait 0.8s

    //lip 12
    //  «Сколько лет вы с ним живёте?»
    together {
        freeman speaks for 2.29s
        do {
            camera medium freeman
            freeman overlays "dengi_l"
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 6: perekrestok ======================================
//  Возвращаемся туда, где направления нет: теперь его будут задавать.
scene "s6" (duration: 1s, set: perekrestok) {
    transition static 0.2s

    place freeman at (0.50, 0.80) facing front on floor
    freeman scales 0.90 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 13
    //  «И вот что важно: лень вы не победите.»
    together {
        freeman speaks for 2.86s
        do {
            freeman overlays "smel"
            wait 1.50s
            freeman overlays "blink"
        }
    }
    wait 0.35s

    //lip 14
    //  «И не надо. Лень не побеждают — её запрягают.»
    together {
        freeman speaks for 4.19s
        do {
            freeman overlays "poimal"
            wait 2.20s
            freeman overlays "gorech"
        }
    }
    wait 0.9s

    //lip 15
    //  «Мозг бережёт топливо. Это не порок, это конструкция.»
    together {
        freeman speaks for 4.53s
        do {
            freeman overlays "razmer"
            wait 2.30s
            freeman overlays "klin"
        }
    }
    wait 0.4s

    //lip 16
    //  «А куда ехать — задаёт направление. Амбиция это не «хочу больше», а
    //  «хочу туда».»
    together {
        freeman speaks for 7.24s
        do {
            freeman overlays "dve_storony"
            wait 3.60s
            freeman overlays "vdal"
            wait 2.40s
            freeman overlays "doshlo"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 7: pole =============================================
//  ВЗЛЁТ. Единственное высокое место ролика, и высокое слово стоит в одной
//  фразе с бытовым: «свобода» и «лента».
scene "s7" (duration: 1s, set: pole) {
    transition static 0.2s

    place freeman at (0.50, 0.80) facing front on floor
    freeman scales 1.15 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 17
    //  «Свобода — это не пустой вечер, а вечер, который вы не отдали ленте.»
    together {
        freeman speaks for 6.40s
        do {
            freeman overlays "raspahnul"
            wait 2.60s
            freeman overlays "oba_vverh"
            wait 2.20s
            freeman overlays "teplo"
        }
    }
    wait 0.9s
}

// ============ СЦЕНА 8: stol =============================================
//  ШУТКА. Не-решение названо ВЕЩЬЮ — ежедневник, — и лежит он на том же
//  столе, где телефон.
scene "s8" (duration: 1s, set: stol) {
    transition static 0.2s

    place freeman at (0.22, 0.92) facing front on floor
    freeman scales 1.35 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 18
    //  «Самый популярный ответ — взять себя в руки. Купить ежедневник.»
    together {
        freeman speaks for 4.76s
        do {
            freeman overlays "vzves"
            wait 2.40s
            freeman overlays "otmahnulsya"
            wait 1.80s
            freeman overlays "vzglyad"
        }
    }
    wait 0.35s

    //lip 19
    //  «Работает ровно до первой пропущенной страницы.»
    together {
        freeman speaks for 3.04s
        do {
            freeman overlays "shrug"
            wait 1.60s
            freeman overlays "ugryumo"
        }
    }
    wait 1.0s
}

// ============ СЦЕНА 9: zal ==============================================
//  Служебная часть говорится в другом пространстве.
scene "s9" (duration: 1s, set: zal) {
    transition static 0.2s

    place freeman at (0.46, 0.93) facing front on floor
    freeman scales 0.72 over 0.01s
    camera wide
    freeman pose "calm"

    //lip 20
    //  «Курс называется «Двигатель».»
    together {
        freeman speaks for 1.60s
        do {
            freeman overlays "vozzvanie"
        }
    }
    wait 0.4s

    //lip 21
    //  «Десять лекций, и всё бесплатно.»
    together {
        freeman speaks for 2.17s
        do {
            camera medium freeman
            freeman overlays "palec_vverh"
        }
    }
    camera wide
    wait 0.9s
}

// ============ СЦЕНА 10: kuhnya ==========================================
//  ЖАЛО и ПОДПИСЬ. Кольцо ленты: последний кадр тождествен первому, метка
//  курса на том же месте.
scene "s10" (duration: 1s, set: kuhnya) {
    transition static 0.2s

    place freeman at (0.28, 0.78) facing front on floor
    freeman scales 0.90 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-18.svg") at (0.295, 0.545) layer 9
    nomer2 scales 0.16 over 0.01s
    nomer2 hides
    camera wide
    freeman pose "calm"

    //lip 22
    //  «Сегодня спросите себя не «почему я ленюсь», а «куда мой двигатель едет
    //  сам».»
    together {
        freeman speaks for 5.77s
        do {
            freeman overlays "manit"
            wait 2.90s
            freeman overlays "vdal_l"
            wait 1.90s
            freeman overlays "chelo"
        }
    }
    wait 0.5s

    //lip 23
    //  «И кто выбрал ему это направление — вы или лента?»
    together {
        freeman speaks for 4.32s
        do {
            camera medium freeman
            freeman overlays "v_upor"
            wait 2.20s
            freeman overlays "ostyl"
        }
    }
    camera wide
    wait 1.1s

    //  ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ, И ТА ЖЕ МЕТКА.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.02 over 0.01s
    nomer2 scales 0.177 over 0.05s ease-out
    nomer2 scales 0.16 over 0.02s

    //lip 24
    //  «Всё, идём дальше. Лекторий Мейстера, курс лекций. Поехали!»
    together {
        freeman speaks for 5.50s
        do {
            freeman overlays "gladit_grud_niz"
            wait 2.60s
            freeman overlays "wave"
        }
    }
    nomer2 hides
    freeman overlays "hero_wink"
}
