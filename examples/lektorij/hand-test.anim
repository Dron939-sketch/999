import character freeman from "../assets/characters/freeman_rig"

config {
    width: 900
    height: 900
    fps: 24
    background: #c8cbc5
    monochrome: true
    mono-contrast: 1.15
}

scene "test" (duration: 1.0s) {
    place freeman at (0.5, 0.62) facing front
    camera medium freeman
    freeman pose "wave"
    wait 1.0s
}
