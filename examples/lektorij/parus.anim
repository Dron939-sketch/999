// ============ СЦЕНА 9: ulica ============================================
scene "s9" (duration: 1s, set: ulica) {
    transition static 0.2s

    place freeman at (0.50, 0.96) facing front on floor
    freeman scales 0.86 over 0.01s

    let nomer2 = prop("nomer", "../assets/props/nomer-13.svg") at (0.515, 0.672) layer 9
    nomer2 scales 0.16 over 0.01s
    nomer2 hides
    camera wide
    freeman pose "calm"

    //lip 20
    together {
        freeman speaks for 3.77s
        do {
            freeman overlays "manit"
            wait 1.73s
            freeman overlays "kozyrek"
        }
    }
    wait 0.5s

    //lip 21
    together {
        freeman speaks for 5.81s
        do {
            camera medium freeman
            freeman overlays "think"
        }
    }
    camera wide
    wait 1.2s

    //  ТОТ ЖЕ КАДР, ЧТО И ПЕРВЫЙ, И ТА ЖЕ МЕТКА.
    freeman pose "gladit_grud"
    wait 0.02s
    nomer2 shows
    nomer2 scales 0.02 over 0.01s
    nomer2 scales 0.177 over 0.05s ease-out
    nomer2 scales 0.16 over 0.02s

    //lip 22
    together {
        freeman speaks for 5.68s
        do {
            freeman overlays "gladit_grud_niz"
            wait 2.61s
            freeman overlays "vozzvanie"
        }
    }
    nomer2 hides
    freeman overlays "hero_wink"
}
