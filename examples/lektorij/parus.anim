    camera wide
    freeman pose "calm"

    //lip 6
    together {
        freeman speaks for 5.34s
        do {
            freeman overlays "vozzvanie"
            wait 2.46s
            freeman overlays "manit"
        }
    }
    wait 0.9s
}

