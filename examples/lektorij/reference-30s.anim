// =============================================================================
//  ЭТАЛОН СХОДСТВА — 30 секунд по канону Мистера Фримена.
//  Задача: не «красивый ролик», а ЧЕСТНЫЙ ТЕСТ похожести. Собран строго по
//  разбору оригинала: MONTAGE-FREEMAN.md (медиана плана 1.28с, флэши 0.04–0.08с,
//  ТВ-шум как склейка, инверсия как удар, пустота/изоляция), SCRIPT-FREEMAN.md
//  (хук-подколка → пулемёт → разворот → жало), MELOCHI.md (плёночные мелочи).
//  ПОЛЕ — плоское светлое, как дефолт оригинала (локации у него редки).
//  По этому куску сверяем: персонаж, движение, геометрия, физика.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"

config {
    width: 1280
    height: 720
    fps: 24
    background: #e6e4da        // плоское светлое поле — дефолт оригинала
    monochrome: true
    mono-contrast: 1.6         // жёсткий двухтон: чёрный силуэт на светлом
    on-twos: 2
    line-boil: 0.6
    film-grain: 0.16           // после замера дёрганья: фактура без шипения
    vignette: 0.35
    // плёночные мелочи — кадр «снят», а не сгенерирован
    film-flicker: 0.04
    gate-weave: 0.8
    film-scratch: 0.25
    film-dust: 0.5
    // свет: контровой отделяет силуэт
    light-angle: 45
    form-shadow: 0.0        // канон: лицо Фримена ПЛОСКОЕ, без объёма
    rim-light: 0.35
}

scene "kanon" (duration: 32s) {
    // ── ТВ-шум → врывается фигура (канон: без титров, без разгона) ──────────
    transition static 0.35s

    place freeman at (0.5, 0.86) facing front
    freeman scales 1.25
    let slovo = text("ПРОСНИСЬ", 150) at (0.5, -2.0) layer 6
    slovo scales 2.6

    // ── ПУСТОТА/ИЗОЛЯЦИЯ: крошечная фигура в белом поле (приём оригинала) ──
    camera wide
    freeman pose "calm"
    wait 1.6s

    // ── ХУК в упор (t≈3.5, правило 3-7-21) ─────────────────────────────────
    freeman moves-to (0.62, 0.86) over 0.01s
    freeman pose "talk"
    //lip 1
    together {
        freeman speaks for 2.6s
        do {
            camera angle high freeman     // сверху — зритель мелкий
            wait 1.3s
            camera close-up freeman
        }
    }
    freeman pose "flash_grin"             // флэш-морда 0.08с между битами
    wait 0.08s
    freeman pose "skeptic"
    wait 0.5s

    // ── ПУЛЕМЁТ: три коротких удара, кат на каждом ─────────────────────────
    freeman moves-to (0.36, 0.86) over 0.01s
    freeman pose "talk"
    //lip 2
    together {
        freeman speaks for 2.2s
        do {
            camera medium freeman
            wait 1.1s
            camera close-up freeman
        }
    }
    freeman moves-to (0.64, 0.86) over 0.01s
    freeman pose "talk"
    //lip 3
    together {
        freeman speaks for 2.0s
        do {
            camera close-up freeman
            wait 1.0s
            camera extreme-close-up freeman
        }
    }
    freeman pose "flash_rage"
    wait 0.08s
    freeman pose "talk"
    //lip 4
    together {
        freeman speaks for 2.2s
        do {
            camera wide
            wait 1.1s
            camera medium freeman
        }
    }
    camera shake 0.35s intensity 2
    freeman pose "stern"
    wait 0.7s

    // ── РАЗВОРОТ (t≈17): снизу — власть; сверхкруп на глаз ─────────────────
    freeman moves-to (0.5, 0.86) over 0.01s
    freeman pose "talk"
    //lip 5
    together {
        freeman speaks for 4.2s
        do {
            camera angle low freeman
            wait 1.5s
            camera extreme-close-up freeman
            wait 1.4s
            camera medium freeman
        }
    }
    freeman pose "flash_pupils"           // момент узнавания
    wait 0.08s
    wait 0.6s

    // ── СЛОВО-УДАР + негатив (канонический панч) ───────────────────────────
    camera wide
    slovo moves-to (0.5, 0.32) over 0.01s
    slovo scales 1.0 over 0.18s ease-in
    transition invert 0.16s
    camera shake 0.3s intensity 3
    wait 0.9s
    slovo moves-to (0.5, -2.0) over 0.22s ease-in

    // ── ЖАЛО: наезд-удар, подмиг-издёвка, уход в чёрное ────────────────────
    freeman pose "talk"
    //lip 6
    together {
        freeman speaks for 4.6s
        do {
            camera medium freeman
            wait 1.6s
            camera close-up freeman
            wait 1.5s
            camera extreme-close-up freeman
        }
    }
    camera zoom-to freeman over 0.18s ease-in
    freeman pose "hero_wink"
    wait 0.8s
    // отъезд-одиночество: снова крошечная фигура в пустоте
    camera reset over 0.5s
    freeman pose "calm"
    wait 1.0s
    transition fade-black 0.8s
}
