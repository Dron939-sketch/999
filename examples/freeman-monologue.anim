// =============================================================================
//  Мистер Фримен — монолог в камеру. Точный канон:
//    • белая яйцевидная маска, два больших овальных глаза, простой рот;
//    • чёрное силуэтное тело с грубым «дрожащим» чернильным контуром
//      (SVG feTurbulence + feDisplacementMap на каждой части — рисунок от руки);
//    • светло-серый фон с виньеткой и штрихами.
//  Персонаж: examples/assets/characters/freeman_rig/ (риг с локтями/коленями).
//  Рендер: cargo run --release -- render examples/freeman-monologue.anim -o freeman.mp4
// =============================================================================

import character freeman from "assets/characters/freeman_rig"
import set stage from "assets/sets/freeman-stage.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #ccd2ca
    // aged-film post — the finishing layer of the Freeman look.
    // ЗЕРНО 0.34 И ВИНЬЕТКА 0.5 УБРАНЫ. Витрина стиля отстала от замера: именно
    // это зерно пересчитывалось каждый кадр поверх рисунка, живущего на двойках,
    // и давало «дёрганье» 4.39 против 2.04 (MELOCHI.md). Плюс оно же плодило
    // полутона — 26 тонов против шести у оригинала (SIMILARITY.md §6).
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.12
}

scene "monologue" (duration: 20s, set: stage) {
    place freeman at (0.5, 0.74) facing front

    // intro — общий взгляд
    camera medium freeman
    freeman pose "calm"
    wait 1.2s
    freeman overlays "blink"
    wait 0.2s

    // говорит (авто-речь: фонемы чередуются сами)
    //  Мимика — слоем, тело ведут полные позы: `pose "wide"` поставил бы телу
    //  дефолт рига и погасил жест (PRAVILA-DVIZHENIYA.md §5).
    camera close-up freeman
    freeman pose "open"
    freeman speaks for 2s
    freeman overlays "wide"
    wait 1s

    // пожимает плечами
    camera medium freeman
    freeman pose "shrug"
    wait 1.8s

    // указывает и говорит
    freeman pose "point"
    wait 0.8s
    freeman speaks for 1.4s

    // задумался
    camera close-up freeman
    freeman pose "think"
    wait 1.1s
    freeman pose "myslitel"
    wait 0.9s

    // строгий взгляд в упор
    camera extreme-close-up freeman
    freeman pose "v_upor"
    freeman overlays "stern"
    wait 1.4s
    freeman pose "yarost_telom"
    freeman overlays "angry"
    wait 0.8s
    freeman speaks for 1.2s

    // руки в боки, финал
    camera medium freeman
    freeman pose "hips"
    wait 1.6s
    freeman pose "calm"
    wait 0.8s
    freeman overlays "blink"
    wait 0.2s
    freeman pose "calm"
    wait 1s
    transition fade-black 1.4s
}
