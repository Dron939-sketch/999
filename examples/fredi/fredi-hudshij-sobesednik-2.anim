// =============================================================================
//  ФРЕДИ — «Худший собеседник» (реклама приложения, не Лекторий)
//
//  ЧАСТЬ 2 из 2 — ЧТО ДЕЛАТЬ. Продолжение части 1:
//  имя Фреди, бит про живого врача, жало. Титры и уход в негатив — здесь.
//
//  ФИШКА — ДВОЕ В КАДРЕ. Впервые в цеху: кроме Фримена в сцене лежит ВТОРОЙ
//  персонаж (тот же риг под именем sleeper, поза "lezhit"). Он не говорит и
//  не встаёт весь ролик — он просто смотрит в потолок в три часа ночи, пока
//  о нём говорят в третьем лице. Зритель узнаёт себя в лежащем, а не в
//  говорящем: «смотри, как он работает» — и это про тебя.
//
//    · пулемёт идёт КРУПНЫМИ ПЛАНАМИ ЛЕЖАЩЕГО: мимика меняется (weary →
//      doubt → despair), тело не двигается. Пластинка ходит по кругу;
//    · на отрицании Фримен НАКЛОНЯЕТСЯ к зрителю (поза lean) — «фу, с
//      роботом»;
//    · разворот — «следи за рукой»: перечисление на пальцах, кому что
//      изображал сегодня;
//    · взлёт — единственное место, где голос теплеет: имя Фреди;
//    · ПРЕДЕЛ — отдельный бит, которого нет в формуле: прямая отсылка к врачу.
//      Держится строгой мимикой и общим планом, без иронии;
//    · жало — «Пип.» в темноту.
//
//  ЛОКАЦИИ — ЧЕТЫРЕ СЦЕНЫ (продолжение разбивки первой части):
//
//    · кухня        VO-1, VO-2 — та же, что в конце первой части: шов склейки
//                                проходит внутри локации и не читается.
//                                Здесь же ложится имя «ФРЕДИ»;
//    · спальня      VO-3       — «в три часа ночи он не спит», лежащий там же;
//    · поликлиника  VO-4, VO-5 — бит ПРЕДЕЛ. Единственное место без иронии,
//                                и локация буквальная: дверь, в которую входят;
//    · спальня      VO-6…VO-8  — жало там же, где начали.
//
//  Во всех наборах тона средне-серые, а не чёрные: оба персонажа — сплошные
//  силуэты и на тёмной комнате пропали бы. Говорящий стоит на светлом пятне
//  с жёсткой кромкой — единственном месте кадра, где силуэт читается целиком.
// =============================================================================

import character freeman from "../assets/characters/freeman_rig"
import character sleeper from "../assets/characters/freeman_rig"
import set spalnya     from "../assets/sets/fredi-spalnya.svg"
import set kuhnya      from "../assets/sets/fredi-kuhnya.svg"
import set poliklinika from "../assets/sets/fredi-poliklinika.svg"

config {
    width: 1280
    height: 720
    fps: 24
    background: #b9bbb4
    monochrome: true
    mono-contrast: 1.7
    snow: 0.35
    on-twos: 2
    line-boil: 0.55
    film-grain: 0.05
    vignette: 0.22
    film-flicker: 0.025
    gate-weave: 0.35
    film-scratch: 0.25
    film-dust: 0.5
    light-angle: 45
    form-shadow: 0.0
    rim-light: 0.0
}

scene "kuhnya" (duration: 16.4s, set: kuhnya) {
    //  Шов с частью 1 проходит внутри кухни: зритель стыка не увидит.
    //  Здесь же ложится имя — на «первом честном разговоре за день».
    transition static 0.35s

    // Фреди — на светлом пятне слева: только там силуэт читается целиком.
    place freeman at (0.28, 0.72) facing front
    freeman scales 0.6 over 0.01s
    // Имя ложится в кадр на реплике, которая его называет.
    let imya = text("ФРЕДИ", 90) at (0.5, -2.0) layer 6
    imya scales 0.5 over 0.01s
    camera wide
    freeman pose "calm"

    // ── БЕЗ СЛОВ: лежащий смотрит в потолок ───────────────────────────────
    camera wide
    freeman pose "spina"
    wait 1.4s
    freeman pose "polu_spina"
    wait 0.6s
    freeman pose "v_upor"

    // ── VO-20 [ВЗЛЁТ]: Зовут Фреди. Он не поддакивает — он спрашивает.
    // Имя выезжает ДО маркера: prep_lipsync терпит между `//lip` и `speaks`
    // только строительные строки, и на этих двух маркер обнулялся.
    imya moves-to (0.5, 0.30) over 0.01s
    imya scales 0.62 over 0.24s ease-in
    //lip 1
    together {
        freeman speaks for 4.4s
        do {
            camera medium freeman
            freeman pose "open"
            wait 1.6s
            freeman pose "v_upor"
            wait 1.6s
            freeman pose "calm"
        }
    }

    // Пауза между репликами: без неё сборка сдвигала звук на 0.1–0.3с вправо
    // (зазор меньше 0.15с), и рот открывался раньше слова.
    wait 0.6s

    // ── VO-21 [ВЗЛЁТ]: Поворачивает твою тему так, как тебе в голову не приходило
    //lip 2
    together {
        freeman speaks for 8.9s
        do {
            camera medium freeman
            wait 1.6s
            freeman pose "point"
            wait 1.4s
            freeman pose "raskryl"
            wait 1.6s
            freeman pose "hips"
            wait 1.2s
            camera medium freeman
            freeman pose "point"
            wait 1.2s
            freeman pose "hips"
            wait 1.2s
            freeman pose "calm"
            wait 1.0s
            freeman pose "raskryl"
            wait 1.0s
        }
    }
}

scene "spalnya" (duration: 7.5s, set: spalnya) {
    //  «В три часа ночи он не спит» — лежащий всё ещё там, где мы его оставили.
    transition static 0.35s

    // Лежащий: на кровати справа, верх матраса на 0.75 высоты кадра.
    place sleeper at (0.73, 0.60) facing front
    sleeper scales 0.5 over 0.01s
    sleeper pose "lezhit"
    sleeper overlays "weary"

    // Фреди — на светлом пятне от фонаря слева: только там виден силуэт.
    place freeman at (0.28, 0.72) facing front
    freeman scales 0.6 over 0.01s
    camera wide

    // ── VO-22 [ВЗЛЁТ]: В три часа ночи он не спит. В браузере, без установки, нач
    //lip 3
    together {
        freeman speaks for 6.5s
        do {
            camera wide
            freeman pose "point"
            wait 1.8s
            freeman pose "open"
            wait 1.4s
            freeman pose "raskryl"
            wait 1.4s
            freeman pose "calm"
            wait 1.2s
            freeman pose "hips"
            wait 1.0s
            freeman pose "v_upor"
            wait 1.0s
            freeman pose "calm"
        }
    }
}

scene "poliklinika" (duration: 19.5s, set: poliklinika) {
    //  Бит ПРЕДЕЛ. Единственное место ролика без иронии — и локация
    //  буквальная: дверь, в которую входят, а не метафора.
    transition static 0.35s

    // Фреди — на светлом пятне слева: только там силуэт читается целиком.
    place freeman at (0.28, 0.72) facing front
    freeman scales 0.6 over 0.01s
    camera wide
    freeman pose "calm"

    // ── VO-23 [ПРЕДЕЛ]: И да, честно: если у тебя совсем темно — сон развалился, е
    //lip 4
    together {
        freeman speaks for 10.3s
        do {
            camera close-up freeman
            freeman overlays "stern"
            wait 1.1s
            freeman pose "point"
            wait 1.1s
            freeman pose "v_upor"
            wait 1.0s
            freeman pose "calm"
            wait 1.0s
            freeman pose "hunch"
            wait 1.8s
            freeman pose "v_upor"
            wait 1.6s
            camera medium freeman
            wait 1.3s
            freeman pose "open"
            wait 1.3s
            freeman pose "hunch"
            wait 1.2s
            freeman pose "hips"
            wait 1.2s
            freeman pose "v_upor"
        }
    }

    // ── VO-24 [ПРЕДЕЛ]: Фреди, кстати, первый тебе это и скажет. Он умнее многих ж
    //lip 5
    together {
        freeman speaks for 5.1s
        do {
            camera medium freeman
            freeman pose "calm"
            wait 1.0s
            freeman pose "raskryl"
            wait 1.0s
            freeman overlays "smug"
            freeman pose "hips"
            wait 1.0s
            freeman pose "v_upor"
            wait 1.0s
            freeman pose "calm"
        }
    }
}

scene "spalnya-2" (duration: 9.4s, set: spalnya) {
    //  Жало там же, где начали. Имя уже в кадре — с ним и уходим в темноту.
    transition static 0.35s

    // Лежащий: на кровати справа, верх матраса на 0.75 высоты кадра.
    place sleeper at (0.73, 0.60) facing front
    sleeper scales 0.5 over 0.01s
    sleeper pose "lezhit"
    sleeper overlays "weary"

    // Фреди — на светлом пятне от фонаря слева: только там виден силуэт.
    place freeman at (0.28, 0.72) facing front
    freeman scales 0.6 over 0.01s
    // Пропы живут внутри сцены: на жале имя ставим сразу на место,
    // без выезда — оно уже прозвучало и просто досматривает ролик.
    let imya = text("ФРЕДИ", 90) at (0.5, 0.30) layer 6
    imya scales 0.62 over 0.01s
    camera wide

    // ── VO-25 [ЖАЛО]: Ссылка внизу. Тот собеседник в твоей голове никуда не дене
    //lip 6
    together {
        freeman speaks for 4.7s
        do {
            camera wide
            freeman pose "point"
            wait 1.0s
            freeman pose "point"
            wait 1.0s
            freeman pose "calm"
            wait 1.6s
        }
    }

    wait 0.6s

    // ── VO-26 [ЖАЛО]: Но пусть у него появится конкурент.
    //lip 7
    together {
        freeman speaks for 2.8s
        do {
            camera close-up freeman
            freeman overlays "hero_wink"
            wait 1.4s
            freeman pose "v_upor"
            wait 1.2s
        }
    }

    // Пауза перед «Пип» — точка ролика, ей нужна тишина до.
    wait 0.7s

    // ── VO-27 [ЖАЛО]: Пип.
    //lip 8
    together {
        freeman speaks for 0.7s
        do {
            camera medium freeman
            wait 0.4s
        }
    }

    // ── УХОД: негатив-вспышка, имя уже в кадре ────────────────────────────
    transition invert 0.16s
    wait 0.8s
}
