/target
**/*.rs.bk
*.mp4
*.mp3
# Готовые ролики и озвучка НЕ хранятся в git — заливаются в GitHub Releases
# (rolling-тег на ветку), см. videos/README.md. В репозитории — только исходники
# и манифест: иначе videos/ и история пухнут линейно по числу прогонов CI.
output/
__pycache__/

# сгенерированные препроцессором липсинка сцены
*.lipsynced.anim
*.lipsynced.anim.map.json

# Сцены, пересчитанные заводом под вертикальный кадр (`studio._vertical_source`
# пишет `.<имя>.vert.anim` рядом с исходником), и вообще любые временные сцены
# с точки в начале — например копия «до» для сверки рендеров до/после.
# Без этого локальный прогон `studio.py` оставляет за собой неотслеживаемые
# файлы прямо в `examples/`.
.*.anim
.*.anim.*

# отчёты планки Фримена (эфемерные, пишутся заводом рядом с видео)
videos/*.planka.json
